/-!
# Okhotin's Boolean Grammar Open Problems: PPL 105, PPL 153 & PPL 166

## Honest Scope Statement
This module formalizes the foundational theory, exact normal forms, expressive separations,
decidable `O(n^3)` parsing, and structural barriers surrounding Alexander Okhotin's three
**LIVE-VERIFIED OPEN** Boolean grammar prize problems (`prizeproblems.org`, C$360 each):
- **PPL 105:** Does every Boolean grammar have an equivalent grammar in Greibach Normal Form?
- **PPL 153:** Does there exist a universal constant `k` such that every Boolean-grammar language
  is generated by a Boolean grammar with at most `k` nonterminals?
- **PPL 166:** Does there exist a language inherently ambiguous with respect to Boolean grammars?

This module makes **no claim** to resolve any of PPL 105, PPL 153, or PPL 166 in full generality.
Instead, it delivers a **100% unconditional, kernel-verified, pure-Mathlib-signature**
formalization built completely from scratch covering:
1. Exact unique length-stratified semantics for ε-free acyclic-unit Boolean grammars,
   sharpness counterexamples (`A → ¬A`, `A → A`), Knaster–Tarski & Kleene LFP semantics for
   general Conjunctive grammars, closure laws (`⊔, ⊓, \`), and `ContextFreeGrammar` embedding.
2. Bar-Hillel Pumping Lemma for Mathlib's `ContextFreeGrammar` (returning the repeated
   nonterminal witness), strict expressive separation `CFL ⊊ Conjunctive ⊆ Boolean` via
   `{a^n b^n c^n | n ≥ 1}`, and non-closure of CFLs under intersection and complementation.
3. Okhotin Binary Normal Form (BNF, 2004) conversion and computable bottom-up `O(n^3)` CYK
   decidability for all ε-free acyclic-unit Boolean grammars over finite alphabets.
4. PPL 105 Greibach Normal Form frontier: exact suffix-code distributivity vs. general
   non-distributivity & non-monotonic left-recursion barriers, positive GNF theorems for
   stratified and acyclic-left-corner linear Boolean grammars, and explicit GNF for `{a^n b^n c^n}`.
5. PPL 153 & PPL 166 frontiers: Gruska's infinite CFG nonterminal hierarchy (`> k` nonterminals),
   2-nonterminal Boolean collapse of the exact same witness family, finiteness impossibility for
   bounded-RHS / BNF universal `k`, unambiguous BNF resolution of Parikh's inherently ambiguous
   CFL `{a^i b^j c^k | i = j ∨ j = k}`, and full Boolean-algebra closure of unambiguous BNF
   Boolean languages.

Every public theorem signature uses **zero custom or `private` definitions** (100% native Mathlib).
-/

namespace PPL105

/-! ## Section 1: Exact Semantics & Closure Laws for Conjunctive & Boolean Grammars -/

section SemanticsPrivate

private lemma mem_singleton_lang {α : Type*} (a : α) (w : List α) :
    w ∈ ({[a]} : Language α) ↔ w = [a] := Iff.rfl

private lemma mem_sup_lang {α : Type*} (L₁ L₂ : Language α) (w : List α) :
    w ∈ (L₁ ⊔ L₂ : Language α) ↔ w ∈ L₁ ∨ w ∈ L₂ := Iff.rfl

private lemma mem_inf_lang {α : Type*} (L₁ L₂ : Language α) (w : List α) :
    w ∈ (L₁ ⊓ L₂ : Language α) ↔ w ∈ L₁ ∧ w ∈ L₂ := Iff.rfl

private lemma mem_sdiff_lang {α : Type*} (L₁ L₂ : Language α) (w : List α) :
    w ∈ (L₁ \ L₂ : Language α) ↔ w ∈ L₁ ∧ w ∉ L₂ := Iff.rfl

private lemma mem_bot_lang {α : Type*} (w : List α) :
    w ∈ (⊥ : Language α) ↔ False := Iff.rfl

private lemma mem_iSup_lang {α ι : Type*} (F : ι → Language α) (w : List α) :
    w ∈ (⨆ i, F i : Language α) ↔ ∃ i, w ∈ F i := by
  change w ∈ ⋃ i, (F i : Set (List α)) ↔ _
  exact Set.mem_iUnion

private def evalSF {α : Type*} {k : ℕ} (X : Fin k → Language α) (γ : List (α ⊕ Fin k)) :
    Language α :=
  (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod

private lemma evalSF_nil {α : Type*} {k : ℕ} (X : Fin k → Language α) :
    evalSF X [] = 1 := rfl

private lemma mem_evalSF_nil {α : Type*} {k : ℕ} (X : Fin k → Language α) (w : List α) :
    w ∈ evalSF X [] ↔ w = [] := by
  simp [evalSF, Language.mem_one]

private lemma evalSF_cons {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (s : α ⊕ Fin k) (γ : List (α ⊕ Fin k)) :
    evalSF X (s :: γ) = Sum.elim (fun a => ({[a]} : Language α)) X s * evalSF X γ := by
  simp [evalSF]

private lemma evalSF_append {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (γ₁ γ₂ : List (α ⊕ Fin k)) :
    evalSF X (γ₁ ++ γ₂) = evalSF X γ₁ * evalSF X γ₂ := by
  simp [evalSF]

private lemma mem_evalSF_singleton_inl {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (a : α) (w : List α) :
    w ∈ evalSF X [Sum.inl a] ↔ w = [a] := by
  simp [evalSF, mem_singleton_lang]

private lemma mem_evalSF_singleton_inr {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (j : Fin k) (w : List α) :
    w ∈ evalSF X [Sum.inr j] ↔ w ∈ X j := by
  simp [evalSF]

private lemma evalSF_mono {α : Type*} {k : ℕ} {X Y : Fin k → Language α} (hXY : X ≤ Y)
    (γ : List (α ⊕ Fin k)) : evalSF X γ ≤ evalSF Y γ := by
  induction γ with
  | nil => exact le_rfl
  | cons s γ ih =>
    rw [evalSF_cons, evalSF_cons]
    have hs : Sum.elim (fun a => ({[a]} : Language α)) X s ≤
        Sum.elim (fun a => ({[a]} : Language α)) Y s := by
      cases s with
      | inl a => exact le_rfl
      | inr j => exact hXY j
    intro w hw
    change w ∈ Sum.elim (fun a => ({[a]} : Language α)) X s * evalSF X γ at hw
    change w ∈ Sum.elim (fun a => ({[a]} : Language α)) Y s * evalSF Y γ
    rw [Language.mem_mul] at hw ⊢
    rcases hw with ⟨u, hu, v, hv, rfl⟩
    exact ⟨u, hs hu, v, ih hv, rfl⟩

private lemma evalSym_nil_not_mem {α : Type*} {k : ℕ} {X : Fin k → Language α}
    (hX : ∀ j, ([] : List α) ∉ X j) (s : α ⊕ Fin k) :
    ([] : List α) ∉ Sum.elim (fun a => ({[a]} : Language α)) X s := by
  cases s with
  | inl a =>
    simp [mem_singleton_lang]
  | inr j => exact hX j

private lemma evalSF_nil_not_mem {α : Type*} {k : ℕ} {X : Fin k → Language α}
    (hX : ∀ j, ([] : List α) ∉ X j) {γ : List (α ⊕ Fin k)} (hγ : γ ≠ []) :
    ([] : List α) ∉ evalSF X γ := by
  cases γ with
  | nil => exact (hγ rfl).elim
  | cons s γ' =>
    rw [evalSF_cons, Language.mem_mul]
    rintro ⟨u, hu, v, _, huv⟩
    have hu0 : u = [] := (List.append_eq_nil_iff.mp huv).1
    subst hu0
    exact evalSym_nil_not_mem hX s hu

private lemma evalSF_congr_le {α : Type*} {k : ℕ} {X Y : Fin k → Language α} {m : ℕ}
    (hXY : ∀ j (u : List α), u.length ≤ m → (u ∈ X j ↔ u ∈ Y j))
    (γ : List (α ⊕ Fin k)) (w : List α) (hw : w.length ≤ m) :
    w ∈ evalSF X γ ↔ w ∈ evalSF Y γ := by
  induction γ generalizing w with
  | nil => simp [evalSF]
  | cons s γ ih =>
    rw [evalSF_cons, evalSF_cons, Language.mem_mul, Language.mem_mul]
    constructor <;> rintro ⟨u, hu, v, hv, rfl⟩
    · have hu_le : u.length ≤ m := by simp only [List.length_append] at hw; omega
      have hv_le : v.length ≤ m := by simp only [List.length_append] at hw; omega
      refine ⟨u, ?_, v, (ih v hv_le).mp hv, rfl⟩
      cases s with
      | inl a => exact hu
      | inr j => exact (hXY j u hu_le).mp hu
    · have hu_le : u.length ≤ m := by simp only [List.length_append] at hw; omega
      have hv_le : v.length ≤ m := by simp only [List.length_append] at hw; omega
      refine ⟨u, ?_, v, (ih v hv_le).mpr hv, rfl⟩
      cases s with
      | inl a => exact hu
      | inr j => exact (hXY j u hu_le).mpr hu

private lemma evalSF_congr_lt_of_two_le {α : Type*} {k : ℕ} {X Y : Fin k → Language α} {n : ℕ}
    (hX0 : ∀ j, ([] : List α) ∉ X j) (hY0 : ∀ j, ([] : List α) ∉ Y j)
    (hXY : ∀ j (u : List α), u.length < n → (u ∈ X j ↔ u ∈ Y j))
    {γ : List (α ⊕ Fin k)} (hγ : 2 ≤ γ.length) (w : List α) (hw : w.length = n) :
    w ∈ evalSF X γ ↔ w ∈ evalSF Y γ := by
  cases γ with
  | nil => simp at hγ
  | cons s γ' =>
    have hγ' : γ' ≠ [] := by
      intro h; subst h; simp at hγ
    rw [evalSF_cons, evalSF_cons, Language.mem_mul, Language.mem_mul]
    constructor <;> rintro ⟨u, hu, v, hv, rfl⟩
    · have hu_ne : u ≠ [] := fun h => evalSym_nil_not_mem hX0 s (h ▸ hu)
      have hv_ne : v ≠ [] := fun h => evalSF_nil_not_mem hX0 hγ' (h ▸ hv)
      have hu_pos : 1 ≤ u.length := List.length_pos_of_ne_nil hu_ne
      have hv_pos : 1 ≤ v.length := List.length_pos_of_ne_nil hv_ne
      have hu_lt : u.length < n := by simp only [List.length_append] at hw; omega
      have hv_le : v.length ≤ n - 1 := by simp only [List.length_append] at hw; omega
      refine ⟨u, ?_, v, ?_, rfl⟩
      · cases s with
        | inl a => exact hu
        | inr j => exact (hXY j u hu_lt).mp hu
      · exact (evalSF_congr_le (m := n - 1) (fun j z hz => hXY j z (by omega)) γ' v hv_le).mp hv
    · have hu_ne : u ≠ [] := fun h => evalSym_nil_not_mem hY0 s (h ▸ hu)
      have hv_ne : v ≠ [] := fun h => evalSF_nil_not_mem hY0 hγ' (h ▸ hv)
      have hu_pos : 1 ≤ u.length := List.length_pos_of_ne_nil hu_ne
      have hv_pos : 1 ≤ v.length := List.length_pos_of_ne_nil hv_ne
      have hu_lt : u.length < n := by simp only [List.length_append] at hw; omega
      have hv_le : v.length ≤ n - 1 := by simp only [List.length_append] at hw; omega
      refine ⟨u, ?_, v, ?_, rfl⟩
      · cases s with
        | inl a => exact hu
        | inr j => exact (hXY j u hu_lt).mpr hu
      · exact (evalSF_congr_le (m := n - 1) (fun j z hz => hXY j z (by omega)) γ' v hv_le).mpr hv

private lemma evalSF_congr_unit_or_long {α : Type*} {k : ℕ} {X Y : Fin k → Language α}
    (rank : Fin k → ℕ) (i : Fin k) (n : ℕ)
    (hX0 : ∀ j, ([] : List α) ∉ X j) (hY0 : ∀ j, ([] : List α) ∉ Y j)
    (hXY_lt : ∀ j (u : List α), u.length < n → (u ∈ X j ↔ u ∈ Y j))
    (hXY_rk : ∀ j, rank j < rank i → ∀ (u : List α), u.length = n → (u ∈ X j ↔ u ∈ Y j))
    {γ : List (α ⊕ Fin k)} (hγ_ne : γ ≠ [])
    (hγ_rk : ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i)
    (w : List α) (hw : w.length = n) :
    w ∈ evalSF X γ ↔ w ∈ evalSF Y γ := by
  by_cases hlen : 2 ≤ γ.length
  · exact evalSF_congr_lt_of_two_le hX0 hY0 hXY_lt hlen w hw
  · rcases γ with _ | ⟨s, _ | ⟨t, rest⟩⟩
    · exact (hγ_ne rfl).elim
    · cases s with
      | inl a => simp [evalSF]
      | inr j =>
        rw [mem_evalSF_singleton_inr, mem_evalSF_singleton_inr]
        exact hXY_rk j (hγ_rk j rfl) w hw
    · simp at hlen

private def boolCond {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X : Fin k → Language α) (i : Fin k) (w : List α) : Prop :=
  ∃ r ∈ G i, (∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)

private lemma boolCond_congr {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (rank : Fin k → ℕ)
    (hwf : ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    {X Y : Fin k → Language α} (i : Fin k) (n : ℕ)
    (hX0 : ∀ j, ([] : List α) ∉ X j) (hY0 : ∀ j, ([] : List α) ∉ Y j)
    (hXY_lt : ∀ j (u : List α), u.length < n → (u ∈ X j ↔ u ∈ Y j))
    (hXY_rk : ∀ j, rank j < rank i → ∀ (u : List α), u.length = n → (u ∈ X j ↔ u ∈ Y j))
    (w : List α) (hw : w.length = n) :
    boolCond G X i w ↔ boolCond G Y i w := by
  unfold boolCond
  refine exists_congr fun r => and_congr_right fun hr => and_congr ?_ ?_
  · refine forall_congr' fun γ => imp_congr_right fun hγ => ?_
    have hwfγ := hwf i r hr γ (List.mem_append_left _ hγ)
    exact evalSF_congr_unit_or_long rank i n hX0 hY0 hXY_lt hXY_rk hwfγ.1 hwfγ.2 w hw
  · refine forall_congr' fun δ => imp_congr_right fun hδ => not_congr ?_
    have hwfδ := hwf i r hr δ (List.mem_append_right _ hδ)
    exact evalSF_congr_unit_or_long rank i n hX0 hY0 hXY_lt hXY_rk hwfδ.1 hwfδ.2 w hw

private def bgLayer {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X_lt : Fin k → Language α) (n : ℕ) : ℕ → Fin k → Language α
  | 0 => X_lt
  | m + 1 => fun i =>
      X_lt i ⊔ ({w : List α | w.length = n ∧ w ≠ [] ∧ boolCond G (bgLayer G X_lt n m) i w} : Language α)

private lemma mem_bgLayer_succ {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X_lt : Fin k → Language α) (n m : ℕ) (i : Fin k) (w : List α) :
    w ∈ bgLayer G X_lt n (m + 1) i ↔
      w ∈ X_lt i ∨ (w.length = n ∧ w ≠ [] ∧ boolCond G (bgLayer G X_lt n m) i w) := Iff.rfl

private lemma bgLayer_nil_not_mem {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X_lt : Fin k → Language α) (hX0 : ∀ j, ([] : List α) ∉ X_lt j) (n m : ℕ) :
    ∀ j, ([] : List α) ∉ bgLayer G X_lt n m j := by
  cases m with
  | zero => exact hX0
  | succ m =>
    intro j hmem
    rw [mem_bgLayer_succ] at hmem
    rcases hmem with h1 | ⟨_, hne, _⟩
    · exact hX0 j h1
    · exact hne rfl

private lemma bgLayer_mem_lt {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X_lt : Fin k → Language α) (n m : ℕ) (j : Fin k) (w : List α) (hw : w.length < n) :
    w ∈ bgLayer G X_lt n m j ↔ w ∈ X_lt j := by
  cases m with
  | zero => rfl
  | succ m =>
    rw [mem_bgLayer_succ]
    constructor
    · rintro (h | ⟨heq, _, _⟩)
      · exact h
      · omega
    · exact Or.inl

private lemma bgLayer_len_le {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X_lt : Fin k → Language α) (n : ℕ)
    (hX_le : ∀ j (w : List α), w ∈ X_lt j → w.length < n) (m : ℕ) :
    ∀ j (w : List α), w ∈ bgLayer G X_lt n m j → w.length ≤ n := by
  cases m with
  | zero => intro j w hw; exact le_of_lt (hX_le j w hw)
  | succ m =>
    intro j w hw
    rw [mem_bgLayer_succ] at hw
    rcases hw with h | ⟨heq, _, _⟩
    · exact le_of_lt (hX_le j w h)
    · exact le_of_eq heq

private lemma bgLayer_stable {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (rank : Fin k → ℕ)
    (hwf : ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (X_lt : Fin k → Language α) (hX0 : ∀ j, ([] : List α) ∉ X_lt j) (n : ℕ) :
    ∀ m : ℕ, ∀ i : Fin k, rank i < m →
      ∀ w : List α, w ∈ bgLayer G X_lt n (m + 1) i ↔ w ∈ bgLayer G X_lt n m i := by
  intro m
  induction m with
  | zero => intro i hi; omega
  | succ m ih =>
    intro i hi w
    rw [mem_bgLayer_succ, mem_bgLayer_succ]
    refine or_congr_right (and_congr_right fun hwn => and_congr_right fun _ => ?_)
    exact boolCond_congr G rank hwf i n
      (bgLayer_nil_not_mem G X_lt hX0 n (m + 1))
      (bgLayer_nil_not_mem G X_lt hX0 n m)
      (fun j u hu => by rw [bgLayer_mem_lt G X_lt n (m + 1) j u hu, bgLayer_mem_lt G X_lt n m j u hu])
      (fun j hj u _ => ih j (by omega) u)
      w hwn

private def bgApprox {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (R : ℕ) : ℕ → Fin k → Language α
  | 0 => fun _ => (⊥ : Language α)
  | n + 1 => bgLayer G (bgApprox G R n) (n + 1) R

private lemma bgApprox_nil_not_mem {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (R : ℕ) : ∀ n j, ([] : List α) ∉ bgApprox G R n j
  | 0, _ => fun h => (mem_bot_lang []).mp h
  | n + 1, j => bgLayer_nil_not_mem G (bgApprox G R n) (bgApprox_nil_not_mem G R n) (n + 1) R j

private lemma bgApprox_len_le {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (R : ℕ) : ∀ n j (w : List α), w ∈ bgApprox G R n j → w.length ≤ n
  | 0, _, w, h => False.elim ((mem_bot_lang w).mp h)
  | n + 1, j, w, h =>
    bgLayer_len_le G (bgApprox G R n) (n + 1)
      (fun j' u hu => Nat.lt_succ_of_le (bgApprox_len_le G R n j' u hu)) R j w h

private lemma bgApprox_mono_mem {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (R : ℕ) (n m : ℕ) (hnm : n ≤ m) (j : Fin k) (w : List α) (hw : w.length ≤ n) :
    w ∈ bgApprox G R m j ↔ w ∈ bgApprox G R n j := by
  induction hnm with
  | refl => rfl
  | @step m' hnm' ih =>
    rw [← ih]
    have hlt : w.length < m' + 1 := Nat.lt_succ_of_le (le_trans hw hnm')
    exact bgLayer_mem_lt G (bgApprox G R m') (m' + 1) R j w hlt

end SemanticsPrivate

/-- **Unique Length-Stratified Semantics for ε-Free Acyclic-Unit Boolean Grammars.**
Every ε-free Boolean grammar `G` whose unit nonterminal dependencies are acyclic (`rank j < rank i`)
has a **unique** language vector `X : Fin k → Language α` solving its Boolean language equations. -/
theorem ppl105_boolean_grammar_unique_solution {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (hwf : ∃ rank : Fin k → ℕ, ∀ i : Fin k, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i) :
    ∃! X : Fin k → Language α,
      ∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) := by
  rcases hwf with ⟨rank, hwf⟩
  let R : ℕ := Finset.univ.sup rank + 1
  have hrank_lt : ∀ i : Fin k, rank i < R := fun i =>
    Nat.lt_succ_of_le (Finset.le_sup (f := rank) (Finset.mem_univ i))
  let X0 : Fin k → Language α := fun i => ({w : List α | w ∈ bgApprox G R w.length i} : Language α)
  have hX0_eq : ∀ n j (u : List α), u.length ≤ n → (u ∈ X0 j ↔ u ∈ bgApprox G R n j) := by
    intro n j u hu
    exact (bgApprox_mono_mem G R u.length n hu j u le_rfl).symm
  have hX0_nil : ∀ j, ([] : List α) ∉ X0 j := fun j => bgApprox_nil_not_mem G R 0 j
  have hX0_sol : ∀ i w, w ∈ X0 i ↔ w ≠ [] ∧ boolCond G X0 i w := by
    intro i w
    cases hlen : w.length with
    | zero =>
      have hw0 : w = [] := List.eq_nil_of_length_eq_zero hlen
      subst hw0
      simp [hX0_nil i]
    | succ n =>
      have hmem1 : w ∈ X0 i ↔ w ∈ bgLayer G (bgApprox G R n) (n + 1) R i := by
        show w ∈ bgApprox G R w.length i ↔ _
        rw [hlen]; rfl
      have hmem2 : w ∈ bgLayer G (bgApprox G R n) (n + 1) R i ↔
          w ∈ bgLayer G (bgApprox G R n) (n + 1) (R + 1) i :=
        (bgLayer_stable G rank hwf (bgApprox G R n) (bgApprox_nil_not_mem G R n)
          (n + 1) R i (hrank_lt i) w).symm
      rw [hmem1, hmem2, mem_bgLayer_succ]
      have hnot_prev : w ∉ bgApprox G R n i := fun h => by
        have := bgApprox_len_le G R n i w h
        omega
      simp only [hnot_prev, false_or, hlen, true_and]
      refine and_congr_right fun _ => ?_
      exact boolCond_congr G rank hwf i (n + 1)
        (bgLayer_nil_not_mem G (bgApprox G R n) (bgApprox_nil_not_mem G R n) (n + 1) R)
        hX0_nil
        (fun j u hu => by
          change u ∈ bgApprox G R (n + 1) j ↔ u ∈ X0 j
          exact (hX0_eq (n + 1) j u (le_of_lt hu)).symm)
        (fun j _ u hu => by
          change u ∈ bgApprox G R (n + 1) j ↔ u ∈ X0 j
          exact (hX0_eq (n + 1) j u (le_of_eq hu)).symm)
        w hlen
  refine ⟨X0, hX0_sol, ?_⟩
  intro Y hY
  have hY_nil : ∀ j, ([] : List α) ∉ Y j := by
    intro j hj
    exact ((hY j []).mp hj).1 rfl
  have heq_len : ∀ n : ℕ, ∀ w : List α, w.length = n → ∀ i : Fin k, w ∈ Y i ↔ w ∈ X0 i := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ihn =>
      have heq_rk : ∀ m : ℕ, ∀ i : Fin k, rank i = m → ∀ w : List α, w.length = n →
          (w ∈ Y i ↔ w ∈ X0 i) := by
        intro m
        induction m using Nat.strong_induction_on with
        | h m ihm =>
          intro i hi w hw
          rw [hY i w, hX0_sol i w]
          refine and_congr_right fun _ => ?_
          exact boolCond_congr G rank hwf i n hY_nil hX0_nil
            (fun j u hu => ihn u.length hu u rfl j)
            (fun j hj u hu => ihm (rank j) (hi ▸ hj) j rfl u hu)
            w hw
      intro w hw i
      exact heq_rk (rank i) i rfl w hw
  funext i
  ext w
  exact heq_len w.length w rfl i

/-- **Liar-Paradox Sharpness Barrier (`A → ¬A`):** Without acyclicity on unit negative rules,
a 1-nonterminal Boolean grammar has **no** solution over any nonempty alphabet `α`. -/
theorem ppl105_unit_negation_no_solution {α : Type*} (a : α) :
    let G : Fin 1 → List (List (List (α ⊕ Fin 1)) × List (List (α ⊕ Fin 1))) :=
      fun _ => [([], [[Sum.inr (0 : Fin 1)]])]
    ¬ ∃ X : Fin 1 → Language α,
      ∀ i : Fin 1, ∀ w : List α, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun c => ({[c]} : Language α)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun c => ({[c]} : Language α)) X)).prod) := by
  intro G
  rintro ⟨X, hX⟩
  have h := hX 0 [a]
  simp [G] at h

/-- **Unit-Cycle Non-Uniqueness Barrier (`A → A`):** Without acyclicity on unit positive rules,
a 1-nonterminal grammar has at least two distinct ε-free solutions (`⊥` and `{w | w ≠ []}`). -/
theorem ppl105_unit_cycle_nonunique {α : Type*} (a : α) :
    let G : Fin 1 → List (List (List (α ⊕ Fin 1)) × List (List (α ⊕ Fin 1))) :=
      fun _ => [([[Sum.inr (0 : Fin 1)]], [])]
    ∃ X Y : Fin 1 → Language α, X ≠ Y ∧
      (∀ i : Fin 1, ∀ w : List α, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun c => ({[c]} : Language α)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun c => ({[c]} : Language α)) X)).prod)) ∧
      (∀ i : Fin 1, ∀ w : List α, w ∈ Y i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun c => ({[c]} : Language α)) Y)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun c => ({[c]} : Language α)) Y)).prod)) := by
  intro G
  refine ⟨fun _ => (⊥ : Language α), fun _ => ({w : List α | w ≠ []} : Language α), ?_, ?_, ?_⟩
  · intro h
    have hmem : [a] ∈ (fun _ : Fin 1 => ({w : List α | w ≠ []} : Language α)) 0 := by simp
    rw [← h] at hmem
    exact (mem_bot_lang [a]).mp hmem
  · intro i w
    fin_cases i
    simp [G, mem_bot_lang]
  · intro i w
    fin_cases i
    change w ≠ [] ↔ _
    simp [G]
    exact id

section ConjunctivePrivate

private def conjOp {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k))))
    (X : Fin k → Language α) : Fin k → Language α :=
  fun i => ({w : List α | ∃ r ∈ G i, ∀ γ ∈ r, w ∈ evalSF X γ} : Language α)

private lemma mem_conjOp {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k))))
    (X : Fin k → Language α) (i : Fin k) (w : List α) :
    w ∈ conjOp G X i ↔ ∃ r ∈ G i, ∀ γ ∈ r, w ∈ evalSF X γ := Iff.rfl

private lemma conjOp_mono {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)))) :
    Monotone (conjOp G) := by
  intro X Y hXY i w hw
  rcases (mem_conjOp G X i w).mp hw with ⟨r, hr, hmatch⟩
  exact (mem_conjOp G Y i w).mpr ⟨r, hr, fun γ hγ => evalSF_mono hXY γ (hmatch γ hγ)⟩

private def conjOrderHom {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)))) :
    (Fin k → Language α) →o (Fin k → Language α) :=
  ⟨conjOp G, conjOp_mono G⟩

private lemma evalSF_iSup_monotone {α : Type*} {k : ℕ}
    {F : ℕ → Fin k → Language α} (hF : Monotone F)
    (γ : List (α ⊕ Fin k)) (w : List α) :
    w ∈ evalSF (fun i => ⨆ n : ℕ, F n i) γ ↔ ∃ n : ℕ, w ∈ evalSF (F n) γ := by
  induction γ generalizing w with
  | nil =>
    simp only [mem_evalSF_nil, exists_const]
  | cons s γ ih =>
    rw [evalSF_cons, Language.mem_mul]
    constructor
    · rintro ⟨u, hu, v, hv, rfl⟩
      obtain ⟨n₂, hn₂⟩ := (ih v).mp hv
      cases s with
      | inl a =>
        refine ⟨n₂, ?_⟩
        rw [evalSF_cons, Language.mem_mul]
        exact ⟨u, hu, v, hn₂, rfl⟩
      | inr j =>
        rcases (mem_iSup_lang (fun n => F n j) u).mp hu with ⟨n₁, hn₁⟩
        refine ⟨max n₁ n₂, ?_⟩
        rw [evalSF_cons, Language.mem_mul]
        exact ⟨u, hF (le_max_left n₁ n₂) j hn₁, v,
          evalSF_mono (hF (le_max_right n₁ n₂)) γ hn₂, rfl⟩
    · rintro ⟨n, hn⟩
      rw [evalSF_cons, Language.mem_mul] at hn
      rcases hn with ⟨u, hu, v, hv, rfl⟩
      refine ⟨u, ?_, v, (ih v).mpr ⟨n, hv⟩, rfl⟩
      cases s with
      | inl a => exact hu
      | inr j => exact (mem_iSup_lang (fun n => F n j) u).mpr ⟨n, hu⟩

private lemma conjOp_iterate_mono {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)))) :
    Monotone (fun n : ℕ => (conjOp G)^[n] (⊥ : Fin k → Language α)) := by
  have hstep : ∀ n : ℕ, (conjOp G)^[n] (⊥ : Fin k → Language α) ≤
      (conjOp G)^[n + 1] (⊥ : Fin k → Language α) := by
    intro n
    induction n with
    | zero => exact bot_le
    | succ n ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
      exact conjOp_mono G ih
  exact monotone_nat_of_le_succ hstep

private lemma conjOp_kleene_prefix {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k))))
    (Y : Fin k → Language α) (hY : conjOp G Y ≤ Y) :
    ∀ n : ℕ, (conjOp G)^[n] (⊥ : Fin k → Language α) ≤ Y
  | 0 => bot_le
  | n + 1 => by
    rw [Function.iterate_succ_apply']
    exact (conjOp_mono G (conjOp_kleene_prefix G Y hY n)).trans hY

private lemma conjOp_kleene_eq_lfp {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)))) :
    OrderHom.lfp (conjOrderHom G) =
      fun i => ⨆ n : ℕ, ((conjOp G)^[n] (⊥ : Fin k → Language α)) i := by
  set K : Fin k → Language α := fun i => ⨆ n : ℕ, ((conjOp G)^[n] (⊥ : Fin k → Language α)) i
  have hK_le : K ≤ OrderHom.lfp (conjOrderHom G) := by
    intro i w hw
    rcases (mem_iSup_lang _ w).mp hw with ⟨n, hn⟩
    exact conjOp_kleene_prefix G (OrderHom.lfp (conjOrderHom G))
      (le_of_eq (OrderHom.map_lfp (conjOrderHom G))) n i hn
  have hK_pre : conjOp G K ≤ K := by
    intro i w hw
    rcases (mem_conjOp G K i w).mp hw with ⟨r, hr, hmatch⟩
    have hfin : ∀ l : List (List (α ⊕ Fin k)), (∀ γ ∈ l, w ∈ evalSF K γ) →
        ∃ n : ℕ, ∀ γ ∈ l, w ∈ evalSF ((conjOp G)^[n] ⊥) γ := by
      intro l
      induction l with
      | nil => intro _; exact ⟨0, by simp⟩
      | cons γ l ih =>
        intro hall
        obtain ⟨n₁, hn₁⟩ := (evalSF_iSup_monotone (conjOp_iterate_mono G) γ w).mp
          (hall γ (List.mem_cons_self ..))
        obtain ⟨n₂, hn₂⟩ := ih (fun γ' hγ' => hall γ' (List.mem_cons_of_mem _ hγ'))
        refine ⟨max n₁ n₂, fun γ' hγ' => ?_⟩
        rcases List.mem_cons.mp hγ' with rfl | hmem
        · exact evalSF_mono (conjOp_iterate_mono G (le_max_left n₁ n₂)) γ' hn₁
        · exact evalSF_mono (conjOp_iterate_mono G (le_max_right n₁ n₂)) γ' (hn₂ γ' hmem)
    obtain ⟨n, hn⟩ := hfin r hmatch
    refine (mem_iSup_lang _ w).mpr ⟨n + 1, ?_⟩
    rw [Function.iterate_succ_apply']
    exact (mem_conjOp G _ i w).mpr ⟨r, hr, hn⟩
  have hlfp_le : OrderHom.lfp (conjOrderHom G) ≤ K := OrderHom.lfp_le (conjOrderHom G) hK_pre
  exact le_antisymm hlfp_le hK_le

end ConjunctivePrivate

/-- **Knaster–Tarski Least Fixed Point & Kleene ω-Iteration Semantics for Conjunctive Grammars.**
For every (not necessarily ε-free or acyclic) conjunctive grammar `G`, its one-step operator `Φ`
has a least fixed point `X*` which equals the exact Kleene ω-supremum `⨆ n, (Φ^[n] ⊥) i`. -/
theorem ppl105_conjunctive_lfp_and_kleene {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)))) :
    let Φ : (Fin k → Language α) → (Fin k → Language α) :=
      fun X i => ({w : List α | ∃ r ∈ G i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α)
    ∃ X : Fin k → Language α,
      Φ X = X ∧
      (∀ Y : Fin k → Language α, Φ Y ≤ Y → X ≤ Y) ∧
      (∀ i : Fin k, X i = ⨆ n : ℕ, (Φ^[n] (⊥ : Fin k → Language α)) i) := by
  intro Φ
  refine ⟨OrderHom.lfp (conjOrderHom G), OrderHom.map_lfp (conjOrderHom G),
    fun Y hY => OrderHom.lfp_le (conjOrderHom G) hY, fun i => ?_⟩
  exact congrFun (conjOp_kleene_eq_lfp G) i

/-- **Coincidence of Unique Boolean Solution and Knaster–Tarski LFP for ε-Free Acyclic-Unit
Conjunctive Grammars.** When a conjunctive grammar has nonempty rules (`r ≠ []`) and ε-free
acyclic-unit conjuncts, its unique ε-free Boolean solution equals its Knaster–Tarski LFP. -/
theorem ppl105_conjunctive_unique_eq_lfp {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k))))
    (hpos : ∀ i : Fin k, ∀ r ∈ G i, r ≠ [])
    (hwf : ∃ rank : Fin k → ℕ, ∀ i : Fin k, ∀ r ∈ G i, ∀ γ ∈ r,
      γ ≠ [] ∧ ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i) :
    let Φ : (Fin k → Language α) → (Fin k → Language α) :=
      fun X i => ({w : List α | ∃ r ∈ G i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α)
    let G_B : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))) :=
      fun i => (G i).map (fun r => (r, []))
    ∀ X : Fin k → Language α,
      (∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G_B i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) →
      Φ X = X ∧ ∀ Y : Fin k → Language α, Φ Y ≤ Y → X ≤ Y := by
  intro Φ G_B X hX
  have hX_nil : ∀ j, ([] : List α) ∉ X j := fun j hj => ((hX j []).mp hj).1 rfl
  have hX_fix : Φ X = X := by
    funext i
    ext w
    rw [hX i w]
    change (∃ r ∈ G i, ∀ γ ∈ r, w ∈ evalSF X γ) ↔ _
    simp only [G_B, List.mem_map]
    constructor
    · rintro ⟨r, hr, hmatch⟩
      have hne : w ≠ [] := by
        rcases List.exists_mem_of_ne_nil r (hpos i r hr) with ⟨γ, hγ⟩
        rcases hwf with ⟨rank, hwf'⟩
        intro hw0
        subst hw0
        exact evalSF_nil_not_mem hX_nil (hwf' i r hr γ hγ).1 (hmatch γ hγ)
      exact ⟨hne, (r, []), ⟨r, hr, rfl⟩, hmatch, by simp⟩
    · rintro ⟨_, _, ⟨r, hr, rfl⟩, hmatch, _⟩
      exact ⟨r, hr, hmatch⟩
  refine ⟨hX_fix, ?_⟩
  intro Y hY
  have hlfp_le_Y : OrderHom.lfp (conjOrderHom G) ≤ Y := OrderHom.lfp_le (conjOrderHom G) hY
  have hlfp_nil : ∀ j, ([] : List α) ∉ OrderHom.lfp (conjOrderHom G) j := by
    intro j hj
    exact hX_nil j (OrderHom.lfp_le (conjOrderHom G) (le_of_eq hX_fix) j hj)
  have hlfp_sol : ∀ i w, w ∈ OrderHom.lfp (conjOrderHom G) i ↔
      w ≠ [] ∧ ∃ r ∈ G_B i,
        (∀ γ ∈ r.1, w ∈ evalSF (OrderHom.lfp (conjOrderHom G)) γ) ∧
        (∀ δ ∈ r.2, w ∉ evalSF (OrderHom.lfp (conjOrderHom G)) δ) := by
    intro i w
    have hfix : conjOp G (OrderHom.lfp (conjOrderHom G)) i = OrderHom.lfp (conjOrderHom G) i :=
      congrFun (OrderHom.map_lfp (conjOrderHom G)) i
    have hmem : w ∈ OrderHom.lfp (conjOrderHom G) i ↔
        w ∈ conjOp G (OrderHom.lfp (conjOrderHom G)) i := by
      rw [hfix]
    rw [hmem, mem_conjOp]
    simp only [G_B, List.mem_map]
    constructor
    · rintro ⟨r, hr, hmatch⟩
      have hne : w ≠ [] := by
        rcases List.exists_mem_of_ne_nil r (hpos i r hr) with ⟨γ, hγ⟩
        rcases hwf with ⟨rank, hwf'⟩
        intro hw0; subst hw0
        exact evalSF_nil_not_mem hlfp_nil (hwf' i r hr γ hγ).1 (hmatch γ hγ)
      exact ⟨hne, (r, []), ⟨r, hr, rfl⟩, hmatch, by simp⟩
    · rintro ⟨_, _, ⟨r, hr, rfl⟩, hmatch, _⟩
      exact ⟨r, hr, hmatch⟩
  have hwf_B : ∃ rank : Fin k → ℕ, ∀ i : Fin k, ∀ r ∈ G_B i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i := by
    rcases hwf with ⟨rank, hwf'⟩
    refine ⟨rank, fun i r hr γ hγ => ?_⟩
    rcases List.mem_map.mp hr with ⟨r', hr', rfl⟩
    simp only [List.append_nil] at hγ
    exact hwf' i r' hr' γ hγ
  obtain ⟨Z, _, hZuniq⟩ := ppl105_boolean_grammar_unique_solution G_B hwf_B
  have hXZ : X = Z := hZuniq X hX
  have hLZ : OrderHom.lfp (conjOrderHom G) = Z := hZuniq _ hlfp_sol
  rw [hXZ, ← hLZ]
  exact hlfp_le_Y

section ClosurePrivate

private def mapSym {α : Type*} {k₁ k₂ : ℕ} (f : Fin k₁ → Fin k₂) :
    α ⊕ Fin k₁ → α ⊕ Fin k₂ :=
  Sum.map id f

private def mapSF {α : Type*} {k₁ k₂ : ℕ} (f : Fin k₁ → Fin k₂)
    (γ : List (α ⊕ Fin k₁)) : List (α ⊕ Fin k₂) :=
  γ.map (mapSym f)

private def mapRuleB {α : Type*} {k₁ k₂ : ℕ} (f : Fin k₁ → Fin k₂)
    (r : List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))) :
    List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂)) :=
  (r.1.map (mapSF f), r.2.map (mapSF f))

private lemma evalSF_mapSF {α : Type*} {k₁ k₂ : ℕ} (f : Fin k₁ → Fin k₂)
    (X : Fin k₂ → Language α) (γ : List (α ⊕ Fin k₁)) :
    evalSF X (mapSF f γ) = evalSF (fun i => X (f i)) γ := by
  simp only [evalSF, mapSF, mapSym, List.map_map]
  congr 1
  refine List.map_congr_left fun s _ => ?_
  cases s <;> rfl

private lemma mapSF_ne_nil {α : Type*} {k₁ k₂ : ℕ} (f : Fin k₁ → Fin k₂)
    {γ : List (α ⊕ Fin k₁)} (hγ : γ ≠ []) : mapSF f γ ≠ [] := by
  simp [mapSF, hγ]

private lemma mapSF_eq_singleton_inr {α : Type*} {k₁ k₂ : ℕ} (f : Fin k₁ → Fin k₂)
    {γ : List (α ⊕ Fin k₁)} {j₂ : Fin k₂} (h : mapSF f γ = [Sum.inr j₂]) :
    ∃ j₁ : Fin k₁, γ = [Sum.inr j₁] ∧ f j₁ = j₂ := by
  cases γ with
  | nil => simp [mapSF] at h
  | cons s rest =>
    cases rest with
    | nil =>
      cases s with
      | inl a => simp [mapSF, mapSym] at h
      | inr j₁ =>
        simp only [mapSF, mapSym, List.map_cons, List.map_nil, Sum.map_inr,
          List.cons.injEq, Sum.inr.injEq, and_true] at h
        exact ⟨j₁, rfl, h⟩
    | cons _ _ => simp [mapSF] at h

private def inlFin {k₁ k₂ : ℕ} (i : Fin k₁) : Fin (k₁ + k₂ + 1) :=
  ⟨i.1, by omega⟩

private def inrFin {k₁ k₂ : ℕ} (j : Fin k₂) : Fin (k₁ + k₂ + 1) :=
  ⟨k₁ + j.1, by omega⟩

private def topFin (k₁ k₂ : ℕ) : Fin (k₁ + k₂ + 1) :=
  ⟨k₁ + k₂, by omega⟩

private def combineBG {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1))))) :
    Fin (k₁ + k₂ + 1) →
      List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
  fun i =>
    if h1 : i.1 < k₁ then (G₁ ⟨i.1, h1⟩).map (mapRuleB inlFin)
    else if h2 : i.1 < k₁ + k₂ then (G₂ ⟨i.1 - k₁, by omega⟩).map (mapRuleB inrFin)
    else topRules

private lemma combineBG_top {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1))))) :
    combineBG G₁ G₂ topRules (topFin k₁ k₂) = topRules := by
  dsimp only [combineBG, topFin]
  rw [dif_neg (by omega), dif_neg (by omega)]

private def combineSol {α : Type*} {k₁ k₂ : ℕ}
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α) (Ltop : Language α) :
    Fin (k₁ + k₂ + 1) → Language α :=
  fun i =>
    if h1 : i.1 < k₁ then X₁ ⟨i.1, h1⟩
    else if h2 : i.1 < k₁ + k₂ then X₂ ⟨i.1 - k₁, by omega⟩
    else Ltop

private lemma combineSol_inl {α : Type*} {k₁ k₂ : ℕ}
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α) (Ltop : Language α) (i : Fin k₁) :
    combineSol X₁ X₂ Ltop (inlFin i) = X₁ i := by
  dsimp only [combineSol, inlFin]
  rw [dif_pos i.2]

private lemma combineSol_inr {α : Type*} {k₁ k₂ : ℕ}
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α) (Ltop : Language α) (j : Fin k₂) :
    combineSol X₁ X₂ Ltop (inrFin j) = X₂ j := by
  dsimp only [combineSol, inrFin]
  rw [dif_neg (by omega), dif_pos (by omega)]
  congr 1; apply Fin.ext; dsimp; omega

private lemma combineSol_top {α : Type*} {k₁ k₂ : ℕ}
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α) (Ltop : Language α) :
    combineSol X₁ X₂ Ltop (topFin k₁ k₂) = Ltop := by
  dsimp only [combineSol, topFin]
  rw [dif_neg (by omega), dif_neg (by omega)]

private lemma combineBG_wf {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (rank₁ : Fin k₁ → ℕ) (rank₂ : Fin k₂ → ℕ)
    (hwf₁ : ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank₁ j < rank₁ i)
    (hwf₂ : ∀ i, ∀ r ∈ G₂ i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank₂ j < rank₂ i)
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))))
    (htop : ∀ r ∈ topRules, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j : Fin (k₁ + k₂ + 1), γ = [Sum.inr j] → j.1 < k₁ + k₂) :
    ∃ rank : Fin (k₁ + k₂ + 1) → ℕ,
      ∀ i, ∀ r ∈ combineBG G₁ G₂ topRules i, ∀ γ ∈ r.1 ++ r.2,
        γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i := by
  let M : ℕ := max (Finset.univ.sup rank₁) (Finset.univ.sup rank₂) + 1
  let rank : Fin (k₁ + k₂ + 1) → ℕ := fun i =>
    if h1 : i.1 < k₁ then rank₁ ⟨i.1, h1⟩
    else if h2 : i.1 < k₁ + k₂ then rank₂ ⟨i.1 - k₁, by omega⟩
    else M
  refine ⟨rank, fun i r hr γ hγ => ?_⟩
  by_cases h1 : i.1 < k₁
  · simp only [combineBG, dif_pos h1, List.mem_map] at hr
    rcases hr with ⟨r₁, hr₁, rfl⟩
    simp only [mapRuleB, ← List.map_append, List.mem_map] at hγ
    rcases hγ with ⟨γ₁, hγ₁, rfl⟩
    have h := hwf₁ ⟨i.1, h1⟩ r₁ hr₁ γ₁ hγ₁
    refine ⟨mapSF_ne_nil inlFin h.1, fun j hj => ?_⟩
    rcases mapSF_eq_singleton_inr inlFin hj with ⟨j₁, rfl, rfl⟩
    have hlt := h.2 j₁ rfl
    simpa [rank, inlFin, h1, j₁.2] using hlt
  · by_cases h2 : i.1 < k₁ + k₂
    · simp only [combineBG, dif_neg h1, dif_pos h2, List.mem_map] at hr
      rcases hr with ⟨r₂, hr₂, rfl⟩
      simp only [mapRuleB, ← List.map_append, List.mem_map] at hγ
      rcases hγ with ⟨γ₂, hγ₂, rfl⟩
      have h := hwf₂ ⟨i.1 - k₁, by omega⟩ r₂ hr₂ γ₂ hγ₂
      refine ⟨mapSF_ne_nil inrFin h.1, fun j hj => ?_⟩
      rcases mapSF_eq_singleton_inr inrFin hj with ⟨j₂, rfl, rfl⟩
      have hlt := h.2 j₂ rfl
      have h1' : ¬ (k₁ + j₂.1 < k₁) := by omega
      have h2' : k₁ + j₂.1 < k₁ + k₂ := by omega
      simpa [rank, inrFin, h1, h2, h1', h2'] using hlt
    · simp only [combineBG, dif_neg h1, dif_neg h2] at hr
      have h := htop r hr γ hγ
      refine ⟨h.1, fun j hj => ?_⟩
      have hjlt : j.1 < k₁ + k₂ := h.2 j hj
      simp only [rank, dif_neg h1, dif_neg h2]
      by_cases hj1 : j.1 < k₁
      · simp only [dif_pos hj1]
        have hle := Finset.le_sup (f := rank₁) (Finset.mem_univ (⟨j.1, hj1⟩ : Fin k₁))
        exact Nat.lt_succ_of_le (le_trans hle (le_max_left _ _))
      · simp only [dif_neg hj1, dif_pos hjlt]
        have hle := Finset.le_sup (f := rank₂) (Finset.mem_univ (⟨j.1 - k₁, by omega⟩ : Fin k₂))
        exact Nat.lt_succ_of_le (le_trans hle (le_max_right _ _))

private lemma combineBG_sol_other {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α) (Ltop : Language α)
    (hX₁ : ∀ i w, w ∈ X₁ i ↔ w ≠ [] ∧ boolCond G₁ X₁ i w)
    (hX₂ : ∀ i w, w ∈ X₂ i ↔ w ≠ [] ∧ boolCond G₂ X₂ i w)
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))))
    (htop_sol : ∀ w, w ∈ Ltop ↔ w ≠ [] ∧
      boolCond (combineBG G₁ G₂ topRules) (combineSol X₁ X₂ Ltop) (topFin k₁ k₂) w) :
    ∀ i w, w ∈ combineSol X₁ X₂ Ltop i ↔
      w ≠ [] ∧ boolCond (combineBG G₁ G₂ topRules) (combineSol X₁ X₂ Ltop) i w := by
  intro i w
  by_cases h1 : i.1 < k₁
  · simp only [combineSol, dif_pos h1, hX₁ ⟨i.1, h1⟩ w, boolCond, combineBG, List.mem_map]
    refine and_congr_right fun _ => ?_
    constructor
    · rintro ⟨r₁, hr₁, hpos, hneg⟩
      refine ⟨mapRuleB inlFin r₁, ⟨r₁, hr₁, rfl⟩, ?_, ?_⟩
      · intro γ hγ
        rcases List.mem_map.mp hγ with ⟨γ₁, hγ₁, rfl⟩
        rw [evalSF_mapSF]
        simpa [combineSol_inl] using hpos γ₁ hγ₁
      · intro δ hδ
        rcases List.mem_map.mp hδ with ⟨δ₁, hδ₁, rfl⟩
        rw [evalSF_mapSF]
        simpa [combineSol_inl] using hneg δ₁ hδ₁
    · rintro ⟨_, ⟨r₁, hr₁, rfl⟩, hpos, hneg⟩
      refine ⟨r₁, hr₁, ?_, ?_⟩
      · intro γ₁ hγ₁
        have h := hpos (mapSF inlFin γ₁) (List.mem_map.mpr ⟨γ₁, hγ₁, rfl⟩)
        rw [evalSF_mapSF] at h
        simpa [combineSol_inl] using h
      · intro δ₁ hδ₁
        have h := hneg (mapSF inlFin δ₁) (List.mem_map.mpr ⟨δ₁, hδ₁, rfl⟩)
        rw [evalSF_mapSF] at h
        simpa [combineSol_inl] using h
  · by_cases h2 : i.1 < k₁ + k₂
    · simp only [combineSol, dif_neg h1, dif_pos h2, hX₂ ⟨i.1 - k₁, by omega⟩ w, boolCond,
        combineBG, List.mem_map]
      refine and_congr_right fun _ => ?_
      constructor
      · rintro ⟨r₂, hr₂, hpos, hneg⟩
        refine ⟨mapRuleB inrFin r₂, ⟨r₂, hr₂, rfl⟩, ?_, ?_⟩
        · intro γ hγ
          rcases List.mem_map.mp hγ with ⟨γ₂, hγ₂, rfl⟩
          rw [evalSF_mapSF]
          simpa [combineSol_inr] using hpos γ₂ hγ₂
        · intro δ hδ
          rcases List.mem_map.mp hδ with ⟨δ₂, hδ₂, rfl⟩
          rw [evalSF_mapSF]
          simpa [combineSol_inr] using hneg δ₂ hδ₂
      · rintro ⟨_, ⟨r₂, hr₂, rfl⟩, hpos, hneg⟩
        refine ⟨r₂, hr₂, ?_, ?_⟩
        · intro γ₂ hγ₂
          have h := hpos (mapSF inrFin γ₂) (List.mem_map.mpr ⟨γ₂, hγ₂, rfl⟩)
          rw [evalSF_mapSF] at h
          simpa [combineSol_inr] using h
        · intro δ₂ hδ₂
          have h := hneg (mapSF inrFin δ₂) (List.mem_map.mpr ⟨δ₂, hδ₂, rfl⟩)
          rw [evalSF_mapSF] at h
          simpa [combineSol_inr] using h
    · have hi : i = topFin k₁ k₂ := Fin.ext (by dsimp [topFin]; omega)
      subst hi
      rw [combineSol_top]
      exact htop_sol w

end ClosurePrivate

/-- **Boolean Grammar Closure under Union:** The union `X₁ s₁ ⊔ X₂ s₂` of two languages generated
by ε-free acyclic-unit Boolean grammars is generated by an ε-free acyclic-unit Boolean grammar. -/
theorem ppl105_boolean_closure_union {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (s₁ : Fin k₁) (s₂ : Fin k₂)
    (hwf₁ : ∃ rank : Fin k₁ → ℕ, ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (hwf₂ : ∃ rank : Fin k₂ → ℕ, ∀ i, ∀ r ∈ G₂ i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α)
    (hX₁ : ∀ i w, w ∈ X₁ i ↔ w ≠ [] ∧ ∃ r ∈ G₁ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod))
    (hX₂ : ∀ i w, w ∈ X₂ i ↔ w ≠ [] ∧ ∃ r ∈ G₂ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod)) :
    ∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language α),
      (∃ rank : Fin k → ℕ, ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
        γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i) ∧
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) ∧
      X s = X₁ s₁ ⊔ X₂ s₂ := by
  rcases hwf₁ with ⟨rank₁, hwf₁⟩
  rcases hwf₂ with ⟨rank₂, hwf₂⟩
  let topR : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
    [([[Sum.inr (inlFin s₁)]], []), ([[Sum.inr (inrFin s₂)]], [])]
  refine ⟨k₁ + k₂ + 1, combineBG G₁ G₂ topR, topFin k₁ k₂,
    combineSol X₁ X₂ (X₁ s₁ ⊔ X₂ s₂), ?_, ?_, combineSol_top _ _ _⟩
  · refine combineBG_wf G₁ G₂ rank₁ rank₂ hwf₁ hwf₂ topR ?_
    intro r hr γ hγ
    simp only [topR, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl <;>
    · simp only [List.append_nil, List.mem_singleton] at hγ
      subst hγ
      refine ⟨by simp, fun j hj => ?_⟩
      simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hj
      subst hj
      dsimp [inlFin, inrFin]; omega
  · refine combineBG_sol_other G₁ G₂ X₁ X₂ (X₁ s₁ ⊔ X₂ s₂) hX₁ hX₂ topR ?_
    intro w
    rw [mem_sup_lang]
    unfold boolCond
    rw [combineBG_top]
    simp only [topR, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp, exists_eq_left,
      forall_eq, false_implies, forall_const, and_true,
      mem_evalSF_singleton_inr, combineSol_inl, combineSol_inr]
    constructor
    · rintro (h | h)
      · exact ⟨((hX₁ s₁ w).mp h).1, Or.inl h⟩
      · exact ⟨((hX₂ s₂ w).mp h).1, Or.inr h⟩
    · exact And.right

/-- **Boolean Grammar Closure under Intersection:** The intersection `X₁ s₁ ⊓ X₂ s₂` of two
languages generated by ε-free acyclic-unit Boolean grammars is generated by an ε-free acyclic-unit
Boolean grammar. -/
theorem ppl105_boolean_closure_inter {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (s₁ : Fin k₁) (s₂ : Fin k₂)
    (hwf₁ : ∃ rank : Fin k₁ → ℕ, ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (hwf₂ : ∃ rank : Fin k₂ → ℕ, ∀ i, ∀ r ∈ G₂ i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α)
    (hX₁ : ∀ i w, w ∈ X₁ i ↔ w ≠ [] ∧ ∃ r ∈ G₁ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod))
    (hX₂ : ∀ i w, w ∈ X₂ i ↔ w ≠ [] ∧ ∃ r ∈ G₂ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod)) :
    ∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language α),
      (∃ rank : Fin k → ℕ, ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
        γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i) ∧
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) ∧
      X s = X₁ s₁ ⊓ X₂ s₂ := by
  rcases hwf₁ with ⟨rank₁, hwf₁⟩
  rcases hwf₂ with ⟨rank₂, hwf₂⟩
  let topR : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
    [([[Sum.inr (inlFin s₁)], [Sum.inr (inrFin s₂)]], [])]
  refine ⟨k₁ + k₂ + 1, combineBG G₁ G₂ topR, topFin k₁ k₂,
    combineSol X₁ X₂ (X₁ s₁ ⊓ X₂ s₂), ?_, ?_, combineSol_top _ _ _⟩
  · refine combineBG_wf G₁ G₂ rank₁ rank₂ hwf₁ hwf₂ topR ?_
    intro r hr γ hγ
    simp only [topR, List.mem_singleton] at hr
    subst hr
    simp only [List.append_nil, List.mem_cons, List.not_mem_nil, or_false] at hγ
    rcases hγ with rfl | rfl <;>
    · refine ⟨by simp, fun j hj => ?_⟩
      simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hj
      subst hj
      dsimp [inlFin, inrFin]; omega
  · refine combineBG_sol_other G₁ G₂ X₁ X₂ (X₁ s₁ ⊓ X₂ s₂) hX₁ hX₂ topR ?_
    intro w
    rw [mem_inf_lang]
    unfold boolCond
    rw [combineBG_top]
    simp only [topR, exists_eq_left, List.mem_cons, List.not_mem_nil, or_false,
      forall_eq_or_imp, forall_eq, false_implies, forall_const, and_true,
      mem_evalSF_singleton_inr, combineSol_inl, combineSol_inr]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨((hX₁ s₁ w).mp h1).1, h1, h2⟩
    · exact And.right

/-- **Boolean Grammar Closure under ε-Free Complementation:** The ε-free complement
`({w : List α | w ≠ []} : Language α) \ X₁ s₁` of any language generated by an ε-free acyclic-unit
Boolean grammar is generated by an ε-free acyclic-unit Boolean grammar (adding one nonterminal). -/
theorem ppl105_boolean_closure_compl {α : Type*} {k₁ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (s₁ : Fin k₁)
    (hwf₁ : ∃ rank : Fin k₁ → ℕ, ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (X₁ : Fin k₁ → Language α)
    (hX₁ : ∀ i w, w ∈ X₁ i ↔ w ≠ [] ∧ ∃ r ∈ G₁ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod)) :
    ∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language α),
      (∃ rank : Fin k → ℕ, ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
        γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i) ∧
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) ∧
      X s = ({w : List α | w ≠ []} : Language α) \ X₁ s₁ := by
  rcases hwf₁ with ⟨rank₁, hwf₁⟩
  let G₂ : Fin 0 → List (List (List (α ⊕ Fin 0)) × List (List (α ⊕ Fin 0))) := Fin.elim0
  let X₂ : Fin 0 → Language α := Fin.elim0
  let topR : List (List (List (α ⊕ Fin (k₁ + 0 + 1))) × List (List (α ⊕ Fin (k₁ + 0 + 1)))) :=
    [([], [[Sum.inr (inlFin (k₂ := 0) s₁)]])]
  refine ⟨k₁ + 0 + 1, combineBG G₁ G₂ topR, topFin k₁ 0,
    combineSol X₁ X₂ (({w : List α | w ≠ []} : Language α) \ X₁ s₁), ?_, ?_, combineSol_top _ _ _⟩
  · refine combineBG_wf G₁ G₂ rank₁ Fin.elim0 hwf₁ (fun i => Fin.elim0 i) topR ?_
    intro r hr γ hγ
    simp only [topR, List.mem_singleton] at hr
    subst hr
    simp only [List.nil_append, List.mem_singleton] at hγ
    subst hγ
    refine ⟨by simp, fun j hj => ?_⟩
    simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hj
    subst hj
    dsimp [inlFin]; omega
  · refine combineBG_sol_other G₁ G₂ X₁ X₂ (({w : List α | w ≠ []} : Language α) \ X₁ s₁) hX₁
      (fun i => Fin.elim0 i) topR ?_
    intro w
    unfold boolCond
    rw [combineBG_top]
    change (w ≠ [] ∧ w ∉ X₁ s₁) ↔ _
    simp [topR, mem_evalSF_singleton_inr, combineSol_inl]

section ConjClosurePrivate

private def combineConj {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))))) :
    Fin (k₁ + k₂ + 1) → List (List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
  fun i =>
    if h1 : i.1 < k₁ then (G₁ ⟨i.1, h1⟩).map (fun r => r.map (mapSF inlFin))
    else if h2 : i.1 < k₁ + k₂ then (G₂ ⟨i.1 - k₁, by omega⟩).map (fun r => r.map (mapSF inrFin))
    else topRules

private lemma combineConj_inl {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))))) (i : Fin k₁) :
    combineConj G₁ G₂ topRules (inlFin i) = (G₁ i).map (fun r => r.map (mapSF inlFin)) := by
  dsimp only [combineConj, inlFin]
  rw [dif_pos i.2]

private lemma combineConj_inr {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))))) (j : Fin k₂) :
    combineConj G₁ G₂ topRules (inrFin j) = (G₂ j).map (fun r => r.map (mapSF inrFin)) := by
  dsimp only [combineConj, inrFin]
  rw [dif_neg (by omega), dif_pos (by omega)]
  have hsub : (⟨k₁ + j.1 - k₁, by omega⟩ : Fin k₂) = j := Fin.ext (by dsimp; omega)
  rw [hsub]

private lemma combineConj_top {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))))) :
    combineConj G₁ G₂ topRules (topFin k₁ k₂) = topRules := by
  dsimp only [combineConj, topFin]
  rw [dif_neg (by omega), dif_neg (by omega)]

private lemma combineConj_iter_inl {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))))) :
    ∀ n (i : Fin k₁),
      ((conjOp (combineConj G₁ G₂ topRules))^[n] ⊥) (inlFin i) = ((conjOp G₁)^[n] ⊥) i
  | 0, _ => rfl
  | n + 1, i => by
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    ext w
    rw [mem_conjOp, mem_conjOp, combineConj_inl]
    simp only [List.mem_map]
    constructor
    · rintro ⟨_, ⟨r₁, hr₁, rfl⟩, hmatch⟩
      refine ⟨r₁, hr₁, fun γ₁ hγ₁ => ?_⟩
      have h := hmatch (mapSF inlFin γ₁) (List.mem_map.mpr ⟨γ₁, hγ₁, rfl⟩)
      rw [evalSF_mapSF] at h
      simpa [combineConj_iter_inl G₁ G₂ topRules n] using h
    · rintro ⟨r₁, hr₁, hmatch⟩
      refine ⟨r₁.map (mapSF inlFin), ⟨r₁, hr₁, rfl⟩, fun γ hγ => ?_⟩
      rcases List.mem_map.mp hγ with ⟨γ₁, hγ₁, rfl⟩
      rw [evalSF_mapSF]
      simpa [combineConj_iter_inl G₁ G₂ topRules n] using hmatch γ₁ hγ₁

private lemma combineConj_iter_inr {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (topRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))))) :
    ∀ n (j : Fin k₂),
      ((conjOp (combineConj G₁ G₂ topRules))^[n] ⊥) (inrFin j) = ((conjOp G₂)^[n] ⊥) j
  | 0, _ => rfl
  | n + 1, j => by
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    ext w
    rw [mem_conjOp, mem_conjOp, combineConj_inr]
    simp only [List.mem_map]
    constructor
    · rintro ⟨_, ⟨r₂, hr₂, rfl⟩, hmatch⟩
      refine ⟨r₂, hr₂, fun γ₂ hγ₂ => ?_⟩
      have h := hmatch (mapSF inrFin γ₂) (List.mem_map.mpr ⟨γ₂, hγ₂, rfl⟩)
      rw [evalSF_mapSF] at h
      simpa [combineConj_iter_inr G₁ G₂ topRules n] using h
    · rintro ⟨r₂, hr₂, hmatch⟩
      refine ⟨r₂.map (mapSF inrFin), ⟨r₂, hr₂, rfl⟩, fun γ hγ => ?_⟩
      rcases List.mem_map.mp hγ with ⟨γ₂, hγ₂, rfl⟩
      rw [evalSF_mapSF]
      simpa [combineConj_iter_inr G₁ G₂ topRules n] using hmatch γ₂ hγ₂

end ConjClosurePrivate

/-- **Conjunctive Grammar Closure under Union & Intersection (Knaster–Tarski LFP Semantics).** -/
theorem ppl105_conjunctive_closure_union_inter {α : Type*} {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂))))
    (s₁ : Fin k₁) (s₂ : Fin k₂) :
    let L₁ : Language α :=
      ⨆ n : ℕ, ((fun X i => ({w : List α | ∃ r ∈ G₁ i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α))^[n] ⊥) s₁
    let L₂ : Language α :=
      ⨆ n : ℕ, ((fun X i => ({w : List α | ∃ r ∈ G₂ i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α))^[n] ⊥) s₂
    (∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)))) (s : Fin k),
      (⨆ n : ℕ, ((fun X i => ({w : List α | ∃ r ∈ G i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α))^[n] ⊥) s) =
        L₁ ⊔ L₂) ∧
    (∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)))) (s : Fin k),
      (⨆ n : ℕ, ((fun X i => ({w : List α | ∃ r ∈ G i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α))^[n] ⊥) s) =
        L₁ ⊓ L₂) := by
  intro L₁ L₂
  constructor
  · let topU : List (List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
      [[[Sum.inr (inlFin s₁)]], [[Sum.inr (inrFin s₂)]]]
    refine ⟨k₁ + k₂ + 1, combineConj G₁ G₂ topU, topFin k₁ k₂, ?_⟩
    ext w
    rw [mem_iSup_lang, mem_sup_lang, mem_iSup_lang, mem_iSup_lang]
    constructor
    · rintro ⟨n, hn⟩
      cases n with
      | zero => exact False.elim ((mem_bot_lang w).mp hn)
      | succ n =>
        change w ∈ ((conjOp (combineConj G₁ G₂ topU))^[n + 1] ⊥) (topFin k₁ k₂) at hn
        rw [Function.iterate_succ_apply', mem_conjOp, combineConj_top] at hn
        simp only [topU, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
          exists_eq_left, forall_eq, mem_evalSF_singleton_inr,
          combineConj_iter_inl, combineConj_iter_inr] at hn
        rcases hn with h | h
        · exact Or.inl ⟨n, h⟩
        · exact Or.inr ⟨n, h⟩
    · rintro (⟨n, hn⟩ | ⟨n, hn⟩)
      · refine ⟨n + 1, ?_⟩
        change w ∈ ((conjOp (combineConj G₁ G₂ topU))^[n + 1] ⊥) (topFin k₁ k₂)
        rw [Function.iterate_succ_apply', mem_conjOp, combineConj_top]
        simp only [topU, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
          exists_eq_left, forall_eq, mem_evalSF_singleton_inr,
          combineConj_iter_inl, combineConj_iter_inr]
        exact Or.inl hn
      · refine ⟨n + 1, ?_⟩
        change w ∈ ((conjOp (combineConj G₁ G₂ topU))^[n + 1] ⊥) (topFin k₁ k₂)
        rw [Function.iterate_succ_apply', mem_conjOp, combineConj_top]
        simp only [topU, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
          exists_eq_left, forall_eq, mem_evalSF_singleton_inr,
          combineConj_iter_inl, combineConj_iter_inr]
        exact Or.inr hn
  · let topI : List (List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
      [[[Sum.inr (inlFin s₁)], [Sum.inr (inrFin s₂)]]]
    refine ⟨k₁ + k₂ + 1, combineConj G₁ G₂ topI, topFin k₁ k₂, ?_⟩
    ext w
    rw [mem_iSup_lang, mem_inf_lang, mem_iSup_lang, mem_iSup_lang]
    constructor
    · rintro ⟨n, hn⟩
      cases n with
      | zero => exact False.elim ((mem_bot_lang w).mp hn)
      | succ n =>
        change w ∈ ((conjOp (combineConj G₁ G₂ topI))^[n + 1] ⊥) (topFin k₁ k₂) at hn
        rw [Function.iterate_succ_apply', mem_conjOp, combineConj_top] at hn
        simp only [topI, exists_eq_left, List.mem_cons, List.not_mem_nil,
          or_false, forall_eq_or_imp, forall_eq, mem_evalSF_singleton_inr,
          combineConj_iter_inl, combineConj_iter_inr] at hn
        exact ⟨⟨n, hn.1⟩, ⟨n, hn.2⟩⟩
    · rintro ⟨⟨n₁, hn₁⟩, ⟨n₂, hn₂⟩⟩
      refine ⟨max n₁ n₂ + 1, ?_⟩
      change w ∈ ((conjOp (combineConj G₁ G₂ topI))^[max n₁ n₂ + 1] ⊥) (topFin k₁ k₂)
      rw [Function.iterate_succ_apply', mem_conjOp, combineConj_top]
      simp only [topI, exists_eq_left, List.mem_cons, List.not_mem_nil,
        or_false, forall_eq_or_imp, forall_eq, mem_evalSF_singleton_inr,
        combineConj_iter_inl, combineConj_iter_inr]
      exact ⟨conjOp_iterate_mono G₁ (le_max_left n₁ n₂) s₁ hn₁,
        conjOp_iterate_mono G₂ (le_max_right n₁ n₂) s₂ hn₂⟩

/-- **Exact Embedding of Every Mathlib `ContextFreeGrammar` into a Conjunctive Grammar.**
Every context-free grammar `g : ContextFreeGrammar α` has an equivalent single-conjunct
conjunctive grammar `G` whose Knaster–Tarski least fixed point at start nonterminal `s` equals
`g.language`. -/
theorem ppl105_cfg_embeds_in_conjunctive {α : Type*} (g : ContextFreeGrammar α) :
    ∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)))) (s : Fin k),
      (∀ i : Fin k, ∀ r ∈ G i, r.length = 1) ∧
      (⨆ n : ℕ, ((fun X i => ({w : List α | ∃ r ∈ G i, ∀ γ ∈ r,
        w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod} : Language α))^[n] ⊥) s) =
        g.language := by
  classical
  let ruleNTs : ContextFreeRule α g.NT → Finset g.NT := fun r =>
    insert r.input (r.output.filterMap (fun s => match s with
      | Symbol.terminal _ => none
      | Symbol.nonterminal A => some A)).toFinset
  let active : Finset g.NT := insert g.initial (g.rules.biUnion ruleNTs)
  have hinit_mem : g.initial ∈ active := Finset.mem_insert_self _ _
  let k : ℕ := active.card
  let e : active ≃ Fin k := active.equivFin
  let s0 : Fin k := e ⟨g.initial, hinit_mem⟩
  let encodeSym : Symbol α g.NT → α ⊕ Fin k := fun sym =>
    match sym with
    | Symbol.terminal a => Sum.inl a
    | Symbol.nonterminal A =>
      if hA : A ∈ active then Sum.inr (e ⟨A, hA⟩) else Sum.inr s0
  let encodeOut : List (Symbol α g.NT) → List (α ⊕ Fin k) := List.map encodeSym
  let G : Fin k → List (List (List (α ⊕ Fin k))) := fun i =>
    (g.rules.toList.filter (fun r => r.input = (e.symm i).1)).map (fun r => [encodeOut r.output])
  refine ⟨k, G, s0, ?_, ?_⟩
  · intro i r hr
    rcases List.mem_map.mp hr with ⟨r', _, rfl⟩
    rfl
  · have h_rule_nt : ∀ r ∈ g.rules, ∀ A : g.NT,
        Symbol.nonterminal A ∈ r.output → A ∈ active := by
      intro r hr A hA
      apply Finset.mem_insert_of_mem
      apply Finset.mem_biUnion.mpr
      refine ⟨r, hr, Finset.mem_insert_of_mem ?_⟩
      simp only [List.mem_toFinset, List.mem_filterMap]
      exact ⟨Symbol.nonterminal A, hA, rfl⟩
    have h_rule_in : ∀ r ∈ g.rules, r.input ∈ active := by
      intro r hr
      apply Finset.mem_insert_of_mem
      apply Finset.mem_biUnion.mpr
      exact ⟨r, hr, Finset.mem_insert_self _ _⟩
    have hsound : ∀ n (i : Fin k) (w : List α),
        w ∈ ((conjOp G)^[n] ⊥) i →
          g.Derives [Symbol.nonterminal (e.symm i).1] (w.map Symbol.terminal) := by
      intro n
      induction n with
      | zero => intro i w hw; exact False.elim ((mem_bot_lang w).mp hw)
      | succ n ih =>
        intro i w hw
        rw [Function.iterate_succ_apply', mem_conjOp] at hw
        rcases hw with ⟨r, hr, hmatch⟩
        rcases List.mem_map.mp hr with ⟨cr, hcr, rfl⟩
        simp only [List.mem_filter, Finset.mem_toList, decide_eq_true_eq] at hcr
        rcases hcr with ⟨hcr_mem, hcr_in⟩
        have hmem_out : w ∈ evalSF ((conjOp G)^[n] ⊥) (encodeOut cr.output) :=
          hmatch (encodeOut cr.output) (List.mem_singleton_self _)
        have hsub : ∀ l : List (Symbol α g.NT), (∀ A, Symbol.nonterminal A ∈ l → A ∈ active) →
            ∀ u : List α, u ∈ evalSF ((conjOp G)^[n] ⊥) (encodeOut l) →
              g.Derives l (u.map Symbol.terminal) := by
          intro l
          induction l with
          | nil =>
            intro _ u hu
            have hu0 : u = [] := (mem_evalSF_nil _ _).mp hu
            subst hu0
            exact Relation.ReflTransGen.refl
          | cons sym rest ihr =>
            intro hall u hu
            simp only [encodeOut, List.map_cons, evalSF_cons, Language.mem_mul] at hu
            rcases hu with ⟨u₁, hu₁, u₂, hu₂, rfl⟩
            have h2 := ihr (fun A hA => hall A (List.mem_cons_of_mem _ hA)) u₂ hu₂
            have h1 : g.Derives [sym] (u₁.map Symbol.terminal) := by
              cases sym with
              | terminal a =>
                have hu1 : u₁ = [a] := (mem_singleton_lang a u₁).mp hu₁
                subst hu1
                exact Relation.ReflTransGen.refl
              | nonterminal A =>
                have hA : A ∈ active := hall A (List.mem_cons_self ..)
                simp only [encodeSym, dif_pos hA, Sum.elim_inr] at hu₁
                have hder := ih (e ⟨A, hA⟩) u₁ hu₁
                simpa using hder
            have hstep1 := h1.append_right rest
            have hstep2 := h2.append_left (u₁.map Symbol.terminal)
            simpa [List.map_append] using hstep1.trans hstep2
        have hder_out := hsub cr.output (h_rule_nt cr hcr_mem) w hmem_out
        have hprod : g.Produces [Symbol.nonterminal (e.symm i).1] cr.output := by
          refine ⟨cr, hcr_mem, ?_⟩
          rw [← hcr_in]
          simpa using ContextFreeRule.Rewrites.head (r := cr) []
        exact Relation.ReflTransGen.head hprod hder_out
    have hcomp : ∀ (ss : List (Symbol α g.NT)) (w : List α),
        (∀ A, Symbol.nonterminal A ∈ ss → A ∈ active) →
        g.Derives ss (w.map Symbol.terminal) →
        ∃ n : ℕ, w ∈ evalSF ((conjOp G)^[n] ⊥) (encodeOut ss) := by
      intro ss w hss hder
      induction hder using Relation.ReflTransGen.head_induction_on with
      | refl =>
        refine ⟨0, ?_⟩
        clear hss
        induction w with
        | nil => simp [encodeOut, evalSF]
        | cons a tl ihw =>
          simp only [List.map_cons, encodeOut, encodeSym, evalSF_cons, Language.mem_mul]
          exact ⟨[a], (mem_singleton_lang a [a]).mpr rfl, tl, ihw, rfl⟩
      | @head ss₁ ss₂ hprod hrest ih =>
        rcases hprod with ⟨cr, hcr_mem, hrew⟩
        rcases ContextFreeRule.rewrites_iff.mp hrew with ⟨p, q, rfl, rfl⟩
        have hss₂ : ∀ A, Symbol.nonterminal A ∈ p ++ cr.output ++ q → A ∈ active := by
          intro A hA
          simp only [List.mem_append] at hA
          rcases hA with (hp | ho) | hq
          · exact hss A (by simp [hp])
          · exact h_rule_nt cr hcr_mem A ho
          · exact hss A (by simp [hq])
        obtain ⟨n, hn⟩ := ih hss₂
        refine ⟨n + 1, ?_⟩
        simp only [encodeOut, List.map_append, evalSF_append, Language.mem_mul] at hn ⊢
        rcases hn with ⟨u₁, ⟨u_p, hu_p, u_o, hu_o, rfl⟩, u_q, hu_q, rfl⟩
        have hmono := conjOp_iterate_mono G (Nat.le_succ n)
        refine ⟨u_p ++ u_o, ⟨u_p, evalSF_mono hmono _ hu_p, u_o, ?_, rfl⟩,
          u_q, evalSF_mono hmono _ hu_q, rfl⟩
        have hA_in : cr.input ∈ active := h_rule_in cr hcr_mem
        simp only [List.map_singleton, encodeSym, dif_pos hA_in, mem_evalSF_singleton_inr]
        rw [Function.iterate_succ_apply', mem_conjOp]
        refine ⟨[encodeOut cr.output], ?_, fun γ hγ => ?_⟩
        · simp only [G, List.mem_map, List.mem_filter, Finset.mem_toList, decide_eq_true_eq]
          exact ⟨cr, ⟨hcr_mem, by simp⟩, rfl⟩
        · rw [List.mem_singleton.mp hγ]
          exact hu_o
    ext w
    rw [mem_iSup_lang]
    constructor
    · rintro ⟨n, hn⟩
      show g.Generates (w.map Symbol.terminal)
      unfold ContextFreeGrammar.Generates
      have h := hsound n s0 w hn
      simpa [s0] using h
    · intro hw
      have hder : g.Derives [Symbol.nonterminal g.initial] (w.map Symbol.terminal) := hw
      obtain ⟨n, hn⟩ := hcomp [Symbol.nonterminal g.initial] w
        (fun A hA => by
          simp only [List.mem_singleton, Symbol.nonterminal.injEq] at hA
          exact hA ▸ hinit_mem) hder
      refine ⟨n, ?_⟩
      have h1 : encodeOut [Symbol.nonterminal g.initial] = [Sum.inr s0] := by
        simp [encodeOut, encodeSym, dif_pos hinit_mem, s0]
      rw [h1, mem_evalSF_singleton_inr] at hn
      exact hn

/-! ## Section 2: Bar-Hillel Pumping Lemma & Strict Expressive Separation (`CFL ⊊ Conjunctive`) -/

section PumpingPrivate

universe u

mutual
  private inductive DTree {T : Type u} (g : ContextFreeGrammar T) :
      Symbol T g.NT → List T → Type (max 1 u)
    | leaf (a : T) : DTree g (Symbol.terminal a) [a]
    | node (r : ContextFreeRule T g.NT) (hr : r ∈ g.rules)
        {ws : List (List T)} (ch : DForest g r.output ws) :
        DTree g (Symbol.nonterminal r.input) ws.flatten

  private inductive DForest {T : Type u} (g : ContextFreeGrammar T) :
      List (Symbol T g.NT) → List (List T) → Type (max 1 u)
    | nil : DForest g [] []
    | cons {s : Symbol T g.NT} {ss : List (Symbol T g.NT)} {w : List T} {ws : List (List T)}
        (hd : DTree g s w) (tl : DForest g ss ws) :
        DForest g (s :: ss) (w :: ws)
end

mutual
  private def DTree.size {T : Type*} {g : ContextFreeGrammar T} {s : Symbol T g.NT} {w : List T} :
      DTree g s w → ℕ
    | .leaf _ => 1
    | .node _ _ ch => 1 + ch.size

  private def DForest.size {T : Type*} {g : ContextFreeGrammar T}
      {ss : List (Symbol T g.NT)} {ws : List (List T)} :
      DForest g ss ws → ℕ
    | .nil => 0
    | .cons hd tl => hd.size + tl.size
end

mutual
  private def DTree.height {T : Type*} {g : ContextFreeGrammar T} {s : Symbol T g.NT} {w : List T} :
      DTree g s w → ℕ
    | .leaf _ => 0
    | .node _ _ ch => 1 + ch.height

  private def DForest.height {T : Type*} {g : ContextFreeGrammar T}
      {ss : List (Symbol T g.NT)} {ws : List (List T)} :
      DForest g ss ws → ℕ
    | .nil => 0
    | .cons hd tl => max hd.height tl.height
end

mutual
  private lemma dtree_length_le {T : Type*} {g : ContextFreeGrammar T} (K : ℕ)
      (hK1 : 1 ≤ K) (hK : ∀ r ∈ g.rules, r.output.length ≤ K)
      {s : Symbol T g.NT} {w : List T} (t : DTree g s w) :
      w.length ≤ K ^ t.height := by
    cases t with
    | leaf a => simp [DTree.height]
    | node r hr ch =>
      have h1 := dforest_length_le K hK1 hK ch
      have h2 := hK r hr
      calc _ ≤ r.output.length * K ^ ch.height := h1
        _ ≤ K * K ^ ch.height := Nat.mul_le_mul_right _ h2
        _ = K ^ (1 + ch.height) := by rw [Nat.add_comm, pow_succ, Nat.mul_comm]

  private lemma dforest_length_le {T : Type*} {g : ContextFreeGrammar T} (K : ℕ)
      (hK1 : 1 ≤ K) (hK : ∀ r ∈ g.rules, r.output.length ≤ K)
      {ss : List (Symbol T g.NT)} {ws : List (List T)} (f : DForest g ss ws) :
      ws.flatten.length ≤ ss.length * K ^ f.height := by
    cases f with
    | nil => simp [DForest.height]
    | cons hd tl =>
      have h1 := dtree_length_le K hK1 hK hd
      have h2 := dforest_length_le K hK1 hK tl
      have hm1 : K ^ hd.height ≤ K ^ max hd.height tl.height :=
        Nat.pow_le_pow_right hK1 (le_max_left _ _)
      have hm2 : K ^ tl.height ≤ K ^ max hd.height tl.height :=
        Nat.pow_le_pow_right hK1 (le_max_right _ _)
      simp only [List.flatten_cons, List.length_append, List.length_cons, DForest.height]
      calc _ ≤ K ^ hd.height + _ * K ^ tl.height := Nat.add_le_add h1 h2
        _ ≤ K ^ max hd.height tl.height + _ * K ^ max hd.height tl.height :=
            Nat.add_le_add hm1 (Nat.mul_le_mul_left _ hm2)
        _ = (_ + 1) * K ^ max hd.height tl.height := by
            rw [Nat.add_mul, Nat.one_mul, Nat.add_comm]
end

mutual
  private lemma dtree_to_derives {T : Type u} {g : ContextFreeGrammar T}
      {s : Symbol T g.NT} {w : List T} (t : DTree g s w) :
      g.Derives [s] (w.map Symbol.terminal) := by
    cases t with
    | leaf a => simpa using Relation.ReflTransGen.refl
    | node r hr ch =>
      have h1 : g.Produces [Symbol.nonterminal r.input] r.output := by
        refine ⟨r, hr, ?_⟩
        simpa using ContextFreeRule.Rewrites.head (r := r) []
      exact Relation.ReflTransGen.head h1 (dforest_to_derives ch)

  private lemma dforest_to_derives {T : Type u} {g : ContextFreeGrammar T}
      {ss : List (Symbol T g.NT)} {ws : List (List T)} (f : DForest g ss ws) :
      g.Derives ss (ws.flatten.map Symbol.terminal) := by
    cases f with
    | nil => simpa using Relation.ReflTransGen.refl
    | @cons s ss w ws hd tl =>
      have h1 := (dtree_to_derives hd).append_right ss
      have h2 := (dforest_to_derives tl).append_left (w.map Symbol.terminal)
      simpa [List.flatten_cons, List.map_append] using h1.trans h2
end

private def dtreeCast {T : Type u} {g : ContextFreeGrammar T}
    {s : Symbol T g.NT} {w₁ w₂ : List T} (h : w₁ = w₂) (t : DTree g s w₁) : DTree g s w₂ :=
  h ▸ t

private lemma dtreeCast_size {T : Type u} {g : ContextFreeGrammar T}
    {s : Symbol T g.NT} {w₁ w₂ : List T} (h : w₁ = w₂) (t : DTree g s w₁) :
    (dtreeCast h t).size = t.size := by
  subst h; rfl

private def DForest.append {T : Type*} {g : ContextFreeGrammar T}
    {ss₁ ss₂ : List (Symbol T g.NT)} {ws₁ ws₂ : List (List T)} :
    DForest g ss₁ ws₁ → DForest g ss₂ ws₂ → DForest g (ss₁ ++ ss₂) (ws₁ ++ ws₂)
  | .nil, f₂ => f₂
  | .cons hd tl, f₂ => .cons hd (tl.append f₂)

private lemma dforest_split {T : Type*} {g : ContextFreeGrammar T} :
    ∀ {ss₁ ss₂ : List (Symbol T g.NT)} {ws : List (List T)},
      DForest g (ss₁ ++ ss₂) ws →
      ∃ ws₁ ws₂ : List (List T), ws = ws₁ ++ ws₂ ∧
        Nonempty (DForest g ss₁ ws₁) ∧ Nonempty (DForest g ss₂ ws₂)
  | [], _, ws, f => ⟨[], ws, rfl, ⟨.nil⟩, ⟨f⟩⟩
  | _ :: _, _, _, .cons hd tl => by
    obtain ⟨ws₁, ws₂, rfl, ⟨f₁⟩, ⟨f₂⟩⟩ := dforest_split tl
    exact ⟨_ :: ws₁, ws₂, rfl, ⟨.cons hd f₁⟩, ⟨f₂⟩⟩

private lemma dforest_of_terminals {T : Type*} (g : ContextFreeGrammar T) (w : List T) :
    ∃ ws : List (List T), ws.flatten = w ∧ Nonempty (DForest g (w.map Symbol.terminal) ws) := by
  induction w with
  | nil => exact ⟨[], rfl, ⟨.nil⟩⟩
  | cons a tl ih =>
    obtain ⟨ws, hfl, ⟨f⟩⟩ := ih
    exact ⟨[a] :: ws, by simp [hfl], ⟨.cons (.leaf a) f⟩⟩

private lemma derives_to_dforest {T : Type*} {g : ContextFreeGrammar T}
    {ss : List (Symbol T g.NT)} {w : List T}
    (h : g.Derives ss (w.map Symbol.terminal)) :
    ∃ ws : List (List T), ws.flatten = w ∧ Nonempty (DForest g ss ws) := by
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl => exact dforest_of_terminals g w
  | @head ss₁ ss₂ hprod _ ih =>
    rcases hprod with ⟨r, hr, hrew⟩
    rcases ContextFreeRule.rewrites_iff.mp hrew with ⟨p, q, rfl, rfl⟩
    obtain ⟨ws, hfl, ⟨f⟩⟩ := ih
    obtain ⟨ws_pq, ws_q, rfl, ⟨f_pq⟩, ⟨f_q⟩⟩ := dforest_split f
    obtain ⟨ws_p, ws_r, rfl, ⟨f_p⟩, ⟨f_r⟩⟩ := dforest_split f_pq
    refine ⟨ws_p ++ [ws_r.flatten] ++ ws_q, ?_, ⟨?_⟩⟩
    · simpa [List.flatten_append, List.append_assoc] using hfl
    · simpa [List.append_assoc] using (f_p.append (.cons (.node r hr f_r) f_q))

private lemma generates_to_dtree {T : Type*} {g : ContextFreeGrammar T} {w : List T}
    (hw : w ∈ g.language) : Nonempty (DTree g (Symbol.nonterminal g.initial) w) := by
  obtain ⟨ws, hfl, ⟨f⟩⟩ := derives_to_dforest (show g.Derives [Symbol.nonterminal g.initial]
    (w.map Symbol.terminal) from hw)
  cases f with
  | cons hd tl =>
    cases tl with
    | nil =>
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil] at hfl
      exact ⟨dtreeCast hfl hd⟩

private def dtreeCastNT {T : Type u} {g : ContextFreeGrammar T}
    {A B : g.NT} {w : List T} (h : A = B) (t : DTree g (Symbol.nonterminal A) w) :
    DTree g (Symbol.nonterminal B) w :=
  h ▸ t

private lemma dtreeCastNT_size {T : Type u} {g : ContextFreeGrammar T}
    {A B : g.NT} {w : List T} (h : A = B) (t : DTree g (Symbol.nonterminal A) w) :
    (dtreeCastNT h t).size = t.size := by
  subst h; rfl

private lemma dforest_max_child {T : Type u} {g : ContextFreeGrammar T} :
    ∀ {ss : List (Symbol T g.NT)} {ws : List (List T)} (f : DForest g ss ws),
    0 < f.height →
    ∃ (s_c : Symbol T g.NT) (w_c u_l u_r : List T) (t_c : DTree g s_c w_c),
      ws.flatten = u_l ++ w_c ++ u_r ∧
      t_c.height = f.height ∧
      t_c.size ≤ f.size ∧
      g.Derives ss (u_l.map Symbol.terminal ++ [s_c] ++ u_r.map Symbol.terminal) ∧
      ∀ (w_c' : List T) (t_c' : DTree g s_c w_c'), t_c'.size < t_c.size →
        ∃ (ws' : List (List T)) (f' : DForest g ss ws'),
          ws'.flatten = u_l ++ w_c' ++ u_r ∧ f'.size < f.size
  | _, _, .nil, hpos => by simp [DForest.height] at hpos
  | _, _, @DForest.cons _ _ s ss w ws hd tl, hpos => by
    by_cases hge : tl.height ≤ hd.height
    · refine ⟨s, w, [], ws.flatten, hd, ?_, ?_, ?_, ?_, ?_⟩
      · simp
      · simp [DForest.height, max_eq_left hge]
      · simp [DForest.size]
      · have htl := (dforest_to_derives tl).append_left [s]
        simpa using htl
      · intro w' t' hlt
        refine ⟨w' :: ws, .cons t' tl, by simp, ?_⟩
        simp only [DForest.size]; omega
    · push Not at hge
      have htl_pos : 0 < tl.height := by omega
      obtain ⟨s_c, w_c, u_l, u_r, t_c, hfl, hht, hsz, hder, hplug⟩ := dforest_max_child tl htl_pos
      refine ⟨s_c, w_c, w ++ u_l, u_r, t_c, ?_, ?_, ?_, ?_, ?_⟩
      · simp [hfl, List.append_assoc]
      · simp [DForest.height, max_eq_right (le_of_lt hge), hht]
      · simp only [DForest.size]; omega
      · have hhd := (dtree_to_derives hd).append_right ss
        have htl := hder.append_left (w.map Symbol.terminal)
        simpa [List.map_append, List.append_assoc] using hhd.trans htl
      · intro w' t' hlt
        obtain ⟨ws', f', hfl', hsz'⟩ := hplug w' t' hlt
        refine ⟨w :: ws', .cons hd f', ?_, ?_⟩
        · simp [hfl', List.append_assoc]
        · simp only [DForest.size]; omega

private lemma dtree_descend_height {T : Type u} {g : ContextFreeGrammar T} :
    ∀ (d : ℕ) {A : g.NT} {w : List T} (t : DTree g (Symbol.nonterminal A) w) (H : ℕ),
      1 ≤ H → t.height = H + d →
      ∃ (C : g.NT) (u w_sub v : List T) (t_sub : DTree g (Symbol.nonterminal C) w_sub),
        w = u ++ w_sub ++ v ∧
        t_sub.height = H ∧
        g.Derives [Symbol.nonterminal A] (u.map Symbol.terminal ++ [Symbol.nonterminal C] ++ v.map Symbol.terminal) ∧
        ∀ (w_sub' : List T) (t_sub' : DTree g (Symbol.nonterminal C) w_sub'), t_sub'.size < t_sub.size →
          ∃ t' : DTree g (Symbol.nonterminal A) (u ++ w_sub' ++ v), t'.size < t.size
  | 0, A, w, t, H, _, hht =>
    ⟨A, [], w, [], t, by simp, by simpa using hht, by simpa using Relation.ReflTransGen.refl,
      fun w' t' hlt => ⟨dtreeCast (by simp) t', by rw [dtreeCast_size]; exact hlt⟩⟩
  | d + 1, A, w, t, H, hH1, hht => by
    cases t with
    | node r hr ch =>
      have hch_ht : ch.height = H + d := by simp only [DTree.height] at hht; omega
      have hch_pos : 0 < ch.height := by omega
      obtain ⟨s_c, w_c, u_l, u_r, t_c, hfl, ht_c_ht, _, hder_ch, hplug_ch⟩ :=
        dforest_max_child ch hch_pos
      cases s_c with
      | terminal a =>
        cases t_c with
        | leaf => simp only [DTree.height] at ht_c_ht; omega
      | nonterminal B =>
        obtain ⟨C, u2, w_sub, v2, t_sub, hw_c_eq, ht_sub_ht, hder_sub, hplug_sub⟩ :=
          dtree_descend_height d t_c H hH1 (by rw [ht_c_ht, hch_ht])
        refine ⟨C, u_l ++ u2, w_sub, v2 ++ u_r, t_sub, ?_, ht_sub_ht, ?_, ?_⟩
        · rw [hfl, hw_c_eq]; simp [List.append_assoc]
        · have h1 : g.Produces [Symbol.nonterminal r.input] r.output :=
            ⟨r, hr, by simpa using ContextFreeRule.Rewrites.head (r := r) []⟩
          have h2 := Relation.ReflTransGen.head h1 hder_ch
          have h3 := (hder_sub.append_left (u_l.map Symbol.terminal)).append_right (u_r.map Symbol.terminal)
          simpa [List.map_append, List.append_assoc] using h2.trans h3
        · intro w_sub' t_sub' hlt
          obtain ⟨t_c', htc'_lt⟩ := hplug_sub w_sub' t_sub' hlt
          obtain ⟨ws', f', hfl', hsz'⟩ := hplug_ch (u2 ++ w_sub' ++ v2) t_c' htc'_lt
          have hweq : ws'.flatten = u_l ++ u2 ++ w_sub' ++ (v2 ++ u_r) := by
            rw [hfl']; simp [List.append_assoc]
          refine ⟨dtreeCast hweq (.node r hr f'), ?_⟩
          rw [dtreeCast_size]
          simp only [DTree.size]; omega

private lemma dtree_deep_spine {T : Type u} {g : ContextFreeGrammar T} :
    ∀ (m : ℕ) {A : g.NT} {w : List T} (t : DTree g (Symbol.nonterminal A) w),
      t.height = m + 1 →
      ∃ (nt : ℕ → g.NT),
        nt 0 = A ∧
        (∀ i ≤ m, ∃ r ∈ g.rules, r.input = nt i) ∧
        (∀ i j, i < j → j ≤ m →
          ∃ u v x y z : List T,
            w = u ++ v ++ x ++ y ++ z ∧
            g.Derives [Symbol.nonterminal A] (u.map Symbol.terminal ++ [Symbol.nonterminal (nt i)] ++ z.map Symbol.terminal) ∧
            g.Derives [Symbol.nonterminal (nt i)] (v.map Symbol.terminal ++ [Symbol.nonterminal (nt j)] ++ y.map Symbol.terminal) ∧
            (∃ tx : DTree g (Symbol.nonterminal (nt j)) x, tx.size < t.size) ∧
            (nt i = nt j → ∃ t' : DTree g (Symbol.nonterminal A) (u ++ x ++ z), t'.size < t.size))
  | 0, A, w, t, hht => by
    cases t with
    | node r hr ch =>
      exact ⟨fun _ => r.input, rfl, fun _ _ => ⟨r, hr, rfl⟩, fun i j hij hj0 => by omega⟩
  | m + 1, A, w, t, hht => by
    cases t with
    | node r hr ch =>
      have hch_ht : ch.height = m + 1 := by simp only [DTree.height] at hht; omega
      obtain ⟨s_c, w_c, u_l, u_r, t_c, hfl, ht_c_ht, htc_sz, hder_ch, hplug_ch⟩ :=
        dforest_max_child ch (by omega)
      cases s_c with
      | terminal a =>
        cases t_c with
        | leaf => simp only [DTree.height] at ht_c_ht; omega
      | nonterminal B =>
        obtain ⟨nt', hnt0, hnt_mem, hnt_split⟩ :=
          dtree_deep_spine m t_c (by rw [ht_c_ht, hch_ht])
        let nt : ℕ → g.NT := fun i => match i with | 0 => r.input | i + 1 => nt' i
        have hstep_A_B : g.Derives [Symbol.nonterminal r.input]
            (u_l.map Symbol.terminal ++ [Symbol.nonterminal B] ++ u_r.map Symbol.terminal) :=
          Relation.ReflTransGen.head ⟨r, hr, by simpa using ContextFreeRule.Rewrites.head (r := r) []⟩ hder_ch
        have htc_lt : t_c.size < (DTree.node r hr ch).size := by
          simp only [DTree.size]; omega
        refine ⟨nt, rfl, ?_, ?_⟩
        · intro i hi
          cases i with
          | zero => exact ⟨r, hr, rfl⟩
          | succ i => exact hnt_mem i (by omega)
        · intro i j hij hj
          cases i with
          | zero =>
            cases j with
            | zero => omega
            | succ j' =>
              by_cases hj0 : j' = 0
              · subst hj0
                refine ⟨[], u_l, w_c, u_r, [], ?_, ?_, ?_, ?_, ?_⟩
                · simp [hfl]
                · simpa using Relation.ReflTransGen.refl
                · simpa [nt, hnt0] using hstep_A_B
                · refine ⟨dtreeCastNT hnt0.symm t_c, ?_⟩
                  rw [dtreeCastNT_size]
                  exact htc_lt
                · intro heq
                  have hAB : B = r.input := (by simpa [nt, hnt0] using heq : r.input = B).symm
                  refine ⟨dtreeCast (by simp) (dtreeCastNT hAB t_c), ?_⟩
                  rw [dtreeCast_size, dtreeCastNT_size]
                  exact htc_lt
              · obtain ⟨u1, v1, x1, y1, z1, hwc_eq, hdu1, hdv1, ⟨tx1, htx1_lt⟩, _⟩ :=
                  hnt_split 0 j' (by omega) (by omega)
                have hder_B_j : g.Derives [Symbol.nonterminal B]
                    ((u1 ++ v1).map Symbol.terminal ++ [Symbol.nonterminal (nt' j')] ++ (y1 ++ z1).map Symbol.terminal) := by
                  have h1 := (hdv1.append_left (u1.map Symbol.terminal)).append_right (z1.map Symbol.terminal)
                  simpa [hnt0, List.map_append, List.append_assoc] using hdu1.trans h1
                refine ⟨[], u_l ++ u1 ++ v1, x1, y1 ++ z1 ++ u_r, [], ?_, ?_, ?_, ⟨tx1, by omega⟩, ?_⟩
                · rw [hfl, hwc_eq]; simp [List.append_assoc]
                · simpa using Relation.ReflTransGen.refl
                · have h1 := (hder_B_j.append_left (u_l.map Symbol.terminal)).append_right (u_r.map Symbol.terminal)
                  simpa [nt, List.map_append, List.append_assoc] using hstep_A_B.trans h1
                · intro heq
                  have hAj : nt' j' = r.input := heq.symm
                  refine ⟨dtreeCast (by simp) (dtreeCastNT hAj tx1), ?_⟩
                  rw [dtreeCast_size, dtreeCastNT_size]
                  omega
          | succ i' =>
            cases j with
            | zero => omega
            | succ j' =>
              obtain ⟨u1, v1, x1, y1, z1, hwc_eq, hdu1, hdv1, ⟨tx1, htx1_lt⟩, hshort1⟩ :=
                hnt_split i' j' (by omega) (by omega)
              refine ⟨u_l ++ u1, v1, x1, y1, z1 ++ u_r, ?_, ?_, hdv1, ⟨tx1, by omega⟩, ?_⟩
              · rw [hfl, hwc_eq]; simp [List.append_assoc]
              · have h1 := (hdu1.append_left (u_l.map Symbol.terminal)).append_right (u_r.map Symbol.terminal)
                simpa [nt, List.map_append, List.append_assoc] using hstep_A_B.trans h1
              · intro heq
                obtain ⟨tc', htc'_lt⟩ := hshort1 heq
                obtain ⟨ws', f', hfl', hsz'⟩ := hplug_ch (u1 ++ x1 ++ z1) tc' htc'_lt
                have hweq : ws'.flatten = (u_l ++ u1) ++ x1 ++ (z1 ++ u_r) := by
                  rw [hfl']; simp [List.append_assoc]
                refine ⟨dtreeCast hweq (.node r hr f'), ?_⟩
                rw [dtreeCast_size]
                simp only [DTree.size]; omega

private lemma replicate_flatten_append {T : Type*} (v : List T) :
    ∀ k : ℕ, (List.replicate k v).flatten ++ v = (List.replicate (k + 1) v).flatten
  | 0 => by simp
  | k + 1 => by
    calc (List.replicate (k + 1) v).flatten ++ v
        = (v ++ (List.replicate k v).flatten) ++ v := by simp [List.replicate_succ]
      _ = v ++ ((List.replicate k v).flatten ++ v) := by rw [List.append_assoc]
      _ = v ++ (List.replicate (k + 1) v).flatten := by rw [replicate_flatten_append v k]
      _ = (List.replicate (k + 2) v).flatten := by simp [List.replicate_succ]

private lemma derives_iterate {T : Type*} {g : ContextFreeGrammar T}
    {A : g.NT} {v y : List T}
    (h : g.Derives [Symbol.nonterminal A] (v.map Symbol.terminal ++ [Symbol.nonterminal A] ++ y.map Symbol.terminal)) :
    ∀ k : ℕ, g.Derives [Symbol.nonterminal A]
      (((List.replicate k v).flatten).map Symbol.terminal ++ [Symbol.nonterminal A] ++
        ((List.replicate k y).flatten).map Symbol.terminal)
  | 0 => by simpa using Relation.ReflTransGen.refl
  | k + 1 => by
    have ih := derives_iterate h k
    have h2 := (h.append_left (((List.replicate k v).flatten).map Symbol.terminal)).append_right
      (((List.replicate k y).flatten).map Symbol.terminal)
    have h3 := ih.trans h2
    have hv := congrArg (List.map (Symbol.terminal (N := g.NT))) (replicate_flatten_append v k)
    have hy : (y ++ (List.replicate k y).flatten).map (Symbol.terminal (N := g.NT)) =
        ((List.replicate (k + 1) y).flatten).map Symbol.terminal := by
      simp [List.replicate_succ]
    rw [List.map_append] at hv hy
    rw [← hv, ← hy]
    simpa [List.append_assoc] using h3

end PumpingPrivate

/-- **Bar-Hillel Context-Free Pumping Lemma (with Repeated Nonterminal Witness).**
For every Mathlib `ContextFreeGrammar T`, there exists a pumping length `P ≥ 1` such that every
word `w ∈ g.language` with `P ≤ w.length` decomposes as `w = u ++ v ++ x ++ y ++ z` with a
repeated nonterminal `A : g.NT`, `(v ++ x ++ y).length ≤ P`, `1 ≤ (v ++ y).length`, explicit
derivation witnesses for `g.initial ⇒* u A z`, `A ⇒* v A y`, `A ⇒* x`, and all pumped words
`u ++ v^i ++ x ++ y^i ++ z ∈ g.language`. -/
theorem ppl105_cfl_pumping_lemma {T : Type*} (g : ContextFreeGrammar T) :
    ∃ P : ℕ, 1 ≤ P ∧ ∀ w ∈ g.language, P ≤ w.length →
      ∃ (A : g.NT) (u v x y z : List T),
        w = u ++ v ++ x ++ y ++ z ∧
        (v ++ x ++ y).length ≤ P ∧
        1 ≤ (v ++ y).length ∧
        g.Derives [Symbol.nonterminal g.initial]
          (u.map Symbol.terminal ++ [Symbol.nonterminal A] ++ z.map Symbol.terminal) ∧
        g.Derives [Symbol.nonterminal A]
          (v.map Symbol.terminal ++ [Symbol.nonterminal A] ++ y.map Symbol.terminal) ∧
        g.Derives [Symbol.nonterminal A] (x.map Symbol.terminal) ∧
        ∀ i : ℕ, u ++ (List.replicate i v).flatten ++ x ++ (List.replicate i y).flatten ++ z ∈ g.language := by
  classical
  let K : ℕ := max 2 (g.rules.sup (fun r => r.output.length))
  have hK1 : 1 ≤ K := le_trans (by decide) (le_max_left 2 _)
  have hK : ∀ r ∈ g.rules, r.output.length ≤ K := fun r hr =>
    le_trans (Finset.le_sup (f := fun r : ContextFreeRule T g.NT => r.output.length) hr) (le_max_right 2 _)
  let H : ℕ := g.rules.card + 1
  let P : ℕ := K ^ H + 1
  refine ⟨P, by omega, fun w hw hlen => ?_⟩
  have hex : ∃ sz : ℕ, ∃ t : DTree g (Symbol.nonterminal g.initial) w, t.size = sz := by
    obtain ⟨t⟩ := generates_to_dtree hw
    exact ⟨t.size, t, rfl⟩
  let minSz := Nat.find hex
  obtain ⟨t, ht_sz⟩ := Nat.find_spec hex
  have hmin : ∀ t' : DTree g (Symbol.nonterminal g.initial) w, minSz ≤ t'.size := fun t' =>
    Nat.find_min' hex ⟨t', rfl⟩
  have hht_ge : H ≤ t.height := by
    by_contra hlt
    have hwl := dtree_length_le K hK1 hK t
    have hpow : K ^ t.height ≤ K ^ H := Nat.pow_le_pow_right hK1 (by omega)
    dsimp [P] at hlen
    omega
  obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hht_ge
  obtain ⟨C, u0, w_top, v0, t_top, hw_top_eq, ht_top_ht, hder_top, hplug_top⟩ :=
    dtree_descend_height d t H (by omega) hd
  obtain ⟨nt, _, hnt_mem, hnt_split⟩ := dtree_deep_spine g.rules.card t_top ht_top_ht
  let S : Finset g.NT := g.rules.image ContextFreeRule.input
  have hScard : S.card < (Finset.univ : Finset (Fin (g.rules.card + 1))).card := by
    have h1 : S.card ≤ g.rules.card := Finset.card_image_le
    simp only [Finset.card_univ, Fintype.card_fin]
    omega
  have hmaps : ∀ i ∈ (Finset.univ : Finset (Fin (g.rules.card + 1))), nt i.1 ∈ S := by
    intro i _
    obtain ⟨r, hr, hri⟩ := hnt_mem i.1 (Nat.lt_succ_iff.mp i.2)
    exact Finset.mem_image.mpr ⟨r, hr, hri⟩
  obtain ⟨i₁, _, i₂, _, hne, heq_nt⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hScard hmaps
  have hlt_or : i₁.1 < i₂.1 ∨ i₂.1 < i₁.1 :=
    lt_or_gt_of_ne (fun h => hne (Fin.ext h))
  obtain ⟨I, J, hIJ_lt, hJ_le, hntIJ⟩ : ∃ I J : ℕ, I < J ∧ J ≤ g.rules.card ∧ nt I = nt J := by
    rcases hlt_or with h | h
    · exact ⟨i₁.1, i₂.1, h, Nat.lt_succ_iff.mp i₂.2, heq_nt⟩
    · exact ⟨i₂.1, i₁.1, h, Nat.lt_succ_iff.mp i₁.2, heq_nt.symm⟩
  obtain ⟨u1, v, x, y, z1, hwt_eq, hdu1, hdv, ⟨t_j, _⟩, hshort⟩ :=
    hnt_split I J hIJ_lt hJ_le
  have hvxy_le : (v ++ x ++ y).length ≤ P := by
    have h1 : w_top.length ≤ K ^ H := by
      have := dtree_length_le K hK1 hK t_top
      rwa [ht_top_ht] at this
    have h2 : (v ++ x ++ y).length ≤ w_top.length := by
      rw [hwt_eq]; simp; omega
    dsimp [P]; omega
  have hvy_pos : 1 ≤ (v ++ y).length := by
    by_contra h0
    simp only [List.length_append] at h0
    have hv0 : v = [] := List.eq_nil_of_length_eq_zero (by omega)
    have hy0 : y = [] := List.eq_nil_of_length_eq_zero (by omega)
    obtain ⟨t_top_short, ht_short_lt⟩ := hshort hntIJ
    obtain ⟨t_new, ht_new_lt⟩ := hplug_top (u1 ++ x ++ z1) t_top_short ht_short_lt
    have heq_w : u0 ++ (u1 ++ x ++ z1) ++ v0 = w := by
      rw [hw_top_eq, hwt_eq, hv0, hy0]; simp [List.append_assoc]
    have ht_min := hmin (dtreeCast heq_w t_new)
    rw [dtreeCast_size] at ht_min
    omega
  rw [← hntIJ] at hdv t_j
  have h_u : g.Derives [Symbol.nonterminal g.initial]
      ((u0 ++ u1).map Symbol.terminal ++ [Symbol.nonterminal (nt I)] ++ (z1 ++ v0).map Symbol.terminal) := by
    have h2 := (hdu1.append_left (u0.map Symbol.terminal)).append_right (v0.map Symbol.terminal)
    simpa [List.map_append, List.append_assoc] using hder_top.trans h2
  have h_x : g.Derives [Symbol.nonterminal (nt I)] (x.map Symbol.terminal) := dtree_to_derives t_j
  refine ⟨nt I, u0 ++ u1, v, x, y, z1 ++ v0, ?_, hvxy_le, hvy_pos, h_u, hdv, h_x, fun k => ?_⟩
  · rw [hw_top_eq, hwt_eq]; simp [List.append_assoc]
  · show g.Generates (((u0 ++ u1) ++ (List.replicate k v).flatten ++ x ++
      (List.replicate k y).flatten ++ (z1 ++ v0)).map Symbol.terminal)
    unfold ContextFreeGrammar.Generates
    have h_v := derives_iterate hdv k
    have h_vx := h_v.trans ((h_x.append_left (((List.replicate k v).flatten).map Symbol.terminal)).append_right
      (((List.replicate k y).flatten).map Symbol.terminal))
    have h_all := h_u.trans ((h_vx.append_left ((u0 ++ u1).map Symbol.terminal)).append_right
      ((z1 ++ v0).map Symbol.terminal))
    simpa [List.map_append, List.append_assoc] using h_all

/-- **Non-Context-Freeness of `{a^n b^n c^n | n ≥ 1}`:** No Mathlib `ContextFreeGrammar (Fin 3)`
generates `L_{abc} = {0^n ++ 1^n ++ 2^n | n ≥ 1}`. -/
theorem ppl105_anbncn_not_cfl :
    ¬ ∃ g : ContextFreeGrammar (Fin 3),
      g.language = ({w : List (Fin 3) | ∃ n : ℕ, 1 ≤ n ∧
        w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) := by
  rintro ⟨g, hg⟩
  obtain ⟨P, hP1, hpump⟩ := ppl105_cfl_pumping_lemma g
  let w : List (Fin 3) := List.replicate P 0 ++ List.replicate P 1 ++ List.replicate P 2
  have hw_mem : w ∈ g.language := by
    rw [hg]
    exact ⟨P, hP1, rfl⟩
  have hw_len : P ≤ w.length := by simp [w]
  obtain ⟨_, u, v, x, y, z, hw_eq, hvxy_le, hvy_pos, _, _, _, hiter⟩ := hpump w hw_mem hw_len
  have h1 : w = u ++ (v ++ x ++ y) ++ z := by simpa [List.append_assoc] using hw_eq
  have hlen_split : w.length = u.length + (v ++ x ++ y).length + z.length := by
    rw [h1]; simp [List.length_append]; omega
  have hno02 : (0 : Fin 3) ∉ v ++ x ++ y ∨ (2 : Fin 3) ∉ v ++ x ++ y := by
    by_contra hboth
    push Not at hboth
    rcases hboth with ⟨h0, h2⟩
    obtain ⟨i0, hi0, hget0⟩ := List.mem_iff_getElem.mp h0
    obtain ⟨i2, hi2, hget2⟩ := List.mem_iff_getElem.mp h2
    have hlt0_w : u.length + i0 < w.length := by omega
    have hlt2_w : u.length + i2 < w.length := by omega
    have hidx0 : w[u.length + i0]'hlt0_w = 0 := by
      have hsub : (u ++ (v ++ x ++ y) ++ z)[u.length + i0]'(by rw [← h1]; exact hlt0_w) = 0 := by
        rw [List.getElem_append_left (by rw [List.length_append]; omega),
            List.getElem_append_right (by omega)]
        simpa using hget0
      simpa [h1] using hsub
    have hidx2 : w[u.length + i2]'hlt2_w = 2 := by
      have hsub : (u ++ (v ++ x ++ y) ++ z)[u.length + i2]'(by rw [← h1]; exact hlt2_w) = 2 := by
        rw [List.getElem_append_left (by rw [List.length_append]; omega),
            List.getElem_append_right (by omega)]
        simpa using hget2
      simpa [h1] using hsub
    have hltP : u.length + i0 < P := by
      by_contra hge
      push Not at hge
      have h_eq : w[u.length + i0]'hlt0_w = 1 ∨ w[u.length + i0]'hlt0_w = 2 := by
        dsimp [w]
        by_cases hlt2 : u.length + i0 < P + P
        · left
          rw [List.getElem_append_left (by simp; omega), List.getElem_append_right (by simp; omega)]
          simp
        · right
          rw [List.getElem_append_right (by simp; omega)]
          simp
      rcases h_eq with h | h <;> rw [hidx0] at h <;> exact absurd h (by decide)
    have hge2P : 2 * P ≤ u.length + i2 := by
      by_contra hlt
      push Not at hlt
      have h_eq : w[u.length + i2]'hlt2_w = 0 ∨ w[u.length + i2]'hlt2_w = 1 := by
        dsimp [w]
        rw [List.getElem_append_left (by simp; omega)]
        by_cases hlt1 : u.length + i2 < P
        · left
          rw [List.getElem_append_left (by simp; omega)]
          simp
        · right
          rw [List.getElem_append_right (by simp; omega)]
          simp
      rcases h_eq with h | h <;> rw [hidx2] at h <;> exact absurd h (by decide)
    omega
  have hw2 : u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z ∈ g.language :=
    hiter 2
  rw [hg] at hw2
  rcases hw2 with ⟨n, _, hwn⟩
  have hcount : ∀ c : Fin 3,
      (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z).count c =
        w.count c + (v ++ y).count c := by
    intro c
    rw [hw_eq]
    simp [List.count_append, List.replicate_succ]
    omega
  have hc0 : (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z).count 0 = n := by
    rw [hwn]; simp [List.count_append, List.count_replicate]
  have hc1 : (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z).count 1 = n := by
    rw [hwn]; simp [List.count_append, List.count_replicate]
  have hc2 : (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z).count 2 = n := by
    rw [hwn]; simp [List.count_append, List.count_replicate]
  have hw0 : w.count 0 = P := by simp [w, List.count_append, List.count_replicate]
  have hw1 : w.count 1 = P := by simp [w, List.count_append, List.count_replicate]
  have hw2c : w.count 2 = P := by simp [w, List.count_append, List.count_replicate]
  have heq01 : (v ++ y).count 0 = (v ++ y).count 1 := by
    have h0 := hcount 0; have h1 := hcount 1; omega
  have heq12 : (v ++ y).count 1 = (v ++ y).count 2 := by
    have h1 := hcount 1; have h2 := hcount 2; omega
  have hzero : (v ++ y).count 0 = 0 ∧ (v ++ y).count 1 = 0 ∧ (v ++ y).count 2 = 0 := by
    rcases hno02 with h0 | h2
    · have hc0z : (v ++ y).count 0 = 0 := List.count_eq_zero.mpr fun hm => by
        simp only [List.mem_append] at hm
        rcases hm with h | h <;> exact h0 (by simp [h])
      omega
    · have hc2z : (v ++ y).count 2 = 0 := List.count_eq_zero.mpr fun hm => by
        simp only [List.mem_append] at hm
        rcases hm with h | h <;> exact h2 (by simp [h])
      omega
  have hlen_sum : ∀ l : List (Fin 3), l.length = l.count 0 + l.count 1 + l.count 2 := by
    intro l
    induction l with
    | nil => simp
    | cons a tl ihl =>
      fin_cases a <;> simp [ihl] <;> omega
  have := hlen_sum (v ++ y)
  omega

section AnBnCnPrivate

private lemma anbncn_inter_eq :
    ({w : List (Fin 3) | ∃ m k, 1 ≤ m ∧ 1 ≤ k ∧
        w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2} : Language (Fin 3)) ⊓
    ({w : List (Fin 3) | ∃ k n, 1 ≤ k ∧ 1 ≤ n ∧
        w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) =
    ({w : List (Fin 3) | ∃ n, 1 ≤ n ∧
        w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) := by
  ext w
  change (∃ m k, 1 ≤ m ∧ 1 ≤ k ∧
      w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2) ∧
    (∃ k n, 1 ≤ k ∧ 1 ≤ n ∧
      w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2) ↔
    (∃ n, 1 ≤ n ∧ w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2)
  constructor
  · rintro ⟨⟨m, k₁, hm, hk₁, rfl⟩, ⟨k₂, n, _, _, h2⟩⟩
    have hc0 := congrArg (List.count (0 : Fin 3)) h2
    have hc1 := congrArg (List.count (1 : Fin 3)) h2
    have hc2 := congrArg (List.count (2 : Fin 3)) h2
    simp [List.count_append, List.count_replicate] at hc0 hc1 hc2
    exact ⟨m, hm, by rw [hc2, ← hc1]⟩
  · rintro ⟨n, hn, rfl⟩
    exact ⟨⟨n, n, hn, hn, rfl⟩, ⟨n, n, hn, hn, rfl⟩⟩

private def anbncnBNF :
    Fin 10 → List (List (List (Fin 3 ⊕ Fin 10)) × List (List (Fin 3 ⊕ Fin 10)))
  | ⟨0, _⟩ => [([[Sum.inl 0]], [])]
  | ⟨1, _⟩ => [([[Sum.inl 1]], [])]
  | ⟨2, _⟩ => [([[Sum.inl 2]], [])]
  | ⟨3, _⟩ => [([[Sum.inr 0, Sum.inr 1]], []), ([[Sum.inr 0, Sum.inr 4]], [])]
  | ⟨4, _⟩ => [([[Sum.inr 3, Sum.inr 1]], [])]
  | ⟨5, _⟩ => [([[Sum.inl 2]], []), ([[Sum.inr 2, Sum.inr 5]], [])]
  | ⟨6, _⟩ => [([[Sum.inl 0]], []), ([[Sum.inr 0, Sum.inr 6]], [])]
  | ⟨7, _⟩ => [([[Sum.inr 1, Sum.inr 2]], []), ([[Sum.inr 1, Sum.inr 8]], [])]
  | ⟨8, _⟩ => [([[Sum.inr 7, Sum.inr 2]], [])]
  | ⟨9, _⟩ => [([[Sum.inr 3, Sum.inr 5], [Sum.inr 6, Sum.inr 7]], [])]

private def anbncnSol : Fin 10 → Language (Fin 3)
  | ⟨0, _⟩ => {[0]}
  | ⟨1, _⟩ => {[1]}
  | ⟨2, _⟩ => {[2]}
  | ⟨3, _⟩ => {w | ∃ m, 1 ≤ m ∧ w = List.replicate m 0 ++ List.replicate m 1}
  | ⟨4, _⟩ => {w | ∃ m, 1 ≤ m ∧ w = List.replicate m 0 ++ List.replicate (m + 1) 1}
  | ⟨5, _⟩ => {w | ∃ k, 1 ≤ k ∧ w = List.replicate k 2}
  | ⟨6, _⟩ => {w | ∃ k, 1 ≤ k ∧ w = List.replicate k 0}
  | ⟨7, _⟩ => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n 1 ++ List.replicate n 2}
  | ⟨8, _⟩ => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n 1 ++ List.replicate (n + 1) 2}
  | ⟨9, _⟩ => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2}

private lemma mem_evalSF_pair {α : Type*} {k : ℕ} (X : Fin k → Language α) (B C : Fin k)
    (w : List α) :
    w ∈ evalSF X [Sum.inr B, Sum.inr C] ↔ ∃ u ∈ X B, ∃ v ∈ X C, u ++ v = w := by
  simp [evalSF, Language.mem_mul]

private lemma anbncnSol_valid :
    ∀ i : Fin 10, ∀ w : List (Fin 3), w ∈ anbncnSol i ↔
      w ≠ [] ∧ boolCond anbncnBNF anbncnSol i w := by
  intro i w
  fin_cases i
  · change w = [0] ↔ _
    simp [boolCond, anbncnBNF, mem_evalSF_singleton_inl]
    rintro rfl; simp
  · change w = [1] ↔ _
    simp [boolCond, anbncnBNF, mem_evalSF_singleton_inl]
    rintro rfl; simp
  · change w = [2] ↔ _
    simp [boolCond, anbncnBNF, mem_evalSF_singleton_inl]
    rintro rfl; simp
  · change (∃ m, 1 ≤ m ∧ w = List.replicate m 0 ++ List.replicate m 1) ↔ _
    simp only [boolCond, anbncnBNF, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
      exists_eq_left, forall_eq, false_implies, forall_const, and_true, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧ ((∃ u, u = [0] ∧ ∃ v, v = [1] ∧ u ++ v = w) ∨
      (∃ u, u = [0] ∧ ∃ v, (∃ m, 1 ≤ m ∧ v = List.replicate m 0 ++ List.replicate (m + 1) 1) ∧ u ++ v = w))
    constructor
    · rintro ⟨m, hm, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
      cases m with
      | zero => omega
      | succ m' =>
        cases m' with
        | zero => left; exact ⟨[0], rfl, [1], rfl, rfl⟩
        | succ m'' =>
          right
          refine ⟨[0], rfl, List.replicate (m'' + 1) 0 ++ List.replicate (m'' + 2) 1,
            ⟨m'' + 1, by omega, rfl⟩, ?_⟩
          simp [List.replicate_succ]
    · rintro ⟨_, ⟨_, rfl, _, rfl, rfl⟩ | ⟨_, rfl, _, ⟨m, hm, rfl⟩, rfl⟩⟩
      · exact ⟨1, le_rfl, rfl⟩
      · exact ⟨m + 1, by omega, by simp [List.replicate_succ]⟩
  · change (∃ m, 1 ≤ m ∧ w = List.replicate m 0 ++ List.replicate (m + 1) 1) ↔ _
    simp only [boolCond, anbncnBNF, List.mem_singleton, exists_eq_left, List.not_mem_nil,
      forall_eq, false_implies, forall_const, and_true, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧ ∃ u, (∃ m, 1 ≤ m ∧ u = List.replicate m 0 ++ List.replicate m 1) ∧
      ∃ v, v = [1] ∧ u ++ v = w
    constructor
    · rintro ⟨m, hm, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this,
        List.replicate m 0 ++ List.replicate m 1, ⟨m, hm, rfl⟩, [1], rfl, ?_⟩
      rw [List.append_assoc, List.replicate_succ']
    · rintro ⟨_, _, ⟨m, hm, rfl⟩, _, rfl, rfl⟩
      exact ⟨m, hm, by rw [List.append_assoc, List.replicate_succ']⟩
  · change (∃ k, 1 ≤ k ∧ w = List.replicate k 2) ↔ _
    simp only [boolCond, anbncnBNF, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
      exists_eq_left, forall_eq, false_implies, forall_const, and_true,
      mem_evalSF_singleton_inl, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧ (w = [2] ∨ ∃ u, u = [2] ∧ ∃ v, (∃ k, 1 ≤ k ∧ v = List.replicate k 2) ∧ u ++ v = w)
    constructor
    · rintro ⟨k, hk, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
      cases k with
      | zero => omega
      | succ k' =>
        cases k' with
        | zero => left; rfl
        | succ k'' =>
          right
          exact ⟨[2], rfl, List.replicate (k'' + 1) 2, ⟨k'' + 1, by omega, rfl⟩, by simp [List.replicate_succ]⟩
    · rintro ⟨_, rfl | ⟨_, rfl, _, ⟨k, hk, rfl⟩, rfl⟩⟩
      · exact ⟨1, le_rfl, rfl⟩
      · exact ⟨k + 1, by omega, by simp [List.replicate_succ]⟩
  · change (∃ k, 1 ≤ k ∧ w = List.replicate k 0) ↔ _
    simp only [boolCond, anbncnBNF, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
      exists_eq_left, forall_eq, false_implies, forall_const, and_true,
      mem_evalSF_singleton_inl, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧ (w = [0] ∨ ∃ u, u = [0] ∧ ∃ v, (∃ k, 1 ≤ k ∧ v = List.replicate k 0) ∧ u ++ v = w)
    constructor
    · rintro ⟨k, hk, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
      cases k with
      | zero => omega
      | succ k' =>
        cases k' with
        | zero => left; rfl
        | succ k'' =>
          right
          exact ⟨[0], rfl, List.replicate (k'' + 1) 0, ⟨k'' + 1, by omega, rfl⟩, by simp [List.replicate_succ]⟩
    · rintro ⟨_, rfl | ⟨_, rfl, _, ⟨k, hk, rfl⟩, rfl⟩⟩
      · exact ⟨1, le_rfl, rfl⟩
      · exact ⟨k + 1, by omega, by simp [List.replicate_succ]⟩
  · change (∃ n, 1 ≤ n ∧ w = List.replicate n 1 ++ List.replicate n 2) ↔ _
    simp only [boolCond, anbncnBNF, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
      exists_eq_left, forall_eq, false_implies, forall_const, and_true, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧ ((∃ u, u = [1] ∧ ∃ v, v = [2] ∧ u ++ v = w) ∨
      (∃ u, u = [1] ∧ ∃ v, (∃ n, 1 ≤ n ∧ v = List.replicate n 1 ++ List.replicate (n + 1) 2) ∧ u ++ v = w))
    constructor
    · rintro ⟨n, hn, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
      cases n with
      | zero => omega
      | succ n' =>
        cases n' with
        | zero => left; exact ⟨[1], rfl, [2], rfl, rfl⟩
        | succ n'' =>
          right
          refine ⟨[1], rfl, List.replicate (n'' + 1) 1 ++ List.replicate (n'' + 2) 2,
            ⟨n'' + 1, by omega, rfl⟩, ?_⟩
          simp [List.replicate_succ]
    · rintro ⟨_, ⟨_, rfl, _, rfl, rfl⟩ | ⟨_, rfl, _, ⟨n, hn, rfl⟩, rfl⟩⟩
      · exact ⟨1, le_rfl, rfl⟩
      · exact ⟨n + 1, by omega, by simp [List.replicate_succ]⟩
  · change (∃ n, 1 ≤ n ∧ w = List.replicate n 1 ++ List.replicate (n + 1) 2) ↔ _
    simp only [boolCond, anbncnBNF, List.mem_singleton, exists_eq_left, List.not_mem_nil,
      forall_eq, false_implies, forall_const, and_true, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧ ∃ u, (∃ n, 1 ≤ n ∧ u = List.replicate n 1 ++ List.replicate n 2) ∧
      ∃ v, v = [2] ∧ u ++ v = w
    constructor
    · rintro ⟨n, hn, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this,
        List.replicate n 1 ++ List.replicate n 2, ⟨n, hn, rfl⟩, [2], rfl, ?_⟩
      rw [List.append_assoc, List.replicate_succ']
    · rintro ⟨_, _, ⟨n, hn, rfl⟩, _, rfl, rfl⟩
      exact ⟨n, hn, by rw [List.append_assoc, List.replicate_succ']⟩
  · change (∃ n, 1 ≤ n ∧ w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2) ↔ _
    simp only [boolCond, anbncnBNF, exists_eq_left, List.mem_cons,
      List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq, false_implies, forall_const,
      and_true, mem_evalSF_pair]
    change _ ↔ w ≠ [] ∧
      (∃ u, (∃ m, 1 ≤ m ∧ u = List.replicate m 0 ++ List.replicate m 1) ∧
        ∃ v, (∃ k, 1 ≤ k ∧ v = List.replicate k 2) ∧ u ++ v = w) ∧
      (∃ u, (∃ k, 1 ≤ k ∧ u = List.replicate k 0) ∧
        ∃ v, (∃ n, 1 ≤ n ∧ v = List.replicate n 1 ++ List.replicate n 2) ∧ u ++ v = w)
    have hint : ((∃ m k, 1 ≤ m ∧ 1 ≤ k ∧ w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2) ∧
        (∃ k n, 1 ≤ k ∧ 1 ≤ n ∧ w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2)) ↔
        (∃ n, 1 ≤ n ∧ w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2) := by
      have h := congrFun (congrArg Membership.mem anbncn_inter_eq) w
      exact iff_of_eq h
    constructor
    · rintro ⟨n, hn, rfl⟩
      refine ⟨by intro h; have := congrArg List.length h; simp at this; omega,
        ⟨List.replicate n 0 ++ List.replicate n 1, ⟨n, hn, rfl⟩, List.replicate n 2, ⟨n, hn, rfl⟩, rfl⟩,
        ⟨List.replicate n 0, ⟨n, hn, rfl⟩, List.replicate n 1 ++ List.replicate n 2, ⟨n, hn, rfl⟩,
          by simp [List.append_assoc]⟩⟩
    · rintro ⟨_, ⟨_, ⟨m, hm, rfl⟩, _, ⟨k₁, hk₁, rfl⟩, rfl⟩,
        ⟨_, ⟨k₂, hk₂, rfl⟩, _, ⟨n, hn, rfl⟩, h2⟩⟩
      exact hint.mp ⟨⟨m, k₁, hm, hk₁, rfl⟩, ⟨k₂, n, hk₂, hn, by simpa [List.append_assoc] using h2.symm⟩⟩

end AnBnCnPrivate

/-- **Explicit 10-Nonterminal Okhotin BNF Conjunctive Grammar for `{a^n b^n c^n | n ≥ 1}`.** -/
theorem ppl105_anbncn_bnf_conjunctive :
    ∃ (k : ℕ) (G : Fin k → List (List (List (Fin 3 ⊕ Fin k)) × List (List (Fin 3 ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language (Fin 3)),
      (∀ i, ∀ r ∈ G i, r.2 = []) ∧
      (∀ i, ∀ r ∈ G i, (∃ a : Fin 3, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) ∧
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod)) ∧
      X s = ({w : List (Fin 3) | ∃ n : ℕ, 1 ≤ n ∧
        w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) := by
  refine ⟨10, anbncnBNF, 9, anbncnSol, ?_, ?_, anbncnSol_valid, rfl⟩
  · intro i r hr
    fin_cases i <;> simp [anbncnBNF] at hr <;> rcases hr with rfl | rfl <;> rfl
  · intro i r hr
    fin_cases i <;> simp [anbncnBNF] at hr
    · subst hr; exact Or.inl ⟨0, rfl⟩
    · subst hr; exact Or.inl ⟨1, rfl⟩
    · subst hr; exact Or.inl ⟨2, rfl⟩
    · rcases hr with rfl | rfl
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨0, 1, rfl⟩⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨0, 4, rfl⟩⟩
    · subst hr; exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨3, 1, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inl ⟨2, rfl⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨2, 5, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inl ⟨0, rfl⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨0, 6, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨1, 2, rfl⟩⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨1, 8, rfl⟩⟩
    · subst hr; exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨7, 2, rfl⟩⟩
    · subst hr
      refine Or.inr ⟨by simp, fun γ hγ => ?_⟩
      simp at hγ
      rcases hγ with rfl | rfl
      · exact ⟨3, 5, rfl⟩
      · exact ⟨6, 7, rfl⟩

/-- **Strict Expressive Separation (`CFL ⊊ Conjunctive ⊆ Boolean`):**
Every `ContextFreeGrammar` embeds into Conjunctive grammars (`ppl105_cfg_embeds_in_conjunctive`),
and there exists a language over `Fin 3` generated by a BNF conjunctive grammar that is generated
by NO `ContextFreeGrammar (Fin 3)`. -/
theorem ppl105_strict_separation_cfl_conjunctive :
    ∃ L : Language (Fin 3),
      (∃ (k : ℕ) (G : Fin k → List (List (List (Fin 3 ⊕ Fin k)) × List (List (Fin 3 ⊕ Fin k))))
        (s : Fin k) (X : Fin k → Language (Fin 3)),
        (∀ i, ∀ r ∈ G i, r.2 = []) ∧
        (∀ i, ∀ r ∈ G i, (∃ a : Fin 3, r = ([[Sum.inl a]], [])) ∨
          (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) ∧
        (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod)) ∧
        X s = L) ∧
      (¬ ∃ g : ContextFreeGrammar (Fin 3), g.language = L) :=
  ⟨({w : List (Fin 3) | ∃ n : ℕ, 1 ≤ n ∧
    w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)),
    ppl105_anbncn_bnf_conjunctive, ppl105_anbncn_not_cfl⟩

section CFGNonClosurePrivate

private def evalCFGSym {α N : Type*} (X : N → Language α) : Symbol α N → Language α
  | Symbol.terminal a => ({[a]} : Language α)
  | Symbol.nonterminal A => X A

private def evalCFG {α N : Type*} (X : N → Language α) (ss : List (Symbol α N)) : Language α :=
  (ss.map (evalCFGSym X)).prod

private lemma cfg_derives_sound_of_closed {α : Type*} (g : ContextFreeGrammar α)
    (X : g.NT → Language α)
    (hclosed : ∀ r ∈ g.rules, evalCFG X r.output ≤ X r.input) :
    ∀ {ss : List (Symbol α g.NT)} {w : List α},
      g.Derives ss (w.map Symbol.terminal) → w ∈ evalCFG X ss := by
  intro ss w h
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl =>
    induction w with
    | nil => simp [evalCFG]
    | cons a tl ih =>
      simp only [List.map_cons, evalCFG, evalCFGSym, List.prod_cons, Language.mem_mul]
      exact ⟨[a], (mem_singleton_lang a [a]).mpr rfl, tl, ih, rfl⟩
  | @head ss₁ ss₂ hprod _ ih =>
    rcases hprod with ⟨r, hr, hrew⟩
    rcases ContextFreeRule.rewrites_iff.mp hrew with ⟨p, q, rfl, rfl⟩
    simp only [evalCFG, List.map_append, List.prod_append, Language.mem_mul] at ih ⊢
    rcases ih with ⟨u₁, ⟨u_p, hu_p, u_o, hu_o, rfl⟩, u_q, hu_q, rfl⟩
    refine ⟨u_p ++ u_o, ⟨u_p, hu_p, u_o, ?_, rfl⟩, u_q, hu_q, rfl⟩
    simp only [List.map_singleton, List.prod_singleton, evalCFGSym]
    exact hclosed r hr hu_o

private def liftSymL {α N₁ N₂ : Type*} : Symbol α N₁ → Symbol α (Option (N₁ ⊕ N₂))
  | Symbol.terminal a => Symbol.terminal a
  | Symbol.nonterminal A => Symbol.nonterminal (some (Sum.inl A))

private def liftSymR {α N₁ N₂ : Type*} : Symbol α N₂ → Symbol α (Option (N₁ ⊕ N₂))
  | Symbol.terminal a => Symbol.terminal a
  | Symbol.nonterminal B => Symbol.nonterminal (some (Sum.inr B))

private abbrev cfgAmbLeft : ContextFreeGrammar (Fin 3) :=
  { NT := Fin 3
    initial := 0
    rules := {
      ⟨0, [Symbol.nonterminal 1, Symbol.nonterminal 2]⟩,
      ⟨1, [Symbol.terminal 0, Symbol.terminal 1]⟩,
      ⟨1, [Symbol.terminal 0, Symbol.nonterminal 1, Symbol.terminal 1]⟩,
      ⟨2, [Symbol.terminal 2]⟩,
      ⟨2, [Symbol.terminal 2, Symbol.nonterminal 2]⟩ } }

private abbrev cfgAmbRight : ContextFreeGrammar (Fin 3) :=
  { NT := Fin 3
    initial := 0
    rules := {
      ⟨0, [Symbol.nonterminal 1, Symbol.nonterminal 2]⟩,
      ⟨1, [Symbol.terminal 0]⟩,
      ⟨1, [Symbol.terminal 0, Symbol.nonterminal 1]⟩,
      ⟨2, [Symbol.terminal 1, Symbol.terminal 2]⟩,
      ⟨2, [Symbol.terminal 1, Symbol.nonterminal 2, Symbol.terminal 2]⟩ } }

private lemma cfgAmbLeft_lang :
    cfgAmbLeft.language = ({w : List (Fin 3) | ∃ m k, 1 ≤ m ∧ 1 ≤ k ∧
      w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2} : Language (Fin 3)) := by
  let X : Fin 3 → Language (Fin 3) := fun i => match i with
    | ⟨0, _⟩ => {w | ∃ m k, 1 ≤ m ∧ 1 ≤ k ∧ w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2}
    | ⟨1, _⟩ => {w | ∃ m, 1 ≤ m ∧ w = List.replicate m 0 ++ List.replicate m 1}
    | ⟨2, _⟩ => {w | ∃ k, 1 ≤ k ∧ w = List.replicate k 2}
  have hclosed : ∀ r ∈ cfgAmbLeft.rules, evalCFG X r.output ≤ X r.input := by
    intro r hr w hw
    have hr' : r = ⟨0, [Symbol.nonterminal 1, Symbol.nonterminal 2]⟩ ∨
        r = ⟨1, [Symbol.terminal 0, Symbol.terminal 1]⟩ ∨
        r = ⟨1, [Symbol.terminal 0, Symbol.nonterminal 1, Symbol.terminal 1]⟩ ∨
        r = ⟨2, [Symbol.terminal 2]⟩ ∨
        r = ⟨2, [Symbol.terminal 2, Symbol.nonterminal 2]⟩ := by
      simpa [cfgAmbLeft] using hr
    rcases hr' with rfl | rfl | rfl | rfl | rfl
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, ⟨m, hm, rfl⟩, v, ⟨k, hk, rfl⟩, rfl⟩
      exact ⟨m, k, hm, hk, rfl⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, hu, v, hv, rfl⟩
      have hu' : u = [0] := (mem_singleton_lang 0 u).mp hu
      have hv' : v = [1] := (mem_singleton_lang 1 v).mp hv
      subst hu'; subst hv'
      exact ⟨1, le_rfl, rfl⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, hu, v, hv, rfl⟩
      rcases Language.mem_mul.mp hv with ⟨v1, ⟨m, hm, rfl⟩, v2, hv2, rfl⟩
      have hu' : u = [0] := (mem_singleton_lang 0 u).mp hu
      have hv2' : v2 = [1] := (mem_singleton_lang 1 v2).mp hv2
      subst hu'; subst hv2'
      refine ⟨m + 1, by omega, ?_⟩
      rw [List.replicate_succ, List.replicate_succ']
      simp [List.append_assoc]
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      have hw' : w = [2] := (mem_singleton_lang 2 w).mp hw
      subst hw'
      exact ⟨1, le_rfl, rfl⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, hu, v, ⟨k, hk, rfl⟩, rfl⟩
      have hu' : u = [2] := (mem_singleton_lang 2 u).mp hu
      subst hu'
      exact ⟨k + 1, by omega, by simp [List.replicate_succ]⟩
  have h1 : ∀ m, 1 ≤ m → cfgAmbLeft.Derives [Symbol.nonterminal 1]
      ((List.replicate m (0 : Fin 3) ++ List.replicate m (1 : Fin 3)).map Symbol.terminal) := by
    intro m hm
    induction m with
    | zero => omega
    | succ m ih =>
      cases m with
      | zero =>
        exact Relation.ReflTransGen.single ⟨⟨1, [Symbol.terminal 0, Symbol.terminal 1]⟩,
          by simp [cfgAmbLeft], by simpa using ContextFreeRule.Rewrites.head []⟩
      | succ m' =>
        have hstep : cfgAmbLeft.Produces [Symbol.nonterminal 1]
            [Symbol.terminal 0, Symbol.nonterminal 1, Symbol.terminal 1] :=
          ⟨⟨1, [Symbol.terminal 0, Symbol.nonterminal 1, Symbol.terminal 1]⟩,
            by simp [cfgAmbLeft], by simpa using ContextFreeRule.Rewrites.head []⟩
        have hd := ((ih (by omega)).append_left [Symbol.terminal 0]).append_right [Symbol.terminal 1]
        have hrel := Relation.ReflTransGen.head hstep hd
        have heq : ([Symbol.terminal (N := Fin 3) (0 : Fin 3)] ++
            (List.replicate (m' + 1) (0 : Fin 3) ++ List.replicate (m' + 1) (1 : Fin 3)).map Symbol.terminal ++
            [Symbol.terminal (N := Fin 3) (1 : Fin 3)]) =
            (List.replicate (m' + 2) (0 : Fin 3) ++ List.replicate (m' + 2) (1 : Fin 3)).map Symbol.terminal := by
          rw [List.replicate_succ (n := m' + 1) (a := (0 : Fin 3)),
              List.replicate_succ' (n := m' + 1) (a := (1 : Fin 3))]
          simp [List.map_append, List.append_assoc]
        rw [heq] at hrel
        exact hrel
  have h2 : ∀ k, 1 ≤ k → cfgAmbLeft.Derives [Symbol.nonterminal 2]
      ((List.replicate k (2 : Fin 3)).map Symbol.terminal) := by
    intro k hk
    induction k with
    | zero => omega
    | succ k ih =>
      cases k with
      | zero =>
        exact Relation.ReflTransGen.single ⟨⟨2, [Symbol.terminal 2]⟩,
          by simp [cfgAmbLeft], by simpa using ContextFreeRule.Rewrites.head []⟩
      | succ k' =>
        have hstep : cfgAmbLeft.Produces [Symbol.nonterminal 2]
            [Symbol.terminal 2, Symbol.nonterminal 2] :=
          ⟨⟨2, [Symbol.terminal 2, Symbol.nonterminal 2]⟩,
            by simp [cfgAmbLeft], by simpa using ContextFreeRule.Rewrites.head []⟩
        have hd := (ih (by omega)).append_left [Symbol.terminal 2]
        simpa [List.replicate_succ] using Relation.ReflTransGen.head hstep hd
  ext w
  constructor
  · intro hw
    have hs := cfg_derives_sound_of_closed cfgAmbLeft X hclosed
      (show cfgAmbLeft.Derives [Symbol.nonterminal 0] (w.map Symbol.terminal) from hw)
    simp only [evalCFG, List.map_singleton, List.prod_cons, List.prod_nil, mul_one, evalCFGSym] at hs
    exact hs
  · rintro ⟨m, k, hm, hk, rfl⟩
    show cfgAmbLeft.Generates ((List.replicate m (0 : Fin 3) ++ List.replicate m (1 : Fin 3) ++
      List.replicate k (2 : Fin 3)).map Symbol.terminal)
    unfold ContextFreeGrammar.Generates
    have hstep0 : cfgAmbLeft.Produces [Symbol.nonterminal 0]
        [Symbol.nonterminal 1, Symbol.nonterminal 2] :=
      ⟨⟨0, [Symbol.nonterminal 1, Symbol.nonterminal 2]⟩,
        by simp [cfgAmbLeft], by simpa using ContextFreeRule.Rewrites.head []⟩
    have hd1 := (h1 m hm).append_right [Symbol.nonterminal 2]
    have hd2 := (h2 k hk).append_left ((List.replicate m (0 : Fin 3) ++ List.replicate m (1 : Fin 3)).map Symbol.terminal)
    simpa [List.map_append] using Relation.ReflTransGen.head hstep0 (hd1.trans hd2)

private lemma cfgAmbRight_lang :
    cfgAmbRight.language = ({w : List (Fin 3) | ∃ k n, 1 ≤ k ∧ 1 ≤ n ∧
      w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) := by
  let X : Fin 3 → Language (Fin 3) := fun i => match i with
    | ⟨0, _⟩ => {w | ∃ k n, 1 ≤ k ∧ 1 ≤ n ∧ w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2}
    | ⟨1, _⟩ => {w | ∃ k, 1 ≤ k ∧ w = List.replicate k 0}
    | ⟨2, _⟩ => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n 1 ++ List.replicate n 2}
  have hclosed : ∀ r ∈ cfgAmbRight.rules, evalCFG X r.output ≤ X r.input := by
    intro r hr w hw
    have hr' : r = ⟨0, [Symbol.nonterminal 1, Symbol.nonterminal 2]⟩ ∨
        r = ⟨1, [Symbol.terminal 0]⟩ ∨
        r = ⟨1, [Symbol.terminal 0, Symbol.nonterminal 1]⟩ ∨
        r = ⟨2, [Symbol.terminal 1, Symbol.terminal 2]⟩ ∨
        r = ⟨2, [Symbol.terminal 1, Symbol.nonterminal 2, Symbol.terminal 2]⟩ := by
      simpa [cfgAmbRight] using hr
    rcases hr' with rfl | rfl | rfl | rfl | rfl
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, ⟨k, hk, rfl⟩, v, ⟨n, hn, rfl⟩, rfl⟩
      exact ⟨k, n, hk, hn, by simp [List.append_assoc]⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      have hw' : w = [0] := (mem_singleton_lang 0 w).mp hw
      subst hw'
      exact ⟨1, le_rfl, rfl⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, hu, v, ⟨k, hk, rfl⟩, rfl⟩
      have hu' : u = [0] := (mem_singleton_lang 0 u).mp hu
      subst hu'
      exact ⟨k + 1, by omega, by simp [List.replicate_succ]⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, hu, v, hv, rfl⟩
      have hu' : u = [1] := (mem_singleton_lang 1 u).mp hu
      have hv' : v = [2] := (mem_singleton_lang 2 v).mp hv
      subst hu'; subst hv'
      exact ⟨1, le_rfl, rfl⟩
    · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        evalCFGSym] at hw
      rcases Language.mem_mul.mp hw with ⟨u, hu, v, hv, rfl⟩
      rcases Language.mem_mul.mp hv with ⟨v1, ⟨n, hn, rfl⟩, v2, hv2, rfl⟩
      have hu' : u = [1] := (mem_singleton_lang 1 u).mp hu
      have hv2' : v2 = [2] := (mem_singleton_lang 2 v2).mp hv2
      subst hu'; subst hv2'
      refine ⟨n + 1, by omega, ?_⟩
      rw [List.replicate_succ, List.replicate_succ']
      simp [List.append_assoc]
  have h1 : ∀ k, 1 ≤ k → cfgAmbRight.Derives [Symbol.nonterminal 1]
      ((List.replicate k (0 : Fin 3)).map Symbol.terminal) := by
    intro k hk
    induction k with
    | zero => omega
    | succ k ih =>
      cases k with
      | zero =>
        exact Relation.ReflTransGen.single ⟨⟨1, [Symbol.terminal 0]⟩,
          by simp [cfgAmbRight], by simpa using ContextFreeRule.Rewrites.head []⟩
      | succ k' =>
        have hstep : cfgAmbRight.Produces [Symbol.nonterminal 1]
            [Symbol.terminal 0, Symbol.nonterminal 1] :=
          ⟨⟨1, [Symbol.terminal 0, Symbol.nonterminal 1]⟩,
            by simp [cfgAmbRight], by simpa using ContextFreeRule.Rewrites.head []⟩
        have hd := (ih (by omega)).append_left [Symbol.terminal 0]
        simpa [List.replicate_succ] using Relation.ReflTransGen.head hstep hd
  have h2 : ∀ n, 1 ≤ n → cfgAmbRight.Derives [Symbol.nonterminal 2]
      ((List.replicate n (1 : Fin 3) ++ List.replicate n (2 : Fin 3)).map Symbol.terminal) := by
    intro n hn
    induction n with
    | zero => omega
    | succ n ih =>
      cases n with
      | zero =>
        exact Relation.ReflTransGen.single ⟨⟨2, [Symbol.terminal 1, Symbol.terminal 2]⟩,
          by simp [cfgAmbRight], by simpa using ContextFreeRule.Rewrites.head []⟩
      | succ n' =>
        have hstep : cfgAmbRight.Produces [Symbol.nonterminal 2]
            [Symbol.terminal 1, Symbol.nonterminal 2, Symbol.terminal 2] :=
          ⟨⟨2, [Symbol.terminal 1, Symbol.nonterminal 2, Symbol.terminal 2]⟩,
            by simp [cfgAmbRight], by simpa using ContextFreeRule.Rewrites.head []⟩
        have hd := ((ih (by omega)).append_left [Symbol.terminal 1]).append_right [Symbol.terminal 2]
        have hrel := Relation.ReflTransGen.head hstep hd
        have heq : ([Symbol.terminal (N := Fin 3) (1 : Fin 3)] ++
            (List.replicate (n' + 1) (1 : Fin 3) ++ List.replicate (n' + 1) (2 : Fin 3)).map Symbol.terminal ++
            [Symbol.terminal (N := Fin 3) (2 : Fin 3)]) =
            (List.replicate (n' + 2) (1 : Fin 3) ++ List.replicate (n' + 2) (2 : Fin 3)).map Symbol.terminal := by
          rw [List.replicate_succ (n := n' + 1) (a := (1 : Fin 3)),
              List.replicate_succ' (n := n' + 1) (a := (2 : Fin 3))]
          simp [List.map_append, List.append_assoc]
        rw [heq] at hrel
        exact hrel
  ext w
  constructor
  · intro hw
    have hs := cfg_derives_sound_of_closed cfgAmbRight X hclosed
      (show cfgAmbRight.Derives [Symbol.nonterminal 0] (w.map Symbol.terminal) from hw)
    simp only [evalCFG, List.map_singleton, List.prod_cons, List.prod_nil, mul_one, evalCFGSym] at hs
    exact hs
  · rintro ⟨k, n, hk, hn, rfl⟩
    show cfgAmbRight.Generates ((List.replicate k (0 : Fin 3) ++ List.replicate n (1 : Fin 3) ++
      List.replicate n (2 : Fin 3)).map Symbol.terminal)
    unfold ContextFreeGrammar.Generates
    have hstep0 : cfgAmbRight.Produces [Symbol.nonterminal 0]
        [Symbol.nonterminal 1, Symbol.nonterminal 2] :=
      ⟨⟨0, [Symbol.nonterminal 1, Symbol.nonterminal 2]⟩,
        by simp [cfgAmbRight], by simpa using ContextFreeRule.Rewrites.head []⟩
    have hd1 := (h1 k hk).append_right [Symbol.nonterminal 2]
    have hd2 := (h2 n hn).append_left ((List.replicate k (0 : Fin 3)).map Symbol.terminal)
    simpa [List.map_append, List.append_assoc] using Relation.ReflTransGen.head hstep0 (hd1.trans hd2)

end CFGNonClosurePrivate

/-- **Context-Free Grammar Closure under Union.** -/
theorem ppl105_cfl_closure_union {α : Type*} (g₁ g₂ : ContextFreeGrammar α) :
    ∃ g : ContextFreeGrammar α, g.language = g₁.language ⊔ g₂.language := by
  classical
  let N := Option (g₁.NT ⊕ g₂.NT)
  let rInitL : ContextFreeRule α N := ⟨none, [Symbol.nonterminal (some (Sum.inl g₁.initial))]⟩
  let rInitR : ContextFreeRule α N := ⟨none, [Symbol.nonterminal (some (Sum.inr g₂.initial))]⟩
  let rulesL : Finset (ContextFreeRule α N) :=
    g₁.rules.image (fun r => ⟨some (Sum.inl r.input), r.output.map (liftSymL (N₂ := g₂.NT))⟩)
  let rulesR : Finset (ContextFreeRule α N) :=
    g₂.rules.image (fun r => ⟨some (Sum.inr r.input), r.output.map (liftSymR (N₁ := g₁.NT))⟩)
  let g : ContextFreeGrammar α :=
    { NT := N
      initial := none
      rules := insert rInitL (insert rInitR (rulesL ∪ rulesR)) }
  let X : N → Language α := fun n => match n with
    | none => g₁.language ⊔ g₂.language
    | some (Sum.inl A) => {w | g₁.Derives [Symbol.nonterminal A] (w.map Symbol.terminal)}
    | some (Sum.inr B) => {w | g₂.Derives [Symbol.nonterminal B] (w.map Symbol.terminal)}
  have hclosed : ∀ r ∈ g.rules, evalCFG X r.output ≤ X r.input := by
    intro r hr w hw
    simp only [g, Finset.mem_insert, Finset.mem_union, rulesL, rulesR, Finset.mem_image] at hr
    rcases hr with rfl | rfl | ⟨r₁, hr₁, rfl⟩ | ⟨r₂, hr₂, rfl⟩
    · simp only [rInitL, evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
        mul_one, evalCFGSym] at hw
      exact Or.inl hw
    · simp only [rInitR, evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
        mul_one, evalCFGSym] at hw
      exact Or.inr hw
    · have hsub : ∀ l : List (Symbol α g₁.NT), ∀ u : List α,
          u ∈ evalCFG X (l.map (liftSymL (N₂ := g₂.NT))) →
            g₁.Derives l (u.map Symbol.terminal) := by
        intro l
        induction l with
        | nil =>
          intro u hu
          simp only [List.map_nil, evalCFG, List.prod_nil, Language.mem_one] at hu
          subst hu; exact Relation.ReflTransGen.refl
        | cons s tl ih =>
          intro u hu
          simp only [List.map_cons, evalCFG, List.prod_cons, Language.mem_mul] at hu
          rcases hu with ⟨u₁, hu₁, u₂, hu₂, rfl⟩
          have h2 := ih u₂ hu₂
          have h1 : g₁.Derives [s] (u₁.map Symbol.terminal) := by
            cases s with
            | terminal a =>
              have ha : u₁ = [a] := (mem_singleton_lang a u₁).mp hu₁
              subst ha; exact Relation.ReflTransGen.refl
            | nonterminal A => exact hu₁
          simpa [List.map_append] using (h1.append_right tl).trans (h2.append_left (u₁.map Symbol.terminal))
      have hprod : g₁.Produces [Symbol.nonterminal r₁.input] r₁.output :=
        ⟨r₁, hr₁, by simpa using ContextFreeRule.Rewrites.head []⟩
      exact Relation.ReflTransGen.head hprod (hsub r₁.output w hw)
    · have hsub : ∀ l : List (Symbol α g₂.NT), ∀ u : List α,
          u ∈ evalCFG X (l.map (liftSymR (N₁ := g₁.NT))) →
            g₂.Derives l (u.map Symbol.terminal) := by
        intro l
        induction l with
        | nil =>
          intro u hu
          simp only [List.map_nil, evalCFG, List.prod_nil, Language.mem_one] at hu
          subst hu; exact Relation.ReflTransGen.refl
        | cons s tl ih =>
          intro u hu
          simp only [List.map_cons, evalCFG, List.prod_cons, Language.mem_mul] at hu
          rcases hu with ⟨u₁, hu₁, u₂, hu₂, rfl⟩
          have h2 := ih u₂ hu₂
          have h1 : g₂.Derives [s] (u₁.map Symbol.terminal) := by
            cases s with
            | terminal a =>
              have ha : u₁ = [a] := (mem_singleton_lang a u₁).mp hu₁
              subst ha; exact Relation.ReflTransGen.refl
            | nonterminal B => exact hu₁
          simpa [List.map_append] using (h1.append_right tl).trans (h2.append_left (u₁.map Symbol.terminal))
      have hprod : g₂.Produces [Symbol.nonterminal r₂.input] r₂.output :=
        ⟨r₂, hr₂, by simpa using ContextFreeRule.Rewrites.head []⟩
      exact Relation.ReflTransGen.head hprod (hsub r₂.output w hw)
  have hL_der : ∀ {u v : List (Symbol α g₁.NT)}, g₁.Derives u v →
      g.Derives (u.map (liftSymL (N₂ := g₂.NT))) (v.map (liftSymL (N₂ := g₂.NT))) := by
    intro u v h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | @tail b c _ hprod ih =>
      refine ih.tail ?_
      rcases hprod with ⟨r, hr, hrew⟩
      rcases ContextFreeRule.rewrites_iff.mp hrew with ⟨p, q, rfl, rfl⟩
      refine ⟨⟨some (Sum.inl r.input), r.output.map (liftSymL (N₂ := g₂.NT))⟩,
        Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
          (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hr))), ?_⟩
      rw [ContextFreeRule.rewrites_iff]
      exact ⟨p.map liftSymL, q.map liftSymL, by simp [liftSymL], by simp⟩
  have hR_der : ∀ {u v : List (Symbol α g₂.NT)}, g₂.Derives u v →
      g.Derives (u.map (liftSymR (N₁ := g₁.NT))) (v.map (liftSymR (N₁ := g₁.NT))) := by
    intro u v h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | @tail b c _ hprod ih =>
      refine ih.tail ?_
      rcases hprod with ⟨r, hr, hrew⟩
      rcases ContextFreeRule.rewrites_iff.mp hrew with ⟨p, q, rfl, rfl⟩
      refine ⟨⟨some (Sum.inr r.input), r.output.map (liftSymR (N₁ := g₁.NT))⟩,
        Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
          (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hr))), ?_⟩
      rw [ContextFreeRule.rewrites_iff]
      exact ⟨p.map liftSymR, q.map liftSymR, by simp [liftSymR], by simp⟩
  refine ⟨g, ?_⟩
  ext w
  constructor
  · intro hw
    have hs := cfg_derives_sound_of_closed g X hclosed
      (show g.Derives [Symbol.nonterminal none] (w.map Symbol.terminal) from hw)
    simpa [evalCFG, evalCFGSym, List.prod_cons, List.prod_nil, mul_one, X] using hs
  · rw [mem_sup_lang]
    rintro (h1 | h2)
    · have hprod : g.Produces [Symbol.nonterminal none] [Symbol.nonterminal (some (Sum.inl g₁.initial))] :=
        ⟨rInitL, Finset.mem_insert_self _ _, by simpa using ContextFreeRule.Rewrites.head (r := rInitL) []⟩
      have hd := hL_der (show g₁.Derives [Symbol.nonterminal g₁.initial] (w.map Symbol.terminal) from h1)
      have hterm : (w.map (Symbol.terminal (N := g₁.NT))).map (liftSymL (N₂ := g₂.NT)) =
          w.map (Symbol.terminal (N := N)) := by
        rw [List.map_map]; rfl
      rw [hterm] at hd
      exact Relation.ReflTransGen.head hprod hd
    · have hprod : g.Produces [Symbol.nonterminal none] [Symbol.nonterminal (some (Sum.inr g₂.initial))] :=
        ⟨rInitR, Finset.mem_insert_of_mem (Finset.mem_insert_self _ _),
          by simpa using ContextFreeRule.Rewrites.head (r := rInitR) []⟩
      have hd := hR_der (show g₂.Derives [Symbol.nonterminal g₂.initial] (w.map Symbol.terminal) from h2)
      have hterm : (w.map (Symbol.terminal (N := g₂.NT))).map (liftSymR (N₁ := g₁.NT)) =
          w.map (Symbol.terminal (N := N)) := by
        rw [List.map_map]; rfl
      rw [hterm] at hd
      exact Relation.ReflTransGen.head hprod hd

/-- **Non-Closure of Context-Free Languages under Intersection:**
There exist two context-free grammars `g₁, g₂ : ContextFreeGrammar (Fin 3)` whose intersection
`g₁.language ⊓ g₂.language` is not generated by any `ContextFreeGrammar (Fin 3)`. -/
theorem ppl105_cfl_not_closed_inter :
    ∃ g₁ g₂ : ContextFreeGrammar (Fin 3),
      ¬ ∃ g : ContextFreeGrammar (Fin 3), g.language = g₁.language ⊓ g₂.language := by
  refine ⟨cfgAmbLeft, cfgAmbRight, ?_⟩
  have heq : cfgAmbLeft.language ⊓ cfgAmbRight.language =
      ({w : List (Fin 3) | ∃ n, 1 ≤ n ∧
        w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) := by
    rw [cfgAmbLeft_lang, cfgAmbRight_lang]
    exact anbncn_inter_eq
  rw [heq]
  exact ppl105_anbncn_not_cfl

/-- **Non-Closure of Context-Free Languages under Complementation:**
There exists a context-free grammar `g : ContextFreeGrammar (Fin 3)` whose complement `g.languageᶜ`
is not generated by any `ContextFreeGrammar (Fin 3)`. -/
theorem ppl105_cfl_not_closed_compl :
    ∃ g : ContextFreeGrammar (Fin 3),
      ¬ ∃ g' : ContextFreeGrammar (Fin 3), g'.language = g.languageᶜ := by
  by_contra hall
  push Not at hall
  obtain ⟨g₁, g₂, hno⟩ := ppl105_cfl_not_closed_inter
  obtain ⟨gc₁, hgc₁⟩ := hall g₁
  obtain ⟨gc₂, hgc₂⟩ := hall g₂
  obtain ⟨gu, hgu⟩ := ppl105_cfl_closure_union gc₁ gc₂
  obtain ⟨gfin, hgfin⟩ := hall gu
  apply hno
  refine ⟨gfin, ?_⟩
  rw [hgfin, hgu, hgc₁, hgc₂, compl_sup, compl_compl, compl_compl]

/-! ## Section 3: Okhotin Binary Normal Form (BNF, 2004) & Decidable `O(n^3)` CYK Membership -/

section BNFPrivate

private def evalDNF {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)))) (w : List α) : Prop :=
  ∃ r ∈ d, (∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)

private def andDNF {C : Type*} (d₁ d₂ : List (List C × List C)) : List (List C × List C) :=
  d₁.flatMap (fun r₁ => d₂.map (fun r₂ => (r₁.1 ++ r₂.1, r₁.2 ++ r₂.2)))

private lemma evalDNF_andDNF {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (d₁ d₂ : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)))) (w : List α) :
    evalDNF X (andDNF d₁ d₂) w ↔ evalDNF X d₁ w ∧ evalDNF X d₂ w := by
  unfold evalDNF andDNF
  simp only [List.mem_flatMap, List.mem_map]
  constructor
  · rintro ⟨_, ⟨r₁, hr₁, r₂, hr₂, rfl⟩, hpos, hneg⟩
    refine ⟨⟨r₁, hr₁, fun γ hγ => hpos γ (List.mem_append_left _ hγ),
        fun δ hδ => hneg δ (List.mem_append_left _ hδ)⟩,
      ⟨r₂, hr₂, fun γ hγ => hpos γ (List.mem_append_right _ hγ),
        fun δ hδ => hneg δ (List.mem_append_right _ hδ)⟩⟩
  · rintro ⟨⟨r₁, hr₁, hp₁, hn₁⟩, ⟨r₂, hr₂, hp₂, hn₂⟩⟩
    refine ⟨(r₁.1 ++ r₂.1, r₁.2 ++ r₂.2), ⟨r₁, hr₁, r₂, hr₂, rfl⟩, ?_, ?_⟩
    · intro γ hγ
      rcases List.mem_append.mp hγ with h | h
      · exact hp₁ γ h
      · exact hp₂ γ h
    · intro δ hδ
      rcases List.mem_append.mp hδ with h | h
      · exact hn₁ δ h
      · exact hn₂ δ h

private lemma andDNF_forall {C : Type*} {P : C → Prop}
    {d₁ d₂ : List (List C × List C)}
    (h₁ : ∀ r ∈ d₁, ∀ c ∈ r.1 ++ r.2, P c)
    (h₂ : ∀ r ∈ d₂, ∀ c ∈ r.1 ++ r.2, P c) :
    ∀ r ∈ andDNF d₁ d₂, ∀ c ∈ r.1 ++ r.2, P c := by
  intro r hr c hc
  simp only [andDNF, List.mem_flatMap, List.mem_map] at hr
  rcases hr with ⟨r₁, hr₁, r₂, hr₂, rfl⟩
  simp only [List.mem_append] at hc
  rcases hc with (h | h) | (h | h)
  · exact h₁ r₁ hr₁ c (List.mem_append_left _ h)
  · exact h₂ r₂ hr₂ c (List.mem_append_left _ h)
  · exact h₁ r₁ hr₁ c (List.mem_append_right _ h)
  · exact h₂ r₂ hr₂ c (List.mem_append_right _ h)

private def negClause {C : Type*} (r : List C × List C) : List (List C × List C) :=
  r.1.map (fun γ => ([], [γ])) ++ r.2.map (fun δ => ([δ], []))

private lemma evalDNF_negClause {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))) (w : List α) :
    evalDNF X (negClause r) w ↔
      ¬ ((∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) := by
  classical
  unfold evalDNF negClause
  simp only [List.mem_append, List.mem_map]
  constructor
  · rintro ⟨s, ⟨γ, hγ, rfl⟩ | ⟨δ, hδ, rfl⟩, hp, hn⟩ ⟨hallp, halln⟩
    · exact hn γ (List.mem_singleton_self _) (hallp γ hγ)
    · exact halln δ hδ (hp δ (List.mem_singleton_self _))
  · intro hnot
    by_cases hp : ∀ γ ∈ r.1, w ∈ evalSF X γ
    · have hne : ¬ ∀ δ ∈ r.2, w ∉ evalSF X δ := fun hn => hnot ⟨hp, hn⟩
      push Not at hne
      rcases hne with ⟨δ, hδ, hwδ⟩
      exact ⟨([δ], []), Or.inr ⟨δ, hδ, rfl⟩, by simp [hwδ], by simp⟩
    · push Not at hp
      rcases hp with ⟨γ, hγ, hwγ⟩
      exact ⟨([], [γ]), Or.inl ⟨γ, hγ, rfl⟩, by simp, by simp [hwγ]⟩

private lemma negClause_forall {C : Type*} {P : C → Prop} {r : List C × List C}
    (hr : ∀ c ∈ r.1 ++ r.2, P c) :
    ∀ s ∈ negClause r, ∀ c ∈ s.1 ++ s.2, P c := by
  intro s hs c hc
  rcases List.mem_append.mp hs with h | h
  · rcases List.mem_map.mp h with ⟨γ, hγ, rfl⟩
    simp only [List.nil_append, List.mem_singleton] at hc
    subst hc; exact hr c (List.mem_append_left _ hγ)
  · rcases List.mem_map.mp h with ⟨δ, hδ, rfl⟩
    simp only [List.append_nil, List.mem_singleton] at hc
    subst hc; exact hr c (List.mem_append_right _ hδ)

private def negDNF {C : Type*} : List (List C × List C) → List (List C × List C)
  | [] => [([], [])]
  | r :: rs => andDNF (negClause r) (negDNF rs)

private lemma evalDNF_negDNF {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)))) (w : List α) :
    evalDNF X (negDNF d) w ↔ ¬ evalDNF X d w := by
  induction d with
  | nil => simp [evalDNF, negDNF]
  | cons r rs ih =>
    simp only [negDNF, evalDNF_andDNF, evalDNF_negClause, ih]
    unfold evalDNF
    simp only [List.mem_cons, exists_eq_or_imp, not_or]

private lemma negDNF_forall {C : Type*} {P : C → Prop}
    {d : List (List C × List C)} (hd : ∀ r ∈ d, ∀ c ∈ r.1 ++ r.2, P c) :
    ∀ r ∈ negDNF d, ∀ c ∈ r.1 ++ r.2, P c := by
  induction d with
  | nil => intro r hr c hc; simp [negDNF] at hr; subst hr; simp at hc
  | cons s rs ih =>
    exact andDNF_forall
      (negClause_forall (hd s (List.mem_cons_self ..)))
      (ih fun r hr => hd r (List.mem_cons_of_mem _ hr))

private def andDNFList {C : Type*} : List (List (List C × List C)) → List (List C × List C)
  | [] => [([], [])]
  | d :: ds => andDNF d (andDNFList ds)

private lemma evalDNF_andDNFList {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (ds : List (List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))) (w : List α) :
    evalDNF X (andDNFList ds) w ↔ ∀ d ∈ ds, evalDNF X d w := by
  induction ds with
  | nil => simp [evalDNF, andDNFList]
  | cons d ds ih =>
    simp only [andDNFList, evalDNF_andDNF, ih, List.mem_cons, forall_eq_or_imp]

private lemma andDNFList_forall {C : Type*} {P : C → Prop}
    {ds : List (List (List C × List C))}
    (hds : ∀ d ∈ ds, ∀ r ∈ d, ∀ c ∈ r.1 ++ r.2, P c) :
    ∀ r ∈ andDNFList ds, ∀ c ∈ r.1 ++ r.2, P c := by
  induction ds with
  | nil => intro r hr c hc; simp [andDNFList] at hr; subst hr; simp at hc
  | cons d ds ih =>
    exact andDNF_forall
      (hds d (List.mem_cons_self ..))
      (ih fun d' hd' => hds d' (List.mem_cons_of_mem _ hd'))

private lemma evalDNF_flatten {α : Type*} {k : ℕ} (X : Fin k → Language α)
    (ds : List (List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))) (w : List α) :
    evalDNF X ds.flatten w ↔ ∃ d ∈ ds, evalDNF X d w := by
  unfold evalDNF
  simp only [List.mem_flatten]
  constructor
  · rintro ⟨r, ⟨d, hd, hr⟩, h⟩; exact ⟨d, hd, r, hr, h⟩
  · rintro ⟨d, hd, r, hr, h⟩; exact ⟨r, ⟨d, hd, hr⟩, h⟩

/-- Stage 1 of Okhotin BNF: eliminate all acyclic unit conjuncts `[Sum.inr j]` via DNF expansion. -/
private lemma bg_elim_unit {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (rank : Fin k → ℕ)
    (hwf : ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i)
    (X : Fin k → Language α)
    (hX : ∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G X i w) :
    ∃ G₁ : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
      (∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j : Fin k, γ ≠ [Sum.inr j]) ∧
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G₁ X i w) := by
  classical
  let NonUnit : List (α ⊕ Fin k) → Prop := fun γ => γ ≠ [] ∧ ∀ j : Fin k, γ ≠ [Sum.inr j]
  have hbuild : ∀ m : ℕ, ∀ i : Fin k, rank i = m →
      ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
        (∀ r ∈ d, ∀ γ ∈ r.1 ++ r.2, NonUnit γ) ∧
        ∀ w : List α, w ≠ [] → (w ∈ X i ↔ evalDNF X d w) := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ihm =>
      intro i hi
      have hlit_pos : ∀ γ : List (α ⊕ Fin k),
          (γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i) →
          ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
            (∀ r ∈ d, ∀ c ∈ r.1 ++ r.2, NonUnit c) ∧
            ∀ w : List α, w ≠ [] → (w ∈ evalSF X γ ↔ evalDNF X d w) := by
        intro γ hγ
        by_cases hu : ∃ j : Fin k, γ = [Sum.inr j]
        · rcases hu with ⟨j, rfl⟩
          obtain ⟨dj, hdj_nu, hdj_eq⟩ := ihm (rank j) (hi ▸ hγ.2 j rfl) j rfl
          exact ⟨dj, hdj_nu, fun w hw => by rw [mem_evalSF_singleton_inr]; exact hdj_eq w hw⟩
        · push Not at hu
          refine ⟨[([γ], [])], ?_, fun w _ => ?_⟩
          · intro r hr c hc
            simp only [List.mem_singleton] at hr; subst hr
            simp only [List.append_nil, List.mem_singleton] at hc; subst hc
            exact ⟨hγ.1, hu⟩
          · simp [evalDNF]
      have hlit_neg : ∀ δ : List (α ⊕ Fin k),
          (δ ≠ [] ∧ ∀ j, δ = [Sum.inr j] → rank j < rank i) →
          ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
            (∀ r ∈ d, ∀ c ∈ r.1 ++ r.2, NonUnit c) ∧
            ∀ w : List α, w ≠ [] → (w ∉ evalSF X δ ↔ evalDNF X d w) := by
        intro δ hδ
        obtain ⟨d, hd_nu, hd_eq⟩ := hlit_pos δ hδ
        exact ⟨negDNF d, negDNF_forall hd_nu, fun w hw => by
          rw [evalDNF_negDNF, hd_eq w hw]⟩
      have hrule : ∀ r ∈ G i,
          ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, NonUnit c) ∧
            ∀ w : List α, w ≠ [] →
              (((∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) ↔ evalDNF X d w) := by
        intro r hr
        have hpos_list : ∀ l : List (List (α ⊕ Fin k)),
            (∀ γ ∈ l, γ ≠ [] ∧ ∀ j, γ = [Sum.inr j] → rank j < rank i) →
            ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
              (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, NonUnit c) ∧
              ∀ w : List α, w ≠ [] → ((∀ γ ∈ l, w ∈ evalSF X γ) ↔ evalDNF X d w) := by
          intro l
          induction l with
          | nil =>
            intro _
            refine ⟨[([], [])], fun s hs c hc => ?_, fun w _ => by simp [evalDNF]⟩
            simp only [List.mem_singleton] at hs; subst hs; simp at hc
          | cons γ tl ihl =>
            intro hall
            obtain ⟨d1, hd1_nu, hd1_eq⟩ := hlit_pos γ (hall γ (List.mem_cons_self ..))
            obtain ⟨d2, hd2_nu, hd2_eq⟩ := ihl (fun c hc => hall c (List.mem_cons_of_mem _ hc))
            refine ⟨andDNF d1 d2, andDNF_forall hd1_nu hd2_nu, fun w hw => ?_⟩
            rw [evalDNF_andDNF, ← hd1_eq w hw, ← hd2_eq w hw]
            simp
        have hneg_list : ∀ l : List (List (α ⊕ Fin k)),
            (∀ δ ∈ l, δ ≠ [] ∧ ∀ j, δ = [Sum.inr j] → rank j < rank i) →
            ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
              (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, NonUnit c) ∧
              ∀ w : List α, w ≠ [] → ((∀ δ ∈ l, w ∉ evalSF X δ) ↔ evalDNF X d w) := by
          intro l
          induction l with
          | nil =>
            intro _
            refine ⟨[([], [])], fun s hs c hc => ?_, fun w _ => by simp [evalDNF]⟩
            simp only [List.mem_singleton] at hs; subst hs; simp at hc
          | cons δ tl ihl =>
            intro hall
            obtain ⟨d1, hd1_nu, hd1_eq⟩ := hlit_neg δ (hall δ (List.mem_cons_self ..))
            obtain ⟨d2, hd2_nu, hd2_eq⟩ := ihl (fun c hc => hall c (List.mem_cons_of_mem _ hc))
            refine ⟨andDNF d1 d2, andDNF_forall hd1_nu hd2_nu, fun w hw => ?_⟩
            rw [evalDNF_andDNF, ← hd1_eq w hw, ← hd2_eq w hw]
            simp
        obtain ⟨dp, hdp_nu, hdp_eq⟩ := hpos_list r.1 (fun γ hγ => hwf i r hr γ (List.mem_append_left _ hγ))
        obtain ⟨dn, hdn_nu, hdn_eq⟩ := hneg_list r.2 (fun δ hδ => hwf i r hr δ (List.mem_append_right _ hδ))
        refine ⟨andDNF dp dn, andDNF_forall hdp_nu hdn_nu, fun w hw => ?_⟩
        rw [evalDNF_andDNF, ← hdp_eq w hw, ← hdn_eq w hw]
      have hrules_list : ∀ rs : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
          (∀ r ∈ rs, r ∈ G i) →
          ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, NonUnit c) ∧
            ∀ w : List α, w ≠ [] →
              ((∃ r ∈ rs, (∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) ↔
                evalDNF X d w) := by
        intro rs
        induction rs with
        | nil =>
          intro _
          exact ⟨[], fun _ h => by simp at h, fun _ _ => by simp [evalDNF]⟩
        | cons r tl ihtl =>
          intro hall
          obtain ⟨d1, hd1_nu, hd1_eq⟩ := hrule r (hall r (List.mem_cons_self ..))
          obtain ⟨d2, hd2_nu, hd2_eq⟩ := ihtl (fun r' hr' => hall r' (List.mem_cons_of_mem _ hr'))
          refine ⟨d1 ++ d2, fun s hs c hc => ?_, fun w hw => ?_⟩
          · rcases List.mem_append.mp hs with h | h
            · exact hd1_nu s h c hc
            · exact hd2_nu s h c hc
          · simp only [List.mem_cons, exists_eq_or_imp, evalDNF, List.mem_append]
            rw [hd1_eq w hw, hd2_eq w hw]
            unfold evalDNF
            constructor
            · rintro (⟨s, hs, h⟩ | ⟨s, hs, h⟩)
              · exact ⟨s, Or.inl hs, h⟩
              · exact ⟨s, Or.inr hs, h⟩
            · rintro ⟨s, hs | hs, h⟩
              · exact Or.inl ⟨s, hs, h⟩
              · exact Or.inr ⟨s, hs, h⟩
      obtain ⟨d, hd_nu, hd_eq⟩ := hrules_list (G i) (fun _ h => h)
      refine ⟨d, hd_nu, fun w hw => ?_⟩
      rw [hX i w, and_iff_right hw]
      exact hd_eq w hw
  let G₁ : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))) :=
    fun i => Classical.choose (hbuild (rank i) i rfl)
  refine ⟨G₁, fun i => (Classical.choose_spec (hbuild (rank i) i rfl)).1, fun i w => ?_⟩
  by_cases hw : w = []
  · subst hw
    simp only [ne_eq, not_true_eq_false, false_and, iff_false]
    intro hmem
    exact ((hX i []).mp hmem).1 rfl
  · rw [and_iff_right hw]
    exact (Classical.choose_spec (hbuild (rank i) i rfl)).2 w hw

/-- Stage 2 of Okhotin BNF: separate terminal rules `A → a` from length-`≥ 2` pure-nonterminal
rules by introducing one universal nonterminal `U` (`Σ⁺`) and `|α|` terminal wrappers `T_a`. -/
private lemma bg_sep_len_one {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G₁ : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (hnu : ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2, γ ≠ [] ∧ ∀ j : Fin k, γ ≠ [Sum.inr j])
    (X : Fin k → Language α)
    (hX : ∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G₁ X i w) :
    ∃ (k₂ : ℕ) (emb : Fin k → Fin k₂)
      (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
      (X₂ : Fin k₂ → Language α),
      (∀ i, X₂ (emb i) = X i) ∧
      (∀ i, ∀ r ∈ G₂ i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, 2 ≤ γ.length ∧ ∀ s ∈ γ, ∃ B : Fin k₂, s = Sum.inr B)) ∧
      (∀ i w, w ∈ X₂ i ↔ w ≠ [] ∧ boolCond G₂ X₂ i w) := by
  classical
  let m := Fintype.card α
  let e : α ≃ Fin m := Fintype.equivFin α
  let k₂ := k + 1 + m
  let origIdx : Fin k → Fin k₂ := fun i => ⟨i.1, by omega⟩
  let uIdx : Fin k₂ := ⟨k, by omega⟩
  let termIdx : α → Fin k₂ := fun a => ⟨k + 1 + (e a).1, by omega⟩
  let liftSym : α ⊕ Fin k → α ⊕ Fin k₂ :=
    Sum.elim (fun a => Sum.inr (termIdx a)) (fun j => Sum.inr (origIdx j))
  let liftSF : List (α ⊕ Fin k) → List (α ⊕ Fin k₂) := List.map liftSym
  let L_ne : Language α := {w : List α | w ≠ []}
  let X₂ : Fin k₂ → Language α := fun i =>
    if h1 : i.1 < k then X ⟨i.1, h1⟩
    else if h2 : i.1 = k then L_ne
    else ({[e.symm ⟨i.1 - (k + 1), by omega⟩]} : Language α)
  have hX₂_orig : ∀ i : Fin k, X₂ (origIdx i) = X i := by
    intro i; dsimp only [X₂, origIdx]; rw [dif_pos i.2]
  have hX₂_u : X₂ uIdx = L_ne := by
    dsimp only [X₂, uIdx]; rw [dif_neg (by omega), dif_pos rfl]
  have hX₂_term : ∀ a : α, X₂ (termIdx a) = ({[a]} : Language α) := by
    intro a; dsimp only [X₂, termIdx]
    have h1 : ¬ (k + 1 + (e a).1 < k) := by omega
    have h2 : ¬ (k + 1 + (e a).1 = k) := by omega
    rw [dif_neg h1, dif_neg h2]
    have hsub : (⟨k + 1 + (e a).1 - (k + 1), by omega⟩ : Fin m) = e a := Fin.ext (by dsimp; omega)
    rw [hsub, Equiv.symm_apply_apply]
  have hX_nil : ∀ j, ([] : List α) ∉ X j := fun j hj => ((hX j []).mp hj).1 rfl
  have heval_lift : ∀ γ : List (α ⊕ Fin k), evalSF X₂ (liftSF γ) = evalSF X γ := by
    intro γ
    simp only [evalSF, liftSF, List.map_map]
    congr 1
    refine List.map_congr_left fun s _ => ?_
    cases s with
    | inl a => simp [liftSym, hX₂_term]
    | inr j => simp [liftSym, hX₂_orig]
  let allAlphas : List α := (Finset.univ : Finset α).toList
  have hmem_allAlphas : ∀ a : α, a ∈ allAlphas := fun a =>
    Finset.mem_toList.mpr (Finset.mem_univ a)
  let G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))) := fun i =>
    if h1 : i.1 < k then
      let j : Fin k := ⟨i.1, h1⟩
      let termRules := (allAlphas.filter (fun a => decide ([a] ∈ X j))).map (fun a => ([[Sum.inl a]], []))
      let longRules := ((G₁ j).filter (fun r => r.1.all (fun γ => decide (2 ≤ γ.length)))).map
        (fun r => ([Sum.inr uIdx, Sum.inr uIdx] :: r.1.map liftSF,
          (r.2.filter (fun δ => decide (2 ≤ δ.length))).map liftSF))
      termRules ++ longRules
    else if h2 : i.1 = k then
      allAlphas.map (fun a => ([[Sum.inl a]], [])) ++ [([[Sum.inr uIdx, Sum.inr uIdx]], [])]
    else
      [([[Sum.inl (e.symm ⟨i.1 - (k + 1), by omega⟩)]], [])]
  have huu_mem : ∀ w : List α, w ∈ evalSF X₂ [Sum.inr uIdx, Sum.inr uIdx] ↔ 2 ≤ w.length := by
    intro w
    rw [mem_evalSF_pair, hX₂_u]
    constructor
    · rintro ⟨u, hu, v, hv, rfl⟩
      have h1 : 1 ≤ u.length := List.length_pos_of_ne_nil hu
      have h2 : 1 ≤ v.length := List.length_pos_of_ne_nil hv
      simp only [List.length_append]; omega
    · intro hlen
      rcases w with _ | ⟨a, _ | ⟨b, tl⟩⟩
      · simp at hlen
      · simp at hlen
      · exact ⟨[a], by change [a] ≠ []; simp, b :: tl, by change b :: tl ≠ []; simp, rfl⟩
  have hlen1_is_term : ∀ (j : Fin k) (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
      r ∈ G₁ j → ∀ γ ∈ r.1 ++ r.2, γ.length < 2 → ∃ a : α, γ = [Sum.inl a] := by
    intro j r hr γ hγ hlt
    have h := hnu j r hr γ hγ
    rcases γ with _ | ⟨s, _ | ⟨t, rest⟩⟩
    · exact (h.1 rfl).elim
    · cases s with
      | inl a => exact ⟨a, rfl⟩
      | inr b => exact (h.2 b rfl).elim
    · simp at hlt
  refine ⟨k₂, origIdx, G₂, X₂, hX₂_orig, ?_, ?_⟩
  · intro i r hr
    by_cases h1 : i.1 < k
    · dsimp only [G₂] at hr
      rw [dif_pos h1, List.mem_append, List.mem_map, List.mem_map] at hr
      rcases hr with ⟨a, _, rfl⟩ | ⟨r₀, hr₀, rfl⟩
      · exact Or.inl ⟨a, rfl⟩
      · refine Or.inr ⟨by simp, fun γ hγ => ?_⟩
        simp only [List.cons_append, List.mem_cons, List.mem_append, List.mem_map,
          List.mem_filter, decide_eq_true_eq] at hγ
        rcases hγ with rfl | ⟨γ₀, hγ₀, rfl⟩ | ⟨δ₀, ⟨_, hδlen⟩, rfl⟩
        · exact ⟨by simp, fun s hs => by simp at hs; subst hs; exact ⟨uIdx, rfl⟩⟩
        · simp only [List.mem_filter, List.all_eq_true, decide_eq_true_eq] at hr₀
          refine ⟨by simp [liftSF, hr₀.2 γ₀ hγ₀], fun s hs => ?_⟩
          rcases List.mem_map.mp hs with ⟨s₀, _, rfl⟩
          cases s₀ with
          | inl a => exact ⟨termIdx a, rfl⟩
          | inr j => exact ⟨origIdx j, rfl⟩
        · refine ⟨by simp [liftSF, hδlen], fun s hs => ?_⟩
          rcases List.mem_map.mp hs with ⟨s₀, _, rfl⟩
          cases s₀ with
          | inl a => exact ⟨termIdx a, rfl⟩
          | inr j => exact ⟨origIdx j, rfl⟩
    · by_cases h2 : i.1 = k
      · dsimp only [G₂] at hr
        rw [dif_neg h1, dif_pos h2, List.mem_append, List.mem_map, List.mem_singleton] at hr
        rcases hr with ⟨a, _, rfl⟩ | rfl
        · exact Or.inl ⟨a, rfl⟩
        · exact Or.inr ⟨by simp, fun γ hγ => by
            simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
            exact ⟨by simp, fun s hs => by simp at hs; subst hs; exact ⟨uIdx, rfl⟩⟩⟩
      · dsimp only [G₂] at hr
        rw [dif_neg h1, dif_neg h2, List.mem_singleton] at hr
        subst hr
        exact Or.inl ⟨e.symm ⟨i.1 - (k + 1), by omega⟩, rfl⟩
  · intro i w
    by_cases h1 : i.1 < k
    · let j : Fin k := ⟨i.1, h1⟩
      have hXi : X₂ i = X j := by dsimp only [X₂]; rw [dif_pos h1]
      rw [hXi]
      by_cases hw0 : w = []
      · subst hw0
        simp [hX_nil j]
      · rw [and_iff_right hw0]
        unfold boolCond
        dsimp only [G₂]
        rw [dif_pos h1]
        by_cases hw1 : w.length = 1
        · rcases w with _ | ⟨a, _ | ⟨b, tl⟩⟩
          · simp at hw1
          · simp only [List.mem_append, List.mem_map, List.mem_filter, decide_eq_true_eq]
            constructor
            · intro hmem
              exact ⟨([[Sum.inl a]], []), Or.inl ⟨a, ⟨hmem_allAlphas a, hmem⟩, rfl⟩,
                fun γ hγ => by simp at hγ; subst hγ; exact (mem_evalSF_singleton_inl X₂ a [a]).mpr rfl,
                by simp⟩
            · rintro ⟨r, ⟨a', ⟨_, ha'⟩, rfl⟩ | ⟨r₀, _, rfl⟩, hp, _⟩
              · have heq := (mem_evalSF_singleton_inl X₂ a' [a]).mp (hp [Sum.inl a'] (List.mem_singleton_self _))
                have : a = a' := List.cons.inj heq |>.1
                subst this; exact ha'
              · have huu := hp [Sum.inr uIdx, Sum.inr uIdx] (List.mem_cons_self ..)
                have h2 := (huu_mem [a]).mp huu
                simp at h2
          · simp at hw1
        · have hw2 : 2 ≤ w.length := by
            have := List.length_pos_of_ne_nil hw0; omega
          rw [hX j w, and_iff_right hw0]
          unfold boolCond
          simp only [List.mem_append, List.mem_map, List.mem_filter,
            List.all_eq_true, decide_eq_true_eq]
          constructor
          · rintro ⟨r₀, hr₀, hp₀, hn₀⟩
            have hall2 : ∀ γ ∈ r₀.1, 2 ≤ γ.length := by
              intro γ hγ
              by_contra hlt
              push Not at hlt
              obtain ⟨a, rfl⟩ := hlen1_is_term j r₀ hr₀ γ (List.mem_append_left _ hγ) hlt
              have heq := (mem_evalSF_singleton_inl X a w).mp (hp₀ [Sum.inl a] hγ)
              subst heq; simp at hw2
            refine ⟨_, Or.inr ⟨r₀, ⟨hr₀, hall2⟩, rfl⟩, ?_, ?_⟩
            · intro γ hγ
              rcases List.mem_cons.mp hγ with rfl | hγ'
              · exact (huu_mem w).mpr hw2
              · rcases List.mem_map.mp hγ' with ⟨γ₀, hγ₀, rfl⟩
                rw [heval_lift]; exact hp₀ γ₀ hγ₀
            · intro δ hδ
              rcases List.mem_map.mp hδ with ⟨δ₀, hδ₀, rfl⟩
              rw [List.mem_filter, decide_eq_true_eq] at hδ₀
              rw [heval_lift]; exact hn₀ δ₀ hδ₀.1
          · rintro ⟨r, ⟨a, _, rfl⟩ | ⟨r₀, ⟨hr₀, _⟩, rfl⟩, hp, hn⟩
            · have heq := (mem_evalSF_singleton_inl X₂ a w).mp (hp [Sum.inl a] (List.mem_singleton_self _))
              subst heq; simp at hw2
            · refine ⟨r₀, hr₀, ?_, ?_⟩
              · intro γ₀ hγ₀
                have h := hp (liftSF γ₀) (List.mem_cons_of_mem _ (List.mem_map.mpr ⟨γ₀, hγ₀, rfl⟩))
                rwa [heval_lift] at h
              · intro δ₀ hδ₀
                by_cases hlen : 2 ≤ δ₀.length
                · have h := hn (liftSF δ₀) (List.mem_map.mpr ⟨δ₀,
                    List.mem_filter.mpr ⟨hδ₀, decide_eq_true hlen⟩, rfl⟩)
                  rwa [heval_lift] at h
                · push Not at hlen
                  obtain ⟨a, rfl⟩ := hlen1_is_term j r₀ hr₀ δ₀ (List.mem_append_right _ hδ₀) hlen
                  rw [mem_evalSF_singleton_inl]
                  intro heq; subst heq; simp at hw2
    · by_cases h2 : i.1 = k
      · have hi : i = uIdx := Fin.ext h2
        subst hi
        rw [hX₂_u]
        change w ≠ [] ↔ _
        unfold boolCond
        dsimp only [G₂, uIdx]
        rw [dif_neg (by omega), dif_pos rfl]
        simp only [List.mem_append, List.mem_map, List.mem_singleton]
        constructor
        · intro hne
          refine ⟨hne, ?_⟩
          rcases w with _ | ⟨a, _ | ⟨b, tl⟩⟩
          · exact (hne rfl).elim
          · exact ⟨([[Sum.inl a]], []), Or.inl ⟨a, hmem_allAlphas a, rfl⟩,
              fun γ hγ => by simp at hγ; subst hγ; exact (mem_evalSF_singleton_inl X₂ a [a]).mpr rfl,
              by simp⟩
          · exact ⟨([[Sum.inr uIdx, Sum.inr uIdx]], []), Or.inr rfl,
              fun γ hγ => by simp at hγ; subst hγ; exact (huu_mem (a :: b :: tl)).mpr (by simp),
              by simp⟩
        · exact And.left
      · have hXi : X₂ i = ({[e.symm ⟨i.1 - (k + 1), by omega⟩]} : Language α) := by
          dsimp only [X₂]; rw [dif_neg h1, dif_neg h2]
        rw [hXi, mem_singleton_lang]
        unfold boolCond
        dsimp only [G₂]
        rw [dif_neg h1, dif_neg h2]
        simp only [List.mem_singleton, exists_eq_left, forall_eq, List.not_mem_nil,
          false_implies, forall_const, and_true, mem_evalSF_singleton_inl]
        constructor
        · rintro rfl; exact ⟨by simp, rfl⟩
        · exact And.right

/-- One pair-contraction step: reduces max conjunct length from `M + 3` to `M + 2` by introducing
`k * k` fresh BNF pair nonterminals `N_{B, C} → B C`. -/
private lemma bg_binarize_step {α : Type*} {k M : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X : Fin k → Language α)
    (hshape : ∀ i, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
      (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2,
        2 ≤ γ.length ∧ γ.length ≤ M + 3 ∧ ∀ s ∈ γ, ∃ B : Fin k, s = Sum.inr B))
    (hX : ∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G X i w) :
    ∃ (k' : ℕ) (emb : Fin k → Fin k')
      (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
      (X' : Fin k' → Language α),
      (∀ i, X' (emb i) = X i) ∧
      (∀ i, ∀ r ∈ G' i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2,
          2 ≤ γ.length ∧ γ.length ≤ M + 2 ∧ ∀ s ∈ γ, ∃ B : Fin k', s = Sum.inr B)) ∧
      (∀ i w, w ∈ X' i ↔ w ≠ [] ∧ boolCond G' X' i w) := by
  let k' := k + k * k
  let oldIdx : Fin k → Fin k' := fun i => ⟨i.1, by omega⟩
  have hpair_lt : ∀ B C : Fin k, k + (B.1 * k + C.1) < k' := fun B C => by
    have h1 : B.1 * k + C.1 < k * k := by
      have hB : B.1 + 1 ≤ k := B.2
      calc B.1 * k + C.1 < B.1 * k + k := Nat.add_lt_add_left C.2 _
        _ = (B.1 + 1) * k := by ring
        _ ≤ k * k := Nat.mul_le_mul_right k hB
    omega
  let pairIdx : Fin k → Fin k → Fin k' := fun B C => ⟨k + (B.1 * k + C.1), hpair_lt B C⟩
  let contractSF : List (α ⊕ Fin k) → List (α ⊕ Fin k') := fun γ =>
    match γ with
    | Sum.inr B :: Sum.inr C :: s :: rest =>
        Sum.inr (pairIdx B C) :: mapSF oldIdx (s :: rest)
    | _ => mapSF oldIdx γ
  let contractRule : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)) →
      List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k')) := fun r =>
    (r.1.map contractSF, r.2.map contractSF)
  let X' : Fin k' → Language α := fun i =>
    if h : i.1 < k then X ⟨i.1, h⟩
    else
      have hpos : 0 < k := by
        by_contra hk0
        have hk : k = 0 := by omega
        have hi := i.2
        simp [k', hk] at hi
      let q := (i.1 - k) / k
      let r := (i.1 - k) % k
      have hq : q < k := by
        have hlt : i.1 - k < k * k := by omega
        exact Nat.div_lt_of_lt_mul hlt
      X ⟨q, hq⟩ * X ⟨r, Nat.mod_lt _ hpos⟩
  have hX'_old : ∀ i : Fin k, X' (oldIdx i) = X i := by
    intro i; dsimp only [X', oldIdx]; rw [dif_pos i.2]
  have hX'_pair : ∀ B C : Fin k, X' (pairIdx B C) = X B * X C := by
    intro B C
    dsimp only [X', pairIdx]
    rw [dif_neg (by omega)]
    have hsub : k + (B.1 * k + C.1) - k = B.1 * k + C.1 := by omega
    have hkpos : 0 < k := Nat.pos_of_ne_zero (by intro h; have := B.2; omega)
    have hdiv : (B.1 * k + C.1) / k = B.1 := by
      rw [Nat.add_comm, Nat.mul_comm, Nat.add_mul_div_left _ _ hkpos, Nat.div_eq_of_lt C.2, zero_add]
    have hmod : (B.1 * k + C.1) % k = C.1 := by
      rw [Nat.add_comm, Nat.mul_comm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt C.2]
    congr 1 <;> apply congrArg X <;> apply Fin.ext <;> simp [hsub, hdiv, hmod]
  have heval_contract : ∀ γ : List (α ⊕ Fin k), evalSF X' (contractSF γ) = evalSF X γ := by
    intro γ
    rcases γ with _ | ⟨s₁, _ | ⟨s₂, _ | ⟨s₃, rest⟩⟩⟩
    · simp [contractSF, evalSF_mapSF, hX'_old]
    · simp [contractSF, evalSF_mapSF, hX'_old]
    · simp [contractSF, evalSF_mapSF, hX'_old]
    · cases s₁ with
      | inl a => simp [contractSF, evalSF_mapSF, hX'_old]
      | inr B =>
        cases s₂ with
        | inl b => simp [contractSF, evalSF_mapSF, hX'_old]
        | inr C =>
          simp only [contractSF, evalSF_cons, Sum.elim_inr, hX'_pair, evalSF_mapSF, hX'_old,
            mul_assoc]
  let G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))) := fun i =>
    if h : i.1 < k then (G ⟨i.1, h⟩).map contractRule
    else
      have hpos : 0 < k := by
        by_contra hk0
        have hk : k = 0 := by omega
        have hi := i.2
        simp [k', hk] at hi
      let q := (i.1 - k) / k
      let r := (i.1 - k) % k
      have hq : q < k := Nat.div_lt_of_lt_mul (by omega)
      [([[Sum.inr (oldIdx ⟨q, hq⟩), Sum.inr (oldIdx ⟨r, Nat.mod_lt _ hpos⟩)]], [])]
  have hX_nil : ∀ j, ([] : List α) ∉ X j := fun j hj => ((hX j []).mp hj).1 rfl
  refine ⟨k', oldIdx, G', X', hX'_old, ?_, ?_⟩
  · intro i r hr
    by_cases h : i.1 < k
    · dsimp only [G'] at hr
      rw [dif_pos h, List.mem_map] at hr
      rcases hr with ⟨r₀, hr₀, rfl⟩
      rcases hshape ⟨i.1, h⟩ r₀ hr₀ with ⟨a, rfl⟩ | ⟨hpos, hall⟩
      · exact Or.inl ⟨a, by simp [contractRule, contractSF, mapSF, mapSym]⟩
      · refine Or.inr ⟨by simp [contractRule, hpos], fun γ hγ => ?_⟩
        simp only [contractRule, ← List.map_append, List.mem_map] at hγ
        rcases hγ with ⟨γ₀, hγ₀, rfl⟩
        obtain ⟨hge2, hle3, hnt⟩ := hall γ₀ hγ₀
        rcases γ₀ with _ | ⟨s₁, _ | ⟨s₂, _ | ⟨s₃, rest⟩⟩⟩
        · simp at hge2
        · simp at hge2
        · refine ⟨by simp [contractSF, mapSF], by simp [contractSF, mapSF], fun s hs => ?_⟩
          simp only [contractSF, mapSF, List.mem_map] at hs
          rcases hs with ⟨s₀, hs₀, rfl⟩
          obtain ⟨B, rfl⟩ := hnt s₀ hs₀
          exact ⟨oldIdx B, rfl⟩
        · obtain ⟨B, rfl⟩ := hnt s₁ (List.mem_cons_self ..)
          obtain ⟨C, rfl⟩ := hnt s₂ (List.mem_cons_of_mem _ (List.mem_cons_self ..))
          simp only [contractSF, List.length_cons, mapSF, List.length_map] at hle3 ⊢
          refine ⟨by omega, by omega, fun s hs => ?_⟩
          rcases List.mem_cons.mp hs with rfl | hs'
          · exact ⟨pairIdx B C, rfl⟩
          · rcases List.mem_map.mp hs' with ⟨s₀, hs₀, rfl⟩
            obtain ⟨D, rfl⟩ := hnt s₀ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hs₀))
            exact ⟨oldIdx D, rfl⟩
    · dsimp only [G'] at hr
      rw [dif_neg h, List.mem_singleton] at hr
      subst hr
      refine Or.inr ⟨by simp, fun γ hγ => ?_⟩
      simp only [List.append_nil, List.mem_singleton] at hγ
      subst hγ
      refine ⟨by simp, by simp, fun s hs => ?_⟩
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl <;> exact ⟨_, rfl⟩
  · intro i w
    by_cases h : i.1 < k
    · have hXi : X' i = X ⟨i.1, h⟩ := by dsimp only [X']; rw [dif_pos h]
      rw [hXi, hX ⟨i.1, h⟩ w]
      refine and_congr_right fun _ => ?_
      unfold boolCond
      dsimp only [G']
      rw [dif_pos h]
      simp only [List.mem_map]
      constructor
      · rintro ⟨r₀, hr₀, hp₀, hn₀⟩
        refine ⟨contractRule r₀, ⟨r₀, hr₀, rfl⟩, ?_, ?_⟩
        · intro γ hγ
          rcases List.mem_map.mp hγ with ⟨γ₀, hγ₀, rfl⟩
          rw [heval_contract]; exact hp₀ γ₀ hγ₀
        · intro δ hδ
          rcases List.mem_map.mp hδ with ⟨δ₀, hδ₀, rfl⟩
          rw [heval_contract]; exact hn₀ δ₀ hδ₀
      · rintro ⟨_, ⟨r₀, hr₀, rfl⟩, hp, hn⟩
        refine ⟨r₀, hr₀, ?_, ?_⟩
        · intro γ₀ hγ₀
          have := hp (contractSF γ₀) (List.mem_map.mpr ⟨γ₀, hγ₀, rfl⟩)
          rwa [heval_contract] at this
        · intro δ₀ hδ₀
          have := hn (contractSF δ₀) (List.mem_map.mpr ⟨δ₀, hδ₀, rfl⟩)
          rwa [heval_contract] at this
    · have hpos : 0 < k := by
        by_contra hk0
        have hk : k = 0 := by omega
        have hi := i.2
        simp [k', hk] at hi
      have hq : (i.1 - k) / k < k := Nat.div_lt_of_lt_mul (by omega)
      have hXi : X' i = X ⟨(i.1 - k) / k, hq⟩ * X ⟨(i.1 - k) % k, Nat.mod_lt _ hpos⟩ := by
        dsimp only [X']; rw [dif_neg h]
      have hGi : G' i = [([[Sum.inr (oldIdx ⟨(i.1 - k) / k, hq⟩),
          Sum.inr (oldIdx ⟨(i.1 - k) % k, Nat.mod_lt _ hpos⟩)]], [])] := by
        dsimp only [G']; rw [dif_neg h]
      rw [hXi, Language.mem_mul]
      unfold boolCond
      rw [hGi]
      simp only [List.mem_singleton, exists_eq_left, forall_eq, List.not_mem_nil,
        false_implies, forall_const, and_true, mem_evalSF_pair, hX'_old]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩
        refine ⟨?_, u, hu, v, hv, rfl⟩
        intro huv
        exact hX_nil _ ((List.append_eq_nil_iff.mp huv).1 ▸ hu)
      · exact And.right

private lemma bg_binarize_iter {α : Type*} :
    ∀ (M : ℕ) {k : ℕ}
      (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (X : Fin k → Language α),
      (∀ i, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2,
          2 ≤ γ.length ∧ γ.length ≤ M + 2 ∧ ∀ s ∈ γ, ∃ B : Fin k, s = Sum.inr B)) →
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G X i w) →
      ∃ (k' : ℕ) (emb : Fin k → Fin k')
        (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
        (X' : Fin k' → Language α),
        (∀ i, X' (emb i) = X i) ∧
        (∀ i, ∀ r ∈ G' i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
          (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k', γ = [Sum.inr B, Sum.inr C])) ∧
        (∀ i w, w ∈ X' i ↔ w ≠ [] ∧ boolCond G' X' i w)
  | 0, k, G, X, hshape, hX => by
    refine ⟨k, id, G, X, fun _ => rfl, fun i r hr => ?_, hX⟩
    rcases hshape i r hr with hterm | ⟨hpos, hall⟩
    · exact Or.inl hterm
    · refine Or.inr ⟨hpos, fun γ hγ => ?_⟩
      obtain ⟨hge2, hle2, hnt⟩ := hall γ hγ
      rcases γ with _ | ⟨s₁, _ | ⟨s₂, _ | ⟨s₃, rest⟩⟩⟩
      · simp at hge2
      · simp at hge2
      · obtain ⟨B, rfl⟩ := hnt s₁ (List.mem_cons_self ..)
        obtain ⟨C, rfl⟩ := hnt s₂ (List.mem_cons_of_mem _ (List.mem_cons_self ..))
        exact ⟨B, C, rfl⟩
      · simp at hle2
  | M + 1, k, G, X, hshape, hX => by
    obtain ⟨k₁, emb₁, G₁, X₁, hX₁_emb, hshape₁, hX₁⟩ := bg_binarize_step G X hshape hX
    obtain ⟨k₂, emb₂, G₂, X₂, hX₂_emb, hbnf₂, hX₂⟩ := bg_binarize_iter M G₁ X₁ hshape₁ hX₁
    exact ⟨k₂, emb₂ ∘ emb₁, G₂, X₂, fun i => by simp [hX₂_emb, hX₁_emb], hbnf₂, hX₂⟩

end BNFPrivate

/-- **Okhotin Binary Normal Form Theorem (2004):**
Over any finite alphabet `[Fintype α] [DecidableEq α]`, every ε-free acyclic-unit Boolean grammar
`G` with start nonterminal `s` converts to an equivalent Boolean grammar `G'` in exact Okhotin
Binary Normal Form (`A → a` or `A → B₁C₁ & ... & ¬(D₁E₁) & ...` with at least one positive binary
conjunct) generating the exact same language `X' s' = X s`. -/
theorem ppl105_okhotin_bnf {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (s : Fin k)
    (hwf : ∃ rank : Fin k → ℕ, ∀ i : Fin k, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i)
    (X : Fin k → Language α)
    (hX : ∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
      w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) :
    ∃ (k' : ℕ) (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
      (s' : Fin k') (X' : Fin k' → Language α),
      (∀ i : Fin k', ∀ r ∈ G' i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k', γ = [Sum.inr B, Sum.inr C])) ∧
      (∀ i : Fin k', ∀ w : List α, w ∈ X' i ↔
        w ≠ [] ∧ ∃ r ∈ G' i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X')).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X')).prod)) ∧
      X' s' = X s := by
  classical
  rcases hwf with ⟨rank, hwf⟩
  obtain ⟨G₁, hnu₁, hX₁⟩ := bg_elim_unit G rank hwf X hX
  obtain ⟨k₂, emb₂, G₂, X₂, hX₂_emb, hshape₂, hX₂⟩ := bg_sep_len_one G₁ hnu₁ X hX₁
  let maxLen : ℕ :=
    (Finset.univ : Finset (Fin k₂)).sup (fun i =>
      (G₂ i).foldr (fun r acc => max acc ((r.1 ++ r.2).foldr (fun γ a => max a γ.length) 0)) 0)
  have hle_max : ∀ i : Fin k₂, ∀ r ∈ G₂ i, ∀ γ ∈ r.1 ++ r.2, γ.length ≤ maxLen := by
    intro i r hr γ hγ
    have hfold_γ : ∀ l : List (List (α ⊕ Fin k₂)), ∀ c ∈ l,
        c.length ≤ l.foldr (fun x a => max a x.length) 0 := by
      intro l
      induction l with
      | nil => intro c hc; simp at hc
      | cons hd tl ih =>
        intro c hc
        rcases List.mem_cons.mp hc with rfl | htl
        · exact le_max_right _ _
        · exact le_trans (ih c htl) (le_max_left _ _)
    have hfold_r : ∀ rs : List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))),
        ∀ r₀ ∈ rs, ((r₀.1 ++ r₀.2).foldr (fun x a => max a x.length) 0) ≤
          rs.foldr (fun r₁ acc => max acc ((r₁.1 ++ r₁.2).foldr (fun x a => max a x.length) 0)) 0 := by
      intro rs
      induction rs with
      | nil => intro r₀ hr₀; simp at hr₀
      | cons hd tl ih =>
        intro r₀ hr₀
        rcases List.mem_cons.mp hr₀ with rfl | htl
        · exact le_max_right _ _
        · exact le_trans (ih r₀ htl) (le_max_left _ _)
    have h1 := hfold_γ (r.1 ++ r.2) γ hγ
    have h2 := hfold_r (G₂ i) r hr
    have h3 := Finset.le_sup (f := fun i : Fin k₂ =>
      (G₂ i).foldr (fun r acc => max acc ((r.1 ++ r.2).foldr (fun γ a => max a γ.length) 0)) 0)
      (Finset.mem_univ i)
    omega
  have hshape_M : ∀ i, ∀ r ∈ G₂ i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
      (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2,
        2 ≤ γ.length ∧ γ.length ≤ maxLen + 2 ∧ ∀ sym ∈ γ, ∃ B : Fin k₂, sym = Sum.inr B) := by
    intro i r hr
    rcases hshape₂ i r hr with hterm | ⟨hpos, hall⟩
    · exact Or.inl hterm
    · refine Or.inr ⟨hpos, fun γ hγ => ?_⟩
      obtain ⟨h2, hnt⟩ := hall γ hγ
      exact ⟨h2, le_trans (hle_max i r hr γ hγ) (by omega), hnt⟩
  obtain ⟨k', emb', G', X', hX'_emb, hbnf', hX'⟩ := bg_binarize_iter maxLen G₂ X₂ hshape_M hX₂
  exact ⟨k', G', emb' (emb₂ s), X', hbnf', hX', by rw [hX'_emb, hX₂_emb]⟩

section CYKPrivate

private def cykCheckBin {α : Type*} {k L : ℕ}
    (prev : Fin (L + 1) → ℕ → Fin k → Bool) (l : ℕ) : List (α ⊕ Fin k) → Bool
  | [Sum.inr B, Sum.inr C] =>
      (List.range L).any (fun t =>
        if h : t < L then
          prev ⟨t + 1, by omega⟩ l B && prev ⟨L - t, by omega⟩ (l + (t + 1)) C
        else false)
  | _ => false

private def cykMemo {α : Type*} [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (w : List α) : (L : ℕ) → Fin (L + 1) → ℕ → Fin k → Bool
  | 0 => fun _ _ _ => false
  | L + 1 =>
      let prev := cykMemo G w L
      fun len l i =>
        if h : len.1 ≤ L then prev ⟨len.1, Nat.lt_succ_of_le h⟩ l i
        else if L = 0 then
          match w[l]? with
          | none => false
          | some a => (G i).any (fun r => decide (r = ([[Sum.inl a]], [])))
        else
          (G i).any (fun r =>
            decide (r.1 ≠ []) &&
            r.1.all (cykCheckBin prev l) &&
            r.2.all (fun δ => !(cykCheckBin prev l δ)))

private lemma subword_split {α : Type*} (w : List α) (l len t : ℕ)
    (ht2 : t < len) :
    (w.drop l).take t ++ (w.drop (l + t)).take (len - t) = (w.drop l).take len := by
  have htake : ((w.drop l).take len).take t = (w.drop l).take t := by
    rw [List.take_take, Nat.min_eq_left (le_of_lt ht2)]
  have hdrop : ((w.drop l).take len).drop t = (w.drop (l + t)).take (len - t) := by
    rw [List.drop_take, List.drop_drop]
  rw [← htake, ← hdrop, List.take_append_drop]

private lemma cykMemo_sound_complete {α : Type*} [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (hbnf : ∀ i : Fin k, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
      (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C]))
    (X : Fin k → Language α)
    (hX : ∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G X i w)
    (w : List α) :
    ∀ (L : ℕ) (len : Fin (L + 1)) (l : ℕ), l + len.1 ≤ w.length → ∀ i : Fin k,
      cykMemo G w L len l i = true ↔ (w.drop l).take len.1 ∈ X i := by
  intro L
  induction L with
  | zero =>
    intro len l _ i
    have h0 : len.1 = 0 := by omega
    rw [h0]
    simp only [cykMemo, Bool.false_eq_true, List.take_zero, false_iff]
    intro hmem
    exact ((hX i []).mp hmem).1 rfl
  | succ L ih =>
    intro len l hbound i
    dsimp only [cykMemo]
    by_cases hle : len.1 ≤ L
    · rw [dif_pos hle]
      exact ih ⟨len.1, Nat.lt_succ_of_le hle⟩ l hbound i
    · rw [dif_neg hle]
      have hlen_eq : len.1 = L + 1 := by omega
      have hX_nil : ∀ j, ([] : List α) ∉ X j := fun j hj => ((hX j []).mp hj).1 rfl
      have hsub_len : ((w.drop l).take (L + 1)).length = L + 1 := by
        rw [List.length_take, List.length_drop]; omega
      have hsub_ne : (w.drop l).take (L + 1) ≠ [] := by
        intro h0; have := congrArg List.length h0; rw [hsub_len] at this; simp at this
      by_cases hL0 : L = 0
      · subst hL0
        rw [if_pos rfl, hlen_eq]
        have hl_lt : l < w.length := by omega
        have hget : w[l]? = some (w[l]'hl_lt) := List.getElem?_eq_getElem hl_lt
        have htake1 : (w.drop l).take 1 = [w[l]'hl_lt] := by
          have h1 : w.drop l = (w[l]'hl_lt) :: w.drop (l + 1) := List.drop_eq_getElem_cons hl_lt
          rw [h1]; rfl
        rw [hget, htake1, hX i [w[l]'hl_lt]]
        simp only [List.any_eq_true, decide_eq_true_eq, ne_eq, List.cons_ne_self,
          not_false_eq_true, true_and, boolCond]
        constructor
        · rintro ⟨r, hr, rfl⟩
          exact ⟨([[Sum.inl (w[l]'hl_lt)]], []), hr,
            fun γ hγ => by simp at hγ; subst hγ; exact (mem_evalSF_singleton_inl X _ _).mpr rfl,
            by simp⟩
        · rintro ⟨r, hr, hp, _⟩
          rcases hbnf i r hr with ⟨a, rfl⟩ | ⟨hpos, hbin⟩
          · have ha := (mem_evalSF_singleton_inl X a _).mp (hp [Sum.inl a] (List.mem_singleton_self _))
            have : a = w[l]'hl_lt := (List.cons.inj ha).1.symm
            subst this
            exact ⟨([[Sum.inl (w[l]'hl_lt)]], []), hr, rfl⟩
          · rcases List.exists_mem_of_ne_nil r.1 hpos with ⟨γ, hγ⟩
            obtain ⟨B, C, rfl⟩ := hbin γ (List.mem_append_left _ hγ)
            rcases (mem_evalSF_pair X B C _).mp (hp [Sum.inr B, Sum.inr C] hγ) with ⟨u, hu, v, hv, huv⟩
            have hu1 : 1 ≤ u.length := List.length_pos_of_ne_nil (fun h => hX_nil B (h ▸ hu))
            have hv1 : 1 ≤ v.length := List.length_pos_of_ne_nil (fun h => hX_nil C (h ▸ hv))
            have hlen := congrArg List.length huv
            simp only [List.length_append, List.length_singleton] at hlen
            omega
      · rw [if_neg hL0, hlen_eq, hX i ((w.drop l).take (L + 1)), and_iff_right hsub_ne]
        have hLpos : 1 ≤ L := Nat.pos_of_ne_zero hL0
        have hbin_iff : ∀ B C : Fin k,
            cykCheckBin (α := α) (cykMemo G w L) l [Sum.inr B, Sum.inr C] = true ↔
              (w.drop l).take (L + 1) ∈ evalSF X [Sum.inr B, Sum.inr C] := by
          intro B C
          rw [mem_evalSF_pair]
          simp only [cykCheckBin, List.any_eq_true, List.mem_range]
          constructor
          · rintro ⟨t, ht, hcheck⟩
            rw [dif_pos ht, Bool.and_eq_true] at hcheck
            have hu := (ih ⟨t + 1, by omega⟩ l (by dsimp; omega) B).mp hcheck.1
            have hv := (ih ⟨L - t, by omega⟩ (l + (t + 1)) (by dsimp; omega) C).mp hcheck.2
            have hsp := subword_split w l (L + 1) (t + 1) (by omega)
            have hsubeq : L + 1 - (t + 1) = L - t := by omega
            rw [hsubeq] at hsp
            exact ⟨(w.drop l).take (t + 1), hu, (w.drop (l + (t + 1))).take (L - t), hv, hsp⟩
          · rintro ⟨u, hu, v, hv, huv⟩
            have hu1 : 1 ≤ u.length := List.length_pos_of_ne_nil (fun h => hX_nil B (h ▸ hu))
            have hv1 : 1 ≤ v.length := List.length_pos_of_ne_nil (fun h => hX_nil C (h ▸ hv))
            have hlen_uv : u.length + v.length = L + 1 := by
              have := congrArg List.length huv
              rwa [List.length_append, hsub_len] at this
            let t := u.length - 1
            have ht : t < L := by omega
            have hu_eq : u = (w.drop l).take (t + 1) := by
              have h1 : (u ++ v).take u.length = u := List.take_left
              rw [huv, List.take_take, Nat.min_eq_left (by omega)] at h1
              have ht1 : t + 1 = u.length := by omega
              rw [ht1]; exact h1.symm
            have hv_eq : v = (w.drop (l + (t + 1))).take (L - t) := by
              have h1 : (u ++ v).drop u.length = v := List.drop_left
              rw [huv, List.drop_take, List.drop_drop] at h1
              have ht1 : t + 1 = u.length := by omega
              have ht2 : L - t = L + 1 - u.length := by omega
              rw [ht1, ht2]; exact h1.symm
            refine ⟨t, ht, ?_⟩
            rw [dif_pos ht, Bool.and_eq_true]
            exact ⟨(ih ⟨t + 1, by omega⟩ l (by dsimp; omega) B).mpr (hu_eq ▸ hu),
              (ih ⟨L - t, by omega⟩ (l + (t + 1)) (by dsimp; omega) C).mpr (hv_eq ▸ hv)⟩
        unfold boolCond
        simp only [List.any_eq_true, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true,
          Bool.not_eq_true']
        refine exists_congr fun r => and_congr_right fun hr => ?_
        rcases hbnf i r hr with ⟨a, rfl⟩ | ⟨hpos, hbin⟩
        · constructor
          · rintro ⟨⟨_, hp⟩, _⟩
            have h := hp [Sum.inl a] (List.mem_singleton_self _)
            exact (Bool.false_ne_true h).elim
          · rintro ⟨hp, _⟩
            have h := (mem_evalSF_singleton_inl X a _).mp (hp [Sum.inl a] (List.mem_singleton_self _))
            have hlen := congrArg List.length h
            rw [hsub_len, List.length_singleton] at hlen
            omega
        · constructor
          · rintro ⟨⟨_, hp⟩, hn⟩
            refine ⟨?_, ?_⟩
            · intro γ hγ
              obtain ⟨B, C, rfl⟩ := hbin γ (List.mem_append_left _ hγ)
              exact (hbin_iff B C).mp (hp [Sum.inr B, Sum.inr C] hγ)
            · intro δ hδ
              obtain ⟨B, C, rfl⟩ := hbin δ (List.mem_append_right _ hδ)
              have hfalse := hn [Sum.inr B, Sum.inr C] hδ
              exact fun hm => Bool.false_ne_true (hfalse.symm.trans ((hbin_iff B C).mpr hm))
          · rintro ⟨hp, hn⟩
            refine ⟨⟨hpos, ?_⟩, ?_⟩
            · intro γ hγ
              obtain ⟨B, C, rfl⟩ := hbin γ (List.mem_append_left _ hγ)
              exact (hbin_iff B C).mpr (hp [Sum.inr B, Sum.inr C] hγ)
            · intro δ hδ
              obtain ⟨B, C, rfl⟩ := hbin δ (List.mem_append_right _ hδ)
              exact Bool.eq_false_iff.mpr fun ht => hn [Sum.inr B, Sum.inr C] hδ ((hbin_iff B C).mp ht)

end CYKPrivate

/-- **Computable Bottom-Up `O(n^3)` CYK Membership for Okhotin BNF Boolean Grammars.**
For every BNF Boolean grammar `G` over `[DecidableEq α]` with solution `X`:
1. There exists a computable Boolean decision procedure `f : List α → Fin k → Bool` (implemented
   by the bottom-up DP table `cykMemo`) satisfying `∀ w i, f w i = true ↔ w ∈ X i`; and
2. The exact number of bottom-up binary split checks `(len, l, t)` (`2 ≤ len ≤ n`, `0 ≤ l ≤ n - len`,
   `1 ≤ t < len`) on an input of length `n` equals `n * (n - 1) * (n + 1) / 6 ≤ n ^ 3`. -/
theorem ppl105_bnf_cyk_decidable_and_cubic {α : Type*} [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (hbnf : ∀ i : Fin k, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
      (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C]))
    (X : Fin k → Language α)
    (hX : ∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
      w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) :
    (∃ f : List α → Fin k → Bool, ∀ w : List α, ∀ i : Fin k, f w i = true ↔ w ∈ X i) ∧
    (∀ n : ℕ, 6 * (∑ len ∈ Finset.Icc 2 n, (n - len + 1) * (len - 1)) =
      n * (n - 1) * (n + 1) ∧
      (∑ len ∈ Finset.Icc 2 n, (n - len + 1) * (len - 1)) ≤ n ^ 3) := by
  constructor
  · refine ⟨fun w i => cykMemo G w w.length ⟨w.length, Nat.lt_succ_self _⟩ 0 i, fun w i => ?_⟩
    have h := cykMemo_sound_complete G hbnf X hX w w.length ⟨w.length, Nat.lt_succ_self _⟩ 0 (by simp) i
    simpa using h
  · intro n
    have hsum : 6 * (∑ len ∈ Finset.Icc 2 n, (n - len + 1) * (len - 1)) =
        n * (n - 1) * (n + 1) := by
      induction n with
      | zero => simp
      | succ n ih =>
        cases n with
        | zero => simp
        | succ m =>
          have hIcc : Finset.Icc 2 (m + 2) = insert (m + 2) (Finset.Icc 2 (m + 1)) := by
            ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
          rw [hIcc, Finset.sum_insert (by simp)]
          have hdiff : ∑ len ∈ Finset.Icc 2 (m + 1), (m + 2 - len + 1) * (len - 1) =
              (∑ len ∈ Finset.Icc 2 (m + 1), (m + 1 - len + 1) * (len - 1)) +
              (∑ len ∈ Finset.Icc 2 (m + 1), (len - 1)) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun x hx => ?_
            rw [Finset.mem_Icc] at hx
            have : m + 2 - x + 1 = (m + 1 - x + 1) + 1 := by omega
            rw [this, add_mul, one_mul]
          have hlin : 2 * (∑ len ∈ Finset.Icc 2 (m + 1), (len - 1)) = m * (m + 1) := by
            clear ih hdiff hIcc
            induction m with
            | zero => simp
            | succ k ihk =>
              have hI : Finset.Icc 2 (k + 2) = insert (k + 2) (Finset.Icc 2 (k + 1)) := by
                ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
              rw [hI, Finset.sum_insert (by simp), mul_add, ihk]
              have : k + 2 - 1 = k + 1 := by omega
              rw [this]; ring
          rw [hdiff, mul_add, mul_add, ih]
          have h3 : 6 * (∑ len ∈ Finset.Icc 2 (m + 1), (len - 1)) = 3 * (m * (m + 1)) := by
            omega
          rw [h3]
          have h1 : m + 2 - (m + 2) + 1 = 1 := by omega
          have h2 : m + 2 - 1 = m + 1 := by omega
          have h4 : m + 1 - 1 = m := by omega
          rw [h1, h2, h4]
          ring
    refine ⟨hsum, ?_⟩
    have hle : n * (n - 1) * (n + 1) ≤ 6 * n ^ 3 := by
      cases n with
      | zero => simp
      | succ m =>
        have h1 : (m + 1) * m * (m + 2) ≤ (m + 1) * (m + 1) * (2 * (m + 1)) := by
          gcongr <;> omega
        have h2 : (m + 1) * (m + 1) * (2 * (m + 1)) ≤ 6 * (m + 1) ^ 3 := by
          have : (m + 1) * (m + 1) * (2 * (m + 1)) = 2 * (m + 1) ^ 3 := by ring
          omega
        simpa using le_trans h1 h2
    omega

/-- **Decidability of All ε-Free Acyclic-Unit Boolean Grammars:**
Every language generated by an ε-free acyclic-unit Boolean grammar over a finite decidable alphabet
admits a `DecidablePred` membership predicate (via Okhotin BNF + CYK). -/
theorem ppl105_boolean_grammar_decidable {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (s : Fin k)
    (hwf : ∃ rank : Fin k → ℕ, ∀ i : Fin k, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i)
    (X : Fin k → Language α)
    (hX : ∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
      w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) :
    Nonempty (DecidablePred (· ∈ X s)) := by
  obtain ⟨k', G', s', X', hbnf, hX', heq⟩ := ppl105_okhotin_bnf G s hwf X hX
  obtain ⟨⟨f, hf⟩, _⟩ := ppl105_bnf_cyk_decidable_and_cubic G' hbnf X' hX'
  refine ⟨fun w => decidable_of_iff (f w s' = true) ?_⟩
  rw [hf w s', heq]

/-! ## Section 4: Greibach Normal Form Frontier (PPL 105) -/

/-- **Exact Suffix-Code Distributivity Law:**
Whenever `M : Language α` is a suffix code (in particular, any singleton `{v}` or fixed-length
language), right-concatenation by `M` distributes **exactly** over both intersection and
ε-free complementation. -/
theorem ppl105_suffix_code_distributivity {α : Type*} (L₁ L₂ M : Language α)
    (hsuf : ∀ u₁ v₁ u₂ v₂ : List α, v₁ ∈ M → v₂ ∈ M → u₁ ++ v₁ = u₂ ++ v₂ → u₁ = u₂ ∧ v₁ = v₂) :
    let Lne : Language α := {w : List α | w ≠ []}
    (L₁ ⊓ L₂) * M = (L₁ * M) ⊓ (L₂ * M) ∧
    (Lne \ L₁) * M = (Lne * M) \ (L₁ * M) := by
  intro Lne
  constructor
  · ext w
    rw [Language.mem_mul, mem_inf_lang, Language.mem_mul, Language.mem_mul]
    constructor
    · rintro ⟨u, ⟨hu₁, hu₂⟩, v, hv, rfl⟩
      exact ⟨⟨u, hu₁, v, hv, rfl⟩, ⟨u, hu₂, v, hv, rfl⟩⟩
    · rintro ⟨⟨u₁, hu₁, v₁, hv₁, h₁⟩, ⟨u₂, hu₂, v₂, hv₂, h₂⟩⟩
      obtain ⟨rfl, rfl⟩ := hsuf u₁ v₁ u₂ v₂ hv₁ hv₂ (h₁.trans h₂.symm)
      exact ⟨u₁, ⟨hu₁, hu₂⟩, v₁, hv₁, h₁⟩
  · ext w
    rw [Language.mem_mul, mem_sdiff_lang, Language.mem_mul, Language.mem_mul]
    constructor
    · rintro ⟨u, ⟨hu_ne, hu_not⟩, v, hv, rfl⟩
      refine ⟨⟨u, hu_ne, v, hv, rfl⟩, ?_⟩
      rintro ⟨u', hu', v', hv', heq⟩
      obtain ⟨rfl, _⟩ := hsuf u' v' u v hv' hv heq
      exact hu_not hu'
    · rintro ⟨⟨u, hu_ne, v, hv, rfl⟩, hnot⟩
      refine ⟨u, ⟨hu_ne, ?_⟩, v, hv, rfl⟩
      intro hu₁
      exact hnot ⟨u, hu₁, v, hv, rfl⟩

/-- **Algebraic Non-Distributivity Barrier Blocking General CFG Left-Corner Unfolding (PPL 105):**
Unlike union `(L₁ ⊔ L₂) * M = (L₁ * M) ⊔ (L₂ * M)` (which powers Greibach's CFG algorithm),
concatenation distributes over **neither** intersection **nor** complementation in general. -/
theorem ppl105_concat_non_distributivity_barrier :
    let Lne : Language (Fin 3) := {w : List (Fin 3) | w ≠ []}
    ∃ L₁ L₂ M : Language (Fin 3),
      (L₁ ⊓ L₂) * M ≠ (L₁ * M) ⊓ (L₂ * M) ∧
      (Lne \ L₁) * M ≠ Lne \ (L₁ * M) := by
  intro Lne
  let L₁ : Language (Fin 3) := {[0]}
  let L₂ : Language (Fin 3) := {[0, 1]}
  let M : Language (Fin 3) := ({[1, 2]} : Language (Fin 3)) ⊔ {[2]}
  refine ⟨L₁, L₂, M, ?_, ?_⟩
  · intro heq
    have hmem : ([0, 1, 2] : List (Fin 3)) ∈ (L₁ * M) ⊓ (L₂ * M) := by
      rw [mem_inf_lang, Language.mem_mul, Language.mem_mul]
      refine ⟨⟨[0], rfl, [1, 2], Or.inl rfl, rfl⟩, ⟨[0, 1], rfl, [2], Or.inr rfl, rfl⟩⟩
    rw [← heq, Language.mem_mul] at hmem
    rcases hmem with ⟨u, ⟨hu₁, hu₂⟩, _, _, _⟩
    have h1 : u = [0] := hu₁
    have h2 : u = [0, 1] := hu₂
    rw [h1] at h2
    simp at h2
  · intro heq
    have hmem : ([2] : List (Fin 3)) ∈ Lne \ (L₁ * M) := by
      rw [mem_sdiff_lang]
      refine ⟨by change ([2] : List (Fin 3)) ≠ []; simp, fun h => ?_⟩
      rcases Language.mem_mul.mp h with ⟨u, hu, v, hv, huv⟩
      have hu' : u = [0] := hu
      subst hu'
      have hlen := congrArg List.length huv
      rcases hv with rfl | rfl <;> simp at hlen
    rw [← heq] at hmem
    rcases Language.mem_mul.mp hmem with ⟨u, ⟨hu_ne, _⟩, v, hv, huv⟩
    have hu1 : 1 ≤ u.length := List.length_pos_of_ne_nil hu_ne
    have hlen := congrArg List.length huv
    rcases hv with rfl | rfl <;> simp only [List.length_append, List.length_cons, List.length_nil] at hlen <;> omega

/-- **Non-Monotonic Left-Recursion Barrier (PPL 105):**
For the 1-nonterminal left-recursive Boolean grammar `A → () | ¬(A ())` over `Unit`, the
one-step operator `Φ` is **antitone** and **strictly non-monotone** (breaking Knaster–Tarski
and Arden's Lemma `X = X R ⊔ S ⇒ X = S R*`), yet the equation admits a unique ε-free solution:
the parity-alternating language `{w : List Unit | Odd w.length}`. -/
theorem ppl105_nonmonotonic_left_recursion_barrier :
    let G : Fin 1 → List (List (List (Unit ⊕ Fin 1)) × List (List (Unit ⊕ Fin 1))) :=
      fun _ => [([[Sum.inl ()]], []), ([], [[Sum.inr 0, Sum.inl ()]])]
    let Φ : Language Unit → Language Unit :=
      fun X => ({[()]} : Language Unit) ⊔ (({w : List Unit | w ≠ []} : Language Unit) \ (X * {[()]}))
    (∀ X Y : Language Unit, X ≤ Y → Φ Y ≤ Φ X) ∧
    (∃ X Y : Language Unit, X ≤ Y ∧ ¬ (Φ X ≤ Φ Y)) ∧
    (∃! X : Fin 1 → Language Unit,
      ∀ i : Fin 1, ∀ w : List Unit, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language Unit)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language Unit)) X)).prod)) ∧
    (∀ X : Fin 1 → Language Unit,
      (∀ i : Fin 1, ∀ w : List Unit, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language Unit)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language Unit)) X)).prod)) →
      X 0 = ({w : List Unit | Odd w.length} : Language Unit)) := by
  intro G Φ
  have hanti : ∀ X Y : Language Unit, X ≤ Y → Φ Y ≤ Φ X := by
    intro X Y hXY w hw
    rcases hw with h1 | ⟨hne, hnot⟩
    · exact Or.inl h1
    · refine Or.inr ⟨hne, fun hX => hnot ?_⟩
      rcases Language.mem_mul.mp hX with ⟨u, hu, v, hv, rfl⟩
      exact Language.mem_mul.mpr ⟨u, hXY hu, v, hv, rfl⟩
  have hnonmono : ∃ X Y : Language Unit, X ≤ Y ∧ ¬ (Φ X ≤ Φ Y) := by
    refine ⟨⊥, {[()]}, bot_le, fun hle => ?_⟩
    have hmem : [(), ()] ∈ Φ ⊥ := by
      right
      refine ⟨by simp, fun h => ?_⟩
      rcases Language.mem_mul.mp h with ⟨u, hu, _, _, _⟩
      exact (mem_bot_lang u).mp hu
    rcases hle hmem with h1 | ⟨_, hnot⟩
    · have : [(), ()] = [()] := h1; simp at this
    · exact hnot (Language.mem_mul.mpr ⟨[()], rfl, [()], rfl, rfl⟩)
  have hwf : ∃ rank : Fin 1 → ℕ, ∀ i : Fin 1, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
      γ ≠ [] ∧ ∀ j : Fin 1, γ = [Sum.inr j] → rank j < rank i := by
    refine ⟨fun _ => 0, fun i r hr γ hγ => ?_⟩
    simp only [G, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl
    · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
      exact ⟨by simp, fun j hj => by simp at hj⟩
    · simp only [List.nil_append, List.mem_singleton] at hγ; subst hγ
      exact ⟨by simp, fun j hj => by simp at hj⟩
  let Xodd : Fin 1 → Language Unit := fun _ => ({w : List Unit | Odd w.length} : Language Unit)
  have hodd_sol : ∀ i : Fin 1, ∀ w : List Unit,
      w ∈ Xodd i ↔ w ≠ [] ∧ boolCond G Xodd i w := by
    intro i w
    fin_cases i
    change Odd w.length ↔ _
    unfold boolCond
    simp only [G, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp, exists_eq_left,
      forall_eq, false_implies, forall_const, and_true, true_and]
    have hmul : w ∈ evalSF Xodd [Sum.inr 0, Sum.inl ()] ↔ ∃ n, w.length = n + 1 ∧ Odd n := by
      simp only [evalSF, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        Language.mem_mul]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩
        have hv' : v = [()] := hv
        subst hv'
        exact ⟨u.length, by simp, hu⟩
      · rintro ⟨n, hlen, hodd⟩
        refine ⟨w.take n, ?_, [()], rfl, ?_⟩
        · change Odd (w.take n).length
          rw [List.length_take, Nat.min_eq_left (by omega)]
          exact hodd
        · have hlast : w.drop n = [()] := by
            have hdl : (w.drop n).length = 1 := by rw [List.length_drop]; omega
            rcases h : w.drop n with _ | ⟨a, _ | ⟨b, tl⟩⟩
            · simp [h] at hdl
            · cases a; rfl
            · simp [h] at hdl
          rw [← hlast, List.take_append_drop]
    rw [mem_evalSF_singleton_inl, hmul]
    constructor
    · intro hodd
      have hne : w ≠ [] := fun h => by subst h; simp at hodd
      refine ⟨hne, ?_⟩
      cases hlen : w.length with
      | zero => exact (hne (List.eq_nil_of_length_eq_zero hlen)).elim
      | succ m =>
        cases m with
        | zero =>
          left
          rcases w with _ | ⟨a, _ | ⟨b, tl⟩⟩
          · simp at hlen
          · cases a; rfl
          · simp at hlen
        | succ m' =>
          right
          rintro ⟨n, hn, hn_odd⟩
          have heq : n = m' + 1 := by omega
          subst heq
          rw [hlen] at hodd
          rcases hodd with ⟨k₁, hk₁⟩
          rcases hn_odd with ⟨k₂, hk₂⟩
          omega
    · rintro ⟨hne, rfl | hnot⟩
      · exact ⟨0, by simp⟩
      · cases hlen : w.length with
        | zero => exact (hne (List.eq_nil_of_length_eq_zero hlen)).elim
        | succ m =>
          by_contra hnot_odd
          have heven : Even (m + 1) := Nat.not_odd_iff_even.mp (hlen ▸ hnot_odd)
          rcases heven with ⟨r, hr⟩
          have hm_odd : Odd m := ⟨r - 1, by omega⟩
          exact hnot ⟨m, hlen, hm_odd⟩
  refine ⟨hanti, hnonmono, ppl105_boolean_grammar_unique_solution G hwf, fun X hX => ?_⟩
  obtain ⟨Z, _, hZuniq⟩ := ppl105_boolean_grammar_unique_solution G hwf
  have h1 : X = Z := hZuniq X hX
  have h2 : (fun _ : Fin 1 => ({w : List Unit | Odd w.length} : Language Unit)) = Z :=
    hZuniq _ hodd_sol
  have h3 : X = fun _ => ({w : List Unit | Odd w.length} : Language Unit) := h1.trans h2.symm
  exact congrFun h3 0

section GNFPrivate

/-- Convert any leading-terminal Boolean grammar (where every conjunct starts with `Sum.inl a`,
possibly followed by mixed terminals/nonterminals) into strict Greibach Normal Form
(`Sum.inl a :: β.map Sum.inr`) by adding `|α|` terminal-wrapper nonterminals `T_a → a`. -/
private lemma leading_term_to_strict_gnf {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X : Fin k → Language α)
    (hlead : ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, ∃ (a : α) (rest : List (α ⊕ Fin k)), γ = Sum.inl a :: rest)
    (hX : ∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G X i w) :
    ∃ (k' : ℕ) (emb : Fin k → Fin k')
      (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
      (X' : Fin k' → Language α),
      (∀ i, X' (emb i) = X i) ∧
      (∀ i, ∀ r ∈ G' i, ∀ γ ∈ r.1 ++ r.2,
        ∃ (a : α) (β : List (Fin k')), γ = Sum.inl a :: β.map Sum.inr) ∧
      (∀ i w, w ∈ X' i ↔ w ≠ [] ∧ boolCond G' X' i w) := by
  let m := Fintype.card α
  let e : α ≃ Fin m := Fintype.equivFin α
  let k' := k + m
  let origIdx : Fin k → Fin k' := fun i => ⟨i.1, by omega⟩
  let termIdx : α → Fin k' := fun a => ⟨k + (e a).1, by omega⟩
  let tailNT : α ⊕ Fin k → Fin k' := Sum.elim termIdx origIdx
  let convSF : List (α ⊕ Fin k) → List (α ⊕ Fin k')
    | [] => []
    | Sum.inl a :: rest => Sum.inl a :: (rest.map tailNT).map Sum.inr
    | Sum.inr j :: rest => Sum.inr (origIdx j) :: (rest.map tailNT).map Sum.inr
  let convRule : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)) →
      List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k')) := fun r =>
    (r.1.map convSF, r.2.map convSF)
  let X' : Fin k' → Language α := fun i =>
    if h : i.1 < k then X ⟨i.1, h⟩
    else ({[e.symm ⟨i.1 - k, by omega⟩]} : Language α)
  have hX'_orig : ∀ i : Fin k, X' (origIdx i) = X i := by
    intro i; dsimp only [X', origIdx]; rw [dif_pos i.2]
  have hX'_term : ∀ a : α, X' (termIdx a) = ({[a]} : Language α) := by
    intro a; dsimp only [X', termIdx]; rw [dif_neg (by omega)]
    have hsub : (⟨k + (e a).1 - k, by omega⟩ : Fin m) = e a := Fin.ext (by dsimp; omega)
    rw [hsub, Equiv.symm_apply_apply]
  have heval_tail : ∀ rest : List (α ⊕ Fin k),
      evalSF X' ((rest.map tailNT).map Sum.inr) = evalSF X rest := by
    intro rest
    simp only [evalSF, List.map_map]
    congr 1
    refine List.map_congr_left fun s _ => ?_
    cases s with
    | inl a => simp [tailNT, hX'_term]
    | inr j => simp [tailNT, hX'_orig]
  have heval_conv : ∀ γ : List (α ⊕ Fin k), evalSF X' (convSF γ) = evalSF X γ := by
    intro γ
    cases γ with
    | nil => rfl
    | cons s rest =>
      cases s with
      | inl a =>
        simp only [convSF, evalSF_cons, Sum.elim_inl, heval_tail]
      | inr j =>
        simp only [convSF, evalSF_cons, Sum.elim_inr, hX'_orig, heval_tail]
  let G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))) := fun i =>
    if h : i.1 < k then (G ⟨i.1, h⟩).map convRule
    else [([[Sum.inl (e.symm ⟨i.1 - k, by omega⟩)]], [])]
  refine ⟨k', origIdx, G', X', hX'_orig, ?_, ?_⟩
  · intro i r hr γ hγ
    by_cases h : i.1 < k
    · dsimp only [G'] at hr
      rw [dif_pos h, List.mem_map] at hr
      rcases hr with ⟨r₀, hr₀, rfl⟩
      simp only [convRule, ← List.map_append, List.mem_map] at hγ
      rcases hγ with ⟨γ₀, hγ₀, rfl⟩
      obtain ⟨a, rest, rfl⟩ := hlead ⟨i.1, h⟩ r₀ hr₀ γ₀ hγ₀
      exact ⟨a, rest.map tailNT, rfl⟩
    · dsimp only [G'] at hr
      rw [dif_neg h, List.mem_singleton] at hr
      subst hr
      simp only [List.append_nil, List.mem_singleton] at hγ
      subst hγ
      exact ⟨e.symm ⟨i.1 - k, by omega⟩, [], rfl⟩
  · intro i w
    by_cases h : i.1 < k
    · have hXi : X' i = X ⟨i.1, h⟩ := by dsimp only [X']; rw [dif_pos h]
      rw [hXi, hX ⟨i.1, h⟩ w]
      refine and_congr_right fun _ => ?_
      unfold boolCond
      dsimp only [G']
      rw [dif_pos h]
      simp only [List.mem_map]
      constructor
      · rintro ⟨r₀, hr₀, hp₀, hn₀⟩
        refine ⟨convRule r₀, ⟨r₀, hr₀, rfl⟩, ?_, ?_⟩
        · intro γ hγ
          rcases List.mem_map.mp hγ with ⟨γ₀, hγ₀, rfl⟩
          rw [heval_conv]; exact hp₀ γ₀ hγ₀
        · intro δ hδ
          rcases List.mem_map.mp hδ with ⟨δ₀, hδ₀, rfl⟩
          rw [heval_conv]; exact hn₀ δ₀ hδ₀
      · rintro ⟨_, ⟨r₀, hr₀, rfl⟩, hp, hn⟩
        refine ⟨r₀, hr₀, ?_, ?_⟩
        · intro γ₀ hγ₀
          have := hp (convSF γ₀) (List.mem_map.mpr ⟨γ₀, hγ₀, rfl⟩)
          rwa [heval_conv] at this
        · intro δ₀ hδ₀
          have := hn (convSF δ₀) (List.mem_map.mpr ⟨δ₀, hδ₀, rfl⟩)
          rwa [heval_conv] at this
    · have hXi : X' i = ({[e.symm ⟨i.1 - k, by omega⟩]} : Language α) := by
        dsimp only [X']; rw [dif_neg h]
      rw [hXi, mem_singleton_lang]
      unfold boolCond
      dsimp only [G']
      rw [dif_neg h]
      simp only [List.mem_singleton, exists_eq_left, forall_eq, List.not_mem_nil,
        false_implies, forall_const, and_true, mem_evalSF_singleton_inl]
      constructor
      · rintro rfl; exact ⟨by simp, rfl⟩
      · exact And.right

end GNFPrivate

/-- **Positive GNF Theorem for Stratified Boolean Grammars (PPL 105):**
If an ε-free Boolean grammar `G` over a finite alphabet `[Fintype α] [DecidableEq α]` has a
purely disjunctive GNF stratum `isCF : Fin k → Bool` such that every left-corner nonterminal in
every (positive OR negative!) conjunct belongs to `isCF`, then `G` converts constructively to
exact **Greibach Normal Form** (`γ = Sum.inl a :: β.map Sum.inr`) preserving `X s`. -/
theorem ppl105_stratified_cf_left_corner_gnf {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (s : Fin k)
    (isCF : Fin k → Bool)
    (hCF : ∀ j : Fin k, isCF j = true → ∀ r ∈ G j,
      r.2 = [] ∧ ∃ (a : α) (rest : List (α ⊕ Fin k)), r.1 = [Sum.inl a :: rest])
    (hstrat : ∀ i : Fin k, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
      (∃ (a : α) (rest : List (α ⊕ Fin k)), γ = Sum.inl a :: rest) ∨
      (∃ (j : Fin k) (rest : List (α ⊕ Fin k)), isCF j = true ∧ γ = Sum.inr j :: rest))
    (X : Fin k → Language α)
    (hX : ∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
      w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) :
    ∃ (k' : ℕ) (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
      (s' : Fin k') (X' : Fin k' → Language α),
      (∀ i : Fin k', ∀ r ∈ G' i, ∀ γ ∈ r.1 ++ r.2,
        ∃ (a : α) (β : List (Fin k')), γ = Sum.inl a :: β.map Sum.inr) ∧
      (∀ i : Fin k', ∀ w : List α, w ∈ X' i ↔
        w ≠ [] ∧ ∃ r ∈ G' i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X')).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X')).prod)) ∧
      X' s' = X s := by
  classical
  let LeadsTerm : List (α ⊕ Fin k) → Prop :=
    fun γ => ∃ (a : α) (rest : List (α ⊕ Fin k)), γ = Sum.inl a :: rest
  have hX_nil : ∀ j, ([] : List α) ∉ X j := fun j hj => ((hX j []).mp hj).1 rfl
  -- For any `j` with `isCF j = true`, `w ∈ X j * evalSF X rest ↔ ∃ r ∈ G j, w ∈ evalSF X (r_γ ++ rest)`:
  have hcf_unfold : ∀ (j : Fin k) (hj : isCF j = true) (rest : List (α ⊕ Fin k)),
      ∃ ls : List (List (α ⊕ Fin k)),
        (∀ c ∈ ls, LeadsTerm c) ∧
        ∀ w : List α, w ∈ evalSF X (Sum.inr j :: rest) ↔ ∃ c ∈ ls, w ∈ evalSF X c := by
    intro j hj rest
    let ls : List (List (α ⊕ Fin k)) :=
      (G j).flatMap (fun r => r.1.map (fun γ => γ ++ rest))
    refine ⟨ls, ?_, ?_⟩
    · intro c hc
      simp only [ls, List.mem_flatMap, List.mem_map] at hc
      rcases hc with ⟨r, hr, γ, hγ, rfl⟩
      obtain ⟨_, a, r_rest, hr1⟩ := hCF j hj r hr
      rw [hr1, List.mem_singleton] at hγ
      subst hγ
      exact ⟨a, r_rest ++ rest, rfl⟩
    · intro w
      rw [evalSF_cons, Sum.elim_inr, Language.mem_mul]
      simp only [ls, List.mem_flatMap, List.mem_map]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩
        obtain ⟨_, r, hr, hp, _⟩ := (hX j u).mp hu
        obtain ⟨_, a, r_rest, hr1⟩ := hCF j hj r hr
        have hu' : u ∈ evalSF X (Sum.inl a :: r_rest) := hp _ (by rw [hr1]; exact List.mem_singleton_self _)
        refine ⟨(Sum.inl a :: r_rest) ++ rest, ⟨r, hr, Sum.inl a :: r_rest,
          by rw [hr1]; exact List.mem_singleton_self _, rfl⟩, ?_⟩
        rw [evalSF_append, Language.mem_mul]
        exact ⟨u, hu', v, hv, rfl⟩
      · rintro ⟨_, ⟨r, hr, γ, hγ, rfl⟩, hw⟩
        rw [evalSF_append, Language.mem_mul] at hw
        rcases hw with ⟨u, hu, v, hv, rfl⟩
        obtain ⟨hr2, a, r_rest, hr1⟩ := hCF j hj r hr
        rw [hr1, List.mem_singleton] at hγ
        subst hγ
        have hu_ne : u ≠ [] := fun h0 => evalSF_nil_not_mem hX_nil (by simp) (h0 ▸ hu)
        refine ⟨u, (hX j u).mpr ⟨hu_ne, r, hr, ?_, by rw [hr2]; simp⟩, v, hv, rfl⟩
        intro γ' hγ'
        rw [hr1, List.mem_singleton] at hγ'
        subst hγ'; exact hu
  have hlit_pos : ∀ (i : Fin k) (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
      r ∈ G i → ∀ γ ∈ r.1,
      ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
        (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
        ∀ w : List α, w ∈ evalSF X γ ↔ evalDNF X d w := by
    intro i r hr γ hγ
    rcases hstrat i r hr γ (List.mem_append_left _ hγ) with hlt | ⟨j, rest, hj, rfl⟩
    · refine ⟨[([γ], [])], fun s hs c hc => ?_, fun w => by simp [evalDNF]⟩
      simp only [List.mem_singleton] at hs; subst hs
      simp only [List.append_nil, List.mem_singleton] at hc; subst hc
      exact hlt
    · obtain ⟨ls, hls_lead, hls_eq⟩ := hcf_unfold j hj rest
      refine ⟨ls.map (fun c => ([c], [])), ?_, fun w => ?_⟩
      · intro s hs c hc
        rcases List.mem_map.mp hs with ⟨c₀, hc₀, rfl⟩
        simp only [List.append_nil, List.mem_singleton] at hc; subst hc
        exact hls_lead c hc₀
      · rw [hls_eq w]
        unfold evalDNF
        simp only [List.mem_map]
        constructor
        · rintro ⟨c, hc, hw⟩; exact ⟨([c], []), ⟨c, hc, rfl⟩, by simp [hw], by simp⟩
        · rintro ⟨_, ⟨c, hc, rfl⟩, hp, _⟩; exact ⟨c, hc, hp c (List.mem_singleton_self _)⟩
  have hlit_neg : ∀ (i : Fin k) (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
      r ∈ G i → ∀ δ ∈ r.2,
      ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
        (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
        ∀ w : List α, w ∉ evalSF X δ ↔ evalDNF X d w := by
    intro i r hr δ hδ
    rcases hstrat i r hr δ (List.mem_append_right _ hδ) with hlt | ⟨j, rest, hj, rfl⟩
    · refine ⟨[([], [δ])], fun s hs c hc => ?_, fun w => by simp [evalDNF]⟩
      simp only [List.mem_singleton] at hs; subst hs
      simp only [List.nil_append, List.mem_singleton] at hc; subst hc
      exact hlt
    · obtain ⟨ls, hls_lead, hls_eq⟩ := hcf_unfold j hj rest
      refine ⟨[([], ls)], ?_, fun w => ?_⟩
      · intro s hs c hc
        simp only [List.mem_singleton] at hs; subst hs
        simp only [List.nil_append] at hc
        exact hls_lead c hc
      · rw [hls_eq w]
        unfold evalDNF
        simp only [List.mem_singleton, exists_eq_left, List.not_mem_nil, false_implies,
          forall_const, true_and, not_exists, not_and]
  have hbuild : ∀ i : Fin k,
      ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
        (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
        ∀ w : List α, boolCond G X i w ↔ evalDNF X d w := by
    intro i
    have hrule : ∀ r ∈ G i,
        ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
          (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
          ∀ w : List α, ((∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) ↔ evalDNF X d w := by
      intro r hr
      have hp : ∀ l : List (List (α ⊕ Fin k)), (∀ γ ∈ l, γ ∈ r.1) →
          ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
            ∀ w : List α, (∀ γ ∈ l, w ∈ evalSF X γ) ↔ evalDNF X d w := by
        intro l
        induction l with
        | nil =>
          intro _
          exact ⟨[([], [])], fun s hs c hc => by simp at hs; subst hs; simp at hc,
            fun w => by simp [evalDNF]⟩
        | cons γ tl ihtl =>
          intro hall
          obtain ⟨d1, hd1, heq1⟩ := hlit_pos i r hr γ (hall γ (List.mem_cons_self ..))
          obtain ⟨d2, hd2, heq2⟩ := ihtl (fun c hc => hall c (List.mem_cons_of_mem _ hc))
          refine ⟨andDNF d1 d2, andDNF_forall hd1 hd2, fun w => ?_⟩
          rw [evalDNF_andDNF, ← heq1 w, ← heq2 w]; simp
      have hn : ∀ l : List (List (α ⊕ Fin k)), (∀ δ ∈ l, δ ∈ r.2) →
          ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
            ∀ w : List α, (∀ δ ∈ l, w ∉ evalSF X δ) ↔ evalDNF X d w := by
        intro l
        induction l with
        | nil =>
          intro _
          exact ⟨[([], [])], fun s hs c hc => by simp at hs; subst hs; simp at hc,
            fun w => by simp [evalDNF]⟩
        | cons δ tl ihtl =>
          intro hall
          obtain ⟨d1, hd1, heq1⟩ := hlit_neg i r hr δ (hall δ (List.mem_cons_self ..))
          obtain ⟨d2, hd2, heq2⟩ := ihtl (fun c hc => hall c (List.mem_cons_of_mem _ hc))
          refine ⟨andDNF d1 d2, andDNF_forall hd1 hd2, fun w => ?_⟩
          rw [evalDNF_andDNF, ← heq1 w, ← heq2 w]; simp
      obtain ⟨dp, hdp, hpeq⟩ := hp r.1 (fun _ h => h)
      obtain ⟨dn, hdn, hneq⟩ := hn r.2 (fun _ h => h)
      refine ⟨andDNF dp dn, andDNF_forall hdp hdn, fun w => ?_⟩
      rw [evalDNF_andDNF, ← hpeq w, ← hneq w]
    have hlist : ∀ rs : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
        (∀ r ∈ rs, r ∈ G i) →
        ∃ d : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
          (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
          ∀ w : List α, (∃ r ∈ rs, (∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) ↔
            evalDNF X d w := by
      intro rs
      induction rs with
      | nil => intro _; exact ⟨[], fun _ h => by simp at h, fun _ => by simp [evalDNF]⟩
      | cons r tl ihtl =>
        intro hall
        obtain ⟨d1, hd1, heq1⟩ := hrule r (hall r (List.mem_cons_self ..))
        obtain ⟨d2, hd2, heq2⟩ := ihtl (fun r' hr' => hall r' (List.mem_cons_of_mem _ hr'))
        refine ⟨d1 ++ d2, fun s hs c hc => ?_, fun w => ?_⟩
        · rcases List.mem_append.mp hs with h | h
          · exact hd1 s h c hc
          · exact hd2 s h c hc
        · simp only [List.mem_cons, exists_eq_or_imp, heq1 w, heq2 w]
          unfold evalDNF
          simp only [List.mem_append]
          constructor
          · rintro (⟨s, hs, h⟩ | ⟨s, hs, h⟩)
            · exact ⟨s, Or.inl hs, h⟩
            · exact ⟨s, Or.inr hs, h⟩
          · rintro ⟨s, hs | hs, h⟩
            · exact Or.inl ⟨s, hs, h⟩
            · exact Or.inr ⟨s, hs, h⟩
    exact hlist (G i) (fun _ h => h)
  let G₁ : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))) :=
    fun i => Classical.choose (hbuild i)
  have hG₁_lead : ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2, LeadsTerm γ :=
    fun i => (Classical.choose_spec (hbuild i)).1
  have hG₁_sol : ∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G₁ X i w := by
    intro i w
    rw [hX i w]
    exact and_congr_right fun _ => (Classical.choose_spec (hbuild i)).2 w
  obtain ⟨k', emb', G', X', hX'_emb, hgnf', hX'⟩ := leading_term_to_strict_gnf G₁ X hG₁_lead hG₁_sol
  exact ⟨k', G', emb' s, X', hgnf', hX', hX'_emb s⟩

/-- **Positive GNF Theorem for Acyclic-Left-Corner Linear Boolean Grammars (PPL 105):**
If an ε-free Boolean grammar `G` over `[Fintype α] [DecidableEq α]` has a ranking `rank : Fin k → ℕ`
such that every conjunct either begins with a terminal (`Sum.inl a :: rest`) OR has the linear
right-terminal-suffix form `Sum.inr j :: v.map Sum.inl` with `rank j < rank i`, then `G` converts
constructively into exact **Greibach Normal Form** preserving `X s`. -/
theorem ppl105_acyclic_linear_boolean_gnf {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (s : Fin k)
    (hlin : ∃ rank : Fin k → ℕ, ∀ i : Fin k, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
      (∃ (a : α) (rest : List (α ⊕ Fin k)), γ = Sum.inl a :: rest) ∨
      (∃ (j : Fin k) (v : List α), rank j < rank i ∧ γ = Sum.inr j :: v.map Sum.inl))
    (X : Fin k → Language α)
    (hX : ∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
      w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) :
    ∃ (k' : ℕ) (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
      (s' : Fin k') (X' : Fin k' → Language α),
      (∀ i : Fin k', ∀ r ∈ G' i, ∀ γ ∈ r.1 ++ r.2,
        ∃ (a : α) (β : List (Fin k')), γ = Sum.inl a :: β.map Sum.inr) ∧
      (∀ i : Fin k', ∀ w : List α, w ∈ X' i ↔
        w ≠ [] ∧ ∃ r ∈ G' i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X')).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X')).prod)) ∧
      X' s' = X s := by
  classical
  rcases hlin with ⟨rank, hlin⟩
  -- Extend with one universal nonterminal U = k generating Σ⁺:
  let k₁ := k + 1
  let orig : Fin k → Fin k₁ := fun i => ⟨i.1, by omega⟩
  let uIdx : Fin k₁ := ⟨k, by omega⟩
  let L_ne : Language α := {w : List α | w ≠ []}
  let X₁ : Fin k₁ → Language α := fun i =>
    if h : i.1 < k then X ⟨i.1, h⟩ else L_ne
  have hX₁_orig : ∀ i : Fin k, X₁ (orig i) = X i := fun i => by
    dsimp only [X₁, orig]; rw [dif_pos i.2]
  have hX₁_u : X₁ uIdx = L_ne := by
    dsimp only [X₁, uIdx]; rw [dif_neg (by omega)]
  let allAlphas : List α := (Finset.univ : Finset α).toList
  have hmem_allAlphas : ∀ a : α, a ∈ allAlphas := fun a =>
    Finset.mem_toList.mpr (Finset.mem_univ a)
  let LeadsTerm : List (α ⊕ Fin k₁) → Prop :=
    fun γ => ∃ (a : α) (rest : List (α ⊕ Fin k₁)), γ = Sum.inl a :: rest
  have heval_v : ∀ (v : List α) (w : List α), w ∈ evalSF X₁ (v.map Sum.inl) ↔ w = v := by
    intro v
    induction v with
    | nil => intro w; exact mem_evalSF_nil X₁ w
    | cons a tl ih =>
      intro w
      simp only [List.map_cons, evalSF_cons, Sum.elim_inl, Language.mem_mul]
      constructor
      · rintro ⟨u, hu, z, hz, rfl⟩
        have hu' : u = [a] := hu
        have hz' : z = tl := (ih z).mp hz
        subst hu'; subst hz'; rfl
      · rintro rfl
        exact ⟨[a], rfl, tl, (ih tl).mpr rfl, rfl⟩
  -- Leading-terminal DNF for Σ⁺ * {v}:
  let uSuffixDNF (v : List α) : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))) :=
    allAlphas.flatMap (fun a =>
      [([Sum.inl a :: v.map Sum.inl], []), ([Sum.inl a :: Sum.inr uIdx :: v.map Sum.inl], [])])
  have huSuffix_lead : ∀ v, ∀ r ∈ uSuffixDNF v, ∀ c ∈ r.1 ++ r.2, LeadsTerm c := by
    intro v r hr c hc
    simp only [uSuffixDNF, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with ⟨a, _, rfl | rfl⟩ <;>
    · simp only [List.append_nil, List.mem_singleton] at hc; subst hc; exact ⟨a, _, rfl⟩
  have huSuffix_eval : ∀ (v w : List α),
      evalDNF X₁ (uSuffixDNF v) w ↔ ∃ u : List α, u ≠ [] ∧ u ++ v = w := by
    intro v w
    unfold evalDNF
    simp only [uSuffixDNF, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false]
    constructor
    · rintro ⟨_, ⟨a, _, rfl | rfl⟩, hp, _⟩
      · have h := hp _ (List.mem_singleton_self _)
        rw [evalSF_cons, Sum.elim_inl, Language.mem_mul] at h
        rcases h with ⟨u₁, hu₁, u₂, hu₂, rfl⟩
        have hu₁' : u₁ = [a] := hu₁
        have hu₂' : u₂ = v := (heval_v v u₂).mp hu₂
        subst hu₁'; subst hu₂'
        exact ⟨[a], by simp, rfl⟩
      · have h := hp _ (List.mem_singleton_self _)
        rw [evalSF_cons, Sum.elim_inl, Language.mem_mul] at h
        rcases h with ⟨u₁, hu₁, z, hz, rfl⟩
        rw [evalSF_cons, Sum.elim_inr, hX₁_u, Language.mem_mul] at hz
        rcases hz with ⟨u₂, hu₂, u₃, hu₃, rfl⟩
        have hu₁' : u₁ = [a] := hu₁
        have hu₃' : u₃ = v := (heval_v v u₃).mp hu₃
        subst hu₁'; subst hu₃'
        exact ⟨a :: u₂, by simp, by simp⟩
    · rintro ⟨u, hu_ne, rfl⟩
      rcases u with _ | ⟨a, tl⟩
      · exact (hu_ne rfl).elim
      · cases tl with
        | nil =>
          refine ⟨([Sum.inl a :: v.map Sum.inl], []), ⟨a, hmem_allAlphas a, Or.inl rfl⟩, ?_, by simp⟩
          intro γ hγ; rw [List.mem_singleton.mp hγ]
          rw [evalSF_cons, Sum.elim_inl, Language.mem_mul]
          exact ⟨[a], rfl, v, (heval_v v v).mpr rfl, rfl⟩
        | cons b tl' =>
          refine ⟨([Sum.inl a :: Sum.inr uIdx :: v.map Sum.inl], []),
            ⟨a, hmem_allAlphas a, Or.inr rfl⟩, ?_, by simp⟩
          intro γ hγ; rw [List.mem_singleton.mp hγ]
          rw [evalSF_cons, Sum.elim_inl, Language.mem_mul]
          refine ⟨[a], rfl, (b :: tl') ++ v, ?_, by simp⟩
          rw [evalSF_cons, Sum.elim_inr, hX₁_u, Language.mem_mul]
          exact ⟨b :: tl', by change b :: tl' ≠ []; simp, v, (heval_v v v).mpr rfl, rfl⟩
  -- Right-append a terminal suffix `v` to a leading-terminal DNF `d`:
  let appendSuffixDNF (d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁)))) (v : List α) :
      List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))) :=
    andDNF (uSuffixDNF v)
      (d.map (fun r => (r.1.map (· ++ v.map Sum.inl), r.2.map (· ++ v.map Sum.inl))))
  have happendSuffix_lead : ∀ d v, (∀ r ∈ d, ∀ c ∈ r.1 ++ r.2, LeadsTerm c) →
      ∀ r ∈ appendSuffixDNF d v, ∀ c ∈ r.1 ++ r.2, LeadsTerm c := by
    intro d v hd
    refine andDNF_forall (huSuffix_lead v) fun r hr c hc => ?_
    rcases List.mem_map.mp hr with ⟨r₀, hr₀, rfl⟩
    simp only [← List.map_append, List.mem_map] at hc
    rcases hc with ⟨c₀, hc₀, rfl⟩
    obtain ⟨a, rest, rfl⟩ := hd r₀ hr₀ c₀ hc₀
    exact ⟨a, rest ++ v.map Sum.inl, rfl⟩
  have happendSuffix_eval : ∀ d v (w : List α),
      evalDNF X₁ (appendSuffixDNF d v) w ↔
        ∃ u : List α, u ≠ [] ∧ evalDNF X₁ d u ∧ u ++ v = w := by
    intro d v w
    rw [evalDNF_andDNF, huSuffix_eval v w]
    unfold evalDNF
    simp only [List.mem_map]
    constructor
    · rintro ⟨⟨u, hu_ne, rfl⟩, ⟨_, ⟨r₀, hr₀, rfl⟩, hp, hn⟩⟩
      refine ⟨u, hu_ne, ⟨r₀, hr₀, ?_, ?_⟩, rfl⟩
      · intro γ hγ
        have h := hp (γ ++ v.map Sum.inl) (List.mem_map.mpr ⟨γ, hγ, rfl⟩)
        rw [evalSF_append, Language.mem_mul] at h
        rcases h with ⟨u', hu', v', hv', heq⟩
        have hv'' : v' = v := (heval_v v v').mp hv'
        subst hv''
        have hu'' : u' = u := List.append_cancel_right heq
        exact hu'' ▸ hu'
      · intro δ hδ huδ
        apply hn (δ ++ v.map Sum.inl) (List.mem_map.mpr ⟨δ, hδ, rfl⟩)
        rw [evalSF_append, Language.mem_mul]
        exact ⟨u, huδ, v, (heval_v v v).mpr rfl, rfl⟩
    · rintro ⟨u, hu_ne, ⟨r₀, hr₀, hp₀, hn₀⟩, rfl⟩
      refine ⟨⟨u, hu_ne, rfl⟩, ⟨(r₀.1.map (· ++ v.map Sum.inl), r₀.2.map (· ++ v.map Sum.inl)),
        ⟨r₀, hr₀, rfl⟩, ?_, ?_⟩⟩
      · intro γ hγ
        rcases List.mem_map.mp hγ with ⟨γ₀, hγ₀, rfl⟩
        rw [evalSF_append, Language.mem_mul]
        exact ⟨u, hp₀ γ₀ hγ₀, v, (heval_v v v).mpr rfl, rfl⟩
      · intro δ hδ hwδ
        rcases List.mem_map.mp hδ with ⟨δ₀, hδ₀, rfl⟩
        rw [evalSF_append, Language.mem_mul] at hwδ
        rcases hwδ with ⟨u', hu', v', hv', heq⟩
        have hv'' : v' = v := (heval_v v v').mp hv'
        subst hv''
        have hu'' : u' = u := List.append_cancel_right heq
        exact hn₀ δ₀ hδ₀ (hu'' ▸ hu')
  -- Strong induction on `rank i` to build a leading-terminal DNF for each `i : Fin k`:
  have hbuild : ∀ m : ℕ, ∀ i : Fin k, rank i = m →
      ∃ d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))),
        (∀ r ∈ d, ∀ c ∈ r.1 ++ r.2, LeadsTerm c) ∧
        ∀ w : List α, w ≠ [] → (w ∈ X i ↔ evalDNF X₁ d w) := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ihm =>
      intro i hi
      have hlit_pos : ∀ (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))), r ∈ G i →
          ∀ γ ∈ r.1 ++ r.2,
          ∃ d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
            ∀ w : List α, w ≠ [] → (w ∈ evalSF X γ ↔ evalDNF X₁ d w) := by
        intro r hr γ hγ
        rcases hlin i r hr γ hγ with ⟨a, rest, rfl⟩ | ⟨j, v, hj_lt, rfl⟩
        · refine ⟨[([mapSF orig (Sum.inl a :: rest)], [])], ?_, fun w _ => ?_⟩
          · intro s hs c hc
            simp only [List.mem_singleton] at hs; subst hs
            simp only [List.append_nil, List.mem_singleton] at hc; subst hc
            exact ⟨a, mapSF orig rest, rfl⟩
          · simp only [evalDNF, List.mem_singleton, exists_eq_left, forall_eq, List.not_mem_nil,
              false_implies, forall_const, and_true, evalSF_mapSF, hX₁_orig]
        · obtain ⟨dj, hdj_lead, hdj_eq⟩ := ihm (rank j) (hi ▸ hj_lt) j rfl
          refine ⟨appendSuffixDNF dj v, happendSuffix_lead dj v hdj_lead, fun w _ => ?_⟩
          rw [happendSuffix_eval dj v w, evalSF_cons, Sum.elim_inr, Language.mem_mul]
          have heval_vX : ∀ z : List α, z ∈ evalSF X (v.map Sum.inl) ↔ z = v := by
            intro z
            have h1 := evalSF_mapSF orig X₁ (v.map Sum.inl)
            have h2 : mapSF orig (v.map Sum.inl) = v.map Sum.inl := by
              simp [mapSF, mapSym, List.map_map]
            rw [h2] at h1
            simp only [hX₁_orig] at h1
            rw [← h1]
            exact heval_v v z
          constructor
          · rintro ⟨u, hu, z, hz, rfl⟩
            have hz' : z = v := (heval_vX z).mp hz
            subst hz'
            have hu_ne : u ≠ [] := ((hX j u).mp hu).1
            exact ⟨u, hu_ne, (hdj_eq u hu_ne).mp hu, rfl⟩
          · rintro ⟨u, hu_ne, hu_dnf, rfl⟩
            exact ⟨u, (hdj_eq u hu_ne).mpr hu_dnf, v, (heval_vX v).mpr rfl, rfl⟩
      have hrule : ∀ r ∈ G i,
          ∃ d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
            ∀ w : List α, w ≠ [] →
              (((∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) ↔ evalDNF X₁ d w) := by
        intro r hr
        have hp : ∀ l : List (List (α ⊕ Fin k)), (∀ γ ∈ l, γ ∈ r.1) →
            ∃ d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))),
              (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
              ∀ w : List α, w ≠ [] → ((∀ γ ∈ l, w ∈ evalSF X γ) ↔ evalDNF X₁ d w) := by
          intro l
          induction l with
          | nil =>
            intro _
            exact ⟨[([], [])], fun s hs c hc => by simp at hs; subst hs; simp at hc,
              fun _ _ => by simp [evalDNF]⟩
          | cons γ tl ihtl =>
            intro hall
            obtain ⟨d1, hd1, heq1⟩ := hlit_pos r hr γ (List.mem_append_left _ (hall γ (List.mem_cons_self ..)))
            obtain ⟨d2, hd2, heq2⟩ := ihtl (fun c hc => hall c (List.mem_cons_of_mem _ hc))
            refine ⟨andDNF d1 d2, andDNF_forall hd1 hd2, fun w hw => ?_⟩
            rw [evalDNF_andDNF, ← heq1 w hw, ← heq2 w hw]; simp
        have hn : ∀ l : List (List (α ⊕ Fin k)), (∀ δ ∈ l, δ ∈ r.2) →
            ∃ d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))),
              (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
              ∀ w : List α, w ≠ [] → ((∀ δ ∈ l, w ∉ evalSF X δ) ↔ evalDNF X₁ d w) := by
          intro l
          induction l with
          | nil =>
            intro _
            exact ⟨[([], [])], fun s hs c hc => by simp at hs; subst hs; simp at hc,
              fun _ _ => by simp [evalDNF]⟩
          | cons δ tl ihtl =>
            intro hall
            obtain ⟨d1, hd1, heq1⟩ := hlit_pos r hr δ (List.mem_append_right _ (hall δ (List.mem_cons_self ..)))
            obtain ⟨d2, hd2, heq2⟩ := ihtl (fun c hc => hall c (List.mem_cons_of_mem _ hc))
            refine ⟨andDNF (negDNF d1) d2, andDNF_forall (negDNF_forall hd1) hd2, fun w hw => ?_⟩
            rw [evalDNF_andDNF, evalDNF_negDNF, ← heq1 w hw, ← heq2 w hw]; simp
        obtain ⟨dp, hdp, hpeq⟩ := hp r.1 (fun _ h => h)
        obtain ⟨dn, hdn, hneq⟩ := hn r.2 (fun _ h => h)
        refine ⟨andDNF dp dn, andDNF_forall hdp hdn, fun w hw => ?_⟩
        rw [evalDNF_andDNF, ← hpeq w hw, ← hneq w hw]
      have hlist : ∀ rs : List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))),
          (∀ r ∈ rs, r ∈ G i) →
          ∃ d : List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))),
            (∀ s ∈ d, ∀ c ∈ s.1 ++ s.2, LeadsTerm c) ∧
            ∀ w : List α, w ≠ [] →
              ((∃ r ∈ rs, (∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ)) ↔
                evalDNF X₁ d w) := by
        intro rs
        induction rs with
        | nil => intro _; exact ⟨[], fun _ h => by simp at h, fun _ _ => by simp [evalDNF]⟩
        | cons r tl ihtl =>
          intro hall
          obtain ⟨d1, hd1, heq1⟩ := hrule r (hall r (List.mem_cons_self ..))
          obtain ⟨d2, hd2, heq2⟩ := ihtl (fun r' hr' => hall r' (List.mem_cons_of_mem _ hr'))
          refine ⟨d1 ++ d2, fun s hs c hc => ?_, fun w hw => ?_⟩
          · rcases List.mem_append.mp hs with h | h
            · exact hd1 s h c hc
            · exact hd2 s h c hc
          · simp only [List.mem_cons, exists_eq_or_imp, heq1 w hw, heq2 w hw]
            unfold evalDNF
            simp only [List.mem_append]
            constructor
            · rintro (⟨s, hs, h⟩ | ⟨s, hs, h⟩)
              · exact ⟨s, Or.inl hs, h⟩
              · exact ⟨s, Or.inr hs, h⟩
            · rintro ⟨s, hs | hs, h⟩
              · exact Or.inl ⟨s, hs, h⟩
              · exact Or.inr ⟨s, hs, h⟩
      obtain ⟨d, hd_lead, hd_eq⟩ := hlist (G i) (fun _ h => h)
      refine ⟨d, hd_lead, fun w hw => ?_⟩
      rw [hX i w, and_iff_right hw]
      exact hd_eq w hw
  let G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))) := fun i =>
    if h : i.1 < k then Classical.choose (hbuild (rank ⟨i.1, h⟩) ⟨i.1, h⟩ rfl)
    else uSuffixDNF []
  have hG₁_lead : ∀ i, ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2, LeadsTerm γ := by
    intro i r hr γ hγ
    by_cases h : i.1 < k
    · dsimp only [G₁] at hr; rw [dif_pos h] at hr
      exact (Classical.choose_spec (hbuild (rank ⟨i.1, h⟩) ⟨i.1, h⟩ rfl)).1 r hr γ hγ
    · dsimp only [G₁] at hr; rw [dif_neg h] at hr
      exact huSuffix_lead [] r hr γ hγ
  have hG₁_sol : ∀ i w, w ∈ X₁ i ↔ w ≠ [] ∧ boolCond G₁ X₁ i w := by
    intro i w
    by_cases h : i.1 < k
    · have hXi : X₁ i = X ⟨i.1, h⟩ := by dsimp only [X₁]; rw [dif_pos h]
      rw [hXi]
      by_cases hw0 : w = []
      · subst hw0; simp only [ne_eq, not_true_eq_false, false_and, iff_false]
        intro hmem; exact ((hX ⟨i.1, h⟩ []).mp hmem).1 rfl
      · rw [and_iff_right hw0]
        change w ∈ X ⟨i.1, h⟩ ↔ evalDNF X₁ (G₁ i) w
        have hGi : G₁ i = Classical.choose (hbuild (rank ⟨i.1, h⟩) ⟨i.1, h⟩ rfl) := by
          dsimp only [G₁]; rw [dif_pos h]
        rw [hGi]
        exact (Classical.choose_spec (hbuild (rank ⟨i.1, h⟩) ⟨i.1, h⟩ rfl)).2 w hw0
    · have hi : i = uIdx := Fin.ext (by dsimp [uIdx]; omega)
      subst hi
      rw [hX₁_u]
      change w ≠ [] ↔ w ≠ [] ∧ evalDNF X₁ (G₁ uIdx) w
      have hGu : G₁ uIdx = uSuffixDNF [] := by dsimp only [G₁, uIdx]; rw [dif_neg (by omega)]
      rw [hGu, huSuffix_eval [] w]
      constructor
      · intro hne; exact ⟨hne, w, hne, by simp⟩
      · exact And.left
  obtain ⟨k', emb', G', X', hX'_emb, hgnf', hX'⟩ := leading_term_to_strict_gnf G₁ X₁ hG₁_lead hG₁_sol
  exact ⟨k', G', emb' (orig s), X', hgnf', hX', by rw [hX'_emb, hX₁_orig]⟩

section AnBnCnGNFPrivate

private def anbncnGNF :
    Fin 7 → List (List (List (Fin 3 ⊕ Fin 7)) × List (List (Fin 3 ⊕ Fin 7)))
  | ⟨0, _⟩ => [([[Sum.inl 1]], [])]
  | ⟨1, _⟩ => [([[Sum.inl 2]], [])]
  | ⟨2, _⟩ => [([[Sum.inl 0, Sum.inr 0]], []), ([[Sum.inl 0, Sum.inr 2, Sum.inr 0]], [])]
  | ⟨3, _⟩ => [([[Sum.inl 2]], []), ([[Sum.inl 2, Sum.inr 3]], [])]
  | ⟨4, _⟩ => [([[Sum.inl 0]], []), ([[Sum.inl 0, Sum.inr 4]], [])]
  | ⟨5, _⟩ => [([[Sum.inl 1, Sum.inr 1]], []), ([[Sum.inl 1, Sum.inr 5, Sum.inr 1]], [])]
  | ⟨6, _⟩ => [
      ([[Sum.inl 0, Sum.inr 0, Sum.inr 3], [Sum.inl 0, Sum.inr 5]], []),
      ([[Sum.inl 0, Sum.inr 0, Sum.inr 3], [Sum.inl 0, Sum.inr 4, Sum.inr 5]], []),
      ([[Sum.inl 0, Sum.inr 2, Sum.inr 0, Sum.inr 3], [Sum.inl 0, Sum.inr 5]], []),
      ([[Sum.inl 0, Sum.inr 2, Sum.inr 0, Sum.inr 3], [Sum.inl 0, Sum.inr 4, Sum.inr 5]], [])]

private def anbncnGNFSol : Fin 7 → Language (Fin 3)
  | ⟨0, _⟩ => {[1]}
  | ⟨1, _⟩ => {[2]}
  | ⟨2, _⟩ => {w | ∃ m, 1 ≤ m ∧ w = List.replicate m 0 ++ List.replicate m 1}
  | ⟨3, _⟩ => {w | ∃ k, 1 ≤ k ∧ w = List.replicate k 2}
  | ⟨4, _⟩ => {w | ∃ k, 1 ≤ k ∧ w = List.replicate k 0}
  | ⟨5, _⟩ => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n 1 ++ List.replicate n 2}
  | ⟨6, _⟩ => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2}

end AnBnCnGNFPrivate

/-- **Explicit Greibach Normal Form Conjunctive Grammar for the Non-CFL `{a^n b^n c^n | n ≥ 1}`:**
Demonstrates constructively that GNF conjunctive grammars strictly exceed CFLs. -/
theorem ppl105_anbncn_gnf :
    ∃ (k : ℕ) (G : Fin k → List (List (List (Fin 3 ⊕ Fin k)) × List (List (Fin 3 ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language (Fin 3)),
      (∀ i, ∀ r ∈ G i, r.2 = []) ∧
      (∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
        ∃ (a : Fin 3) (β : List (Fin k)), γ = Sum.inl a :: β.map Sum.inr) ∧
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod)) ∧
      X s = ({w : List (Fin 3) | ∃ n : ℕ, 1 ≤ n ∧
        w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2} : Language (Fin 3)) := by
  refine ⟨7, anbncnGNF, 6, anbncnGNFSol, ?_, ?_, ?_, rfl⟩
  · intro i r hr
    fin_cases i <;> simp [anbncnGNF] at hr <;> rcases hr with rfl | rfl | rfl | rfl <;> rfl
  · intro i r hr γ hγ
    fin_cases i <;> simp [anbncnGNF] at hr
    · subst hr; simp at hγ; subst hγ; exact ⟨1, [], rfl⟩
    · subst hr; simp at hγ; subst hγ; exact ⟨2, [], rfl⟩
    · rcases hr with rfl | rfl <;> (simp at hγ; subst hγ)
      · exact ⟨0, [0], rfl⟩
      · exact ⟨0, [2, 0], rfl⟩
    · rcases hr with rfl | rfl <;> (simp at hγ; subst hγ)
      · exact ⟨2, [], rfl⟩
      · exact ⟨2, [3], rfl⟩
    · rcases hr with rfl | rfl <;> (simp at hγ; subst hγ)

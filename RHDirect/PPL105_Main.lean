                  have hidx_eq : idx' = idx := Fin.ext ((List.Nodup.getElem_inj_iff (List.nodup_dedup _)).mp hp_eq)
                  subst hidx_eq; rw [h2] at hidx'; simp at hidx'
                · rfl
              rw [hσ]
            · intro r₁ hr₁ r₂ hr₂
              rcases List.mem_map.mp hr₁ with ⟨a, _, rfl⟩
              rcases List.mem_map.mp hr₂ with ⟨⟨b, σ⟩, _, rfl⟩
              simp [mkMinterm]
          have hreq : (G' i)[p₁] = (G' i)[p₂] := by
            have hmem₁ : (G' i)[p₁] ∈ topTermRules ++ topBinRules := list_mem_of_eq hGi (List.getElem_mem p₁.2)
            have hmem₂ : (G' i)[p₂] ∈ topTermRules ++ topBinRules := list_mem_of_eq hGi (List.getElem_mem p₂.2)
            rcases List.mem_append.mp hmem₁ with hl₁ | hr₁ <;>
            rcases List.mem_append.mp hmem₂ with hl₂ | hr₂
            · rcases List.mem_map.mp hl₁ with ⟨a₁, _, h₁⟩
              rcases List.mem_map.mp hl₂ with ⟨a₂, _, h₂⟩
              have hw₁ := (mem_evalSF_singleton_inl X' a₁ w).mp (hm₁.1 _ (by rw [← h₁]; simp))
              have hw₂ := (mem_evalSF_singleton_inl X' a₂ w).mp (hm₂.1 _ (by rw [← h₂]; simp))
              rw [hw₁] at hw₂; have : a₁ = a₂ := (List.cons.inj hw₂).1
              subst this; rw [← h₁, ← h₂]
            · rcases List.mem_map.mp hl₁ with ⟨a₁, _, h₁⟩
              rcases List.mem_map.mp hr₂ with ⟨⟨a₂, σ₂⟩, _, h₂⟩
              have hw₁ := (mem_evalSF_singleton_inl X' a₁ w).mp (hm₁.1 _ (by rw [← h₁]; simp))
              obtain ⟨⟨v, hv, hw₂⟩, _⟩ := (hminterm_match a₂ σ₂ w).mp (by rw [h₂]; exact hm₂)
              rw [hw₁] at hw₂; have hlen := congrArg List.length hw₂
              simp only [List.length_cons, List.length_nil] at hlen
              exact (hv (List.eq_nil_of_length_eq_zero (by omega))).elim
            · rcases List.mem_map.mp hr₁ with ⟨⟨a₁, σ₁⟩, _, h₁⟩
              rcases List.mem_map.mp hl₂ with ⟨a₂, _, h₂⟩
              have hw₂ := (mem_evalSF_singleton_inl X' a₂ w).mp (hm₂.1 _ (by rw [← h₂]; simp))
              obtain ⟨⟨v, hv, hw₁⟩, _⟩ := (hminterm_match a₁ σ₁ w).mp (by rw [h₁]; exact hm₁)
              rw [hw₂] at hw₁; have hlen := congrArg List.length hw₁
              simp only [List.length_cons, List.length_nil] at hlen
              exact (hv (List.eq_nil_of_length_eq_zero (by omega))).elim
            · rcases List.mem_map.mp hr₁ with ⟨⟨a₁, σ₁⟩, _, h₁⟩
              rcases List.mem_map.mp hr₂ with ⟨⟨a₂, σ₂⟩, _, h₂⟩
              obtain ⟨⟨v₁, _, hw₁⟩, hσ₁⟩ := (hminterm_match a₁ σ₁ w).mp (by rw [h₁]; exact hm₁)
              obtain ⟨⟨v₂, _, hw₂⟩, hσ₂⟩ := (hminterm_match a₂ σ₂ w).mp (by rw [h₂]; exact hm₂)
              rw [hw₁] at hw₂; have : a₁ = a₂ := (List.cons.inj hw₂).1
              subst this; rw [hσ₁] at h₁; rw [hσ₂] at h₂; rw [← h₁, ← h₂]
          have hnodup_g : (G' i).Nodup := by rw [hGi]; exact hnodup_top
          exact Fin.ext ((List.Nodup.getElem_inj_iff hnodup_g).mp hreq)
  · -- 4. Unique binary factorization
    intro i r hr γ hγ B C hBC u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq
    have huniq_TU : ∀ (a : α), B = termIdx a → u₁ = u₂ ∧ v₁ = v₂ := by
      intro a hB; subst hB; rw [hX'_term] at hu₁ hu₂
      have h1 : u₁ = [a] := hu₁; have h2 : u₂ = [a] := hu₂
      subst h1; subst h2; exact ⟨rfl, List.append_cancel_left heq⟩
    by_cases h1 : i.1 < k
    · dsimp only [G'] at hr; rw [dif_pos h1, List.mem_map] at hr
      rcases hr with ⟨r₀, hr₀, rfl⟩
      simp only [mapRuleB, ← List.map_append, List.mem_map] at hγ
      rcases hγ with ⟨γ₀, hγ₀, rfl⟩
      rcases hU.1 ⟨i.1, h1⟩ r₀ hr₀ with ⟨a, rfl⟩ | ⟨_, hbin⟩
      · simp at hγ₀; subst hγ₀; simp [mapSF, mapSym] at hBC
      · obtain ⟨B₀, C₀, rfl⟩ := hbin γ₀ hγ₀
        simp only [mapSF, mapSym, List.map_cons, List.map_nil, Sum.map_inr,
          List.cons.injEq, Sum.inr.injEq, and_true] at hBC
        rcases hBC with ⟨rfl, rfl⟩
        rw [hX'_orig] at hu₁ hv₁ hu₂ hv₂
        exact hU.2.2.2 ⟨i.1, h1⟩ r₀ hr₀ _ hγ₀ B₀ C₀ rfl u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq
    · by_cases h2 : i.1 < k + m
      · dsimp only [G'] at hr; rw [dif_neg h1, dif_pos h2, List.mem_singleton] at hr; subst hr
        simp at hγ; subst hγ; simp at hBC
      · by_cases h3 : i.1 = k + m
        · dsimp only [G'] at hr; rw [dif_neg h1, dif_neg h2, dif_pos h3] at hr
          simp only [uRules, List.mem_append, List.mem_map] at hr
          rcases hr with ⟨a, _, rfl⟩ | ⟨a, _, rfl⟩
          · simp at hγ; subst hγ; simp at hBC
          · simp at hγ; subst hγ; simp at hBC; exact huniq_TU a hBC.1.symm
        · dsimp only [G'] at hr; rw [dif_neg h1, dif_neg h2, dif_neg h3, List.mem_append] at hr
          rcases hr with ht' | hb'
          · rcases List.mem_map.mp ht' with ⟨a, _, rfl⟩; simp at hγ; subst hγ; simp at hBC
          · rcases List.mem_map.mp hb' with ⟨⟨a, σ⟩, _, rfl⟩
            simp only [mkMinterm, List.cons_append, List.mem_cons, List.mem_append, List.mem_map] at hγ
            rcases hγ with rfl | ⟨idx, _, rfl⟩ | ⟨idx, _, rfl⟩
            · simp at hBC; exact huniq_TU a hBC.1.symm
            · simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC
              rcases hBC with ⟨rfl, rfl⟩
              rw [hX'_orig] at hu₁ hv₁ hu₂ hv₂
              have hmem_p : pairs[idx] ∈ pairs := List.getElem_mem idx.2
              rw [List.mem_dedup, List.mem_filterMap] at hmem_p
              rcases hmem_p with ⟨γ₀, hγ₀_flat, hpair⟩
              rcases List.mem_flatMap.mp hγ₀_flat with ⟨r₀, hr₀, hγ₀⟩
              rcases hU.1 s r₀ hr₀ with ⟨a₀, rfl⟩ | ⟨_, hbin⟩
              · simp at hγ₀; subst hγ₀; simp [pairOf] at hpair
              · obtain ⟨B₀, C₀, rfl⟩ := hbin γ₀ hγ₀
                simp only [pairOf, Option.some.injEq] at hpair
                have hB : B₀ = pairs[idx].1 := congrArg Prod.fst hpair
                have hC : C₀ = pairs[idx].2 := congrArg Prod.snd hpair
                subst hB; subst hC
                exact hU.2.2.2 s r₀ hr₀ _ hγ₀ _ _ rfl u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq
            · simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC
              rcases hBC with ⟨rfl, rfl⟩
              rw [hX'_orig] at hu₁ hv₁ hu₂ hv₂
              have hmem_p : pairs[idx] ∈ pairs := List.getElem_mem idx.2
              rw [List.mem_dedup, List.mem_filterMap] at hmem_p
              rcases hmem_p with ⟨γ₀, hγ₀_flat, hpair⟩
              rcases List.mem_flatMap.mp hγ₀_flat with ⟨r₀, hr₀, hγ₀⟩
              rcases hU.1 s r₀ hr₀ with ⟨a₀, rfl⟩ | ⟨_, hbin⟩
              · simp at hγ₀; subst hγ₀; simp [pairOf] at hpair
              · obtain ⟨B₀, C₀, rfl⟩ := hbin γ₀ hγ₀
                simp only [pairOf, Option.some.injEq] at hpair
                have hB : B₀ = pairs[idx].1 := congrArg Prod.fst hpair
                have hC : C₀ = pairs[idx].2 := congrArg Prod.snd hpair
                subst hB; subst hC
                exact hU.2.2.2 s r₀ hr₀ _ hγ₀ _ _ rfl u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq

private lemma unambig_inter {α : Type*} [Fintype α] [DecidableEq α] {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (s₁ : Fin k₁) (s₂ : Fin k₂)
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α)
    (hU₁ : IsUnambigBNF G₁ X₁) (hU₂ : IsUnambigBNF G₂ X₂) :
    ∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language α),
      IsUnambigBNF G X ∧ X s = X₁ s₁ ⊓ X₂ s₂ := by
  classical
  let allAlphas : List α := (Finset.univ : Finset α).toList
  have hmem_allAlphas : ∀ a : α, a ∈ allAlphas := fun a => Finset.mem_toList.mpr (Finset.mem_univ a)
  have hnodup_allAlphas : allAlphas.Nodup := Finset.nodup_toList _
  let isBinRule {k : ℕ} (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))) : Bool :=
    decide (r.1 ≠ []) && (r.1 ++ r.2).all (fun γ => match γ with | [Sum.inr _, Sum.inr _] => true | _ => false)
  let topTermRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
    (allAlphas.filter (fun a => decide ([a] ∈ X₁ s₁ ∧ [a] ∈ X₂ s₂))).map (fun a => ([[Sum.inl a]], []))
  let binIdxs₁ : List (Fin (G₁ s₁).length) :=
    (List.finRange (G₁ s₁).length).filter (fun p => isBinRule (G₁ s₁)[p])
  let binIdxs₂ : List (Fin (G₂ s₂).length) :=
    (List.finRange (G₂ s₂).length).filter (fun p => isBinRule (G₂ s₂)[p])
  let pairRule (p₁ : Fin (G₁ s₁).length) (p₂ : Fin (G₂ s₂).length) :
      List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1))) :=
    let r₁ := mapRuleB inlFin (G₁ s₁)[p₁]
    let r₂ := mapRuleB inrFin (G₂ s₂)[p₂]
    (r₁.1 ++ r₂.1, r₁.2 ++ r₂.2)
  let topBinRules : List (List (List (α ⊕ Fin (k₁ + k₂ + 1))) × List (List (α ⊕ Fin (k₁ + k₂ + 1)))) :=
    (binIdxs₁.product binIdxs₂).map (fun pq => pairRule pq.1 pq.2)
  let topR := topTermRules ++ topBinRules
  let G := combineBG G₁ G₂ topR
  let X := combineSol X₁ X₂ (X₁ s₁ ⊓ X₂ s₂)
  have hX₁_nil : ∀ j, ([] : List α) ∉ X₁ j := fun j hj => ((hU₁.2.1 j []).mp hj).1 rfl
  have hX₂_nil : ∀ j, ([] : List α) ∉ X₂ j := fun j hj => ((hU₂.2.1 j []).mp hj).1 rfl
  have hbin_iff₁ : ∀ p : Fin (G₁ s₁).length, isBinRule (G₁ s₁)[p] = true ↔
      (G₁ s₁)[p].1 ≠ [] ∧ ∀ γ ∈ (G₁ s₁)[p].1 ++ (G₁ s₁)[p].2, ∃ B C : Fin k₁, γ = [Sum.inr B, Sum.inr C] := by
    intro p
    rcases hU₁.1 s₁ (G₁ s₁)[p] (List.getElem_mem p.2) with ⟨a, ha⟩ | ⟨hpos, hbin⟩
    · simp only [isBinRule, ha, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
      constructor
      · intro h; have := h.2 [Sum.inl a] (by simp); simp at this
      · rintro ⟨_, hbin⟩; obtain ⟨B, C, hBC⟩ := hbin [Sum.inl a] (by simp); simp at hBC
    · constructor
      · intro _; exact ⟨hpos, hbin⟩
      · intro _
        simp only [isBinRule, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
        exact ⟨hpos, fun γ hγ => by obtain ⟨B, C, rfl⟩ := hbin γ hγ; rfl⟩
  have hbin_iff₂ : ∀ p : Fin (G₂ s₂).length, isBinRule (G₂ s₂)[p] = true ↔
      (G₂ s₂)[p].1 ≠ [] ∧ ∀ γ ∈ (G₂ s₂)[p].1 ++ (G₂ s₂)[p].2, ∃ B C : Fin k₂, γ = [Sum.inr B, Sum.inr C] := by
    intro p
    rcases hU₂.1 s₂ (G₂ s₂)[p] (List.getElem_mem p.2) with ⟨a, ha⟩ | ⟨hpos, hbin⟩
    · simp only [isBinRule, ha, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
      constructor
      · intro h; have := h.2 [Sum.inl a] (by simp); simp at this
      · rintro ⟨_, hbin⟩; obtain ⟨B, C, hBC⟩ := hbin [Sum.inl a] (by simp); simp at hBC
    · constructor
      · intro _; exact ⟨hpos, hbin⟩
      · intro _
        simp only [isBinRule, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
        exact ⟨hpos, fun γ hγ => by obtain ⟨B, C, rfl⟩ := hbin γ hγ; rfl⟩
  have hpair_match : ∀ (p₁ : Fin (G₁ s₁).length) (p₂ : Fin (G₂ s₂).length) (w : List α),
      ((∀ γ ∈ (pairRule p₁ p₂).1, w ∈ evalSF X γ) ∧ (∀ δ ∈ (pairRule p₁ p₂).2, w ∉ evalSF X δ)) ↔
      ((∀ γ ∈ (G₁ s₁)[p₁].1, w ∈ evalSF X₁ γ) ∧ (∀ δ ∈ (G₁ s₁)[p₁].2, w ∉ evalSF X₁ δ)) ∧
      ((∀ γ ∈ (G₂ s₂)[p₂].1, w ∈ evalSF X₂ γ) ∧ (∀ δ ∈ (G₂ s₂)[p₂].2, w ∉ evalSF X₂ δ)) := by
    intro p₁ p₂ w
    simp only [pairRule, mapRuleB, List.mem_append, List.mem_map]
    constructor
    · rintro ⟨hp, hn⟩
      refine ⟨⟨fun γ hγ => ?_, fun δ hδ => ?_⟩, ⟨fun γ hγ => ?_, fun δ hδ => ?_⟩⟩
      · have h := hp (mapSF inlFin γ) (Or.inl ⟨γ, hγ, rfl⟩)
        rw [evalSF_mapSF] at h; simpa [X, combineSol_inl] using h
      · have h := hn (mapSF inlFin δ) (Or.inl ⟨δ, hδ, rfl⟩)
        rw [evalSF_mapSF] at h; simpa [X, combineSol_inl] using h
      · have h := hp (mapSF inrFin γ) (Or.inr ⟨γ, hγ, rfl⟩)
        rw [evalSF_mapSF] at h; simpa [X, combineSol_inr] using h
      · have h := hn (mapSF inrFin δ) (Or.inr ⟨δ, hδ, rfl⟩)
        rw [evalSF_mapSF] at h; simpa [X, combineSol_inr] using h
    · rintro ⟨⟨hp₁, hn₁⟩, ⟨hp₂, hn₂⟩⟩
      refine ⟨?_, ?_⟩
      · rintro γ (⟨γ₁, hγ₁, rfl⟩ | ⟨γ₂, hγ₂, rfl⟩)
        · rw [evalSF_mapSF]; simpa [X, combineSol_inl] using hp₁ γ₁ hγ₁
        · rw [evalSF_mapSF]; simpa [X, combineSol_inr] using hp₂ γ₂ hγ₂
      · rintro δ (⟨δ₁, hδ₁, rfl⟩ | ⟨δ₂, hδ₂, rfl⟩)
        · rw [evalSF_mapSF]; simpa [X, combineSol_inl] using hn₁ δ₁ hδ₁
        · rw [evalSF_mapSF]; simpa [X, combineSol_inr] using hn₂ δ₂ hδ₂
  have hbin_len2₁ : ∀ p : Fin (G₁ s₁).length, isBinRule (G₁ s₁)[p] = true →
      ∀ w : List α, (∀ γ ∈ (G₁ s₁)[p].1, w ∈ evalSF X₁ γ) → 2 ≤ w.length := by
    intro p hbp w hp
    obtain ⟨hpos, hbin⟩ := (hbin_iff₁ p).mp hbp
    rcases List.exists_mem_of_ne_nil _ hpos with ⟨γ, hγ⟩
    obtain ⟨B, C, rfl⟩ := hbin γ (List.mem_append_left _ hγ)
    rcases (mem_evalSF_pair X₁ B C w).mp (hp _ hγ) with ⟨u, hu, v, hv, rfl⟩
    have hu1 : 1 ≤ u.length := List.length_pos_of_ne_nil (fun h => hX₁_nil B (h ▸ hu))
    have hv1 : 1 ≤ v.length := List.length_pos_of_ne_nil (fun h => hX₁_nil C (h ▸ hv))
    simp only [List.length_append]; omega
  refine ⟨k₁ + k₂ + 1, G, topFin k₁ k₂, X, ⟨?_, ?_, ?_, ?_⟩, combineSol_top _ _ _⟩
  · -- 1. BNF
    intro i r hr
    by_cases h1 : i.1 < k₁
    · dsimp only [G, combineBG] at hr; rw [dif_pos h1, List.mem_map] at hr
      rcases hr with ⟨r₁, hr₁, rfl⟩
      rcases hU₁.1 ⟨i.1, h1⟩ r₁ hr₁ with ⟨a, rfl⟩ | ⟨hpos, hbin⟩
      · exact Or.inl ⟨a, rfl⟩
      · refine Or.inr ⟨by simp [mapRuleB, hpos], fun γ hγ => ?_⟩
        simp only [mapRuleB, ← List.map_append, List.mem_map] at hγ
        rcases hγ with ⟨γ₁, hγ₁, rfl⟩
        obtain ⟨B, C, rfl⟩ := hbin γ₁ hγ₁
        exact ⟨inlFin B, inlFin C, rfl⟩
    · by_cases h2 : i.1 < k₁ + k₂
      · dsimp only [G, combineBG] at hr; rw [dif_neg h1, dif_pos h2, List.mem_map] at hr
        rcases hr with ⟨r₂, hr₂, rfl⟩
        rcases hU₂.1 ⟨i.1 - k₁, by omega⟩ r₂ hr₂ with ⟨a, rfl⟩ | ⟨hpos, hbin⟩
        · exact Or.inl ⟨a, rfl⟩
        · refine Or.inr ⟨by simp [mapRuleB, hpos], fun γ hγ => ?_⟩
          simp only [mapRuleB, ← List.map_append, List.mem_map] at hγ
          rcases hγ with ⟨γ₂, hγ₂, rfl⟩
          obtain ⟨B, C, rfl⟩ := hbin γ₂ hγ₂
          exact ⟨inrFin B, inrFin C, rfl⟩
      · dsimp only [G, combineBG] at hr; rw [dif_neg h1, dif_neg h2] at hr
        rcases List.mem_append.mp hr with ht | hb
        · rcases List.mem_map.mp ht with ⟨a, _, rfl⟩; exact Or.inl ⟨a, rfl⟩
        · rcases List.mem_map.mp hb with ⟨⟨p₁, p₂⟩, hpq, rfl⟩
          obtain ⟨hp₁, hp₂⟩ := List.mem_product.mp hpq
          simp only [binIdxs₁, binIdxs₂, List.mem_filter, List.mem_finRange, true_and] at hp₁ hp₂
          obtain ⟨hpos₁, hbin₁⟩ := (hbin_iff₁ p₁).mp hp₁
          obtain ⟨_, hbin₂⟩ := (hbin_iff₂ p₂).mp hp₂
          refine Or.inr ⟨by dsimp only [pairRule, mapRuleB]; intro h; exact hpos₁ (List.map_eq_nil_iff.mp (List.append_eq_nil_iff.mp h).1), fun γ hγ => ?_⟩
          dsimp only at hγ
          simp only [pairRule, mapRuleB, List.mem_append, List.mem_map] at hγ
          rcases hγ with ((⟨γ₁, hγ₁, rfl⟩ | ⟨γ₂, hγ₂, rfl⟩) | (⟨γ₁, hγ₁, rfl⟩ | ⟨γ₂, hγ₂, rfl⟩))
          · obtain ⟨B, C, rfl⟩ := hbin₁ γ₁ (List.mem_append_left _ hγ₁); exact ⟨inlFin B, inlFin C, rfl⟩
          · obtain ⟨B, C, rfl⟩ := hbin₂ γ₂ (List.mem_append_left _ hγ₂); exact ⟨inrFin B, inrFin C, rfl⟩
          · obtain ⟨B, C, rfl⟩ := hbin₁ γ₁ (List.mem_append_right _ hγ₁); exact ⟨inlFin B, inlFin C, rfl⟩
          · obtain ⟨B, C, rfl⟩ := hbin₂ γ₂ (List.mem_append_right _ hγ₂); exact ⟨inrFin B, inrFin C, rfl⟩
  · -- 2. Solution validity
    refine combineBG_sol_other G₁ G₂ X₁ X₂ (X₁ s₁ ⊓ X₂ s₂) hU₁.2.1 hU₂.2.1 topR fun w => ?_
    rw [mem_inf_lang]
    unfold boolCond; rw [combineBG_top]
    by_cases hw0 : w = []
    · subst hw0; simp [hX₁_nil s₁]
    · rw [and_iff_right hw0]
      rcases w with _ | ⟨a, _ | ⟨b, tl⟩⟩
      · exact (hw0 rfl).elim
      · -- length 1: w = [a]
        constructor
        · intro hmem

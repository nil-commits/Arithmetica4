      rw [hAC1, hAC2, hAB1, hAB2]
      have hint : ((∃ m k, 1 ≤ m ∧ 1 ≤ k ∧ w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2) ∧
          (∃ k n, 1 ≤ k ∧ 1 ≤ n ∧ w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2)) ↔
          (∃ n, 1 ≤ n ∧ w = List.replicate n 0 ++ List.replicate n 1 ++ List.replicate n 2) :=
        iff_of_eq (congrFun (congrArg Membership.mem anbncn_inter_eq) w)
      constructor
      · rintro ⟨n, hn, rfl⟩
        refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
        cases n with
        | zero => omega
        | succ n' =>
          cases n' with
          | zero => left; exact ⟨⟨1, le_rfl, rfl⟩, ⟨1, le_rfl, rfl⟩⟩
          | succ n'' =>
            right; right; right
            exact ⟨⟨n'' + 2, n'' + 2, by omega, by omega, rfl⟩, ⟨n'' + 2, n'' + 2, by omega, by omega, rfl⟩⟩
      · rintro ⟨_, ⟨⟨k₁, hk₁, h1⟩, ⟨n, hn, h2⟩⟩ | ⟨⟨k₁, hk₁, h1⟩, ⟨k₂, n, hk₂, hn, h2⟩⟩ |
            ⟨⟨m, k₁, hm, hk₁, h1⟩, ⟨n, hn, h2⟩⟩ | ⟨⟨m, k₁, hm, hk₁, h1⟩, ⟨k₂, n, hk₂, hn, h2⟩⟩⟩
        · exact hint.mp ⟨⟨1, k₁, le_rfl, hk₁, h1⟩, ⟨1, n, le_rfl, hn, h2⟩⟩
        · exact hint.mp ⟨⟨1, k₁, le_rfl, hk₁, h1⟩, ⟨k₂, n, by omega, hn, h2⟩⟩
        · exact hint.mp ⟨⟨m, k₁, by omega, hk₁, h1⟩, ⟨1, n, le_rfl, hn, h2⟩⟩
        · exact hint.mp ⟨⟨m, k₁, by omega, hk₁, h1⟩, ⟨k₂, n, by omega, hn, h2⟩⟩

/-! ## Section 5: Nonterminal-Complexity (PPL 153) & Inherent-Ambiguity (PPL 166) Frontiers -/

/-- **Gruska's Infinite CFG Nonterminal Complexity Hierarchy (PPL 153 Contrast):**
For every `k : ℕ`, the monochromatic Dyck-union language
`L_k = { (j, false)^n ++ (j, true)^n | j : Fin (k + 1), n ≥ 1 }` over `Fin (k + 1) × Bool`
IS a context-free language, yet NO `ContextFreeGrammar` with at most `k` nonterminals generates `L_k`. -/
theorem ppl153_cfg_unbounded_nonterminal_hierarchy (k : ℕ) :
    let L : Language (Fin (k + 1) × Bool) :=
      {w | ∃ (j : Fin (k + 1)) (n : ℕ), 1 ≤ n ∧
        w = List.replicate n (j, false) ++ List.replicate n (j, true)}
    (∃ g : ContextFreeGrammar (Fin (k + 1) × Bool), g.language = L) ∧
    (∀ (g : ContextFreeGrammar (Fin (k + 1) × Bool)) [Fintype g.NT],
      Fintype.card g.NT ≤ k → g.language ≠ L) := by
  classical
  intro L
  constructor
  · -- Explicit (k + 2)-nonterminal CFG generating L:
    let N := Option (Fin (k + 1))
    let rStart : Finset (ContextFreeRule (Fin (k + 1) × Bool) N) :=
      Finset.univ.image (fun j : Fin (k + 1) => ⟨none, [Symbol.nonterminal (some j)]⟩)
    let rBase : Finset (ContextFreeRule (Fin (k + 1) × Bool) N) :=
      Finset.univ.image (fun j : Fin (k + 1) => ⟨some j, [Symbol.terminal (j, false), Symbol.terminal (j, true)]⟩)
    let rRec : Finset (ContextFreeRule (Fin (k + 1) × Bool) N) :=
      Finset.univ.image (fun j : Fin (k + 1) =>
        ⟨some j, [Symbol.terminal (j, false), Symbol.nonterminal (some j), Symbol.terminal (j, true)]⟩)
    let g : ContextFreeGrammar (Fin (k + 1) × Bool) :=
      { NT := N
        initial := none
        rules := rStart ∪ rBase ∪ rRec }
    let X : N → Language (Fin (k + 1) × Bool) := fun nt => match nt with
      | none => L
      | some j => {w | ∃ n, 1 ≤ n ∧ w = List.replicate n (j, false) ++ List.replicate n (j, true)}
    have hclosed : ∀ r ∈ g.rules, evalCFG X r.output ≤ X r.input := by
      intro r hr w hw
      simp only [g, Finset.mem_union, rStart, rBase, rRec, Finset.mem_image, Finset.mem_univ,
        true_and] at hr
      rcases hr with (⟨j, rfl⟩ | ⟨j, rfl⟩) | ⟨j, rfl⟩
      · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
          evalCFGSym] at hw
        rcases hw with ⟨n, hn, rfl⟩
        exact ⟨j, n, hn, rfl⟩
      · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
          evalCFGSym] at hw
        rcases Language.mem_mul.mp hw with ⟨u, hu, v, hv, rfl⟩
        have hu' : u = [(j, false)] := hu; have hv' : v = [(j, true)] := hv
        subst hu'; subst hv'
        exact ⟨1, le_rfl, rfl⟩
      · simp only [evalCFG, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
          evalCFGSym] at hw
        rcases Language.mem_mul.mp hw with ⟨u, hu, v, hv, rfl⟩
        rcases Language.mem_mul.mp hv with ⟨v1, ⟨n, hn, rfl⟩, v2, hv2, rfl⟩
        have hu' : u = [(j, false)] := hu; have hv2' : v2 = [(j, true)] := hv2
        subst hu'; subst hv2'
        refine ⟨n + 1, by omega, ?_⟩
        rw [List.replicate_succ (n := n) (a := (j, false)),
            List.replicate_succ' (n := n) (a := (j, true))]
        simp [List.append_assoc]
    have hgen_j : ∀ (j : Fin (k + 1)) (n : ℕ), 1 ≤ n →
        g.Derives [Symbol.nonterminal (some j)]
          ((List.replicate n (j, false) ++ List.replicate n (j, true)).map Symbol.terminal) := by
      intro j n hn
      induction n with
      | zero => omega
      | succ n ih =>
        cases n with
        | zero =>
          exact Relation.ReflTransGen.single
            ⟨⟨some j, [Symbol.terminal (j, false), Symbol.terminal (j, true)]⟩,
              Finset.mem_union_left _ (Finset.mem_union_right _
                (Finset.mem_image.mpr ⟨j, Finset.mem_univ j, rfl⟩)),
              by simpa using ContextFreeRule.Rewrites.head []⟩
        | succ n' =>
          have hstep : g.Produces [Symbol.nonterminal (some j)]
              [Symbol.terminal (j, false), Symbol.nonterminal (some j), Symbol.terminal (j, true)] :=
            ⟨⟨some j, [Symbol.terminal (j, false), Symbol.nonterminal (some j), Symbol.terminal (j, true)]⟩,
              Finset.mem_union_right _ (Finset.mem_image.mpr ⟨j, Finset.mem_univ j, rfl⟩),
              by simpa using ContextFreeRule.Rewrites.head []⟩
          have hd := ((ih (by omega)).append_left [Symbol.terminal (j, false)]).append_right
            [Symbol.terminal (j, true)]
          have hrel := Relation.ReflTransGen.head hstep hd
          have heq : ([Symbol.terminal (N := N) (j, false)] ++
              (List.replicate (n' + 1) (j, false) ++ List.replicate (n' + 1) (j, true)).map Symbol.terminal ++
              [Symbol.terminal (N := N) (j, true)]) =
              (List.replicate (n' + 2) (j, false) ++ List.replicate (n' + 2) (j, true)).map Symbol.terminal := by
            rw [List.replicate_succ (n := n' + 1) (a := (j, false)),
                List.replicate_succ' (n := n' + 1) (a := (j, true))]
            simp [List.map_append, List.append_assoc]
          rw [heq] at hrel
          exact hrel
    refine ⟨g, ?_⟩
    ext w
    constructor
    · intro hw
      have hs := cfg_derives_sound_of_closed g X hclosed
        (show g.Derives [Symbol.nonterminal none] (w.map Symbol.terminal) from hw)
      simp only [evalCFG, List.map_singleton, List.prod_cons, List.prod_nil, mul_one, evalCFGSym] at hs
      exact hs
    · rintro ⟨j, n, hn, rfl⟩
      show g.Generates ((List.replicate n (j, false) ++ List.replicate n (j, true)).map Symbol.terminal)
      unfold ContextFreeGrammar.Generates
      have hstep0 : g.Produces [Symbol.nonterminal none] [Symbol.nonterminal (some j)] :=
        ⟨⟨none, [Symbol.nonterminal (some j)]⟩,
          Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_image.mpr ⟨j, Finset.mem_univ j, rfl⟩)),
          by simpa using ContextFreeRule.Rewrites.head []⟩
      exact Relation.ReflTransGen.head hstep0 (hgen_j j n hn)
  · -- Pigeonhole + Bar-Hillel Pumping Lower Bound (> k nonterminals):
    intro g _ hcard hlang
    obtain ⟨P, hP1, hpump⟩ := ppl105_cfl_pumping_lemma g
    have hex_j : ∀ j : Fin (k + 1),
        ∃ (A : g.NT) (u v x y z : List (Fin (k + 1) × Bool)),
          List.replicate P (j, false) ++ List.replicate P (j, true) = u ++ v ++ x ++ y ++ z ∧
          1 ≤ (v ++ y).length ∧
          g.Derives [Symbol.nonterminal g.initial]
            (u.map Symbol.terminal ++ [Symbol.nonterminal A] ++ z.map Symbol.terminal) ∧
          g.Derives [Symbol.nonterminal A]
            (v.map Symbol.terminal ++ [Symbol.nonterminal A] ++ y.map Symbol.terminal) ∧
          g.Derives [Symbol.nonterminal A] (x.map Symbol.terminal) := by
      intro j
      let wj := List.replicate P (j, false) ++ List.replicate P (j, true)
      have hwj_mem : wj ∈ g.language := by rw [hlang]; exact ⟨j, P, hP1, rfl⟩
      have hwj_len : P ≤ wj.length := by simp [wj]
      obtain ⟨A, u, v, x, y, z, heq, _, hvy, hdu, hdv, hdx, _⟩ := hpump wj hwj_mem hwj_len
      exact ⟨A, u, v, x, y, z, heq, hvy, hdu, hdv, hdx⟩
    let Aof : Fin (k + 1) → g.NT := fun j => Classical.choose (hex_j j)
    have hlt_card : Fintype.card g.NT < Fintype.card (Fin (k + 1)) := by
      simp only [Fintype.card_fin]; omega
    obtain ⟨j₁, j₂, hjne, hAeq⟩ := Fintype.exists_ne_map_eq_of_card_lt Aof hlt_card
    obtain ⟨u₁, v₁, x₁, y₁, z₁, hw₁, hvy₁, hdu₁, hdv₁, _⟩ := Classical.choose_spec (hex_j j₁)
    obtain ⟨u₂, v₂, x₂, y₂, z₂, hw₂, hvy₂, _, hdv₂, hdx₂⟩ := Classical.choose_spec (hex_j j₂)
    -- Cross-substitute Aof j₂ = Aof j₁ to derive a bicolored word in g.language = L:
    have hA12 : Aof j₁ = Aof j₂ := hAeq
    have hder_2 : g.Derives [Symbol.nonterminal (Aof j₁)] ((v₂ ++ x₂ ++ y₂).map Symbol.terminal) := by
      rw [hA12]
      dsimp only [Aof]
      have h1 := (hdx₂.append_left (v₂.map Symbol.terminal)).append_right (y₂.map Symbol.terminal)
      simpa [List.map_append, List.append_assoc] using hdv₂.trans h1
    have hder_mix : g.Derives [Symbol.nonterminal g.initial]
        ((u₁ ++ v₁ ++ (v₂ ++ x₂ ++ y₂) ++ y₁ ++ z₁).map Symbol.terminal) := by
      dsimp only [Aof] at hder_2
      have h1 := (hder_2.append_left (v₁.map Symbol.terminal)).append_right (y₁.map Symbol.terminal)
      have h2 := hdv₁.trans h1
      have h3 := (h2.append_left (u₁.map Symbol.terminal)).append_right (z₁.map Symbol.terminal)
      simpa [List.map_append, List.append_assoc] using hdu₁.trans h3
    have hmix_mem : u₁ ++ v₁ ++ (v₂ ++ x₂ ++ y₂) ++ y₁ ++ z₁ ∈ L := by
      rw [← hlang]; exact hder_mix
    rcases hmix_mem with ⟨j₀, n₀, _, hmix_eq⟩
    have hmono : ∀ c ∈ u₁ ++ v₁ ++ (v₂ ++ x₂ ++ y₂) ++ y₁ ++ z₁, c.1 = j₀ := by
      intro c hc
      rw [hmix_eq] at hc
      simp only [List.mem_append, List.mem_replicate] at hc
      rcases hc with ⟨_, rfl⟩ | ⟨_, rfl⟩ <;> rfl
    have hne1 : v₁ ++ y₁ ≠ [] := List.ne_nil_of_length_pos (by omega)
    have hne2 : v₂ ++ y₂ ≠ [] := List.ne_nil_of_length_pos (by omega)
    obtain ⟨c₁, hc₁⟩ := List.exists_mem_of_ne_nil (v₁ ++ y₁) hne1
    obtain ⟨c₂, hc₂⟩ := List.exists_mem_of_ne_nil (v₂ ++ y₂) hne2
    have hc₁_j₁ : c₁.1 = j₁ := by
      have hm : c₁ ∈ u₁ ++ v₁ ++ x₁ ++ y₁ ++ z₁ := by
        simp only [List.mem_append] at hc₁ ⊢
        rcases hc₁ with h | h <;> simp [h]
      rw [← hw₁] at hm
      simp only [List.mem_append, List.mem_replicate] at hm
      rcases hm with ⟨_, rfl⟩ | ⟨_, rfl⟩ <;> rfl
    have hc₂_j₂ : c₂.1 = j₂ := by
      have hm : c₂ ∈ u₂ ++ v₂ ++ x₂ ++ y₂ ++ z₂ := by
        simp only [List.mem_append] at hc₂ ⊢
        rcases hc₂ with h | h <;> simp [h]
      rw [← hw₂] at hm
      simp only [List.mem_append, List.mem_replicate] at hm
      rcases hm with ⟨_, rfl⟩ | ⟨_, rfl⟩ <;> rfl
    have hc₁_j₀ : c₁.1 = j₀ := hmono c₁ (by
      simp only [List.mem_append] at hc₁ ⊢
      rcases hc₁ with h | h <;> simp [h])
    have hc₂_j₀ : c₂.1 = j₀ := hmono c₂ (by
      simp only [List.mem_append] at hc₂ ⊢
      rcases hc₂ with h | h <;> simp [h])
    exact hjne (hc₁_j₁.symm.trans (hc₁_j₀.trans (hc₂_j₀.symm.trans hc₂_j₂)))

/-- **2-Nonterminal Boolean Grammar Collapse of Gruska's CFG Witness Family (PPL 153):**
For EVERY `k : ℕ`, the exact same language `L_k` that requires `> k` nonterminals in any CFG
is generated by an ε-free, unit-free **2-nonterminal Boolean grammar** (`Fin 2`, independent of `k`!),
using conjuncts of length at most `3`. -/
theorem ppl153_boolean_two_nonterminal_collapse (k : ℕ) :
    let Alph := Fin (k + 1) × Bool
    let L : Language Alph :=
      {w | ∃ (j : Fin (k + 1)) (n : ℕ), 1 ≤ n ∧
        w = List.replicate n (j, false) ++ List.replicate n (j, true)}
    ∃ (G : Fin 2 → List (List (List (Alph ⊕ Fin 2)) × List (List (Alph ⊕ Fin 2))))
      (X : Fin 2 → Language Alph),
      (∀ i : Fin 2, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
        1 ≤ γ.length ∧ γ.length ≤ 3 ∧ ∀ j : Fin 2, γ ≠ [Sum.inr j]) ∧
      (∀ i : Fin 2, ∀ w : List Alph, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language Alph)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language Alph)) X)).prod)) ∧
      X 1 = L := by
  classical
  intro Alph L
  let allSig : List Alph := (Finset.univ : Finset Alph).toList
  have hmem_allSig : ∀ σ : Alph, σ ∈ allSig := fun σ => Finset.mem_toList.mpr (Finset.mem_univ σ)
  let allJ : List (Fin (k + 1)) := (Finset.univ : Finset (Fin (k + 1))).toList
  have hmem_allJ : ∀ j : Fin (k + 1), j ∈ allJ := fun j => Finset.mem_toList.mpr (Finset.mem_univ j)
  let forbidSig (σ : Alph) : List (List (Alph ⊕ Fin 2)) :=
    [[Sum.inl σ], [Sum.inl σ, Sum.inr 0], [Sum.inr 0, Sum.inl σ], [Sum.inr 0, Sum.inl σ, Sum.inr 0]]
  let badNegs (j : Fin (k + 1)) : List (List (Alph ⊕ Fin 2)) :=
    (allSig.filter (fun σ => decide (σ.1 ≠ j))).flatMap forbidSig
  let G : Fin 2 → List (List (List (Alph ⊕ Fin 2)) × List (List (Alph ⊕ Fin 2))) := fun i =>
    match i with
    | ⟨0, _⟩ => allSig.flatMap (fun σ => [([[Sum.inl σ]], []), ([[Sum.inl σ, Sum.inr 0]], [])])
    | ⟨1, _⟩ => allJ.flatMap (fun j =>
        [([[Sum.inl (j, false), Sum.inl (j, true)]], []),
         ([[Sum.inl (j, false), Sum.inr 1, Sum.inl (j, true)]], badNegs j)])
  let L_ne : Language Alph := {w : List Alph | w ≠ []}
  let X : Fin 2 → Language Alph := fun i => match i with
    | ⟨0, _⟩ => L_ne
    | ⟨1, _⟩ => L
  have hforbid_iff : ∀ (σ : Alph) (w : List Alph),
      (∀ δ ∈ forbidSig σ, w ∉ evalSF X δ) ↔ σ ∉ w := by
    intro σ w
    simp only [forbidSig, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
    have h1 : w ∈ evalSF X [Sum.inl σ] ↔ w = [σ] := mem_evalSF_singleton_inl X σ w
    have h2 : w ∈ evalSF X [Sum.inl σ, Sum.inr 0] ↔ ∃ v : List Alph, v ≠ [] ∧ [σ] ++ v = w := by
      simp only [evalSF, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        Sum.elim_inl, Sum.elim_inr, Language.mem_mul]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩; have hu' : u = [σ] := hu; subst hu'; exact ⟨v, hv, rfl⟩
      · rintro ⟨v, hv, rfl⟩; exact ⟨[σ], rfl, v, hv, rfl⟩
    have h3 : w ∈ evalSF X [Sum.inr 0, Sum.inl σ] ↔ ∃ u : List Alph, u ≠ [] ∧ u ++ [σ] = w := by
      simp only [evalSF, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        Sum.elim_inl, Sum.elim_inr, Language.mem_mul]
      constructor
      · rintro ⟨u, hu, v, hv, rfl⟩; have hv' : v = [σ] := hv; subst hv'; exact ⟨u, hu, rfl⟩
      · rintro ⟨u, hu, rfl⟩; exact ⟨u, hu, [σ], rfl, rfl⟩
    have h4 : w ∈ evalSF X [Sum.inr 0, Sum.inl σ, Sum.inr 0] ↔
        ∃ u v : List Alph, u ≠ [] ∧ v ≠ [] ∧ u ++ [σ] ++ v = w := by
      simp only [evalSF, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
        Sum.elim_inl, Sum.elim_inr, Language.mem_mul]
      constructor
      · rintro ⟨u, hu, _, ⟨s, hs, v, hv, rfl⟩, rfl⟩
        have hs' : s = [σ] := hs; subst hs'
        exact ⟨u, v, hu, hv, by simp [List.append_assoc]⟩
      · rintro ⟨u, v, hu, hv, rfl⟩
        exact ⟨u, hu, [σ] ++ v, ⟨[σ], rfl, v, hv, rfl⟩, by simp [List.append_assoc]⟩
    rw [h1, h2, h3, h4]
    constructor
    · rintro ⟨hn1, hn2, hn3, hn4⟩ hmem
      obtain ⟨u, v, rfl⟩ := List.append_of_mem hmem
      cases u with
      | nil =>
        cases v with
        | nil => exact hn1 rfl
        | cons b tl => exact hn2 ⟨b :: tl, by simp, rfl⟩
      | cons a tl =>
        cases v with
        | nil => exact hn3 ⟨a :: tl, by simp, by simp⟩
        | cons b tl' => exact hn4 ⟨a :: tl, b :: tl', by simp, by simp, by simp [List.append_assoc]⟩
    · intro hnot
      refine ⟨?_, ?_, ?_, ?_⟩
      · rintro rfl; exact hnot (List.mem_singleton_self _)
      · rintro ⟨v, _, rfl⟩; exact hnot (by simp)
      · rintro ⟨u, _, rfl⟩; exact hnot (by simp)
      · rintro ⟨u, v, _, _, rfl⟩; exact hnot (by simp)
  have hbad_iff : ∀ (j : Fin (k + 1)) (w : List Alph),
      (∀ δ ∈ badNegs j, w ∉ evalSF X δ) ↔ ∀ σ ∈ w, σ.1 = j := by
    intro j w
    simp only [badNegs, List.mem_flatMap, List.mem_filter, decide_eq_true_eq]
    constructor
    · intro hall σ hσ
      by_contra hne
      have hforb : ∀ δ ∈ forbidSig σ, w ∉ evalSF X δ := fun δ hδ =>
        hall δ ⟨σ, ⟨hmem_allSig σ, hne⟩, hδ⟩
      exact (hforbid_iff σ w).mp hforb hσ
    · rintro hall δ ⟨σ, ⟨_, hne⟩, hδ⟩
      have hnot : σ ∉ w := fun hσ => hne (hall σ hσ)
      exact (hforbid_iff σ w).mpr hnot δ hδ
  refine ⟨G, X, ?_, ?_, rfl⟩
  · intro i r hr γ hγ
    fin_cases i
    · simp only [G, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with ⟨σ, _, rfl | rfl⟩ <;>
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        exact ⟨by simp, by simp, fun j hj => by simp at hj⟩
    · simp only [G, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with ⟨j, _, rfl | rfl⟩
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        exact ⟨by simp, by simp, fun j' hj' => by simp at hj'⟩
      · simp only [List.cons_append, List.nil_append, List.mem_cons] at hγ
        rcases hγ with rfl | hbad
        · exact ⟨by simp, by simp, fun j' hj' => by simp at hj'⟩
        · simp only [badNegs, List.mem_flatMap, forbidSig, List.mem_cons, List.not_mem_nil,
            or_false] at hbad
          rcases hbad with ⟨σ, _, rfl | rfl | rfl | rfl⟩ <;>
            exact ⟨by simp, by simp, fun j' hj' => by simp at hj'⟩
  · intro i w
    fin_cases i
    · change w ≠ [] ↔ _
      simp only [G, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false]
      constructor
      · intro hne
        refine ⟨hne, ?_⟩
        rcases w with _ | ⟨σ, _ | ⟨τ, tl⟩⟩
        · exact (hne rfl).elim
        · exact ⟨([[Sum.inl σ]], []), ⟨σ, hmem_allSig σ, Or.inl rfl⟩,
            fun γ hγ => by simp at hγ; subst hγ; exact (mem_evalSF_singleton_inl X σ [σ]).mpr rfl,
            by simp⟩
        · refine ⟨([[Sum.inl σ, Sum.inr 0]], []), ⟨σ, hmem_allSig σ, Or.inr rfl⟩, ?_, by simp⟩
          intro γ hγ; rw [List.mem_singleton.mp hγ]
          simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
            Sum.elim_inl, Sum.elim_inr, Language.mem_mul]
          exact ⟨[σ], rfl, τ :: tl, by change τ :: tl ≠ []; simp, rfl⟩
      · exact And.left
    · change (∃ j n, 1 ≤ n ∧ w = List.replicate n (j, false) ++ List.replicate n (j, true)) ↔ _
      simp only [G, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false]
      constructor
      · rintro ⟨j, n, hn, rfl⟩
        refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
        cases n with
        | zero => omega
        | succ n' =>
          cases n' with
          | zero =>
            refine ⟨([[Sum.inl (j, false), Sum.inl (j, true)]], []), ⟨j, hmem_allJ j, Or.inl rfl⟩,
              ?_, by simp⟩
            intro γ hγ; rw [List.mem_singleton.mp hγ]
            simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
              Sum.elim_inl, Language.mem_mul]
            exact ⟨[(j, false)], rfl, [(j, true)], rfl, rfl⟩
          | succ n'' =>
            refine ⟨([[Sum.inl (j, false), Sum.inr 1, Sum.inl (j, true)]], badNegs j),
              ⟨j, hmem_allJ j, Or.inr rfl⟩, ?_, ?_⟩
            · intro γ hγ; rw [List.mem_singleton.mp hγ]
              simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
                Sum.elim_inl, Sum.elim_inr, Language.mem_mul]
              refine ⟨[(j, false)], rfl,
                (List.replicate (n'' + 1) (j, false) ++ List.replicate (n'' + 1) (j, true)) ++ [(j, true)],
                ⟨List.replicate (n'' + 1) (j, false) ++ List.replicate (n'' + 1) (j, true),
                  ⟨j, n'' + 1, by omega, rfl⟩, [(j, true)], rfl, rfl⟩, ?_⟩
              rw [List.replicate_succ (n := n'' + 1) (a := (j, false)),
                  List.replicate_succ' (n := n'' + 1) (a := (j, true))]
              simp [List.append_assoc]
            · exact (hbad_iff j _).mpr fun σ hσ => by
                simp only [List.mem_append, List.mem_replicate] at hσ
                rcases hσ with ⟨_, rfl⟩ | ⟨_, rfl⟩ <;> rfl
      · rintro ⟨_, _, ⟨j, _, rfl | rfl⟩, hp, hn⟩
        · have h := hp _ (List.mem_singleton_self _)
          simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
            Sum.elim_inl, Language.mem_mul] at h
          rcases h with ⟨u, hu, v, hv, rfl⟩
          have hu' : u = [(j, false)] := hu; have hv' : v = [(j, true)] := hv
          subst hu'; subst hv'
          exact ⟨j, 1, le_rfl, rfl⟩
        · have h := hp _ (List.mem_singleton_self _)
          simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
            Sum.elim_inl, Sum.elim_inr, Language.mem_mul] at h
          rcases h with ⟨u0, hu0, _, ⟨uM, ⟨j', n', hn', rfl⟩, u1, hu1, rfl⟩, rfl⟩
          have hu0' : u0 = [(j, false)] := hu0; have hu1' : u1 = [(j, true)] := hu1
          subst hu0'; subst hu1'
          have hall := (hbad_iff j _).mp hn
          have hj_eq : j' = j := by
            have hmem : (j', false) ∈ [(j, false)] ++
                ((List.replicate n' (j', false) ++ List.replicate n' (j', true)) ++ [(j, true)]) := by
              simp only [List.mem_append, List.mem_replicate]
              exact Or.inr (Or.inl (Or.inl ⟨by omega, trivial⟩))
            exact hall (j', false) hmem
          subst hj_eq
          refine ⟨j', n' + 1, by omega, ?_⟩
          rw [List.replicate_succ (n := n') (a := (j', false)),
              List.replicate_succ' (n := n') (a := (j', true))]
          simp [List.append_assoc]

/-- **BNF Counting Impossibility Barrier for Universal Nonterminal Bound `k` (PPL 153):**
Over any finite nonempty alphabet `[Fintype α] [Nonempty α]`, for every `k : ℕ`, the family of
languages generated by `k`-nonterminal Okhotin BNF Boolean grammars is **finite**, so there exists
a singleton language `{a₀^n}` (`n ≥ 1`) generated by NO `k`-nonterminal BNF Boolean grammar.
This proves that any positive resolution of PPL 153 MUST exploit unbounded conjunct length. -/
theorem ppl153_bnf_no_universal_k {α : Type*} [Fintype α] [Nonempty α] (k : ℕ) :
    let BNF_k : Set (Language α) := {L | ∃ (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language α),
      (∀ i : Fin k, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) ∧
      (∀ i : Fin k, ∀ w : List α, w ∈ X i ↔
        w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) ∧
      X s = L}
    BNF_k.Finite ∧
    ∀ a₀ : α, ∃ n : ℕ, 1 ≤ n ∧ ({List.replicate n a₀} : Language α) ∉ BNF_k := by
  classical
  intro BNF_k
  -- Semantic signature of a BNF grammar on Fin k: finite!
  let Sig := Fin k → Finset α × Finset (Finset (Fin k × Fin k) × Finset (Fin k × Fin k))
  let pairOf : List (α ⊕ Fin k) → Option (Fin k × Fin k) := fun γ =>
    match γ with
    | [Sum.inr B, Sum.inr C] => some (B, C)
    | _ => none
  let termOf : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)) → Option α := fun r =>
    match r with
    | ([[Sum.inl a]], []) => some a
    | _ => none
  let binOf : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)) →
      Option (Finset (Fin k × Fin k) × Finset (Fin k × Fin k)) := fun r =>
    if r.1 ≠ [] ∧ (r.1 ++ r.2).all (fun γ => (pairOf γ).isSome) then
      some ((r.1.filterMap pairOf).toFinset, (r.2.filterMap pairOf).toFinset)
    else none
  let sigOf (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)))) : Sig :=
    fun i => ((G i).filterMap termOf |>.toFinset, (G i).filterMap binOf |>.toFinset)
  have hbnf_wf : ∀ (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k)))),
      (∀ i, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) →
      ∃ rank : Fin k → ℕ, ∀ i, ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2,
        γ ≠ [] ∧ ∀ j : Fin k, γ = [Sum.inr j] → rank j < rank i := by
    intro G hbnf
    refine ⟨fun _ => 0, fun i r hr γ hγ => ?_⟩
    rcases hbnf i r hr with ⟨a, rfl⟩ | ⟨_, hbin⟩
    · simp at hγ; subst hγ; exact ⟨by simp, fun j hj => by simp at hj⟩
    · obtain ⟨B, C, rfl⟩ := hbin γ hγ
      exact ⟨by simp, fun j hj => by simp at hj⟩
  have hcond_eq : ∀ (G₁ G₂ : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
      (h₁ : ∀ i, ∀ r ∈ G₁ i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C]))
      (h₂ : ∀ i, ∀ r ∈ G₂ i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])),
      sigOf G₁ = sigOf G₂ →
      ∀ (X : Fin k → Language α) (i : Fin k) (w : List α),
        boolCond G₁ X i w ↔ boolCond G₂ X i w := by
    intro G₁ G₂ h₁ h₂ hsig X i w
    have hside : ∀ (G G' : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
        (hG : ∀ i, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
          (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C]))
        (hG' : ∀ i, ∀ r ∈ G' i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
          (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])),
        sigOf G i = sigOf G' i → boolCond G X i w → boolCond G' X i w := by
      intro G G' hG hG' hsi ⟨r, hr, hp, hn⟩
      rcases hG i r hr with ⟨a, rfl⟩ | ⟨hpos, hbin⟩
      · have ha : a ∈ (sigOf G i).1 := by
          simp only [sigOf, List.mem_toFinset, List.mem_filterMap]
          exact ⟨([[Sum.inl a]], []), hr, rfl⟩
        rw [hsi] at ha
        simp only [sigOf, List.mem_toFinset, List.mem_filterMap] at ha
        rcases ha with ⟨r', hr', hterm'⟩
        rcases hG' i r' hr' with ⟨a', rfl⟩ | ⟨hpos', hbin'⟩
        · simp only [termOf, Option.some.injEq] at hterm'
          subst hterm'
          exact ⟨([[Sum.inl a']], []), hr', hp, hn⟩
        · rcases r' with ⟨r1, r2⟩
          cases r1 with
          | nil => exact (hpos' rfl).elim
          | cons γ rest =>
            obtain ⟨B, C, hγ⟩ := hbin' γ (by simp)
            subst hγ
            simp [termOf] at hterm'
      · have hall_some : (r.1 ++ r.2).all (fun γ => (pairOf γ).isSome) = true := by
          rw [List.all_eq_true]
          intro γ hγ
          obtain ⟨B, C, rfl⟩ := hbin γ hγ
          rfl
        have hb : ((r.1.filterMap pairOf).toFinset, (r.2.filterMap pairOf).toFinset) ∈ (sigOf G i).2 := by
          simp only [sigOf, List.mem_toFinset, List.mem_filterMap]
          refine ⟨r, hr, ?_⟩
          dsimp only [binOf]
          rw [if_pos ⟨hpos, hall_some⟩]
        rw [hsi] at hb
        simp only [sigOf, List.mem_toFinset, List.mem_filterMap] at hb
        rcases hb with ⟨r', hr', hbin'⟩
        dsimp only [binOf] at hbin'
        split_ifs at hbin' with hc'
        simp only [Option.some.injEq, Prod.mk.injEq] at hbin'
        rcases hbin' with ⟨hp_eq, hn_eq⟩
        refine ⟨r', hr', ?_, ?_⟩
        · intro γ' hγ'
          rcases hG' i r' hr' with ⟨a', rfl⟩ | ⟨_, hbin_r'⟩
          · simp [pairOf] at hc'
          · obtain ⟨B, C, rfl⟩ := hbin_r' γ' (List.mem_append_left _ hγ')
            have hmem : (B, C) ∈ (r'.1.filterMap pairOf).toFinset := by
              rw [List.mem_toFinset, List.mem_filterMap]
              exact ⟨[Sum.inr B, Sum.inr C], hγ', rfl⟩
            rw [hp_eq, List.mem_toFinset, List.mem_filterMap] at hmem
            rcases hmem with ⟨γ, hγ, hpair⟩
            obtain ⟨B', C', rfl⟩ := hbin γ (List.mem_append_left _ hγ)
            simp only [pairOf, Option.some.injEq, Prod.mk.injEq] at hpair
            rcases hpair with ⟨rfl, rfl⟩
            exact hp _ hγ
        · intro δ' hδ'
          rcases hG' i r' hr' with ⟨a', rfl⟩ | ⟨_, hbin_r'⟩
          · simp at hδ'
          · obtain ⟨B, C, rfl⟩ := hbin_r' δ' (List.mem_append_right _ hδ')
            have hmem : (B, C) ∈ (r'.2.filterMap pairOf).toFinset := by
              rw [List.mem_toFinset, List.mem_filterMap]
              exact ⟨[Sum.inr B, Sum.inr C], hδ', rfl⟩
            rw [hn_eq, List.mem_toFinset, List.mem_filterMap] at hmem
            rcases hmem with ⟨δ, hδ, hpair⟩
            obtain ⟨B', C', rfl⟩ := hbin δ (List.mem_append_right _ hδ)
            simp only [pairOf, Option.some.injEq, Prod.mk.injEq] at hpair
            rcases hpair with ⟨rfl, rfl⟩
            exact hn _ hδ
    exact ⟨hside G₁ G₂ h₁ h₂ (congrFun hsig i), hside G₂ G₁ h₂ h₁ (congrFun hsig.symm i)⟩
  have hfin : BNF_k.Finite := by
    -- Inject BNF_k into the finite type `Sig × Fin k`:
    let toKey : BNF_k → Sig × Fin k := fun L =>
      let G := Classical.choose L.2
      let s := Classical.choose (Classical.choose_spec L.2)
      (sigOf G, s)
    have hinj : Function.Injective toKey := by
      intro ⟨L₁, hL₁⟩ ⟨L₂, hL₂⟩ hkey
      simp only [toKey, Prod.mk.injEq] at hkey
      rcases hkey with ⟨hsig_eq, hs_eq⟩
      let G₁ := Classical.choose hL₁
      let s₁ := Classical.choose (Classical.choose_spec hL₁)
      let X₁ := Classical.choose (Classical.choose_spec (Classical.choose_spec hL₁))
      have hspec₁ := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec hL₁))
      let G₂ := Classical.choose hL₂
      let s₂ := Classical.choose (Classical.choose_spec hL₂)
      let X₂ := Classical.choose (Classical.choose_spec (Classical.choose_spec hL₂))
      have hspec₂ := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec hL₂))
      have hX₂_sol₁ : ∀ i w, w ∈ X₂ i ↔ w ≠ [] ∧ boolCond G₁ X₂ i w := by
        intro i w
        rw [hspec₂.2.1 i w]
        exact and_congr_right fun _ => (hcond_eq G₁ G₂ hspec₁.1 hspec₂.1 hsig_eq X₂ i w).symm
      obtain ⟨Z, _, hZuniq⟩ := ppl105_boolean_grammar_unique_solution G₁ (hbnf_wf G₁ hspec₁.1)
      have hX12 : X₁ = X₂ := (hZuniq X₁ hspec₁.2.1).trans (hZuniq X₂ hX₂_sol₁).symm
      have hL1_eq : X₁ s₁ = L₁ := hspec₁.2.2
      have hL2_eq : X₂ s₂ = L₂ := hspec₂.2.2
      have hs12 : s₁ = s₂ := hs_eq
      apply Subtype.ext
      change L₁ = L₂
      rw [← hL1_eq, ← hL2_eq, hX12, hs12]
    exact Set.finite_coe_iff.mp (Finite.of_injective toKey hinj)
  refine ⟨hfin, fun a₀ => ?_⟩
  by_contra hall
  push Not at hall
  have hinf : (Set.range (fun n : ℕ => ({List.replicate (n + 1) a₀} : Language α))).Infinite := by
    refine Set.infinite_range_of_injective fun m n hmn => ?_
    have hmem : List.replicate (m + 1) a₀ ∈ ({List.replicate (n + 1) a₀} : Language α) := by
      rw [← hmn]; rfl
    have heq : List.replicate (m + 1) a₀ = List.replicate (n + 1) a₀ := hmem
    have hlen := congrArg List.length heq
    simp at hlen
    exact hlen
  have hsub : Set.range (fun n : ℕ => ({List.replicate (n + 1) a₀} : Language α)) ⊆ BNF_k := by
    rintro _ ⟨n, rfl⟩
    exact hall (n + 1) (by omega)
  exact hinf (hfin.subset hsub)

section ParikhUnambigPrivate

private def parikhBNF :
    Fin 10 → List (List (List (Fin 3 ⊕ Fin 10)) × List (List (Fin 3 ⊕ Fin 10)))
  | ⟨0, _⟩ => [([[Sum.inl 0]], [])]
  | ⟨1, _⟩ => [([[Sum.inl 1]], [])]
  | ⟨2, _⟩ => [([[Sum.inl 2]], [])]
  | ⟨3, _⟩ => [([[Sum.inr 0, Sum.inr 1]], []), ([[Sum.inr 0, Sum.inr 4]], [])]
  | ⟨4, _⟩ => [([[Sum.inr 3, Sum.inr 1]], [])]
  | ⟨5, _⟩ => [([[Sum.inl 2]], []), ([[Sum.inr 2, Sum.inr 5]], [])]
  | ⟨6, _⟩ => [([[Sum.inl 0]], []), ([[Sum.inr 0, Sum.inr 6]], [])]
  | ⟨7, _⟩ => [([[Sum.inr 1, Sum.inr 2]], []), ([[Sum.inr 1, Sum.inr 8]], [])]
  | ⟨8, _⟩ => [([[Sum.inr 7, Sum.inr 2]], [])]
  | ⟨9, _⟩ => [([[Sum.inr 3, Sum.inr 5]], []), ([[Sum.inr 6, Sum.inr 7]], [[Sum.inr 3, Sum.inr 5]])]

private def parikhSol : Fin 10 → Language (Fin 3)
  | ⟨9, _⟩ => {w | ∃ i j k, 1 ≤ i ∧ 1 ≤ j ∧ 1 ≤ k ∧ (i = j ∨ j = k) ∧
      w = List.replicate i 0 ++ List.replicate j 1 ++ List.replicate k 2}
  | i => anbncnSol i

private lemma list_append_eq_of_len_eq {α : Type*} {u₁ v₁ u₂ v₂ : List α}
    (heq : u₁ ++ v₁ = u₂ ++ v₂) (hlen : u₁.length = u₂.length) : u₁ = u₂ ∧ v₁ = v₂ := by
  have hu : u₁ = u₂ := by
    have h1 := congrArg (List.take u₁.length) heq
    rw [List.take_left, hlen, List.take_left] at h1
    exact h1
  subst hu
  exact ⟨rfl, List.append_cancel_left heq⟩

end ParikhUnambigPrivate

/-- **Unambiguous BNF Boolean Resolution of Parikh's Inherently Ambiguous CFL (PPL 166):**
The classical inherently ambiguous context-free language
`L_amb = { a^i b^j c^k | i, j, k ≥ 1 ∧ (i = j ∨ j = k) }` IS generated by an explicit
10-nonterminal **unambiguous** Okhotin BNF Boolean grammar (unique matching rule index AND
unique binary factorization for every binary conjunct). -/
theorem ppl166_parikh_amb_unambiguous_boolean :
    ∃ (k : ℕ) (G : Fin k → List (List (List (Fin 3 ⊕ Fin k)) × List (List (Fin 3 ⊕ Fin k))))
      (s : Fin k) (X : Fin k → Language (Fin 3)),
      -- 1. Okhotin Binary Normal Form:
      (∀ i, ∀ r ∈ G i, (∃ a : Fin 3, r = ([[Sum.inl a]], [])) ∨
        (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) ∧
      -- 2. Exact Boolean grammar solution:
      (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
        (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod) ∧
        (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod)) ∧
      -- 3. Disjoint rule selection (at most one rule index matches any word):
      (∀ (i : Fin k) (w : List (Fin 3)) (p₁ p₂ : Fin (G i).length),
        ((∀ γ ∈ (G i)[p₁].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod) ∧
         (∀ δ ∈ (G i)[p₁].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod)) →
        ((∀ γ ∈ (G i)[p₂].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod) ∧
         (∀ δ ∈ (G i)[p₂].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language (Fin 3))) X)).prod)) →
        p₁ = p₂) ∧
      -- 4. Unique binary factorization for every binary conjunct:
      (∀ (i : Fin k), ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, ∀ B C : Fin k, γ = [Sum.inr B, Sum.inr C] →
        ∀ u₁ v₁ u₂ v₂ : List (Fin 3),
          u₁ ∈ X B → v₁ ∈ X C → u₂ ∈ X B → v₂ ∈ X C → u₁ ++ v₁ = u₂ ++ v₂ → u₁ = u₂ ∧ v₁ = v₂) ∧
      -- 5. Target language is Parikh's inherently ambiguous CFL:
      X s = ({w : List (Fin 3) | ∃ i j k : ℕ, 1 ≤ i ∧ 1 ≤ j ∧ 1 ≤ k ∧ (i = j ∨ j = k) ∧
        w = List.replicate i 0 ++ List.replicate j 1 ++ List.replicate k 2} : Language (Fin 3)) := by
  have hAC : ∀ w : List (Fin 3), w ∈ evalSF parikhSol [Sum.inr 3, Sum.inr 5] ↔
      ∃ m k, 1 ≤ m ∧ 1 ≤ k ∧ w = List.replicate m 0 ++ List.replicate m 1 ++ List.replicate k 2 := by
    intro w
    rw [mem_evalSF_pair]
    change (∃ u, (∃ m, 1 ≤ m ∧ u = List.replicate m 0 ++ List.replicate m 1) ∧
      ∃ v, (∃ k, 1 ≤ k ∧ v = List.replicate k 2) ∧ u ++ v = w) ↔ _
    constructor
    · rintro ⟨_, ⟨m, hm, rfl⟩, _, ⟨k, hk, rfl⟩, rfl⟩; exact ⟨m, k, hm, hk, rfl⟩
    · rintro ⟨m, k, hm, hk, rfl⟩
      exact ⟨List.replicate m 0 ++ List.replicate m 1, ⟨m, hm, rfl⟩, List.replicate k 2, ⟨k, hk, rfl⟩, rfl⟩
  have hAB : ∀ w : List (Fin 3), w ∈ evalSF parikhSol [Sum.inr 6, Sum.inr 7] ↔
      ∃ k n, 1 ≤ k ∧ 1 ≤ n ∧ w = List.replicate k 0 ++ List.replicate n 1 ++ List.replicate n 2 := by
    intro w
    rw [mem_evalSF_pair]
    change (∃ u, (∃ k, 1 ≤ k ∧ u = List.replicate k 0) ∧
      ∃ v, (∃ n, 1 ≤ n ∧ v = List.replicate n 1 ++ List.replicate n 2) ∧ u ++ v = w) ↔ _
    constructor
    · rintro ⟨_, ⟨k, hk, rfl⟩, _, ⟨n, hn, rfl⟩, rfl⟩; exact ⟨k, n, hk, hn, by simp [List.append_assoc]⟩
    · rintro ⟨k, n, hk, hn, rfl⟩
      exact ⟨List.replicate k 0, ⟨k, hk, rfl⟩, List.replicate n 1 ++ List.replicate n 2, ⟨n, hn, rfl⟩,
        by simp [List.append_assoc]⟩
  refine ⟨10, parikhBNF, 9, parikhSol, ?_, ?_, ?_, ?_, rfl⟩
  · -- 1. BNF
    intro i r hr
    fin_cases i <;> simp [parikhBNF] at hr
    · subst hr; exact Or.inl ⟨0, rfl⟩
    · subst hr; exact Or.inl ⟨1, rfl⟩
    · subst hr; exact Or.inl ⟨2, rfl⟩
    · rcases hr with rfl | rfl
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨0, 1, rfl⟩⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨0, 4, rfl⟩⟩
    · subst hr; exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨3, 1, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inl ⟨2, rfl⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨2, 5, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inl ⟨0, rfl⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨0, 6, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨1, 2, rfl⟩⟩
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨1, 8, rfl⟩⟩
    · subst hr; exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨7, 2, rfl⟩⟩
    · rcases hr with rfl | rfl
      · exact Or.inr ⟨by simp, fun γ hγ => by simp at hγ; subst hγ; exact ⟨3, 5, rfl⟩⟩
      · refine Or.inr ⟨by simp, fun γ hγ => ?_⟩
        simp at hγ; rcases hγ with rfl | rfl
        · exact ⟨6, 7, rfl⟩
        · exact ⟨3, 5, rfl⟩
  · -- 2. Solution validity
    intro i w
    have hlt9_sol : ∀ j : Fin 10, j.1 < 9 → parikhSol j = anbncnSol j := by
      intro ⟨j, hj⟩ hlt
      match j, hj, hlt with
      | 0, _, _ | 1, _, _ | 2, _, _ | 3, _, _ | 4, _, _
      | 5, _, _ | 6, _, _ | 7, _, _ | 8, _, _ => rfl
    have hlt9_bnf : ∀ j : Fin 10, j.1 < 9 → parikhBNF j = anbncnBNF j := by
      intro ⟨j, hj⟩ hlt
      match j, hj, hlt with
      | 0, _, _ | 1, _, _ | 2, _, _ | 3, _, _ | 4, _, _
      | 5, _, _ | 6, _, _ | 7, _, _ | 8, _, _ => rfl
    have heval_lt9 : ∀ γ : List (Fin 3 ⊕ Fin 10),
        (∀ j : Fin 10, Sum.inr j ∈ γ → j.1 < 9) →
        evalSF parikhSol γ = evalSF anbncnSol γ := by
      intro γ hγ
      unfold evalSF
      congr 1
      apply List.map_congr_left
      intro x hx
      cases x with
      | inl a => rfl
      | inr j => exact hlt9_sol j (hγ j hx)
    have hlt9_ref : ∀ j : Fin 10, j.1 < 9 → ∀ r ∈ parikhBNF j, ∀ γ ∈ r.1 ++ r.2,
        ∀ m : Fin 10, Sum.inr m ∈ γ → m.1 < 9 := by
      intro j hj r hr γ hγ m hm
      fin_cases j
      · dsimp only [parikhBNF] at hr; simp only [List.mem_singleton] at hr; subst hr
        simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.mem_singleton, reduceCtorEq] at hm
      · dsimp only [parikhBNF] at hr; simp only [List.mem_singleton] at hr; subst hr
        simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.mem_singleton, reduceCtorEq] at hm
      · dsimp only [parikhBNF] at hr; simp only [List.mem_singleton] at hr; subst hr
        simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.mem_singleton, reduceCtorEq] at hm
      · dsimp only [parikhBNF] at hr; simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl <;>
        · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
          simp only [List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hm
          rcases hm with rfl | rfl <;> decide
      · dsimp only [parikhBNF] at hr; simp only [List.mem_singleton] at hr; subst hr
        simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hm
        rcases hm with rfl | rfl <;> decide
      · dsimp only [parikhBNF] at hr; simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl
        · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
          simp only [List.mem_singleton, reduceCtorEq] at hm
        · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
          simp only [List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hm
          rcases hm with rfl | rfl <;> decide
      · dsimp only [parikhBNF] at hr; simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl
        · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
          simp only [List.mem_singleton, reduceCtorEq] at hm
        · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
          simp only [List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hm
          rcases hm with rfl | rfl <;> decide
      · dsimp only [parikhBNF] at hr; simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl <;>
        · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
          simp only [List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hm
          rcases hm with rfl | rfl <;> decide
      · dsimp only [parikhBNF] at hr; simp only [List.mem_singleton] at hr; subst hr
        simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hm
        rcases hm with rfl | rfl <;> decide
      · simp at hj
    by_cases hi9 : i.1 < 9
    · rw [hlt9_sol i hi9, anbncnSol_valid i w]
      refine and_congr_right fun _ => ?_
      unfold boolCond
      rw [← hlt9_bnf i hi9]
      refine exists_congr fun r => and_congr_right fun hr => and_congr ?_ ?_
      · refine forall_congr' fun γ => imp_congr_right fun hγ => ?_
        change w ∈ evalSF anbncnSol γ ↔ w ∈ evalSF parikhSol γ
        rw [heval_lt9 γ (hlt9_ref i hi9 r hr γ (List.mem_append_left _ hγ))]
      · refine forall_congr' fun δ => imp_congr_right fun hδ => ?_
        change w ∉ evalSF anbncnSol δ ↔ w ∉ evalSF parikhSol δ
        rw [heval_lt9 δ (hlt9_ref i hi9 r hr δ (List.mem_append_right _ hδ))]
    · have hi : i = 9 := Fin.ext (by omega)
      subst hi
      change (∃ i j k, 1 ≤ i ∧ 1 ≤ j ∧ 1 ≤ k ∧ (i = j ∨ j = k) ∧
        w = List.replicate i 0 ++ List.replicate j 1 ++ List.replicate k 2) ↔ _
      simp only [parikhBNF, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp,
        exists_eq_left, forall_eq, false_implies, forall_const, and_true]
      change _ ↔ w ≠ [] ∧ (w ∈ evalSF parikhSol [Sum.inr 3, Sum.inr 5] ∨
        (w ∈ evalSF parikhSol [Sum.inr 6, Sum.inr 7] ∧ w ∉ evalSF parikhSol [Sum.inr 3, Sum.inr 5]))
      rw [hAC, hAB]
      constructor
      · rintro ⟨a, b, c, ha, hb, hc, rfl | rfl, rfl⟩
        · exact ⟨by intro h; have := congrArg List.length h; simp at this; omega,
            Or.inl ⟨a, c, ha, hc, rfl⟩⟩
        · refine ⟨by intro h; have := congrArg List.length h; simp at this; omega, ?_⟩
          exact (Classical.em _).elim Or.inl (fun hnot => Or.inr ⟨⟨a, _, ha, hb, rfl⟩, hnot⟩)
      · rintro ⟨_, ⟨m, k, hm, hk, rfl⟩ | ⟨⟨k, n, hk, hn, rfl⟩, _⟩⟩
        · exact ⟨m, m, k, hm, hm, hk, Or.inl rfl, rfl⟩
        · exact ⟨k, n, n, hk, hn, hn, Or.inr rfl, rfl⟩
  · -- 3. Disjoint rule selection
    intro i w p₁ p₂ h₁ h₂
    fin_cases i
    · fin_cases p₁; fin_cases p₂; rfl
    · fin_cases p₁; fin_cases p₂; rfl
    · fin_cases p₁; fin_cases p₂; rfl
    · fin_cases p₁ <;> fin_cases p₂
      · rfl
      · exfalso
        have hlen2 : w.length = 2 := by
          have hm := h₁.1 [Sum.inr 0, Sum.inr 1] (List.mem_singleton_self _)
          rcases (mem_evalSF_pair parikhSol 0 1 w).mp hm with ⟨u, hu, v, hv, rfl⟩
          have hu' : u = [0] := hu; have hv' : v = [1] := hv; subst hu'; subst hv'; rfl
        have hlen4 : 4 ≤ w.length := by
          have hm := h₂.1 [Sum.inr 0, Sum.inr 4] (List.mem_singleton_self _)
          rcases (mem_evalSF_pair parikhSol 0 4 w).mp hm with ⟨u, hu, v, ⟨m, hm1, rfl⟩, rfl⟩
          have hu' : u = [0] := hu; subst hu'; simp; omega
        omega
      · exfalso
        have hlen2 : w.length = 2 := by
          have hm := h₂.1 [Sum.inr 0, Sum.inr 1] (List.mem_singleton_self _)
          rcases (mem_evalSF_pair parikhSol 0 1 w).mp hm with ⟨u, hu, v, hv, rfl⟩
          have hu' : u = [0] := hu; have hv' : v = [1] := hv; subst hu'; subst hv'; rfl
        have hlen4 : 4 ≤ w.length := by
          have hm := h₁.1 [Sum.inr 0, Sum.inr 4] (List.mem_singleton_self _)
          rcases (mem_evalSF_pair parikhSol 0 4 w).mp hm with ⟨u, hu, v, ⟨m, hm1, rfl⟩, rfl⟩
          have hu' : u = [0] := hu; subst hu'; simp; omega
        omega
      · rfl
    · fin_cases p₁; fin_cases p₂; rfl
    · fin_cases p₁ <;> fin_cases p₂
      · rfl
      · exfalso
        have h1 : w = [2] := (mem_evalSF_singleton_inl parikhSol 2 w).mp (h₁.1 _ (List.mem_singleton_self _))
        rcases (mem_evalSF_pair parikhSol 2 5 w).mp (h₂.1 _ (List.mem_singleton_self _)) with
          ⟨u, hu, v, ⟨k, hk, rfl⟩, huv⟩
        have hu' : u = [2] := hu; subst hu'; rw [h1] at huv
        have := congrArg List.length huv; simp at this; omega
      · exfalso
        have h1 : w = [2] := (mem_evalSF_singleton_inl parikhSol 2 w).mp (h₂.1 _ (List.mem_singleton_self _))
        rcases (mem_evalSF_pair parikhSol 2 5 w).mp (h₁.1 _ (List.mem_singleton_self _)) with
          ⟨u, hu, v, ⟨k, hk, rfl⟩, huv⟩
        have hu' : u = [2] := hu; subst hu'; rw [h1] at huv
        have := congrArg List.length huv; simp at this; omega
      · rfl
    · fin_cases p₁ <;> fin_cases p₂
      · rfl
      · exfalso
        have h1 : w = [0] := (mem_evalSF_singleton_inl parikhSol 0 w).mp (h₁.1 _ (List.mem_singleton_self _))
        rcases (mem_evalSF_pair parikhSol 0 6 w).mp (h₂.1 _ (List.mem_singleton_self _)) with
          ⟨u, hu, v, ⟨k, hk, rfl⟩, huv⟩
        have hu' : u = [0] := hu; subst hu'; rw [h1] at huv
        have := congrArg List.length huv; simp at this; omega
      · exfalso
        have h1 : w = [0] := (mem_evalSF_singleton_inl parikhSol 0 w).mp (h₂.1 _ (List.mem_singleton_self _))
        rcases (mem_evalSF_pair parikhSol 0 6 w).mp (h₁.1 _ (List.mem_singleton_self _)) with
          ⟨u, hu, v, ⟨k, hk, rfl⟩, huv⟩
        have hu' : u = [0] := hu; subst hu'; rw [h1] at huv
        have := congrArg List.length huv; simp at this; omega
      · rfl
    · fin_cases p₁ <;> fin_cases p₂
      · rfl
      · exfalso
        have hlen2 : w.length = 2 := by
          rcases (mem_evalSF_pair parikhSol 1 2 w).mp (h₁.1 _ (List.mem_singleton_self _)) with ⟨u, hu, v, hv, rfl⟩
          have hu' : u = [1] := hu; have hv' : v = [2] := hv; subst hu'; subst hv'; rfl
        have hlen4 : 4 ≤ w.length := by
          rcases (mem_evalSF_pair parikhSol 1 8 w).mp (h₂.1 _ (List.mem_singleton_self _)) with ⟨u, hu, v, ⟨n, hn, rfl⟩, rfl⟩
          have hu' : u = [1] := hu; subst hu'; simp; omega
        omega
      · exfalso
        have hlen2 : w.length = 2 := by
          rcases (mem_evalSF_pair parikhSol 1 2 w).mp (h₂.1 _ (List.mem_singleton_self _)) with ⟨u, hu, v, hv, rfl⟩
          have hu' : u = [1] := hu; have hv' : v = [2] := hv; subst hu'; subst hv'; rfl
        have hlen4 : 4 ≤ w.length := by
          rcases (mem_evalSF_pair parikhSol 1 8 w).mp (h₁.1 _ (List.mem_singleton_self _)) with ⟨u, hu, v, ⟨n, hn, rfl⟩, rfl⟩
          have hu' : u = [1] := hu; subst hu'; simp; omega
        omega
      · rfl
    · fin_cases p₁; fin_cases p₂; rfl
    · fin_cases p₁ <;> fin_cases p₂
      · rfl
      · exact (h₂.2 [Sum.inr 3, Sum.inr 5] (List.mem_singleton_self _)
          (h₁.1 [Sum.inr 3, Sum.inr 5] (List.mem_singleton_self _))).elim
      · exact (h₁.2 [Sum.inr 3, Sum.inr 5] (List.mem_singleton_self _)
          (h₂.1 [Sum.inr 3, Sum.inr 5] (List.mem_singleton_self _))).elim
      · rfl
  · -- 4. Unique binary factorization for every binary conjunct:
    intro i r hr γ hγ B C hBC u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq
    have huniq_len1_l : ∀ c : Fin 3, u₁ = [c] → u₂ = [c] → u₁ = u₂ ∧ v₁ = v₂ := by
      intro c h1 h2; subst h1; subst h2; exact ⟨rfl, List.append_cancel_left heq⟩
    have huniq_len1_r : ∀ c : Fin 3, v₁ = [c] → v₂ = [c] → u₁ = u₂ ∧ v₁ = v₂ := by
      intro c h1 h2; subst h1; subst h2; exact ⟨List.append_cancel_right heq, rfl⟩
    fin_cases i <;> dsimp only [parikhBNF] at hr <;>
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    · subst hr; simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ; simp at hBC
    · subst hr; simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ; simp at hBC
    · subst hr; simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ; simp at hBC
    · rcases hr with rfl | rfl <;>
        (simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ;
         simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩)
      · exact huniq_len1_l 0 hu₁ hu₂
      · exact huniq_len1_l 0 hu₁ hu₂
    · subst hr; simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
      simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩
      exact huniq_len1_r 1 hv₁ hv₂
    · rcases hr with rfl | rfl
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ; simp at hBC
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩
        exact huniq_len1_l 2 hu₁ hu₂
    · rcases hr with rfl | rfl
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ; simp at hBC
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩
        exact huniq_len1_l 0 hu₁ hu₂
    · rcases hr with rfl | rfl <;>
        (simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ;
         simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩)
      · exact huniq_len1_l 1 hu₁ hu₂
      · exact huniq_len1_l 1 hu₁ hu₂
    · subst hr; simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
      simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩
      exact huniq_len1_r 2 hv₁ hv₂
    · rcases hr with rfl | rfl
      · simp only [List.append_nil, List.mem_singleton] at hγ; subst hγ
        simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩
        rcases hu₁ with ⟨m₁, _, rfl⟩; rcases hv₁ with ⟨k₁, _, rfl⟩
        rcases hu₂ with ⟨m₂, _, rfl⟩; rcases hv₂ with ⟨k₂, _, rfl⟩
        have hc0 := congrArg (List.count (0 : Fin 3)) heq
        simp [List.count_append, List.count_replicate] at hc0
        exact list_append_eq_of_len_eq heq (by simp [hc0])
      · simp only [List.cons_append, List.nil_append, List.mem_cons, List.not_mem_nil, or_false] at hγ
        rcases hγ with rfl | rfl <;>
          (simp only [List.cons.injEq, Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩)
        · rcases hu₁ with ⟨k₁, _, rfl⟩; rcases hv₁ with ⟨n₁, _, rfl⟩
          rcases hu₂ with ⟨k₂, _, rfl⟩; rcases hv₂ with ⟨n₂, _, rfl⟩
          have hc0 := congrArg (List.count (0 : Fin 3)) heq
          simp [List.count_append, List.count_replicate] at hc0
          exact list_append_eq_of_len_eq heq (by simp [hc0])
        · rcases hu₁ with ⟨m₁, _, rfl⟩; rcases hv₁ with ⟨k₁, _, rfl⟩
          rcases hu₂ with ⟨m₂, _, rfl⟩; rcases hv₂ with ⟨k₂, _, rfl⟩
          have hc0 := congrArg (List.count (0 : Fin 3)) heq
          simp [List.count_append, List.count_replicate] at hc0
          exact list_append_eq_of_len_eq heq (by simp [hc0])

section UnambigAlgebraPrivate

private lemma list_getElem_cast {α : Type*} {l₁ l₂ : List α} (h : l₁ = l₂)
    (i : ℕ) (hi : i < l₁.length) : l₁[i]'hi = l₂[i]'(h ▸ hi) := by
  subst h; rfl

private lemma list_getElem_idx {α : Type*} {l : List α} {i j : ℕ} (h : i = j)
    (hi : i < l.length) (hj : j < l.length) : l[i]'hi = l[j]'hj := by
  subst h; rfl

private lemma list_mem_of_eq {α : Type*} {l₁ l₂ : List α} (h : l₁ = l₂) {x : α} (hx : x ∈ l₁) :
    x ∈ l₂ := h ▸ hx

private def IsUnambigBNF {α : Type*} {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (X : Fin k → Language α) : Prop :=
  (∀ i, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
    (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) ∧
  (∀ i w, w ∈ X i ↔ w ≠ [] ∧ boolCond G X i w) ∧
  (∀ (i : Fin k) (w : List α) (p₁ p₂ : Fin (G i).length),
    ((∀ γ ∈ (G i)[p₁].1, w ∈ evalSF X γ) ∧ (∀ δ ∈ (G i)[p₁].2, w ∉ evalSF X δ)) →
    ((∀ γ ∈ (G i)[p₂].1, w ∈ evalSF X γ) ∧ (∀ δ ∈ (G i)[p₂].2, w ∉ evalSF X δ)) →
    p₁ = p₂) ∧
  (∀ (i : Fin k), ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, ∀ B C : Fin k, γ = [Sum.inr B, Sum.inr C] →
    ∀ u₁ v₁ u₂ v₂ : List α, u₁ ∈ X B → v₁ ∈ X C → u₂ ∈ X B → v₂ ∈ X C →
      u₁ ++ v₁ = u₂ ++ v₂ → u₁ = u₂ ∧ v₁ = v₂)

private lemma unambig_compl {α : Type*} [Fintype α] [DecidableEq α] {k : ℕ}
    (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
    (s : Fin k) (X : Fin k → Language α) (hU : IsUnambigBNF G X) :
    ∃ (k' : ℕ) (G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))))
      (s' : Fin k') (X' : Fin k' → Language α),
      IsUnambigBNF G' X' ∧ X' s' = ({w : List α | w ≠ []} : Language α) \ X s := by
  classical
  let m := Fintype.card α
  let e : α ≃ Fin m := Fintype.equivFin α
  let k' := k + m + 2
  let origIdx : Fin k → Fin k' := fun i => ⟨i.1, by omega⟩
  let termIdx : α → Fin k' := fun a => ⟨k + (e a).1, by omega⟩
  let uIdx : Fin k' := ⟨k + m, by omega⟩
  let topIdx : Fin k' := ⟨k + m + 1, by omega⟩
  let L_ne : Language α := {w : List α | w ≠ []}
  let X' : Fin k' → Language α := fun i =>
    if h1 : i.1 < k then X ⟨i.1, h1⟩
    else if h2 : i.1 < k + m then ({[e.symm ⟨i.1 - k, by omega⟩]} : Language α)
    else if h3 : i.1 = k + m then L_ne
    else L_ne \ X s
  have hX'_orig : ∀ i : Fin k, X' (origIdx i) = X i := fun i => by
    dsimp only [X', origIdx]; rw [dif_pos i.2]
  have hX'_term : ∀ a : α, X' (termIdx a) = ({[a]} : Language α) := fun a => by
    dsimp only [X', termIdx]
    rw [dif_neg (by omega), dif_pos (by omega)]
    have hsub : (⟨k + (e a).1 - k, by omega⟩ : Fin m) = e a := Fin.ext (by dsimp; omega)
    rw [hsub, Equiv.symm_apply_apply]
  have hX'_u : X' uIdx = L_ne := by
    dsimp only [X', uIdx]; rw [dif_neg (by omega), dif_neg (by omega), dif_pos rfl]
  have hX'_top : X' topIdx = L_ne \ X s := by
    dsimp only [X', topIdx]; rw [dif_neg (by omega), dif_neg (by omega), dif_neg (by omega)]
  -- Collect all binary pairs appearing in `G s` (deduplicated):
  let pairOf : List (α ⊕ Fin k) → Option (Fin k × Fin k) := fun γ =>
    match γ with | [Sum.inr B, Sum.inr C] => some (B, C) | _ => none
  let pairs : List (Fin k × Fin k) :=
    (((G s).flatMap (fun r => r.1 ++ r.2)).filterMap pairOf).dedup
  let t := pairs.length
  let allAlphas : List α := (Finset.univ : Finset α).toList
  have hmem_allAlphas : ∀ a : α, a ∈ allAlphas := fun a => Finset.mem_toList.mpr (Finset.mem_univ a)
  have hnodup_allAlphas : allAlphas.Nodup := Finset.nodup_toList _
  let allAssign : List (Fin t → Bool) := (Finset.univ : Finset (Fin t → Bool)).toList
  have hmem_allAssign : ∀ σ : Fin t → Bool, σ ∈ allAssign := fun σ =>
    Finset.mem_toList.mpr (Finset.mem_univ σ)
  have hnodup_allAssign : allAssign.Nodup := Finset.nodup_toList _
  -- Evaluate whether a truth assignment `σ : Fin t → Bool` makes `G s` false on length ≥ 2:
  let pairIdx (p : Fin k × Fin k) : Option (Fin t) :=
    (List.finRange t).find? (fun idx => decide (pairs[idx] = p))
  let ruleEval (σ : Fin t → Bool) (r : List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))) : Bool :=
    decide (r.1 ≠ []) &&
    r.1.all (fun γ => match pairOf γ with | some p => (pairIdx p).elim false σ | none => false) &&
    r.2.all (fun δ => match pairOf δ with | some p => (pairIdx p).elim true (fun idx => !(σ idx)) | none => true)
  let topTermRules : List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))) :=
    (allAlphas.filter (fun a => decide ([a] ∉ X s))).map (fun a => ([[Sum.inl a]], []))
  let mkMinterm (a : α) (σ : Fin t → Bool) :
      List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k')) :=
    let posP := ((List.finRange t).filter (fun idx => σ idx)).map
      (fun idx => [Sum.inr (origIdx (pairs[idx].1)), Sum.inr (origIdx (pairs[idx].2))])
    let negP := ((List.finRange t).filter (fun idx => !(σ idx))).map
      (fun idx => [Sum.inr (origIdx (pairs[idx].1)), Sum.inr (origIdx (pairs[idx].2))])
    ([Sum.inr (termIdx a), Sum.inr uIdx] :: posP, negP)
  let badAssigns : List (Fin t → Bool) :=
    allAssign.filter (fun σ => !((G s).any (ruleEval σ)))
  let topBinPairs : List (α × (Fin t → Bool)) := allAlphas.product badAssigns
  let topBinRules : List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))) :=
    topBinPairs.map (fun p => mkMinterm p.1 p.2)
  let uRules : List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))) :=
    allAlphas.map (fun a => ([[Sum.inl a]], [])) ++
    allAlphas.map (fun a => ([[Sum.inr (termIdx a), Sum.inr uIdx]], []))
  let G' : Fin k' → List (List (List (α ⊕ Fin k')) × List (List (α ⊕ Fin k'))) := fun i =>
    if h1 : i.1 < k then (G ⟨i.1, h1⟩).map (mapRuleB origIdx)
    else if h2 : i.1 < k + m then [([[Sum.inl (e.symm ⟨i.1 - k, by omega⟩)]], [])]
    else if h3 : i.1 = k + m then uRules
    else topTermRules ++ topBinRules
  -- Helper: `[Sum.inr (termIdx a), Sum.inr uIdx]` matches iff `w = a :: v` with `v ≠ []`:
  have hTU_mem : ∀ (a : α) (w : List α),
      w ∈ evalSF X' [Sum.inr (termIdx a), Sum.inr uIdx] ↔ ∃ v : List α, v ≠ [] ∧ w = a :: v := by
    intro a w
    rw [mem_evalSF_pair, hX'_term, hX'_u]
    constructor
    · rintro ⟨u, hu, v, hv, rfl⟩
      have hu' : u = [a] := hu; subst hu'
      exact ⟨v, hv, rfl⟩
    · rintro ⟨v, hv, rfl⟩
      exact ⟨[a], rfl, v, hv, rfl⟩
  -- Helper: actual truth assignment of a word `w` on `pairs`:
  let truthOf (w : List α) : Fin t → Bool := fun idx =>
    decide (w ∈ evalSF X [Sum.inr (pairs[idx].1), Sum.inr (pairs[idx].2)])
  have hpairIdx_spec : ∀ p ∈ pairs, ∃ idx : Fin t, pairIdx p = some idx ∧ pairs[idx] = p := by
    intro p hp
    obtain ⟨n, hn, hget⟩ := List.mem_iff_getElem.mp hp
    have hex : ∃ idx ∈ List.finRange t, decide (pairs[idx] = p) = true :=
      ⟨⟨n, hn⟩, List.mem_finRange _, decide_eq_true hget⟩
    cases hfind : pairIdx p with
    | none =>
      have hnone := List.find?_eq_none.mp hfind ⟨n, hn⟩ (List.mem_finRange _)
      simp [hget] at hnone
    | some idx =>
      have hpred := List.find?_some hfind
      simp only [decide_eq_true_eq] at hpred
      exact ⟨idx, rfl, hpred⟩
  have hruleEval_truth : ∀ (w : List α), 2 ≤ w.length →
      ∀ r ∈ G s, ruleEval (truthOf w) r = true ↔
        (∀ γ ∈ r.1, w ∈ evalSF X γ) ∧ (∀ δ ∈ r.2, w ∉ evalSF X δ) := by
    intro w hw2 r hr
    rcases hU.1 s r hr with ⟨a, rfl⟩ | ⟨hpos, hbin⟩
    · constructor
      · intro h
        simp only [ruleEval, Bool.and_eq_true, List.all_eq_true] at h
        have h1 := h.1.2 [Sum.inl a] (List.mem_singleton_self _)
        simp [pairOf] at h1
      · rintro ⟨hp, _⟩
        have h1 := (mem_evalSF_singleton_inl X a w).mp (hp [Sum.inl a] (List.mem_singleton_self _))
        subst h1; simp at hw2
    · simp only [ruleEval, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, and_assoc]
      rw [and_iff_right hpos]
      refine and_congr ?_ ?_
      · refine forall_congr' fun γ => imp_congr_right fun hγ => ?_
        obtain ⟨B, C, rfl⟩ := hbin γ (List.mem_append_left _ hγ)

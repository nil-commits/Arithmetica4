            dsimp only [X] at hu₁ hv₁ hu₂ hv₂
            rw [combineSol_inl] at hu₁ hv₁ hu₂ hv₂
            exact hU₁.2.2.2 s₁ _ (List.getElem_mem p₁.2) _ (List.mem_append_right _ hγ₁) B₁ C₁ rfl u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq
          · obtain ⟨B₂, C₂, rfl⟩ := hbin₂ γ₂ (List.mem_append_right _ hγ₂)
            simp only [mapSF, mapSym, List.map_cons, List.map_nil, Sum.map_inr, List.cons.injEq,
              Sum.inr.injEq, and_true] at hBC; rcases hBC with ⟨rfl, rfl⟩
            dsimp only [X] at hu₁ hv₁ hu₂ hv₂
            rw [combineSol_inr] at hu₁ hv₁ hu₂ hv₂
            exact hU₂.2.2.2 s₂ _ (List.getElem_mem p₂.2) _ (List.mem_append_right _ hγ₂) B₂ C₂ rfl u₁ v₁ u₂ v₂ hu₁ hv₁ hu₂ hv₂ heq

end UnambigAlgebraPrivate

/-- **Full Boolean-Algebra Closure of Unambiguous BNF Boolean Languages (PPL 166):**
Unlike unambiguous CFLs (which fail closure under union, intersection, and complementation),
unambiguous Okhotin BNF Boolean languages over any finite alphabet `[Fintype α] [DecidableEq α]`
are closed under **ε-free complementation, intersection, AND general union** — explaining why
every union-based CFG inherent-ambiguity mechanism collapses for Boolean grammars. -/
theorem ppl166_unambiguous_bnf_boolean_algebra {α : Type*} [Fintype α] [DecidableEq α]
    {k₁ k₂ : ℕ}
    (G₁ : Fin k₁ → List (List (List (α ⊕ Fin k₁)) × List (List (α ⊕ Fin k₁))))
    (G₂ : Fin k₂ → List (List (List (α ⊕ Fin k₂)) × List (List (α ⊕ Fin k₂))))
    (s₁ : Fin k₁) (s₂ : Fin k₂)
    (X₁ : Fin k₁ → Language α) (X₂ : Fin k₂ → Language α)
    (hbnf₁ : ∀ i, ∀ r ∈ G₁ i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
      (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k₁, γ = [Sum.inr B, Sum.inr C]))
    (hsol₁ : ∀ i w, w ∈ X₁ i ↔ w ≠ [] ∧ ∃ r ∈ G₁ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod))
    (hdisj₁ : ∀ (i : Fin k₁) (w : List α) (p₁ p₂ : Fin (G₁ i).length),
      ((∀ γ ∈ (G₁ i)[p₁].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod) ∧
       (∀ δ ∈ (G₁ i)[p₁].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod)) →
      ((∀ γ ∈ (G₁ i)[p₂].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod) ∧
       (∀ δ ∈ (G₁ i)[p₂].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₁)).prod)) →
      p₁ = p₂)
    (hfac₁ : ∀ (i : Fin k₁), ∀ r ∈ G₁ i, ∀ γ ∈ r.1 ++ r.2, ∀ B C : Fin k₁, γ = [Sum.inr B, Sum.inr C] →
      ∀ u₁ v₁ u₂ v₂ : List α, u₁ ∈ X₁ B → v₁ ∈ X₁ C → u₂ ∈ X₁ B → v₂ ∈ X₁ C →
        u₁ ++ v₁ = u₂ ++ v₂ → u₁ = u₂ ∧ v₁ = v₂)
    (hbnf₂ : ∀ i, ∀ r ∈ G₂ i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
      (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k₂, γ = [Sum.inr B, Sum.inr C]))
    (hsol₂ : ∀ i w, w ∈ X₂ i ↔ w ≠ [] ∧ ∃ r ∈ G₂ i,
      (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod) ∧
      (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod))
    (hdisj₂ : ∀ (i : Fin k₂) (w : List α) (p₁ p₂ : Fin (G₂ i).length),
      ((∀ γ ∈ (G₂ i)[p₁].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod) ∧
       (∀ δ ∈ (G₂ i)[p₁].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod)) →
      ((∀ γ ∈ (G₂ i)[p₂].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod) ∧
       (∀ δ ∈ (G₂ i)[p₂].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X₂)).prod)) →
      p₁ = p₂)
    (hfac₂ : ∀ (i : Fin k₂), ∀ r ∈ G₂ i, ∀ γ ∈ r.1 ++ r.2, ∀ B C : Fin k₂, γ = [Sum.inr B, Sum.inr C] →
      ∀ u₁ v₁ u₂ v₂ : List α, u₁ ∈ X₂ B → v₁ ∈ X₂ C → u₂ ∈ X₂ B → v₂ ∈ X₂ C →
        u₁ ++ v₁ = u₂ ++ v₂ → u₁ = u₂ ∧ v₁ = v₂) :
    let Lne : Language α := {w : List α | w ≠ []}
    let IsUB (L : Language α) : Prop :=
      ∃ (k : ℕ) (G : Fin k → List (List (List (α ⊕ Fin k)) × List (List (α ⊕ Fin k))))
        (s : Fin k) (X : Fin k → Language α),
        (∀ i, ∀ r ∈ G i, (∃ a : α, r = ([[Sum.inl a]], [])) ∨
          (r.1 ≠ [] ∧ ∀ γ ∈ r.1 ++ r.2, ∃ B C : Fin k, γ = [Sum.inr B, Sum.inr C])) ∧
        (∀ i w, w ∈ X i ↔ w ≠ [] ∧ ∃ r ∈ G i,
          (∀ γ ∈ r.1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
          (∀ δ ∈ r.2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) ∧
        (∀ (i : Fin k) (w : List α) (p₁ p₂ : Fin (G i).length),
          ((∀ γ ∈ (G i)[p₁].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
           (∀ δ ∈ (G i)[p₁].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) →
          ((∀ γ ∈ (G i)[p₂].1, w ∈ (γ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod) ∧
           (∀ δ ∈ (G i)[p₂].2, w ∉ (δ.map (Sum.elim (fun a => ({[a]} : Language α)) X)).prod)) →
          p₁ = p₂) ∧
        (∀ (i : Fin k), ∀ r ∈ G i, ∀ γ ∈ r.1 ++ r.2, ∀ B C : Fin k, γ = [Sum.inr B, Sum.inr C] →
          ∀ u₁ v₁ u₂ v₂ : List α, u₁ ∈ X B → v₁ ∈ X C → u₂ ∈ X B → v₂ ∈ X C →
            u₁ ++ v₁ = u₂ ++ v₂ → u₁ = u₂ ∧ v₁ = v₂) ∧
        X s = L
    IsUB (Lne \ X₁ s₁) ∧ IsUB (X₁ s₁ ⊓ X₂ s₂) ∧ IsUB (X₁ s₁ ⊔ X₂ s₂) := by
  intro Lne IsUB
  have hU₁ : IsUnambigBNF G₁ X₁ := ⟨hbnf₁, hsol₁, hdisj₁, hfac₁⟩
  have hU₂ : IsUnambigBNF G₂ X₂ := ⟨hbnf₂, hsol₂, hdisj₂, hfac₂⟩
  obtain ⟨kc₁, Gc₁, sc₁, Xc₁, hUc₁, hXc₁⟩ := unambig_compl G₁ s₁ X₁ hU₁
  obtain ⟨kc₂, Gc₂, sc₂, Xc₂, hUc₂, hXc₂⟩ := unambig_compl G₂ s₂ X₂ hU₂
  obtain ⟨ki, Gi, si, Xi, hUi, hXi⟩ := unambig_inter G₁ G₂ s₁ s₂ X₁ X₂ hU₁ hU₂
  obtain ⟨kci, Gci, sci, Xci, hUci, hXci⟩ := unambig_inter Gc₁ Gc₂ sc₁ sc₂ Xc₁ Xc₂ hUc₁ hUc₂
  obtain ⟨ku, Gu, su, Xu, hUu, hXu⟩ := unambig_compl Gci sci Xci hUci
  have hdemorgan : Xu su = X₁ s₁ ⊔ X₂ s₂ := by
    rw [hXu, hXci, hXc₁, hXc₂]
    ext w
    change (w ≠ [] ∧ ¬ ((w ≠ [] ∧ w ∉ X₁ s₁) ∧ (w ≠ [] ∧ w ∉ X₂ s₂))) ↔ w ∈ X₁ s₁ ∨ w ∈ X₂ s₂
    constructor
    · rintro ⟨hne, hnot⟩
      by_cases h1 : w ∈ X₁ s₁
      · exact Or.inl h1
      · by_cases h2 : w ∈ X₂ s₂
        · exact Or.inr h2
        · exact (hnot ⟨⟨hne, h1⟩, ⟨hne, h2⟩⟩).elim
    · rintro (h1 | h2)
      · exact ⟨((hsol₁ s₁ w).mp h1).1, fun h => h.1.2 h1⟩
      · exact ⟨((hsol₂ s₂ w).mp h2).1, fun h => h.2.2 h2⟩
  exact ⟨⟨kc₁, Gc₁, sc₁, Xc₁, hUc₁.1, hUc₁.2.1, hUc₁.2.2.1, hUc₁.2.2.2, hXc₁⟩,
    ⟨ki, Gi, si, Xi, hUi.1, hUi.2.1, hUi.2.2.1, hUi.2.2.2, hXi⟩,
    ⟨ku, Gu, su, Xu, hUu.1, hUu.2.1, hUu.2.2.1, hUu.2.2.2, hdemorgan⟩⟩

end PPL105

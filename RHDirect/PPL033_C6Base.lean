lemma lam23_swap01 (e0 e1 e2 f01 f10 f02 f20 f12 f21 : Bool) :
    lam23 e0 e1 e2 f01 f10 f02 f20 f12 f21 = lam23 e1 e0 e2 f10 f01 f12 f21 f02 f20 := by
  have h := (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool checkLamSwap01_ok e0) e1) e2) f01) f10) f02) f20) f12) f21)

private def sort3 (x y z : Fin 8) : Fin 8 × Fin 8 × Fin 8 :=
  let (x1, y1) := if x.val ≤ y.val then (x, y) else (y, x)
  let (y2, z1) := if y1.val ≤ z.val then (y1, z) else (z, y1)
  let (x2, y3) := if x1.val ≤ y2.val then (x1, y2) else (y2, x1)
  (x2, y3, z1)


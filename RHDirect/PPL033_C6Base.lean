  have h := (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool checkLamSwap12_ok e0) e1) e2) f01) f10) f02) f20) f12) f21)

/-! ## Section 1: Concrete Commutative Hecke Algebra `𝕋_ℂ ⊆ End_ℂ(S)` & Integral Lattices `𝕋_ℤ` / `𝕋_𝒪` -/

section ConcreteHeckeAlgebra

variable {N : ℕ} (k : ℕ) (χ : DirichletCharacter ℂ N)
variable (S : Submodule ℂ (ℕ → ℂ))
variable (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)

/-- Restriction of the concrete `n`-th Hecke operator `T_n` (`n ≥ 1`) to a `heckeOp`-invariant
subspace `S ⊆ (ℕ → ℂ)`. -/
def heckeEnd (n : ℕ) (hn : 1 ≤ n) : Module.End ℂ S :=
  (heckeOpLin k χ n).restrict (hinv n hn)

@[simp]
theorem heckeEnd_apply (n : ℕ) (hn : 1 ≤ n) (f : S) :
    (heckeEnd k χ S hinv n hn f : ℕ → ℂ) = heckeOp k χ n f.1 :=
  rfl

theorem heckeEnd_apply_one (n : ℕ) (hn : 1 ≤ n) (f : S) :
    (heckeEnd k χ S hinv n hn f).1 1 = f.1 n :=
  heckeOp_apply_one k χ hn f.1

theorem heckeEnd_one : heckeEnd k χ S hinv 1 le_rfl = 1 := by
  ext f m
  exact congrFun (heckeOp_one k χ f.1) m

theorem heckeEnd_comm {m n : ℕ} (hm : 1 ≤ m) (hn : 1 ≤ n) :
    heckeEnd k χ S hinv m hm * heckeEnd k χ S hinv n hn =
      heckeEnd k χ S hinv n hn * heckeEnd k χ S hinv m hm := by
  ext f M
  exact congrFun (heckeOp_comm k χ m n hm hn f.1) M

theorem heckeEnd_mul_of_coprime {m n : ℕ} (hm : 1 ≤ m) (hn : 1 ≤ n) (hcop : Nat.Coprime m n) :
    heckeEnd k χ S hinv m hm * heckeEnd k χ S hinv n hn =
      heckeEnd k χ S hinv (m * n) (Nat.one_le_iff_ne_zero.mpr (mul_ne_zero (by omega) (by omega))) := by
  ext f M
  exact congrFun (heckeOp_mul_of_coprime k χ hcop f.1) M

/-- The generating set `{ T_n | n ≥ 1 } ⊆ End_ℂ(S)` of the concrete Hecke algebra. -/
def heckeGenerators : Set (Module.End ℂ S) :=
  { T | ∃ (n : ℕ) (hn : 1 ≤ n), T = heckeEnd k χ S hinv n hn }

/-- The **concrete complex Hecke algebra** `𝕋_ℂ ⊆ End_ℂ(S)` generated over `ℂ` by `{ T_n | n ≥ 1 }`. -/
def HeckeAlg : Subalgebra ℂ (Module.End ℂ S) :=
  Algebra.adjoin ℂ (heckeGenerators k χ S hinv)

/-- The `n`-th Hecke operator `T_n` (`n ≥ 1`) viewed as an element of `HeckeAlg k χ S hinv`. -/
def heckeAlgGen (n : ℕ) (hn : 1 ≤ n) : HeckeAlg k χ S hinv :=
  ⟨heckeEnd k χ S hinv n hn, Algebra.subset_adjoin ⟨n, hn, rfl⟩⟩

@[simp]
theorem heckeAlgGen_val (n : ℕ) (hn : 1 ≤ n) :
    (heckeAlgGen k χ S hinv n hn : Module.End ℂ S) = heckeEnd k χ S hinv n hn :=
  rfl

theorem heckeAlgGen_one : heckeAlgGen k χ S hinv 1 le_rfl = 1 :=
  Subtype.ext (heckeEnd_one k χ S hinv)

theorem heckeAlgGen_mul_of_coprime {m n : ℕ} (hm : 1 ≤ m) (hn : 1 ≤ n) (hcop : Nat.Coprime m n) :
    heckeAlgGen k χ S hinv m hm * heckeAlgGen k χ S hinv n hn =
      heckeAlgGen k χ S hinv (m * n)
        (Nat.one_le_iff_ne_zero.mpr (mul_ne_zero (by omega) (by omega))) :=
  Subtype.ext (heckeEnd_mul_of_coprime k χ S hinv hm hn hcop)

/-- All elements of `HeckeAlg k χ S hinv` pairwise commute inside `Module.End ℂ S`. -/
theorem heckeAlg_mul_comm_val {A B : Module.End ℂ S}
    (hA : A ∈ HeckeAlg k χ S hinv) (hB : B ∈ HeckeAlg k χ S hinv) :
    A * B = B * A := by
  have hgen_comm : ∀ X ∈ heckeGenerators k χ S hinv, ∀ Y ∈ heckeGenerators k χ S hinv,
      X * Y = Y * X := by
    rintro X ⟨m, hm, rfl⟩ Y ⟨n, hn, rfl⟩
    exact heckeEnd_comm k χ S hinv hm hn
  have hgen_right : ∀ X ∈ heckeGenerators k χ S hinv, ∀ Y ∈ HeckeAlg k χ S hinv,
      X * Y = Y * X := by
    intro X hX Y hY
    refine Algebra.adjoin_induction
      (p := fun Y _ => X * Y = Y * X)
      (mem := fun Y hY => hgen_comm X hX Y hY)
      (algebraMap := fun c => (Algebra.commutes c X).symm)
      (add := fun Y₁ Y₂ _ _ ih₁ ih₂ => by rw [mul_add, add_mul, ih₁, ih₂])
      (mul := fun Y₁ Y₂ _ _ ih₁ ih₂ => by rw [← mul_assoc, ih₁, mul_assoc, ih₂, ← mul_assoc])
      hY
  refine Algebra.adjoin_induction
    (p := fun A _ => A * B = B * A)
    (mem := fun A hA => hgen_right A hA B hB)
    (algebraMap := fun c => Algebra.commutes c B)
    (add := fun A₁ A₂ _ _ ih₁ ih₂ => by rw [add_mul, mul_add, ih₁, ih₂])
    (mul := fun A₁ A₂ _ _ ih₁ ih₂ => by rw [mul_assoc, ih₂, ← mul_assoc, ih₁, mul_assoc])
    hA

/-- **Unconditional Commutative Ring Structure on `HeckeAlg k χ S hinv` (`𝕋_ℂ`)**. -/
instance instCommRingHeckeAlg : CommRing (HeckeAlg k χ S hinv) :=
  { (inferInstance : Ring (HeckeAlg k χ S hinv)) with
    mul_comm := fun A B => Subtype.ext (heckeAlg_mul_comm_val k χ S hinv A.2 B.2) }

/-- **Finite-Dimensionality of `HeckeAlg k χ S hinv`** whenever `S` is finite-dimensional over `ℂ`. -/
instance instFiniteDimensionalHeckeAlg [FiniteDimensional ℂ S] :
    FiniteDimensional ℂ (HeckeAlg k χ S hinv) :=
  FiniteDimensional.of_injective (HeckeAlg k χ S hinv).val.toLinearMap Subtype.val_injective

theorem heckeAlg_moduleFinite [FiniteDimensional ℂ S] :
    Module.Finite ℂ (HeckeAlg k χ S hinv) :=
  inferInstance

end ConcreteHeckeAlgebra

/-! ### Integral & `𝒪`-Hecke Algebras (`IntHeckeAlg`, `OHeckeAlg`) & Canonical Integral Lattice -/

section IntegralHeckeAlgebra

variable {N : ℕ} (k : ℕ) (χ : DirichletCharacter ℂ N)
variable (S : Submodule ℂ (ℕ → ℂ))
variable (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)

section GeneralBaseRing

variable {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]
variable (L : Submodule 𝒪 S)
variable (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ f ∈ L, heckeEnd k χ S hinv n hn f ∈ L)

/-- Restriction of the `n`-th Hecke operator `T_n` (`n ≥ 1`) to a `T_n`-invariant `𝒪`-lattice
`L ⊆ S`, packaged as an `𝒪`-linear endomorphism `Module.End 𝒪 L`. -/
def oHeckeEnd (n : ℕ) (hn : 1 ≤ n) : Module.End 𝒪 L :=
  ((heckeEnd k χ S hinv n hn).restrictScalars 𝒪).restrict (hL_inv n hn)

@[simp]
theorem oHeckeEnd_apply (n : ℕ) (hn : 1 ≤ n) (f : L) :
    ((oHeckeEnd k χ S hinv L hL_inv n hn f : S) : ℕ → ℂ) = heckeOp k χ n f.1.1 :=
  rfl

theorem oHeckeEnd_one : oHeckeEnd k χ S hinv L hL_inv 1 le_rfl = 1 := by
  ext f m
  exact congrFun (heckeOp_one k χ f.1.1) m

theorem oHeckeEnd_comm {m n : ℕ} (hm : 1 ≤ m) (hn : 1 ≤ n) :
    oHeckeEnd k χ S hinv L hL_inv m hm * oHeckeEnd k χ S hinv L hL_inv n hn =
      oHeckeEnd k χ S hinv L hL_inv n hn * oHeckeEnd k χ S hinv L hL_inv m hm := by
  ext f M
  exact congrFun (heckeOp_comm k χ m n hm hn f.1.1) M

theorem oHeckeEnd_mul_of_coprime {m n : ℕ} (hm : 1 ≤ m) (hn : 1 ≤ n) (hcop : Nat.Coprime m n) :
    oHeckeEnd k χ S hinv L hL_inv m hm * oHeckeEnd k χ S hinv L hL_inv n hn =
      oHeckeEnd k χ S hinv L hL_inv (m * n)
        (Nat.one_le_iff_ne_zero.mpr (mul_ne_zero (by omega) (by omega))) := by
  ext f M
  exact congrFun (heckeOp_mul_of_coprime k χ hcop f.1.1) M

/-- Generating set `{ T_n|_L | n ≥ 1 } ⊆ End_𝒪(L)` of the `𝒪`-integral Hecke algebra. -/
def oHeckeGenerators : Set (Module.End 𝒪 L) :=
  { T | ∃ (n : ℕ) (hn : 1 ≤ n), T = oHeckeEnd k χ S hinv L hL_inv n hn }

/-- The **concrete `𝒪`-integral Hecke algebra** `𝕋_𝒪 ⊆ End_𝒪(L)` generated over `𝒪` by
`{ T_n|_L | n ≥ 1 }`. -/
def OHeckeAlg : Subalgebra 𝒪 (Module.End 𝒪 L) :=
  Algebra.adjoin 𝒪 (oHeckeGenerators k χ S hinv L hL_inv)

/-- The `n`-th Hecke operator `T_n` (`n ≥ 1`) inside `OHeckeAlg`. -/
def oHeckeAlgGen (n : ℕ) (hn : 1 ≤ n) : OHeckeAlg k χ S hinv L hL_inv :=
  ⟨oHeckeEnd k χ S hinv L hL_inv n hn, Algebra.subset_adjoin ⟨n, hn, rfl⟩⟩

@[simp]
theorem oHeckeAlgGen_val (n : ℕ) (hn : 1 ≤ n) :
    (oHeckeAlgGen k χ S hinv L hL_inv n hn : Module.End 𝒪 L) =
      oHeckeEnd k χ S hinv L hL_inv n hn :=
  rfl

theorem oHeckeAlgGen_one : oHeckeAlgGen k χ S hinv L hL_inv 1 le_rfl = 1 :=
  Subtype.ext (oHeckeEnd_one k χ S hinv L hL_inv)

theorem oHeckeAlg_mul_comm_val {A B : Module.End 𝒪 L}
    (hA : A ∈ OHeckeAlg k χ S hinv L hL_inv) (hB : B ∈ OHeckeAlg k χ S hinv L hL_inv) :
    A * B = B * A := by
  have hgen_comm : ∀ X ∈ oHeckeGenerators k χ S hinv L hL_inv,
      ∀ Y ∈ oHeckeGenerators k χ S hinv L hL_inv, X * Y = Y * X := by
    rintro X ⟨m, hm, rfl⟩ Y ⟨n, hn, rfl⟩
    exact oHeckeEnd_comm k χ S hinv L hL_inv hm hn
  have hgen_right : ∀ X ∈ oHeckeGenerators k χ S hinv L hL_inv,
      ∀ Y ∈ OHeckeAlg k χ S hinv L hL_inv, X * Y = Y * X := by
    intro X hX Y hY
    refine Algebra.adjoin_induction
      (p := fun Y _ => X * Y = Y * X)
      (mem := fun Y hY => hgen_comm X hX Y hY)
      (algebraMap := fun c => (Algebra.commutes c X).symm)
      (add := fun Y₁ Y₂ _ _ ih₁ ih₂ => by rw [mul_add, add_mul, ih₁, ih₂])
      (mul := fun Y₁ Y₂ _ _ ih₁ ih₂ => by rw [← mul_assoc, ih₁, mul_assoc, ih₂, ← mul_assoc])
      hY
  refine Algebra.adjoin_induction
    (p := fun A _ => A * B = B * A)
    (mem := fun A hA => hgen_right A hA B hB)
    (algebraMap := fun c => Algebra.commutes c B)
    (add := fun A₁ A₂ _ _ ih₁ ih₂ => by rw [add_mul, mul_add, ih₁, ih₂])
    (mul := fun A₁ A₂ _ _ ih₁ ih₂ => by rw [mul_assoc, ih₂, ← mul_assoc, ih₁, mul_assoc])
    hA

/-- **Unconditional Commutative Ring Structure on `OHeckeAlg` (`𝕋_𝒪`)**. -/
instance instCommRingOHeckeAlg : CommRing (OHeckeAlg k χ S hinv L hL_inv) :=
  { (inferInstance : Ring (OHeckeAlg k χ S hinv L hL_inv)) with
    mul_comm := fun A B => Subtype.ext (oHeckeAlg_mul_comm_val k χ S hinv L hL_inv A.2 B.2) }

/-- Torsion-freeness of `L` over any domain `𝒪` embedded injectively into `ℂ`. -/
theorem lattice_isTorsionFree [IsDomain 𝒪] (hinj : Function.Injective (algebraMap 𝒪 ℂ)) :
    Module.IsTorsionFree 𝒪 L := by
  refine Module.isTorsionFree_iff_smul_eq_zero.mpr fun {r x} hr => ?_
  by_cases hr0 : r = 0
  · exact Or.inl hr0
  · right
    have hne : algebraMap 𝒪 ℂ r ≠ 0 := fun h0 => hr0 (hinj (h0.trans (map_zero _).symm))
    have hval : algebraMap 𝒪 ℂ r • (x.1 : S) = 0 := by
      have h1 := congrArg Subtype.val hr
      simpa [Algebra.smul_def] using h1
    exact Subtype.ext ((smul_eq_zero.mp hval).resolve_left hne)

/-- **Unconditional Torsion-Freeness of `OHeckeAlg` (`𝕋_𝒪`)** over any domain `𝒪 ↪ ℂ`. -/
theorem oHeckeAlg_isTorsionFree [IsDomain 𝒪] (hinj : Function.Injective (algebraMap 𝒪 ℂ)) :
    Module.IsTorsionFree 𝒪 (OHeckeAlg k χ S hinv L hL_inv) := by
  have : Module.IsTorsionFree 𝒪 L := lattice_isTorsionFree S L hinj
  refine Module.isTorsionFree_iff_smul_eq_zero.mpr fun {r T} hr => ?_
  by_cases hr0 : r = 0
  · exact Or.inl hr0
  · right
    apply Subtype.ext
    apply LinearMap.ext
    intro f
    have hTf : r • (T.1 f) = 0 := by
      have h1 := congrArg (fun (U : OHeckeAlg k χ S hinv L hL_inv) => U.1 f) hr
      simpa using h1
    exact (smul_eq_zero.mp hTf).resolve_left hr0

/-- **Unconditional Finiteness and Freeness of `OHeckeAlg` (`𝕋_𝒪`)** over any PID `𝒪 ↪ ℂ`
(in particular `𝒪 = ℤ` or any DVR `𝒪`) whenever the lattice `L` is finitely generated over `𝒪`. -/
theorem oHeckeAlg_finite_free [IsDomain 𝒪] [IsPrincipalIdealRing 𝒪]
    (hinj : Function.Injective (algebraMap 𝒪 ℂ)) [Module.Finite 𝒪 L] :
    Module.Finite 𝒪 (OHeckeAlg k χ S hinv L hL_inv) ∧
      Module.Free 𝒪 (OHeckeAlg k χ S hinv L hL_inv) := by
  have : Module.IsTorsionFree 𝒪 L := lattice_isTorsionFree S L hinj
  have : Module.Free 𝒪 L := Module.free_of_finite_type_torsion_free'
  have : Module.Finite 𝒪 (Module.End 𝒪 L) := inferInstance
  have : IsNoetherian 𝒪 (Module.End 𝒪 L) := isNoetherian_of_isNoetherianRing_of_finite 𝒪 _
  have hfin : Module.Finite 𝒪 (OHeckeAlg k χ S hinv L hL_inv) :=
    Module.Finite.iff_fg.mpr (IsNoetherian.noetherian (OHeckeAlg k χ S hinv L hL_inv).toSubmodule)
  have : Module.IsTorsionFree 𝒪 (OHeckeAlg k χ S hinv L hL_inv) :=
    oHeckeAlg_isTorsionFree k χ S hinv L hL_inv hinj
  exact ⟨hfin, Module.free_of_finite_type_torsion_free'⟩

end GeneralBaseRing

/-! ### Explicit `ℤ`-Specialization: The Integral Hecke Algebra `IntHeckeAlg` (`𝕋_ℤ`) -/

section ZSpecialization

variable (L : Submodule ℤ S)
variable (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ f ∈ L, heckeEnd k χ S hinv n hn f ∈ L)

/-- The **integral Hecke algebra** `𝕋_ℤ ⊆ End_ℤ(S_ℤ)` generated over `ℤ` by `{ T_n | n ≥ 1 }`. -/
abbrev IntHeckeAlg : Subalgebra ℤ (Module.End ℤ L) :=
  OHeckeAlg k χ S hinv L hL_inv

theorem intHeckeAlg_isTorsionFree :
    Module.IsTorsionFree ℤ (IntHeckeAlg k χ S hinv L hL_inv) :=
  oHeckeAlg_isTorsionFree k χ S hinv L hL_inv Int.cast_injective

theorem intHeckeAlg_finite_free [Module.Finite ℤ L] :
    Module.Finite ℤ (IntHeckeAlg k χ S hinv L hL_inv) ∧
      Module.Free ℤ (IntHeckeAlg k χ S hinv L hL_inv) :=
  oHeckeAlg_finite_free k χ S hinv L hL_inv Int.cast_injective

end ZSpecialization

/-! ### Canonical Integral `q`-Expansion Lattice `integralCuspLattice 𝒪 S` -/

section CanonicalIntegralLattice

/-- Every finite-dimensional subspace `S ⊆ (ℕ → ℂ)` admits a finite set of Fourier indices
`F : Finset ℕ` whose evaluation map `f ↦ (f n)_{n ∈ F}` is injective on `S`. -/
theorem exists_finset_eval_injective (W : Submodule ℂ (ℕ → ℂ)) [FiniteDimensional ℂ W] :
    ∃ F : Finset ℕ, Function.Injective (fun f : W => fun n : F => f.1 n.1) := by
  classical
  let kerSet : Finset ℕ → Submodule ℂ W := fun F =>
    { carrier := { f : W | ∀ n ∈ F, f.1 n = 0 }
      add_mem' := fun {f g} hf hg n hn => by simp [hf n hn, hg n hn]
      zero_mem' := fun n _ => rfl
      smul_mem' := fun c f hf n hn => by simp [hf n hn] }
  have hex : ∃ F : Finset ℕ, kerSet F = ⊥ := by
    let P : ℕ → Prop := fun r => ∃ F : Finset ℕ, Module.finrank ℂ (kerSet F) = r
    have hPne : ∃ r, P r := ⟨Module.finrank ℂ (kerSet ∅), ∅, rfl⟩
    set r₀ := Nat.find hPne with hr₀_def
    obtain ⟨F₀, hF₀⟩ := Nat.find_spec hPne
    have hF₀' : Module.finrank ℂ (kerSet F₀) = r₀ := hF₀
    by_cases hr₀ : r₀ = 0
    · refine ⟨F₀, ?_⟩
      rw [eq_bot_iff]
      intro f hf
      have h0 : Module.finrank ℂ (kerSet F₀) = 0 := hF₀'.trans hr₀
      have hsub : Subsingleton (kerSet F₀) := Module.finrank_zero_iff.mp h0
      exact congrArg Subtype.val (@Subsingleton.elim _ hsub ⟨f, hf⟩ 0)
    · exfalso
      have hne_bot : kerSet F₀ ≠ ⊥ := by
        intro hbot
        apply hr₀
        rw [← hF₀', hbot, finrank_bot]
      obtain ⟨f₀, hf₀_mem, hf₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne_bot
      have hex_n : ∃ n : ℕ, f₀.1 n ≠ 0 := by
        by_contra hall
        push Not at hall
        apply hf₀_ne
        exact Subtype.ext (funext hall)
      obtain ⟨n₀, hn₀⟩ := hex_n
      let F₁ := insert n₀ F₀
      have hlt : kerSet F₁ < kerSet F₀ := by
        refine lt_of_le_of_ne (fun f hf n hn => hf n (Finset.mem_insert_of_mem hn)) ?_
        intro heq
        have hf₀_in : f₀ ∈ kerSet F₁ := heq.symm ▸ hf₀_mem
        exact hn₀ (hf₀_in n₀ (Finset.mem_insert_self n₀ F₀))
      have hdim_lt : Module.finrank ℂ (kerSet F₁) < r₀ := by
        rw [← hF₀']
        exact Submodule.finrank_lt_finrank_of_lt hlt
      exact Nat.find_min hPne hdim_lt ⟨F₁, rfl⟩
  obtain ⟨F, hF⟩ := hex
  refine ⟨F, fun f g hfg => ?_⟩
  have hdiff : f - g ∈ kerSet F := by
    intro n hn
    have h := congrFun hfg ⟨n, hn⟩
    exact sub_eq_zero.mpr h
  rw [hF, Submodule.mem_bot] at hdiff
  exact sub_eq_zero.mp hdiff

/-- Canonical `𝒪`-integral `q`-expansion lattice `S_𝒪 = { f ∈ S | ∀ n, f n ∈ 𝒪 }`. -/
def integralCuspLattice (𝒪 : Type*) [CommRing 𝒪] [Algebra 𝒪 ℂ] (W : Submodule ℂ (ℕ → ℂ)) :
    Submodule 𝒪 W where
  carrier := { f : W | ∀ n : ℕ, f.1 n ∈ Set.range (algebraMap 𝒪 ℂ) }
  add_mem' := fun {f g} hf hg n => by
    obtain ⟨a, ha⟩ := hf n
    obtain ⟨b, hb⟩ := hg n
    exact ⟨a + b, by simp [map_add, ha, hb]⟩
  zero_mem' := fun n => ⟨0, map_zero _⟩
  smul_mem' := fun r f hf n => by
    obtain ⟨a, ha⟩ := hf n
    refine ⟨r * a, ?_⟩
    simp [map_mul, ha, Algebra.smul_def]

/-- Extract the unique `n`-th Fourier coefficient in `𝒪` of an element `f ∈ integralCuspLattice 𝒪 W`. -/
def integralCoeff {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ] {W : Submodule ℂ (ℕ → ℂ)}
    (f : integralCuspLattice 𝒪 W) (n : ℕ) : 𝒪 :=
  Classical.choose (f.2 n)

@[simp]
theorem algebraMap_integralCoeff {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ] {W : Submodule ℂ (ℕ → ℂ)}
    (f : integralCuspLattice 𝒪 W) (n : ℕ) :
    algebraMap 𝒪 ℂ (integralCoeff f n) = f.1.1 n :=
  Classical.choose_spec (f.2 n)

theorem integralCoeff_add {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]
    (hinj : Function.Injective (algebraMap 𝒪 ℂ)) {W : Submodule ℂ (ℕ → ℂ)}
    (f g : integralCuspLattice 𝒪 W) (n : ℕ) :
    integralCoeff (f + g) n = integralCoeff f n + integralCoeff g n :=
  hinj (by simp [map_add])

theorem integralCoeff_sub {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]
    (hinj : Function.Injective (algebraMap 𝒪 ℂ)) {W : Submodule ℂ (ℕ → ℂ)}
    (f g : integralCuspLattice 𝒪 W) (n : ℕ) :
    integralCoeff (f - g) n = integralCoeff f n - integralCoeff g n :=
  hinj (by simp [map_sub])

theorem integralCoeff_smul {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]
    (hinj : Function.Injective (algebraMap 𝒪 ℂ)) {W : Submodule ℂ (ℕ → ℂ)}
    (r : 𝒪) (f : integralCuspLattice 𝒪 W) (n : ℕ) :
    integralCoeff (r • f) n = r * integralCoeff f n :=
  hinj (by simp [map_mul, Algebra.smul_def])

theorem integralCoeff_zero {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]
    (hinj : Function.Injective (algebraMap 𝒪 ℂ)) {W : Submodule ℂ (ℕ → ℂ)} (n : ℕ) :
    integralCoeff (0 : integralCuspLattice 𝒪 W) n = 0 :=
  hinj (by simp)

/-- Whenever `χ` is `𝒪`-valued, every Hecke operator `T_n` (`n ≥ 1`) preserves
`integralCuspLattice 𝒪 S`. -/
theorem integralCuspLattice_hecke_invariant {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    (n : ℕ) (hn : 1 ≤ n) (f : S) (hf : f ∈ integralCuspLattice 𝒪 S) :
    heckeEnd k χ S hinv n hn f ∈ integralCuspLattice 𝒪 S := by
  intro m
  change ∑ d ∈ (Nat.gcd m n).divisors,
      χ (d : ZMod N) * (d : ℂ) ^ (k - 1) * f.1 (m * n / d ^ 2) ∈ Set.range (algebraMap 𝒪 ℂ)
  let R : Subring ℂ := (algebraMap 𝒪 ℂ).range
  have hmem : ∀ d ∈ (Nat.gcd m n).divisors,
      χ (d : ZMod N) * (d : ℂ) ^ (k - 1) * f.1 (m * n / d ^ 2) ∈ R := by
    intro d _
    refine R.mul_mem (R.mul_mem (hχ d) ?_) (hf (m * n / d ^ 2))
    exact ⟨(d : 𝒪) ^ (k - 1), by simp⟩
  exact R.sum_mem hmem

/-- **Unconditional Finiteness and Freeness of `integralCuspLattice 𝒪 S`** for ANY finite-dimensional
`S ⊆ (ℕ → ℂ)` and ANY PID `𝒪 ↪ ℂ` (e.g., `𝒪 = ℤ` or any DVR). -/
theorem integralCuspLattice_finite_free {𝒪 : Type*} [CommRing 𝒪] [IsDomain 𝒪]
    [IsPrincipalIdealRing 𝒪] [Algebra 𝒪 ℂ] (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (W : Submodule ℂ (ℕ → ℂ)) [FiniteDimensional ℂ W] :
    Module.Finite 𝒪 (integralCuspLattice 𝒪 W) ∧ Module.Free 𝒪 (integralCuspLattice 𝒪 W) := by
  obtain ⟨F, hF⟩ := exists_finset_eval_injective W
  let ev : integralCuspLattice 𝒪 W →ₗ[𝒪] (F → 𝒪) :=
    { toFun := fun f n => integralCoeff f n.1
      map_add' := fun f g => by ext n; exact integralCoeff_add hinj f g n.1
      map_smul' := fun r f => by ext n; exact integralCoeff_smul hinj r f n.1 }
  have hev_inj : Function.Injective ev := by
    intro f g hfg
    apply Subtype.ext
    apply hF
    ext n
    have hn := congrArg (algebraMap 𝒪 ℂ) (congrFun hfg n)
    simpa [ev] using hn
  have : IsNoetherian 𝒪 (F → 𝒪) := isNoetherian_of_isNoetherianRing_of_finite 𝒪 (F → 𝒪)
  have hfin_range : Module.Finite 𝒪 (LinearMap.range ev) :=
    Module.Finite.iff_fg.mpr (IsNoetherian.noetherian (LinearMap.range ev))
  let e : integralCuspLattice 𝒪 W ≃ₗ[𝒪] LinearMap.range ev := LinearEquiv.ofInjective ev hev_inj
  have : Module.Finite 𝒪 (integralCuspLattice 𝒪 W) := Module.Finite.equiv e.symm
  have : Module.IsTorsionFree 𝒪 (integralCuspLattice 𝒪 W) := by
    refine Module.isTorsionFree_iff_smul_eq_zero.mpr fun {r f} hrf => ?_
    by_cases hr0 : r = 0
    · exact Or.inl hr0
    · right
      apply hev_inj
      ext n
      have h0 := congrFun (congrArg ev hrf) n
      rw [map_smul, map_zero, Pi.smul_apply, Pi.zero_apply, smul_eq_mul] at h0
      rw [map_zero, Pi.zero_apply]
      exact (mul_eq_zero.mp h0).resolve_left hr0
  exact ⟨inferInstance, Module.free_of_finite_type_torsion_free'⟩

end CanonicalIntegralLattice

end IntegralHeckeAlgebra

/-! ## Section 2: Unconditional Perfect Hecke–Fourier Duality `S ≃ₗ[ℂ] Module.Dual ℂ 𝕋_ℂ` -/

section PerfectHeckeFourierDuality

variable {N : ℕ} (k : ℕ) (χ : DirichletCharacter ℂ N)
variable (S : Submodule ℂ (ℕ → ℂ))
variable (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)

/-- The **Hecke–Fourier pairing** `⟨T, f⟩ := (T f) 1` between the concrete Hecke algebra
`HeckeAlg k χ S hinv` and the cusp-form space `S`. -/
def heckeFourierPairing : HeckeAlg k χ S hinv →ₗ[ℂ] S →ₗ[ℂ] ℂ where
  toFun T :=
    { toFun := fun f => (T.1 f).1 1
      map_add' := fun f g => by simp
      map_smul' := fun c f => by simp }
  map_add' T₁ T₂ := by ext f; simp
  map_smul' c T := by ext f; simp

@[simp]
theorem heckeFourierPairing_apply (T : HeckeAlg k χ S hinv) (f : S) :
    heckeFourierPairing k χ S hinv T f = (T.1 f).1 1 :=
  rfl

@[simp]
theorem heckeFourierPairing_one (f : S) :
    heckeFourierPairing k χ S hinv 1 f = f.1 1 :=
  rfl

@[simp]
theorem heckeFourierPairing_gen (n : ℕ) (hn : 1 ≤ n) (f : S) :
    heckeFourierPairing k χ S hinv (heckeAlgGen k χ S hinv n hn) f = f.1 n :=
  heckeEnd_apply_one k χ S hinv n hn f

/-- **Exact Left Nondegeneracy of the Hecke–Fourier Pairing (Unconditional)**:
`(∀ f : S, (T f) 1 = 0) → T = 0`.
Proof: for any `f ∈ S` and `n ≥ 1`, `(T f) n = ((T_n ∘ T) f) 1 = ((T ∘ T_n) f) 1 = (T (T_n f)) 1 = 0`
by `heckeOp_apply_one` and commutativity of `HeckeAlg`! -/
theorem heckeFourierPairing_left_nondegenerate
    (hcusp : ∀ f ∈ S, f 0 = 0) (T : HeckeAlg k χ S hinv)
    (hT : ∀ f : S, heckeFourierPairing k χ S hinv T f = 0) :
    T = 0 := by
  apply Subtype.ext
  ext f n
  match n with
  | 0 => exact hcusp (T.1 f).1 (T.1 f).2
  | n + 1 =>
    have hn : 1 ≤ n + 1 := Nat.succ_pos n
    let Tn : HeckeAlg k χ S hinv := heckeAlgGen k χ S hinv (n + 1) hn
    have hcomm : Tn * T = T * Tn := mul_comm Tn T
    calc (T.1 f).1 (n + 1)
        = heckeOp k χ (n + 1) (T.1 f).1 1 := (heckeOp_apply_one k χ hn (T.1 f).1).symm
      _ = ((Tn * T).1 f).1 1 := rfl
      _ = ((T * Tn).1 f).1 1 := by rw [hcomm]
      _ = heckeFourierPairing k χ S hinv T (Tn.1 f) := rfl
      _ = 0 := hT (Tn.1 f)

/-- **Exact Right Nondegeneracy of the Hecke–Fourier Pairing (Unconditional)**:
`(∀ T : HeckeAlg, (T f) 1 = 0) → f = 0`.
Proof: evaluating at `T = T_n` gives `f n = (T_n f) 1 = 0` for all `n ≥ 1`! -/
theorem heckeFourierPairing_right_nondegenerate
    (hcusp : ∀ f ∈ S, f 0 = 0) (f : S)
    (hf : ∀ T : HeckeAlg k χ S hinv, heckeFourierPairing k χ S hinv T f = 0) :
    f = 0 := by
  apply Subtype.ext
  funext n
  match n with
  | 0 => exact hcusp f.1 f.2
  | n + 1 =>
    have hn : 1 ≤ n + 1 := Nat.succ_pos n
    simpa [heckeFourierPairing_gen k χ S hinv (n + 1) hn f] using
      hf (heckeAlgGen k χ S hinv (n + 1) hn)

theorem heckeFourierPairing_injective (hcusp : ∀ f ∈ S, f 0 = 0) :
    Function.Injective (heckeFourierPairing k χ S hinv) := by
  rw [injective_iff_map_eq_zero]
  intro T hT
  exact heckeFourierPairing_left_nondegenerate k χ S hinv hcusp T (fun f =>
    congrArg (fun (φ : S →ₗ[ℂ] ℂ) => φ f) hT)

theorem heckeFourierPairing_flip_injective (hcusp : ∀ f ∈ S, f 0 = 0) :
    Function.Injective (heckeFourierPairing k χ S hinv).flip := by
  rw [injective_iff_map_eq_zero]
  intro f hf
  exact heckeFourierPairing_right_nondegenerate k χ S hinv hcusp f (fun T =>
    congrArg (fun (φ : HeckeAlg k χ S hinv →ₗ[ℂ] ℂ) => φ T) hf)

/-- **Exact Dimension Equality (`dim_ℂ 𝕋_ℂ = dim_ℂ S`, Unconditional)** from two-sided
nondegeneracy of the Hecke–Fourier pairing! -/
theorem finrank_heckeAlg_eq_finrank [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) :
    Module.finrank ℂ (HeckeAlg k χ S hinv) = Module.finrank ℂ S := by
  have h1 : Module.finrank ℂ (HeckeAlg k χ S hinv) ≤ Module.finrank ℂ S := by
    calc Module.finrank ℂ (HeckeAlg k χ S hinv)
        ≤ Module.finrank ℂ (Module.Dual ℂ S) :=
          LinearMap.finrank_le_finrank_of_injective
            (heckeFourierPairing_injective k χ S hinv hcusp)
      _ = Module.finrank ℂ S := Subspace.dual_finrank_eq
  have h2 : Module.finrank ℂ S ≤ Module.finrank ℂ (HeckeAlg k χ S hinv) := by
    calc Module.finrank ℂ S
        ≤ Module.finrank ℂ (Module.Dual ℂ (HeckeAlg k χ S hinv)) :=
          LinearMap.finrank_le_finrank_of_injective
            (heckeFourierPairing_flip_injective k χ S hinv hcusp)
      _ = Module.finrank ℂ (HeckeAlg k χ S hinv) := Subspace.dual_finrank_eq
  exact le_antisymm h1 h2

/-- **CANONICAL PERFECT HECKE–FOURIER DUALITY (`S ≃ₗ[ℂ] Module.Dual ℂ 𝕋_ℂ`, Unconditional)**:
sends each cusp form `f ∈ S` to the linear functional `T ↦ (T f) 1` on `HeckeAlg k χ S hinv`. -/
def heckeFourierDualityEquiv [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) :
    S ≃ₗ[ℂ] Module.Dual ℂ (HeckeAlg k χ S hinv) := by
  have hdim : Module.finrank ℂ S = Module.finrank ℂ (Module.Dual ℂ (HeckeAlg k χ S hinv)) := by
    rw [Subspace.dual_finrank_eq, finrank_heckeAlg_eq_finrank k χ S hinv hcusp]
  have hinj := heckeFourierPairing_flip_injective k χ S hinv hcusp
  have hsurj : Function.Surjective (heckeFourierPairing k χ S hinv).flip :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mp hinj
  exact LinearEquiv.ofBijective (heckeFourierPairing k χ S hinv).flip ⟨hinj, hsurj⟩

/-- **Dual Form of Perfect Hecke–Fourier Duality (`𝕋_ℂ ≃ₗ[ℂ] Module.Dual ℂ S`, Unconditional)**. -/
def heckeAlgDualityEquiv [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) :
    HeckeAlg k χ S hinv ≃ₗ[ℂ] Module.Dual ℂ S := by
  have hdim : Module.finrank ℂ (HeckeAlg k χ S hinv) = Module.finrank ℂ (Module.Dual ℂ S) := by
    rw [Subspace.dual_finrank_eq, finrank_heckeAlg_eq_finrank k χ S hinv hcusp]
  have hinj := heckeFourierPairing_injective k χ S hinv hcusp
  have hsurj : Function.Surjective (heckeFourierPairing k χ S hinv) :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mp hinj
  exact LinearEquiv.ofBijective (heckeFourierPairing k χ S hinv) ⟨hinj, hsurj⟩

@[simp]
theorem heckeFourierDualityEquiv_apply [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) (f : S) (T : HeckeAlg k χ S hinv) :
    heckeFourierDualityEquiv k χ S hinv hcusp f T = (T.1 f).1 1 :=
  rfl

/-- Under `heckeFourierDualityEquiv.symm`, the `n`-th Fourier coefficient (`n ≥ 1`) of the cusp form
attached to a linear functional `φ : 𝕋_ℂ →ₗ[ℂ] ℂ` is literally `φ(T_n)`. -/
theorem heckeFourierDualityEquiv_symm_coeff [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) (φ : Module.Dual ℂ (HeckeAlg k χ S hinv)) {n : ℕ} (hn : 1 ≤ n) :
    ((heckeFourierDualityEquiv k χ S hinv hcusp).symm φ).1 n =
      φ (heckeAlgGen k χ S hinv n hn) := by
  have h := congrArg (fun (ψ : Module.Dual ℂ (HeckeAlg k χ S hinv)) =>
      ψ (heckeAlgGen k χ S hinv n hn))
    ((heckeFourierDualityEquiv k χ S hinv hcusp).apply_symm_apply φ)
  rw [heckeFourierDualityEquiv_apply, heckeAlgGen_val, heckeEnd_apply_one] at h
  exact h

end PerfectHeckeFourierDuality

/-! ## Section 3: Eigenform–AlgHom–Maximal-Ideal Bijection & Reduced / Étale `𝕋_ℂ ≃ₐ[ℂ] (Fin d → ℂ)` -/

section EigenformAlgHomAndEtale

variable {N : ℕ} (k : ℕ) (χ : DirichletCharacter ℂ N)
variable (S : Submodule ℂ (ℕ → ℂ))
variable (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)

/-- If `f ∈ S` is a normalized Hecke eigenform, then EVERY element `T ∈ HeckeAlg k χ S hinv` acts
on `f` by the scalar `⟨T, f⟩ = (T f) 1`. -/
theorem heckeAlg_apply_of_eigenform {f : S} (hf : IsNormalizedHeckeEigenform k χ f.1 f.1)
    (T : HeckeAlg k χ S hinv) :
    T.1 f = heckeFourierPairing k χ S hinv T f • f := by
  have hex : ∀ A ∈ HeckeAlg k χ S hinv, ∃ c : ℂ, A f = c • f := by
    intro A hA
    refine Algebra.adjoin_induction
      (p := fun A _ => ∃ c : ℂ, A f = c • f)
      (mem := by
        rintro A ⟨n, hn, rfl⟩
        refine ⟨f.1 n, Subtype.ext ?_⟩
        exact hf.2 n hn)
      (algebraMap := fun c => ⟨c, rfl⟩)
      (add := by
        rintro A₁ A₂ _ _ ⟨c₁, h₁⟩ ⟨c₂, h₂⟩
        exact ⟨c₁ + c₂, by simp [h₁, h₂, add_smul]⟩)
      (mul := by
        rintro A₁ A₂ _ _ ⟨c₁, h₁⟩ ⟨c₂, h₂⟩
        refine ⟨c₁ * c₂, ?_⟩
        change A₁ (A₂ f) = (c₁ * c₂) • f
        rw [h₂, map_smul, h₁, smul_smul, mul_comm])
      hA
  obtain ⟨c, hc⟩ := hex T.1 T.2
  have hc_eq : heckeFourierPairing k χ S hinv T f = c := by
    change (T.1 f).1 1 = c
    rw [hc]
    simp [hf.1]
  rw [hc_eq]
  exact hc

/-- **EXACT EIGENFORM ↔ ALGEBRA HOMOMORPHISM EQUIVALENCE (UNCONDITIONAL)**:
An element `f ∈ S` is a normalized Hecke eigenform (`f 1 = 1 ∧ ∀ n ≥ 1, T_n f = f n • f`)
**IF AND ONLY IF** the dual functional `φ_f(T) := (T f) 1` is a unital `ℂ`-algebra homomorphism
`HeckeAlg k χ S hinv →ₐ[ℂ] ℂ` (`φ_f 1 = 1 ∧ ∀ T₁ T₂, φ_f (T₁ * T₂) = φ_f T₁ * φ_f T₂`). -/
theorem isNormalizedHeckeEigenform_iff_isAlgHom [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) (f : S) :
    IsNormalizedHeckeEigenform k χ f.1 f.1 ↔
      (heckeFourierDualityEquiv k χ S hinv hcusp f 1 = 1 ∧
        ∀ T₁ T₂ : HeckeAlg k χ S hinv,
          heckeFourierDualityEquiv k χ S hinv hcusp f (T₁ * T₂) =
            heckeFourierDualityEquiv k χ S hinv hcusp f T₁ *
              heckeFourierDualityEquiv k χ S hinv hcusp f T₂) := by
  constructor
  · intro hf
    refine ⟨hf.1, fun T₁ T₂ => ?_⟩
    have hT₂ := heckeAlg_apply_of_eigenform k χ S hinv hf T₂
    change (T₁.1 (T₂.1 f)).1 1 = (T₁.1 f).1 1 * (T₂.1 f).1 1
    conv_lhs => rw [hT₂]
    rw [map_smul]
    simp [mul_comm]
  · rintro ⟨h1, hmul⟩
    refine ⟨h1, fun n hn => ?_⟩
    funext m
    match m with
    | 0 =>
      have hL : heckeOp k χ n f.1 0 = 0 := hcusp _ (hinv n hn f.1 f.2)
      have hR : f.1 0 = 0 := hcusp f.1 f.2
      simp [hL, hR]
    | m + 1 =>
      have hm : 1 ≤ m + 1 := Nat.succ_pos m
      let Tm : HeckeAlg k χ S hinv := heckeAlgGen k χ S hinv (m + 1) hm
      let Tn : HeckeAlg k χ S hinv := heckeAlgGen k χ S hinv n hn
      have hprod := hmul Tm Tn
      have hL : heckeFourierDualityEquiv k χ S hinv hcusp f (Tm * Tn) =
          heckeOp k χ n f.1 (m + 1) := by
        change heckeOp k χ (m + 1) (heckeOp k χ n f.1) 1 = heckeOp k χ n f.1 (m + 1)
        exact heckeOp_apply_one k χ hm (heckeOp k χ n f.1)
      have hRm : heckeFourierDualityEquiv k χ S hinv hcusp f Tm = f.1 (m + 1) :=
        heckeEnd_apply_one k χ S hinv (m + 1) hm f
      have hRn : heckeFourierDualityEquiv k χ S hinv hcusp f Tn = f.1 n :=
        heckeEnd_apply_one k χ S hinv n hn f
      rw [hL, hRm, hRn] at hprod
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [hprod, mul_comm]

/-- Construct the `ℂ`-algebra homomorphism `φ_f : HeckeAlg →ₐ[ℂ] ℂ` attached to a normalized
Hecke eigenform `f ∈ S`. -/
def algHomOfNormalizedEigenform [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) (f : S) (hf : IsNormalizedHeckeEigenform k χ f.1 f.1) :
    HeckeAlg k χ S hinv →ₐ[ℂ] ℂ :=
  let h := (isNormalizedHeckeEigenform_iff_isAlgHom k χ S hinv hcusp f).mp hf
  { toFun := fun T => heckeFourierDualityEquiv k χ S hinv hcusp f T
    map_one' := h.1
    map_mul' := h.2
    map_zero' := map_zero _
    map_add' := fun T₁ T₂ => map_add _ T₁ T₂
    commutes' := fun c => by
      change (algebraMap ℂ (Module.End ℂ S) c f).1 1 = c
      simp [hf.1] }

@[simp]
theorem algHomOfNormalizedEigenform_apply [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) (f : S) (hf : IsNormalizedHeckeEigenform k χ f.1 f.1)
    (T : HeckeAlg k χ S hinv) :
    algHomOfNormalizedEigenform k χ S hinv hcusp f hf T = (T.1 f).1 1 :=
  rfl

/-- **EXACT BIJECTION `{ 𝕋_ℂ →ₐ[ℂ] ℂ } ≃ { Normalized Hecke Eigenforms in S }` (UNCONDITIONAL)**. -/
def algHomEquivNormalizedEigenforms [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) :
    (HeckeAlg k χ S hinv →ₐ[ℂ] ℂ) ≃
      { f : S // IsNormalizedHeckeEigenform k χ f.1 f.1 } where
  toFun ψ :=
    let f : S := (heckeFourierDualityEquiv k χ S hinv hcusp).symm ψ.toLinearMap
    have hdual : heckeFourierDualityEquiv k χ S hinv hcusp f = ψ.toLinearMap :=
      (heckeFourierDualityEquiv k χ S hinv hcusp).apply_symm_apply ψ.toLinearMap
    ⟨f, (isNormalizedHeckeEigenform_iff_isAlgHom k χ S hinv hcusp f).mpr
      ⟨by rw [hdual]; exact map_one ψ, fun T₁ T₂ => by rw [hdual]; exact map_mul ψ T₁ T₂⟩⟩
  invFun f := algHomOfNormalizedEigenform k χ S hinv hcusp f.1 f.2
  left_inv ψ := by
    ext T
    change heckeFourierDualityEquiv k χ S hinv hcusp
        ((heckeFourierDualityEquiv k χ S hinv hcusp).symm ψ.toLinearMap) T = ψ T
    rw [(heckeFourierDualityEquiv k χ S hinv hcusp).apply_symm_apply]
    rfl
  right_inv f := by
    apply Subtype.ext
    change (heckeFourierDualityEquiv k χ S hinv hcusp).symm
        (algHomOfNormalizedEigenform k χ S hinv hcusp f.1 f.2).toLinearMap = f.1
    have hEq : (algHomOfNormalizedEigenform k χ S hinv hcusp f.1 f.2).toLinearMap =
        heckeFourierDualityEquiv k χ S hinv hcusp f.1 := rfl
    rw [hEq]
    exact (heckeFourierDualityEquiv k χ S hinv hcusp).symm_apply_apply f.1

theorem algHomEquivNormalizedEigenforms_coeff [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) (ψ : HeckeAlg k χ S hinv →ₐ[ℂ] ℂ) {n : ℕ} (hn : 1 ≤ n) :
    (algHomEquivNormalizedEigenforms k χ S hinv hcusp ψ).1.1 n =
      ψ (heckeAlgGen k χ S hinv n hn) :=
  heckeFourierDualityEquiv_symm_coeff k χ S hinv hcusp ψ.toLinearMap hn

/-! ### Exact Bijection `{ Maximal Ideals of 𝕋_ℂ } ≃ { 𝕋_ℂ →ₐ[ℂ] ℂ } ≃ { Normalized Eigenforms in S }` -/

/-- Every `ℂ`-algebra homomorphism `ψ : A →ₐ[ℂ] ℂ` from a commutative `ℂ`-algebra has a maximal
kernel. -/
theorem ker_algHom_isMaximal {A : Type*} [CommRing A] [Algebra ℂ A] (ψ : A →ₐ[ℂ] ℂ) :
    (RingHom.ker ψ.toRingHom).IsMaximal := by
  have hsurj : Function.Surjective ψ.toRingHom := fun c => ⟨algebraMap ℂ A c, ψ.commutes c⟩
  let e : A ⧸ RingHom.ker ψ.toRingHom ≃+* ℂ := RingHom.quotientKerEquivOfSurjective hsurj
  refine (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mpr ?_
  refine ⟨⟨0, 1, fun h => zero_ne_one (by
      have h' := congrArg e h
      rwa [map_zero, map_one] at h')⟩,
    fun x y => mul_comm x y, fun {x} hx => ?_⟩
  have hex : e x ≠ 0 := fun h => hx (e.injective (h.trans (map_zero e).symm))
  refine ⟨e.symm (e x)⁻¹, e.injective ?_⟩
  rw [map_mul, map_one, e.apply_symm_apply, mul_inv_cancel₀ hex]

/-- Over `ℂ` (which is algebraically closed), every maximal ideal `𝔪` of a finite-dimensional
commutative `ℂ`-algebra `A` is the kernel of a UNIQUE `ℂ`-algebra homomorphism `A →ₐ[ℂ] ℂ`
(Finite-Dimensional Nullstellensatz). -/
theorem existsUnique_algHom_ker_eq_of_isMaximal {A : Type*} [CommRing A] [Algebra ℂ A]
    [FiniteDimensional ℂ A] (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal) :
    ∃! ψ : A →ₐ[ℂ] ℂ, RingHom.ker ψ.toRingHom = 𝔪 := by
  let _ : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  have hsurj_alg : Function.Surjective (algebraMap ℂ (A ⧸ 𝔪)) := by
    intro x
    have hint : IsIntegral ℂ x := by
      have : FiniteDimensional ℂ (A ⧸ 𝔪) :=
        Module.Finite.of_surjective (Ideal.Quotient.mkₐ ℂ 𝔪).toLinearMap Ideal.Quotient.mk_surjective
      exact Algebra.IsIntegral.isIntegral x
    have hdeg_pos : 0 < (minpoly ℂ x).natDegree := (minpoly.irreducible hint).natDegree_pos
    have hroot := IsAlgClosed.exists_root (minpoly ℂ x) (by
      intro hdeg0
      have := congrArg Polynomial.natDegree (Polynomial.eq_C_of_degree_eq_zero hdeg0)
      simp at this
      omega)
    obtain ⟨c, hc⟩ := hroot
    have hlin : Polynomial.X - Polynomial.C c ∣ minpoly ℂ x :=
      Polynomial.dvd_iff_isRoot.mpr hc
    have hassoc : Associated (Polynomial.X - Polynomial.C c) (minpoly ℂ x) :=
      (Polynomial.irreducible_X_sub_C c).associated_of_dvd (minpoly.irreducible hint) hlin
    have heval : Polynomial.aeval x (Polynomial.X - Polynomial.C c) = 0 := by
      obtain ⟨u, hu⟩ := hassoc
      have h0 := congrArg (Polynomial.aeval x) hu
      rw [map_mul, minpoly.aeval] at h0
      have hu0 : Polynomial.aeval x (u : Polynomial ℂ) ≠ 0 :=
        (u.isUnit.map (Polynomial.aeval x)).ne_zero
      exact (mul_eq_zero.mp h0).resolve_right hu0
    rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at heval
    exact ⟨c, heval.symm⟩
  have hinj_alg : Function.Injective (algebraMap ℂ (A ⧸ 𝔪)) :=
    (algebraMap ℂ (A ⧸ 𝔪)).injective
  let e : ℂ ≃ₐ[ℂ] (A ⧸ 𝔪) := AlgEquiv.ofBijective (Algebra.ofId ℂ (A ⧸ 𝔪)) ⟨hinj_alg, hsurj_alg⟩
  let ψ : A →ₐ[ℂ] ℂ := e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ ℂ 𝔪)
  refine ⟨ψ, ?_, ?_⟩
  · ext a
    simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, ψ,
      AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    change e.symm (Ideal.Quotient.mk 𝔪 a) = 0 ↔ a ∈ 𝔪
    rw [EmbeddingLike.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
  · intro ψ' hψ'
    ext a
    have ha : a - algebraMap ℂ A (ψ' a) ∈ 𝔪 := by
      rw [← hψ', RingHom.mem_ker]
      change ψ' (a - algebraMap ℂ A (ψ' a)) = 0
      simp [map_sub, ψ'.commutes]
    have hq : Ideal.Quotient.mk 𝔪 a = algebraMap ℂ (A ⧸ 𝔪) (ψ' a) := by
      rw [← sub_eq_zero]
      change Ideal.Quotient.mk 𝔪 (a - algebraMap ℂ A (ψ' a)) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    change ψ' a = e.symm (Ideal.Quotient.mk 𝔪 a)
    rw [hq]
    exact (e.symm_apply_apply (ψ' a)).symm

/-- **EXACT BIJECTION `{ Maximal Ideals of 𝕋_ℂ } ≃ { Normalized Hecke Eigenforms in S }`
(UNCONDITIONAL)**: every maximal ideal `𝔪 ⊆ HeckeAlg k χ S hinv` corresponds uniquely to a
normalized Hecke eigenform `f ∈ S` via `𝔪 = { T ∈ 𝕋_ℂ | (T f) 1 = 0 }`. -/
def maximalIdealEquivNormalizedEigenforms [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) :
    { 𝔪 : Ideal (HeckeAlg k χ S hinv) // 𝔪.IsMaximal } ≃
      { f : S // IsNormalizedHeckeEigenform k χ f.1 f.1 } :=
  let eMax : { 𝔪 : Ideal (HeckeAlg k χ S hinv) // 𝔪.IsMaximal } ≃
      (HeckeAlg k χ S hinv →ₐ[ℂ] ℂ) :=
    { toFun := fun 𝔪 => Classical.choose
        (existsUnique_algHom_ker_eq_of_isMaximal 𝔪.1 𝔪.2).exists
      invFun := fun ψ => ⟨RingHom.ker ψ.toRingHom, ker_algHom_isMaximal ψ⟩
      left_inv := fun 𝔪 => Subtype.ext (Classical.choose_spec
        (existsUnique_algHom_ker_eq_of_isMaximal 𝔪.1 𝔪.2).exists)
      right_inv := fun ψ =>
        (existsUnique_algHom_ker_eq_of_isMaximal
          (RingHom.ker ψ.toRingHom) (ker_algHom_isMaximal ψ)).unique
          (Classical.choose_spec
            (existsUnique_algHom_ker_eq_of_isMaximal
              (RingHom.ker ψ.toRingHom) (ker_algHom_isMaximal ψ)).exists)
          rfl }
  eMax.trans (algHomEquivNormalizedEigenforms k χ S hinv hcusp)

/-! ### Reduced / Étale Structure `𝕋_ℂ ≃ₐ[ℂ] (Fin d → ℂ)` under a Simultaneous Eigenbasis -/

section EtaleEigenbasis

/-- **Étale / Diagonalization Isomorphism `HeckeAlg S ≃ₐ[ℂ] (Fin d → ℂ)`**:
Whenever `S` admits a basis `g : Fin d → S` of normalized Hecke eigenforms, the joint eigenvalue
homomorphism `T ↦ (j ↦ (T (g j)) 1)` is a `ℂ`-algebra isomorphism `HeckeAlg k χ S hinv ≃ₐ[ℂ] (Fin d → ℂ)`. -/
def heckeAlgEquivPiOfEigenbasis [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) {d : ℕ}
    (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1) :
    HeckeAlg k χ S hinv ≃ₐ[ℂ] (Fin d → ℂ) := by
  let Φ : HeckeAlg k χ S hinv →ₐ[ℂ] (Fin d → ℂ) :=
    AlgHom.pi (fun j => algHomOfNormalizedEigenform k χ S hinv hcusp (b j) (heig j))
  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro T hT
    apply Subtype.ext
    apply b.ext
    intro j
    have hTj : (T.1 (b j)).1 1 = 0 := congrFun hT j
    have hact := heckeAlg_apply_of_eigenform k χ S hinv (heig j) T
    change T.1 (b j) = 0
    rw [hact]
    change (T.1 (b j)).1 1 • b j = 0
    rw [hTj, zero_smul]
  have hdim : Module.finrank ℂ (HeckeAlg k χ S hinv) = Module.finrank ℂ (Fin d → ℂ) := by
    rw [finrank_heckeAlg_eq_finrank k χ S hinv hcusp, Module.finrank_eq_card_basis b,
      Module.finrank_pi]
  have hsurj : Function.Surjective Φ :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim (f := Φ.toLinearMap)).mp hinj
  exact AlgEquiv.ofBijective Φ ⟨hinj, hsurj⟩

@[simp]
theorem heckeAlgEquivPiOfEigenbasis_apply [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) {d : ℕ}
    (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (T : HeckeAlg k χ S hinv) (j : Fin d) :
    heckeAlgEquivPiOfEigenbasis k χ S hinv hcusp b heig T j = (T.1 (b j)).1 1 :=
  rfl

/-- **Reducedness of `HeckeAlg`** whenever `S` has a basis of normalized Hecke eigenforms:
`HeckeAlg` has NO nonzero nilpotent elements! -/
theorem isReduced_heckeAlg_of_eigenbasis [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0) {d : ℕ}
    (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1) :
    IsReduced (HeckeAlg k χ S hinv) := by
  let e := heckeAlgEquivPiOfEigenbasis k χ S hinv hcusp b heig
  refine ⟨fun T hT => ?_⟩
  rcases hT with ⟨m, hm⟩
  apply e.injective
  ext j
  have hj : (e T j) ^ m = 0 := by
    have h := congrFun (congrArg e hm) j
    simpa [map_pow, map_zero] using h
  exact eq_zero_of_pow_eq_zero hj

/-- **Exact Classification of All Normalized Eigenforms in `S`**:
Under an eigenbasis `b : Fin d → S`, EVERY normalized Hecke eigenform `f ∈ S` equals `b j` for a
unique `j : Fin d`! -/
theorem existsUnique_eigenbasis_eq_of_normalizedEigenform [FiniteDimensional ℂ S]
    (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)
    (hcusp : ∀ f ∈ S, f 0 = 0) {d : ℕ}
    (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (f : S) (hf : IsNormalizedHeckeEigenform k χ f.1 f.1) :
    ∃! j : Fin d, f = b j := by
  let e := heckeAlgEquivPiOfEigenbasis k χ S hinv hcusp b heig
  let ψ : (Fin d → ℂ) →ₐ[ℂ] ℂ :=
    (algHomOfNormalizedEigenform k χ S hinv hcusp f hf).comp e.symm.toAlgHom
  have hsum_single : (∑ j : Fin d, Pi.single (M := fun _ => ℂ) j (1 : ℂ)) = (1 : Fin d → ℂ) := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  have hsum1 : (∑ j : Fin d, ψ (Pi.single (M := fun _ => ℂ) j (1 : ℂ))) = 1 := by
    rw [← map_sum, hsum_single, map_one]
  have hex : ∃ j : Fin d, ψ (Pi.single (M := fun _ => ℂ) j (1 : ℂ)) ≠ 0 := by
    by_contra hall
    push Not at hall
    rw [Finset.sum_eq_zero (fun j _ => hall j)] at hsum1
    exact zero_ne_one hsum1
  obtain ⟨j₀, hj₀⟩ := hex
  have hidem : ∀ j : Fin d, ψ (Pi.single (M := fun _ => ℂ) j (1 : ℂ)) *
      ψ (Pi.single (M := fun _ => ℂ) j (1 : ℂ)) =
      ψ (Pi.single (M := fun _ => ℂ) j (1 : ℂ)) := by
    intro j
    rw [← map_mul]
    congr 1
    ext i
    by_cases hij : i = j <;> simp [hij]
  have hval_j₀ : ψ (Pi.single (M := fun _ => ℂ) j₀ (1 : ℂ)) = 1 := by
    have h := hidem j₀
    have hsub : ψ (Pi.single (M := fun _ => ℂ) j₀ (1 : ℂ)) *
        (ψ (Pi.single (M := fun _ => ℂ) j₀ (1 : ℂ)) - 1) = 0 := by
      linear_combination h
    exact sub_eq_zero.mp ((mul_eq_zero.mp hsub).resolve_left hj₀)
  have hval_ne : ∀ j : Fin d, j ≠ j₀ → ψ (Pi.single (M := fun _ => ℂ) j (1 : ℂ)) = 0 := by
    intro j hj
    have h0 : Pi.single (M := fun _ => ℂ) j (1 : ℂ) * Pi.single (M := fun _ => ℂ) j₀ (1 : ℂ) = 0 := by
      ext i
      by_cases hij : i = j
      · subst hij; simp [hj]
      · simp [Pi.single_apply, hij]
    have hmul := congrArg ψ h0
    rw [map_mul, map_zero, hval_j₀, mul_one] at hmul
    exact hmul
  have hψ_eval : ∀ v : Fin d → ℂ, ψ v = v j₀ := by
    intro v
    have hv : v = ∑ j : Fin d, v j • Pi.single (M := fun _ => ℂ) j (1 : ℂ) := by
      ext i; simp [Finset.sum_apply, Pi.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    rw [Finset.sum_eq_single j₀]
    · rw [map_smul, hval_j₀, smul_eq_mul, mul_one]
    · intro j _ hj
      rw [map_smul, hval_ne j hj, smul_zero]
    · intro h; exact absurd (Finset.mem_univ j₀) h
  have hf_eq : f = b j₀ := by
    apply (heckeFourierDualityEquiv k χ S hinv hcusp).injective
    ext T
    have h1 : ψ (e T) = (T.1 f).1 1 := by
      change (algHomOfNormalizedEigenform k χ S hinv hcusp f hf) (e.symm (e T)) = (T.1 f).1 1
      rw [e.symm_apply_apply]
      rfl
    have h2 : ψ (e T) = (T.1 (b j₀)).1 1 := by
      rw [hψ_eval (e T)]
      rfl
    exact h1.symm.trans h2
  refine ⟨j₀, hf_eq, fun j hj => ?_⟩
  have hbj : b j = b j₀ := hj.symm.trans hf_eq
  exact b.injective hbj

end EtaleEigenbasis

/-! ### Direct Bridge to `Stage6HeckeSpectral.PeterssonQExpansionSpace` -/

section PeterssonBridge

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]

/-- The cuspidal `q`-expansion subspace `S = range(P.qExp) ⊆ (ℕ → ℂ)` of any
`Stage6HeckeSpectral.PeterssonQExpansionSpace k χ H`. -/
def peterssonQSubspace {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H) : Submodule ℂ (ℕ → ℂ) :=
  LinearMap.range P.qExp

theorem peterssonQSubspace_cusp {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H) :
    ∀ f ∈ peterssonQSubspace P, f 0 = 0 := by
  rintro f ⟨v, rfl⟩
  exact P.qExp_cusp v

theorem peterssonQSubspace_hecke_inv {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H) :
    ∀ n : ℕ, 1 ≤ n → ∀ f ∈ peterssonQSubspace P, heckeOp k χ n f ∈ peterssonQSubspace P := by
  rintro n hn f ⟨v, rfl⟩
  exact ⟨P.hecke n v, P.qExp_hecke n hn v⟩

/-- Canonical `ℂ`-linear isomorphism `H ≃ₗ[ℂ] peterssonQSubspace P`. -/
def peterssonQSubspaceEquiv {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H) : H ≃ₗ[ℂ] peterssonQSubspace P :=
  LinearEquiv.ofInjective P.qExp P.qExp_injective

instance instFiniteDimensionalPeterssonQSubspace {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H) : FiniteDimensional ℂ (peterssonQSubspace P) :=
  Module.Finite.equiv (peterssonQSubspaceEquiv P)

/-- **Étale & Reduced Hecke Algebra Theorem for `Stage6HeckeSpectral.PeterssonQExpansionSpace`**:
For every `P : PeterssonQExpansionSpace k χ H`, `peterssonQSubspace P` admits a basis of
normalized Hecke eigenforms (rescaled from the Petersson orthonormal eigenbasis), and therefore:
1. `HeckeAlg k χ (peterssonQSubspace P) _ ≃ₐ[ℂ] (Fin (Module.finrank ℂ H) → ℂ)` (étale!),
2. `IsReduced (HeckeAlg k χ (peterssonQSubspace P) _)`,
3. `Module.finrank ℂ (HeckeAlg k χ (peterssonQSubspace P) _) = Module.finrank ℂ H`. -/
theorem peterssonHeckeAlg_etale_and_reduced {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H) :
    ∃ (b : Module.Basis (Fin (Module.finrank ℂ H)) ℂ (peterssonQSubspace P)),
      (∀ j, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1) ∧
      Nonempty (HeckeAlg k χ (peterssonQSubspace P) (peterssonQSubspace_hecke_inv P) ≃ₐ[ℂ]
        (Fin (Module.finrank ℂ H) → ℂ)) ∧
      IsReduced (HeckeAlg k χ (peterssonQSubspace P) (peterssonQSubspace_hecke_inv P)) ∧
      Module.finrank ℂ (HeckeAlg k χ (peterssonQSubspace P) (peterssonQSubspace_hecke_inv P)) =
        Module.finrank ℂ H := by
  obtain ⟨f, g, _, hf_eig, _, _, _, _, _⟩ := peterssonQExpansion_spectral_eulerProduct P
  have hq_ne : ∀ j, P.qExp (f j) ≠ 0 := fun j h0 =>
    (f.orthonormal.ne_zero j) (P.qExp_injective (h0.trans (map_zero P.qExp).symm))
  have hq_eig : ∀ j, IsHeckeEigenform k χ (P.qExp (f j)) (g j) := fun j n hn => by
    rw [← P.qExp_hecke n hn (f j), hf_eig j n hn, map_smul]
  have hq1_ne : ∀ j, P.qExp (f j) 1 ≠ 0 := fun j =>
    cusp_eigenform_coeff_one_ne_zero (P.qExp_cusp (f j)) (hq_eig j) (hq_ne j)
  let c : Fin (Module.finrank ℂ H) → ℂˣ :=
    fun j => Units.mk0 (P.qExp (f j) 1)⁻¹ (inv_ne_zero (hq1_ne j))
  let bH : Module.Basis (Fin (Module.finrank ℂ H)) ℂ H := f.toBasis.unitsSMul c
  let b : Module.Basis (Fin (Module.finrank ℂ H)) ℂ (peterssonQSubspace P) :=
    bH.map (peterssonQSubspaceEquiv P)
  have hb_eq : ∀ j, (b j).1 = (P.qExp (f j) 1)⁻¹ • P.qExp (f j) := by
    intro j
    rw [show b j = peterssonQSubspaceEquiv P (bH j) from Module.Basis.map_apply _ _ j,
      show bH j = (c j : ℂ) • f j from by
        rw [Module.Basis.unitsSMul_apply, OrthonormalBasis.coe_toBasis, Units.smul_def],
      map_smul]
    rfl
  have hb_norm : ∀ j, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1 := by
    intro j
    rw [hb_eq j]
    obtain ⟨_, hnorm, _⟩ := cusp_eigenform_normalize (P.qExp_cusp (f j)) (hq_eig j) (hq1_ne j)
    refine ⟨hnorm.1, fun n hn => ?_⟩
    have heq := eigenvalue_eq_coeff hnorm hn
    rw [← heq]
    exact hnorm.2 n hn
  refine ⟨b, hb_norm,
    ⟨heckeAlgEquivPiOfEigenbasis k χ (peterssonQSubspace P) (peterssonQSubspace_hecke_inv P)
      (peterssonQSubspace_cusp P) b hb_norm⟩,
    isReduced_heckeAlg_of_eigenbasis k χ (peterssonQSubspace P) (peterssonQSubspace_hecke_inv P)
      (peterssonQSubspace_cusp P) b hb_norm, ?_⟩
  rw [finrank_heckeAlg_eq_finrank k χ (peterssonQSubspace P) (peterssonQSubspace_hecke_inv P)
    (peterssonQSubspace_cusp P), (peterssonQSubspaceEquiv P).finrank_eq]

end PeterssonBridge

end EigenformAlgHomAndEtale

/-! ## Section 4: Integral Augmentation `π_f`, Integral Duality, Congruence Ideal ↔ `f^⊥`, & Wiles–Lenstra `R = T` Bridge -/

section IntegralDualityAndCongruenceIdeal

variable {N : ℕ} (k : ℕ) (χ : DirichletCharacter ℂ N)
variable (S : Submodule ℂ (ℕ → ℂ))
variable (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)

/-! ### Exact Base-Change Linear Independence (`𝒪`-linearly independent in `Fin m → 𝒪` ⇒ `ℂ`-linearly independent) -/

/-- Over any integral domain `𝒪` embedded injectively into `ℂ`, an `𝒪`-linearly independent family
of vectors in `Fin m → 𝒪` remains `ℂ`-linearly independent in `Fin m → ℂ`. -/
theorem linearIndependent_map_of_linearIndependent_domain
    {𝒪 : Type*} [CommRing 𝒪] [IsDomain 𝒪] [Algebra 𝒪 ℂ]
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    {r m : ℕ} (v : Fin r → (Fin m → 𝒪))
    (hli : LinearIndependent 𝒪 v) :
    LinearIndependent ℂ (fun i : Fin r => fun j : Fin m => algebraMap 𝒪 ℂ (v i j)) := by
  classical
  let K := FractionRing 𝒪
  let ιK : K →+* ℂ :=
    IsLocalization.lift (M := nonZeroDivisors 𝒪) (g := algebraMap 𝒪 ℂ) (fun y =>
      isUnit_iff_ne_zero.mpr (by
        intro h0
        have hy0 : (y : 𝒪) = 0 := hinj (h0.trans (map_zero _).symm)
        exact nonZeroDivisors.ne_zero y.2 hy0))
  have hιK_comp : ∀ a : 𝒪, ιK (algebraMap 𝒪 K a) = algebraMap 𝒪 ℂ a :=
    fun a => IsLocalization.lift_eq _ a
  let vK : Fin r → (Fin m → K) := fun i j => algebraMap 𝒪 K (v i j)
  have hliK : LinearIndependent K vK := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsec : ∀ i : Fin r, ∃ a : 𝒪, ∃ s : nonZeroDivisors 𝒪,
        algebraMap 𝒪 K (s : 𝒪) * c i = algebraMap 𝒪 K a := by
      intro i
      obtain ⟨⟨a, s⟩, hEq⟩ := IsLocalization.surj (nonZeroDivisors 𝒪) (c i)
      exact ⟨a, s, by rw [mul_comm]; exact hEq⟩
    choose a s hs using hsec
    let Sprod : nonZeroDivisors 𝒪 := ∏ i : Fin r, s i
    let b : Fin r → 𝒪 := fun i => (∏ j ∈ Finset.univ.erase i, (s j : 𝒪)) * a i
    have hSb : ∀ i : Fin r, algebraMap 𝒪 K (Sprod : 𝒪) * c i = algebraMap 𝒪 K (b i) := by
      intro i
      have hprod_eq : (Sprod : 𝒪) = (∏ j ∈ Finset.univ.erase i, (s j : 𝒪)) * (s i : 𝒪) := by
        rw [Submonoid.coe_finsetProd,
          ← Finset.mul_prod_erase Finset.univ (fun j => (s j : 𝒪)) (Finset.mem_univ i), mul_comm]
      rw [hprod_eq, map_mul, mul_assoc, hs i, ← map_mul]
    have hsum_b : ∑ i : Fin r, b i • v i = 0 := by
      ext j
      apply FaithfulSMul.algebraMap_injective 𝒪 K
      rw [Pi.zero_apply, map_zero, Finset.sum_apply, map_sum]
      have h0 := congrArg (fun x => algebraMap 𝒪 K (Sprod : 𝒪) * x) (congrFun hc j)
      rw [Pi.zero_apply, mul_zero, Finset.sum_apply, Finset.mul_sum] at h0
      rw [← h0]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [Pi.smul_apply, smul_eq_mul, vK, map_mul, ← mul_assoc, hSb i]
    have hb0 : ∀ i : Fin r, b i = 0 := (Fintype.linearIndependent_iff.mp hli) b hsum_b
    intro i
    have hSc0 : algebraMap 𝒪 K (Sprod : 𝒪) * c i = 0 := by
      rw [hSb i, hb0 i, map_zero]
    have hSne : algebraMap 𝒪 K (Sprod : 𝒪) ≠ 0 := by
      intro h0
      exact nonZeroDivisors.ne_zero Sprod.2
        (FaithfulSMul.algebraMap_injective 𝒪 K (h0.trans (map_zero _).symm))
    exact (mul_eq_zero.mp hSc0).resolve_left hSne
  let fK : (Fin r → K) →ₗ[K] (Fin m → K) :=
    { toFun := fun x => ∑ i : Fin r, x i • vK i
      map_add' := fun x y => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun a x => by
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, smul_smul] }
  have hfK_ker : LinearMap.ker fK = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_bot]
    exact funext (Fintype.linearIndependent_iff.mp hliK x hx)
  obtain ⟨gK, hgK⟩ := LinearMap.exists_leftInverse_of_injective fK hfK_ker
  let M : Matrix (Fin r) (Fin m) K := LinearMap.toMatrix' gK
  let V : Matrix (Fin m) (Fin r) K := LinearMap.toMatrix' fK
  have hMV : M * V = 1 := by
    rw [← LinearMap.toMatrix'_comp, hgK, LinearMap.toMatrix'_id]
  have hMV_C : M.map ιK * V.map ιK = 1 := by
    rw [← Matrix.map_mul, hMV, Matrix.map_one ιK (map_zero ιK) (map_one ιK)]
  have hV_entry : ∀ j i, V.map ιK j i = algebraMap 𝒪 ℂ (v i j) := by
    intro j i
    change ιK (fK (Pi.single i 1) j) = algebraMap 𝒪 ℂ (v i j)
    have hf_single : fK (Pi.single i 1) = vK i := by
      simp [fK, Pi.single_apply]
    rw [hf_single]
    exact hιK_comp (v i j)
  rw [Fintype.linearIndependent_iff]
  intro c hc
  have hVc : (V.map ιK).mulVec c = 0 := by
    ext j
    have hj := congrFun hc j
    simp only [Matrix.mulVec, dotProduct, Pi.zero_apply, hV_entry]
    simpa [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm] using hj
  have hc0 : c = 0 := by
    calc c = (1 : Matrix (Fin r) (Fin r) ℂ).mulVec c := (Matrix.one_mulVec c).symm
      _ = (M.map ιK * V.map ιK).mulVec c := by rw [hMV_C]
      _ = (M.map ιK).mulVec ((V.map ιK).mulVec c) := (Matrix.mulVec_mulVec c _ _).symm
      _ = 0 := by rw [hVc, Matrix.mulVec_zero]
  intro i
  exact congrFun hc0 i

/-! ### Exact Integral Augmentations `π_f : OHeckeAlg →ₐ[𝒪] 𝒪` and `IntHeckeAlg →ₐ[ℤ] 𝒪` -/

section IntegralAugmentations

variable {𝒪 : Type*} [CommRing 𝒪] [Algebra 𝒪 ℂ]

/-- Helper: every element of `OHeckeAlg` acts by an `𝒪`-scalar on any normalized eigenform with
`𝒪`-integral Fourier coefficients. -/
theorem oHeckeAlg_exists_eigenvalue
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (f : L) (hf : IsNormalizedHeckeEigenform k χ f.1.1 f.1.1)
    (hf_int : ∀ n : ℕ, 1 ≤ n → f.1.1 n ∈ Set.range (algebraMap 𝒪 ℂ))
    (T : Module.End 𝒪 L) (hT : T ∈ OHeckeAlg k χ S hinv L hL_inv) :
    ∃ c : 𝒪, T f = c • f := by
  refine Algebra.adjoin_induction
    (p := fun T _ => ∃ c : 𝒪, T f = c • f)
    (mem := by
      rintro T ⟨n, hn, rfl⟩
      obtain ⟨c, hc⟩ := hf_int n hn
      refine ⟨c, Subtype.ext (Subtype.ext ?_)⟩
      rw [oHeckeEnd_apply, hf.2 n hn, ← hc]
      funext m
      simp [Algebra.smul_def])
    (algebraMap := fun c => ⟨c, rfl⟩)
    (add := by
      rintro T₁ T₂ _ _ ⟨c₁, h₁⟩ ⟨c₂, h₂⟩
      exact ⟨c₁ + c₂, by simp [h₁, h₂, add_smul]⟩)
    (mul := by
      rintro T₁ T₂ _ _ ⟨c₁, h₁⟩ ⟨c₂, h₂⟩
      refine ⟨c₁ * c₂, ?_⟩
      change T₁ (T₂ f) = (c₁ * c₂) • f
      rw [h₂, map_smul, h₁, smul_smul, mul_comm])
    hT

/-- **Exact Integral Augmentation `π_f : OHeckeAlg 𝒪 L →ₐ[𝒪] 𝒪`**:
For any `𝒪`-lattice `L ⊆ S` preserved by `{T_n}` and any normalized Hecke eigenform `f ∈ L`
whose `n`-th Fourier coefficients lie in `𝒪`, `T ↦ (T f) 1` defines an exact `𝒪`-algebra
homomorphism `OHeckeAlg →ₐ[𝒪] 𝒪` with `T f = π_f(T) • f`! -/
def eigenformAug (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (f : L) (hf : IsNormalizedHeckeEigenform k χ f.1.1 f.1.1)
    (hf_int : ∀ n : ℕ, 1 ≤ n → f.1.1 n ∈ Set.range (algebraMap 𝒪 ℂ)) :
    OHeckeAlg k χ S hinv L hL_inv →ₐ[𝒪] 𝒪 :=
  let πFun : OHeckeAlg k χ S hinv L hL_inv → 𝒪 :=
    fun T => Classical.choose (oHeckeAlg_exists_eigenvalue k χ S hinv L hL_inv f hf hf_int T.1 T.2)
  have hπ_spec : ∀ T, T.1 f = πFun T • f :=
    fun T => Classical.choose_spec
      (oHeckeAlg_exists_eigenvalue k χ S hinv L hL_inv f hf hf_int T.1 T.2)
  have hπ_val : ∀ T, algebraMap 𝒪 ℂ (πFun T) = (T.1 f).1.1 1 := by
    intro T
    have h1 := congrFun (congrArg (fun x : L => x.1.1) (hπ_spec T)) 1
    simpa [Algebra.smul_def, hf.1] using h1.symm
  { toFun := πFun
    map_one' := hinj (by rw [hπ_val 1, map_one]; exact hf.1)
    map_mul' := fun T₁ T₂ => hinj (by
      rw [map_mul, hπ_val (T₁ * T₂), hπ_val T₁, hπ_val T₂]
      change (T₁.1 (T₂.1 f)).1.1 1 = (T₁.1 f).1.1 1 * (T₂.1 f).1.1 1
      conv_lhs => rw [hπ_spec T₂]
      rw [map_smul]
      have h2 := hπ_val T₂
      simp [Algebra.smul_def, h2, mul_comm])
    map_zero' := hinj (by rw [hπ_val 0, map_zero]; rfl)
    map_add' := fun T₁ T₂ => hinj (by
      rw [map_add, hπ_val (T₁ + T₂), hπ_val T₁, hπ_val T₂]; rfl)
    commutes' := fun c => hinj (by
      rw [hπ_val (algebraMap 𝒪 _ c)]
      change (c • f).1.1 1 = algebraMap 𝒪 ℂ c
      simp [Algebra.smul_def, hf.1]) }

theorem eigenformAug_smul_eq (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (f : L) (hf : IsNormalizedHeckeEigenform k χ f.1.1 f.1.1)
    (hf_int : ∀ n : ℕ, 1 ≤ n → f.1.1 n ∈ Set.range (algebraMap 𝒪 ℂ))
    (T : OHeckeAlg k χ S hinv L hL_inv) :
    T.1 f = eigenformAug k χ S hinv hinj L hL_inv f hf hf_int T • f :=
  Classical.choose_spec (oHeckeAlg_exists_eigenvalue k χ S hinv L hL_inv f hf hf_int T.1 T.2)

theorem eigenformAug_apply_val (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (f : L) (hf : IsNormalizedHeckeEigenform k χ f.1.1 f.1.1)
    (hf_int : ∀ n : ℕ, 1 ≤ n → f.1.1 n ∈ Set.range (algebraMap 𝒪 ℂ))
    (T : OHeckeAlg k χ S hinv L hL_inv) :
    algebraMap 𝒪 ℂ (eigenformAug k χ S hinv hinj L hL_inv f hf hf_int T) = (T.1 f).1.1 1 := by
  have h1 := congrFun (congrArg (fun x : L => x.1.1)
    (eigenformAug_smul_eq k χ S hinv hinj L hL_inv f hf hf_int T)) 1
  simpa [Algebra.smul_def, hf.1] using h1.symm

/-- Helper: every element of `OHeckeAlg 𝒪 L` extends to an element of `HeckeAlg S`. -/
theorem oHeckeAlg_exists_ext
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (T : Module.End 𝒪 L) (hT : T ∈ OHeckeAlg k χ S hinv L hL_inv) :
    ∃ U : HeckeAlg k χ S hinv, ∀ x : L, (T x : S) = U.1 x.1 := by
  refine Algebra.adjoin_induction
    (p := fun T _ => ∃ U : HeckeAlg k χ S hinv, ∀ x : L, (T x : S) = U.1 x.1)
    (mem := by rintro T ⟨n, hn, rfl⟩; exact ⟨heckeAlgGen k χ S hinv n hn, fun _ => rfl⟩)
    (algebraMap := fun c => ⟨algebraMap ℂ _ (algebraMap 𝒪 ℂ c), fun x => by simp⟩)
    (add := by
      rintro T₁ T₂ _ _ ⟨U₁, h₁⟩ ⟨U₂, h₂⟩
      exact ⟨U₁ + U₂, fun x => by
        change (T₁ x : S) + (T₂ x : S) = U₁.1 x.1 + U₂.1 x.1
        rw [h₁ x, h₂ x]⟩)
    (mul := by
      rintro T₁ T₂ _ _ ⟨U₁, h₁⟩ ⟨U₂, h₂⟩
      exact ⟨U₁ * U₂, fun x => by
        change (T₁ (T₂ x) : S) = U₁.1 (U₂.1 x.1)
        rw [h₁ (T₂ x), h₂ x]⟩)
    hT

/-- Canonical extension homomorphism `oHeckeAlgToHeckeAlg : OHeckeAlg 𝒪 L →ₐ[𝒪] HeckeAlg S`
whenever `L` spans `S` over `ℂ`. -/
def oHeckeAlgToHeckeAlg
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (hspan : Submodule.span ℂ (L : Set S) = ⊤) :
    OHeckeAlg k χ S hinv L hL_inv →ₐ[𝒪] HeckeAlg k χ S hinv :=
  have hext_uniq : ∀ (U₁ U₂ : HeckeAlg k χ S hinv),
      (∀ x : L, U₁.1 x.1 = U₂.1 x.1) → U₁ = U₂ := by
    intro U₁ U₂ h
    apply Subtype.ext
    apply LinearMap.ext
    intro v
    have hv : v ∈ Submodule.span ℂ (L : Set S) := by rw [hspan]; trivial
    refine Submodule.span_induction (p := fun v _ => U₁.1 v = U₂.1 v)
      (mem := fun x hx => h ⟨x, hx⟩)
      (zero := by simp)
      (add := fun x y _ _ hx hy => by simp [hx, hy])
      (smul := fun c x _ hx => by simp [hx])
      hv
  let ιFun : OHeckeAlg k χ S hinv L hL_inv → HeckeAlg k χ S hinv :=
    fun T => Classical.choose (oHeckeAlg_exists_ext k χ S hinv L hL_inv T.1 T.2)
  have hι_spec : ∀ (T : OHeckeAlg k χ S hinv L hL_inv) (x : L),
      (T.1 x : S) = (ιFun T).1 x.1 :=
    fun T => Classical.choose_spec (oHeckeAlg_exists_ext k χ S hinv L hL_inv T.1 T.2)
  { toFun := ιFun
    map_one' := hext_uniq _ 1 (fun x => (hι_spec 1 x).symm)
    map_mul' := fun T₁ T₂ => hext_uniq _ _ (fun x => by
      rw [← hι_spec (T₁ * T₂) x]
      change (T₁.1 (T₂.1 x) : S) = (ιFun T₁).1 ((ιFun T₂).1 x.1)
      rw [hι_spec T₁ (T₂.1 x), hι_spec T₂ x])
    map_zero' := hext_uniq _ 0 (fun x => (hι_spec 0 x).symm)
    map_add' := fun T₁ T₂ => hext_uniq _ _ (fun x => by
      rw [← hι_spec (T₁ + T₂) x]
      change (T₁.1 x : S) + (T₂.1 x : S) = (ιFun T₁).1 x.1 + (ιFun T₂).1 x.1
      rw [hι_spec T₁ x, hι_spec T₂ x])
    commutes' := fun c => hext_uniq _ _ (fun x => by
      rw [← hι_spec (algebraMap 𝒪 _ c) x]
      simp) }

theorem oHeckeAlgToHeckeAlg_spec
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (hspan : Submodule.span ℂ (L : Set S) = ⊤)
    (T : OHeckeAlg k χ S hinv L hL_inv) (x : L) :
    (T.1 x : S) = (oHeckeAlgToHeckeAlg k χ S hinv L hL_inv hspan T).1 x.1 :=
  Classical.choose_spec (oHeckeAlg_exists_ext k χ S hinv L hL_inv T.1 T.2) x

theorem oHeckeAlgToHeckeAlg_injective
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (hspan : Submodule.span ℂ (L : Set S) = ⊤) :
    Function.Injective (oHeckeAlgToHeckeAlg k χ S hinv L hL_inv hspan) := by
  intro T₁ T₂ h
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  have h1 := oHeckeAlgToHeckeAlg_spec k χ S hinv L hL_inv hspan T₁ x
  have h2 := oHeckeAlgToHeckeAlg_spec k χ S hinv L hL_inv hspan T₂ x
  rw [h] at h1
  exact Subtype.ext (h1.trans h2.symm)

theorem oHeckeAlgToHeckeAlg_gen
    (L : Submodule 𝒪 S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (hspan : Submodule.span ℂ (L : Set S) = ⊤)
    (n : ℕ) (hn : 1 ≤ n) :
    oHeckeAlgToHeckeAlg k χ S hinv L hL_inv hspan (oHeckeAlgGen k χ S hinv L hL_inv n hn) =
      heckeAlgGen k χ S hinv n hn := by
  apply Subtype.ext
  apply LinearMap.ext
  intro v
  have hv : v ∈ Submodule.span ℂ (L : Set S) := by rw [hspan]; trivial
  refine Submodule.span_induction
    (p := fun v _ => (oHeckeAlgToHeckeAlg k χ S hinv L hL_inv hspan
      (oHeckeAlgGen k χ S hinv L hL_inv n hn)).1 v = (heckeAlgGen k χ S hinv n hn).1 v)
    (mem := fun x hx =>
      (oHeckeAlgToHeckeAlg_spec k χ S hinv L hL_inv hspan
        (oHeckeAlgGen k χ S hinv L hL_inv n hn) ⟨x, hx⟩).symm)
    (zero := by simp)
    (add := fun x y _ _ hx hy => by simp [hx, hy])
    (smul := fun c x _ hx => by simp [hx])
    hv

/-- **Exact `ℤ`-Algebra Augmentation `π_f : IntHeckeAlg S_ℤ →ₐ[ℤ] 𝒪`** for any normalized
eigenform `f ∈ S` with `𝒪`-integral Fourier coefficients whenever `S_ℤ` spans `S` over `ℂ`. -/
def intHeckeAlgAug [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (L : Submodule ℤ S)
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ g ∈ L, heckeEnd k χ S hinv n hn g ∈ L)
    (hspan : Submodule.span ℂ (L : Set S) = ⊤)
    (f : S) (hf : IsNormalizedHeckeEigenform k χ f.1 f.1)
    (hf_int : ∀ n : ℕ, 1 ≤ n → f.1 n ∈ Set.range (algebraMap 𝒪 ℂ)) :
    IntHeckeAlg k χ S hinv L hL_inv →ₐ[ℤ] 𝒪 :=
  let toAlg := oHeckeAlgToHeckeAlg k χ S hinv L hL_inv hspan
  let ψ_C : IntHeckeAlg k χ S hinv L hL_inv →ₐ[ℤ] ℂ :=
    ((algHomOfNormalizedEigenform k χ S hinv hcusp f hf).restrictScalars ℤ).comp toAlg
  have hmem : ∀ T : IntHeckeAlg k χ S hinv L hL_inv,
      ψ_C T ∈ Set.range (algebraMap 𝒪 ℂ) := by
    intro T
    refine Algebra.adjoin_induction
      (p := fun A hA => ψ_C ⟨A, hA⟩ ∈ Set.range (algebraMap 𝒪 ℂ))
      (mem := by
        rintro A ⟨n, hn, rfl⟩
        obtain ⟨c, hc⟩ := hf_int n hn
        refine ⟨c, ?_⟩
        change algebraMap 𝒪 ℂ c =
          ((toAlg (oHeckeAlgGen k χ S hinv L hL_inv n hn)).1 f).1 1
        rw [oHeckeAlgToHeckeAlg_gen, heckeAlgGen_val, heckeEnd_apply_one, hc])
      (algebraMap := fun z => ⟨(z : 𝒪), by
        have hz : (⟨algebraMap ℤ (Module.End ℤ L) z, Subalgebra.algebraMap_mem _ z⟩ :
            IntHeckeAlg k χ S hinv L hL_inv) = algebraMap ℤ _ z := rfl
        rw [hz, ψ_C.commutes]
        simp⟩)
      (add := by
        rintro A₁ A₂ h₁ h₂ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
        refine ⟨c₁ + c₂, ?_⟩
        have hadd : (⟨A₁ + A₂, Subalgebra.add_mem _ h₁ h₂⟩ : IntHeckeAlg k χ S hinv L hL_inv) =
            ⟨A₁, h₁⟩ + ⟨A₂, h₂⟩ := rfl
        rw [hadd, map_add, map_add, hc₁, hc₂])
      (mul := by
        rintro A₁ A₂ h₁ h₂ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
        refine ⟨c₁ * c₂, ?_⟩
        have hmul : (⟨A₁ * A₂, Subalgebra.mul_mem _ h₁ h₂⟩ : IntHeckeAlg k χ S hinv L hL_inv) =
            ⟨A₁, h₁⟩ * ⟨A₂, h₂⟩ := rfl
        rw [hmul, map_mul, map_mul, hc₁, hc₂])
      T.2
  let πFun : IntHeckeAlg k χ S hinv L hL_inv → 𝒪 := fun T => Classical.choose (hmem T)
  have hπ_val : ∀ T, algebraMap 𝒪 ℂ (πFun T) = ψ_C T := fun T => Classical.choose_spec (hmem T)
  { toFun := πFun
    map_one' := hinj (by rw [hπ_val 1, map_one, map_one])
    map_mul' := fun T₁ T₂ => hinj (by rw [map_mul, hπ_val, hπ_val, hπ_val, map_mul])
    map_zero' := hinj (by rw [hπ_val 0, map_zero, map_zero])
    map_add' := fun T₁ T₂ => hinj (by rw [map_add, hπ_val, hπ_val, hπ_val, map_add])
    commutes' := fun z => hinj (by rw [hπ_val, ψ_C.commutes]; simp) }

end IntegralAugmentations

/-! ### Full Integral Hecke–Fourier Duality `S_𝒪 ≃ₗ[𝒪] Module.Dual 𝒪 𝕋_𝒪` & Congruence Ideal Bridge -/

section CongruenceIdealAndWilesLenstra

variable {𝒪 : Type*} [CommRing 𝒪] [IsDomain 𝒪] [IsPrincipalIdealRing 𝒪] [Algebra 𝒪 ℂ]

/-- **Integral Hecke–Fourier Duality `S_𝒪 ≃ₗ[𝒪] Module.Dual 𝒪 𝕋_𝒪`**:
Over any PID `𝒪 ↪ ℂ` with `𝒪`-valued character `χ`, whenever a finite-dimensional cuspidal Hecke
space `S` admits a `ℂ`-basis `b : Fin d → S` contained in `S_𝒪 = integralCuspLattice 𝒪 S`:
1. The canonical map `ιT : 𝕋_𝒪 →ₐ[𝒪] 𝕋_ℂ` is injective and maps an `𝒪`-basis of `𝕋_𝒪` to a
   `ℂ`-basis of `𝕋_ℂ`.
2. The integral Hecke–Fourier pairing `⟨T, h⟩ := coeff_1(T h)` yields a canonical **`𝒪`-linear
   equivalence `S_𝒪 ≃ₗ[𝒪] Module.Dual 𝒪 𝕋_𝒪`**! -/
theorem integralHeckeAlg_embedding_and_duality
    [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    {d : ℕ} (b : Module.Basis (Fin d) ℂ S)
    (hb_int : ∀ j : Fin d, b j ∈ integralCuspLattice 𝒪 S) :
    let S_𝒪 := integralCuspLattice 𝒪 S
    let hS_𝒪_inv := integralCuspLattice_hecke_invariant k χ S hinv hχ
    let 𝕋_𝒪 := OHeckeAlg k χ S hinv S_𝒪 hS_𝒪_inv
    ∃ (ιT : 𝕋_𝒪 →ₐ[𝒪] HeckeAlg k χ S hinv)
      (eDual : S_𝒪 ≃ₗ[𝒪] Module.Dual 𝒪 𝕋_𝒪),
      Function.Injective ιT ∧
      (∀ (T : 𝕋_𝒪) (x : S_𝒪), (T.1 x : S) = (ιT T).1 x.1) ∧
      (∀ (n : ℕ) (hn : 1 ≤ n), ιT (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv n hn) =
        heckeAlgGen k χ S hinv n hn) ∧
      (∀ (h : S_𝒪) (T : 𝕋_𝒪), eDual h T = integralCoeff (T.1 h) 1) := by
  classical
  intro S_𝒪 hS_𝒪_inv 𝕋_𝒪
  have hspan_S : Submodule.span ℂ (S_𝒪 : Set S) = ⊤ := by
    apply le_antisymm le_top
    rw [← b.span_eq]
    refine Submodule.span_mono ?_
    rintro _ ⟨j, rfl⟩
    exact hb_int j
  have hsmul_OC : ∀ (r : 𝒪) (U : HeckeAlg k χ S hinv),
      r • U = algebraMap 𝒪 ℂ r • U := fun r U => by
    apply Subtype.ext; apply LinearMap.ext; intro v
    exact (algebraMap_smul ℂ r (U.1 v)).symm
  let ιT : 𝕋_𝒪 →ₐ[𝒪] HeckeAlg k χ S hinv :=
    oHeckeAlgToHeckeAlg k χ S hinv S_𝒪 hS_𝒪_inv hspan_S
  have hι_spec : ∀ (T : 𝕋_𝒪) (x : S_𝒪), (T.1 x : S) = (ιT T).1 x.1 :=
    oHeckeAlgToHeckeAlg_spec k χ S hinv S_𝒪 hS_𝒪_inv hspan_S
  have hι_inj : Function.Injective ιT :=
    oHeckeAlgToHeckeAlg_injective k χ S hinv S_𝒪 hS_𝒪_inv hspan_S
  have hι_gen : ∀ (n : ℕ) (hn : 1 ≤ n),
      ιT (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv n hn) = heckeAlgGen k χ S hinv n hn :=
    oHeckeAlgToHeckeAlg_gen k χ S hinv S_𝒪 hS_𝒪_inv hspan_S
  obtain ⟨hS_fin, hS_free⟩ := integralCuspLattice_finite_free hinj S
  have : Module.Finite 𝒪 S_𝒪 := hS_fin
  have : Module.Free 𝒪 S_𝒪 := hS_free
  obtain ⟨hT_fin, hT_free⟩ := oHeckeAlg_finite_free k χ S hinv S_𝒪 hS_𝒪_inv hinj
  have : Module.Finite 𝒪 𝕋_𝒪 := hT_fin
  have : Module.Free 𝒪 𝕋_𝒪 := hT_free
  let bT_raw := Module.Free.chooseBasis 𝒪 𝕋_𝒪
  let _ : Fintype (Module.Free.ChooseBasisIndex 𝒪 𝕋_𝒪) := Module.Free.ChooseBasisIndex.fintype 𝒪 𝕋_𝒪
  let t := Fintype.card (Module.Free.ChooseBasisIndex 𝒪 𝕋_𝒪)
  let bT : Module.Basis (Fin t) 𝒪 𝕋_𝒪 := bT_raw.reindex (Fintype.equivFin _)
  obtain ⟨F, hF⟩ := exists_finset_eval_injective S
  let m := Fintype.card F
  let eF : Fin m ≃ F := (Fintype.equivFin F).symm
  let coordMap : 𝕋_𝒪 →ₗ[𝒪] (Fin (d * m) → 𝒪) :=
    { toFun := fun T p =>
        let jm := finProdFinEquiv.symm p
        integralCoeff (T.1 ⟨b jm.1, hb_int jm.1⟩) (eF jm.2).1
      map_add' := fun T₁ T₂ => by
        ext p
        exact integralCoeff_add hinj _ _ _
      map_smul' := fun r T => by
        ext p
        exact integralCoeff_smul hinj r _ _ }
  have hcoord_inj : Function.Injective coordMap := by
    intro T₁ T₂ h
    apply hι_inj
    apply Subtype.ext
    apply b.ext
    intro j
    apply hF
    ext n
    have hp := congrArg (algebraMap 𝒪 ℂ) (congrFun h (finProdFinEquiv (j, eF.symm n)))
    simp only [coordMap, LinearMap.coe_mk, AddHom.coe_mk, Equiv.symm_apply_apply,
      Equiv.apply_symm_apply, algebraMap_integralCoeff] at hp
    have h1 := hι_spec T₁ ⟨b j, hb_int j⟩
    have h2 := hι_spec T₂ ⟨b j, hb_int j⟩
    change ((ιT T₁).1 (b j)).1 n.1 = ((ιT T₂).1 (b j)).1 n.1
    rw [← h1, ← h2]
    exact hp
  have hli_coord : LinearIndependent 𝒪 (fun i : Fin t => coordMap (bT i)) :=
    bT.linearIndependent.map' coordMap (LinearMap.ker_eq_bot.mpr hcoord_inj)
  have hli_C_coord : LinearIndependent ℂ
      (fun i : Fin t => fun p : Fin (d * m) => algebraMap 𝒪 ℂ (coordMap (bT i) p)) :=
    linearIndependent_map_of_linearIndependent_domain hinj _ hli_coord
  have hli_C : LinearIndependent ℂ (fun i : Fin t => ιT (bT i)) := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    apply (Fintype.linearIndependent_iff.mp hli_C_coord) c
    ext p
    let jm := finProdFinEquiv.symm p
    have hp0 : ((∑ i : Fin t, c i • ιT (bT i)).1 (b jm.1)).1 (eF jm.2).1 = 0 := by
      rw [hc]; rfl
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    rw [← hp0]
    have hsum : (∑ i : Fin t, c i • ιT (bT i)).1 (b jm.1) =
        ∑ i : Fin t, c i • (ιT (bT i)).1 (b jm.1) := by
      change ((HeckeAlg k χ S hinv).val (∑ i : Fin t, c i • ιT (bT i))) (b jm.1) = _
      rw [map_sum, LinearMap.sum_apply]
      refine Finset.sum_congr rfl fun i _ => rfl
    rw [hsum]
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    congr 1
    simp only [coordMap, LinearMap.coe_mk, AddHom.coe_mk, algebraMap_integralCoeff]
    exact congrFun (congrArg Subtype.val (hι_spec (bT i) ⟨b jm.1, hb_int jm.1⟩)) (eF jm.2).1
  have hspan_C : Submodule.span ℂ (Set.range (fun i : Fin t => ιT (bT i))) = ⊤ := by
    let W : Submodule ℂ (HeckeAlg k χ S hinv) :=
      Submodule.span ℂ (Set.range (fun i : Fin t => ιT (bT i)))
    have hmem_range : ∀ T : 𝕋_𝒪, ιT T ∈ W := by
      intro T
      have hT : T = ∑ i : Fin t, bT.repr T i • bT i := (bT.sum_repr T).symm
      rw [hT, map_sum]
      refine Submodule.sum_mem W fun i _ => ?_
      rw [map_smul, hsmul_OC]
      exact Submodule.smul_mem W _ (Submodule.subset_span ⟨i, rfl⟩)
    have hsub : ∀ U : Module.End ℂ S, (hU : U ∈ HeckeAlg k χ S hinv) →
        (⟨U, hU⟩ : HeckeAlg k χ S hinv) ∈ W := by
      intro U hU
      refine Algebra.adjoin_induction
        (p := fun U hU => (⟨U, hU⟩ : HeckeAlg k χ S hinv) ∈ W)
        (mem := by
          rintro U ⟨n, hn, rfl⟩
          have h := hmem_range (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv n hn)
          rwa [hι_gen n hn] at h)
        (algebraMap := fun c => by
          have h1 : (1 : HeckeAlg k χ S hinv) ∈ W := by
            simpa [map_one] using hmem_range 1
          have heq : (⟨algebraMap ℂ (Module.End ℂ S) c, Subalgebra.algebraMap_mem _ c⟩ :
              HeckeAlg k χ S hinv) = c • (1 : HeckeAlg k χ S hinv) := by
            apply Subtype.ext; ext f; simp
          rw [heq]
          exact Submodule.smul_mem W c h1)
        (add := fun U₁ U₂ h₁ h₂ ih₁ ih₂ => W.add_mem ih₁ ih₂)
        (mul := by
          intro U₁ U₂ h₁ h₂ ih₁ ih₂
          have hmul_W : ∀ x ∈ W, ∀ y ∈ W, x * y ∈ W := by
            intro x hx y hy
            refine Submodule.span_induction (p := fun x _ => x * y ∈ W)
              (mem := by
                rintro _ ⟨i, rfl⟩
                refine Submodule.span_induction (p := fun y _ => ιT (bT i) * y ∈ W)
                  (mem := by
                    rintro _ ⟨j, rfl⟩
                    rw [← map_mul]
                    exact hmem_range (bT i * bT j))
                  (zero := by simp)
                  (add := fun a b _ _ ha hb => by rw [mul_add]; exact W.add_mem ha hb)
                  (smul := fun c a _ ha => by rw [mul_smul_comm]; exact W.smul_mem c ha)
                  hy)
              (zero := by simp)
              (add := fun a b _ _ ha hb => by rw [add_mul]; exact W.add_mem ha hb)
              (smul := fun c a _ ha => by rw [smul_mul_assoc]; exact W.smul_mem c ha)
              hx
          exact hmul_W ⟨U₁, h₁⟩ ih₁ ⟨U₂, h₂⟩ ih₂)
        hU
    rw [eq_top_iff]
    intro U _
    exact hsub U.1 U.2
  let bT_C : Module.Basis (Fin t) ℂ (HeckeAlg k χ S hinv) :=
    Module.Basis.mk hli_C (by rw [hspan_C])
  have hbT_C_apply : ∀ i : Fin t, bT_C i = ιT (bT i) := fun i => by simp [bT_C]
  let Φ : S_𝒪 →ₗ[𝒪] Module.Dual 𝒪 𝕋_𝒪 :=
    { toFun := fun h =>
        { toFun := fun T => integralCoeff (T.1 h) 1
          map_add' := fun T₁ T₂ => integralCoeff_add hinj (T₁.1 h) (T₂.1 h) 1
          map_smul' := fun r T => integralCoeff_smul hinj r (T.1 h) 1 }
      map_add' := fun h₁ h₂ => by
        ext T
        change integralCoeff (T.1 (h₁ + h₂)) 1 = integralCoeff (T.1 h₁) 1 + integralCoeff (T.1 h₂) 1
        rw [map_add]
        exact integralCoeff_add hinj (T.1 h₁) (T.1 h₂) 1
      map_smul' := fun r h => by
        ext T
        change integralCoeff (T.1 (r • h)) 1 = r * integralCoeff (T.1 h) 1
        rw [map_smul]
        exact integralCoeff_smul hinj r (T.1 h) 1 }
  have hΦ_inj : Function.Injective Φ := by
    intro h₁ h₂ hh
    apply Subtype.ext
    apply Subtype.ext
    funext n
    match n with
    | 0 => rw [hcusp h₁.1.1 h₁.1.2, hcusp h₂.1.1 h₂.1.2]
    | n + 1 =>
      have hn : 1 ≤ n + 1 := Nat.succ_pos n
      have hTn := congrArg (algebraMap 𝒪 ℂ)
        (congrArg (fun (φ : Module.Dual 𝒪 𝕋_𝒪) =>
          φ (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (n + 1) hn)) hh)
      simpa [Φ, heckeOp_apply_one k χ hn] using hTn
  have hΦ_surj : Function.Surjective Φ := by
    intro ψ
    let ψ_C : Module.Dual ℂ (HeckeAlg k χ S hinv) :=
      bT_C.constr ℂ (fun i => algebraMap 𝒪 ℂ (ψ (bT i)))
    have hψ_C_compat : ∀ T : 𝕋_𝒪, ψ_C (ιT T) = algebraMap 𝒪 ℂ (ψ T) := by
      intro T
      have hT : T = ∑ i : Fin t, bT.repr T i • bT i := (bT.sum_repr T).symm
      conv_lhs => rw [hT]
      conv_rhs => rw [hT]
      rw [map_sum, map_sum, map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hsmul : ιT (bT.repr T i • bT i) = algebraMap 𝒪 ℂ (bT.repr T i) • ιT (bT i) := by
        rw [map_smul, hsmul_OC]
      rw [hsmul, ψ_C.map_smul, smul_eq_mul, ← hbT_C_apply i, Module.Basis.constr_basis,
        map_smul, smul_eq_mul, map_mul]
    let hS : S := (heckeFourierDualityEquiv k χ S hinv hcusp).symm ψ_C
    have hh_mem : hS ∈ S_𝒪 := by
      intro n
      match n with
      | 0 =>
        rw [hcusp hS.1 hS.2]
        exact ⟨0, map_zero _⟩
      | n + 1 =>
        have hn : 1 ≤ n + 1 := Nat.succ_pos n
        refine ⟨ψ (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (n + 1) hn), ?_⟩
        rw [← hψ_C_compat, hι_gen (n + 1) hn]
        exact (heckeFourierDualityEquiv_symm_coeff k χ S hinv hcusp ψ_C hn).symm
    refine ⟨⟨hS, hh_mem⟩, ?_⟩
    ext T
    apply hinj
    change algebraMap 𝒪 ℂ (integralCoeff (T.1 ⟨hS, hh_mem⟩) 1) = algebraMap 𝒪 ℂ (ψ T)
    rw [algebraMap_integralCoeff, ← hψ_C_compat T]
    have hspec := congrFun (congrArg Subtype.val (hι_spec T ⟨hS, hh_mem⟩)) 1
    rw [hspec]
    exact congrArg (fun (φ : Module.Dual ℂ (HeckeAlg k χ S hinv)) => φ (ιT T))
      ((heckeFourierDualityEquiv k χ S hinv hcusp).apply_symm_apply ψ_C)
  exact ⟨ιT, LinearEquiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩, hι_inj, hι_spec, hι_gen, fun _ _ => rfl⟩

/-- The **Hecke-orthogonal complement** of the `j₀`-th basis eigenform `b j₀` in `S`:
the subspace spanned by all remaining eigenbasis vectors `{ b j | j ≠ j₀ }`. -/
def eigenComplement {d : ℕ} (b : Module.Basis (Fin d) ℂ S) (j₀ : Fin d) : Submodule ℂ S :=
  Submodule.span ℂ { v : S | ∃ j : Fin d, j ≠ j₀ ∧ v = b j }

/-- On a `PeterssonQExpansionSpace`, the `eigenComplement` of a basis eigenform coincides with the
exact Petersson orthogonal complement `(ℂ · f_{j₀})ᗮ` transferred along `P.qExp`! -/
theorem petersson_eigenComplement_eq_orthogonal
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
    {k : ℕ} {χ : DirichletCharacter ℂ 1}
    (P : PeterssonQExpansionSpace k χ H)
    (f : OrthonormalBasis (Fin (Module.finrank ℂ H)) ℂ H)
    (c : Fin (Module.finrank ℂ H) → ℂˣ)
    (j₀ : Fin (Module.finrank ℂ H)) :
    let b : Module.Basis (Fin (Module.finrank ℂ H)) ℂ (peterssonQSubspace P) :=
      (f.toBasis.unitsSMul c).map (peterssonQSubspaceEquiv P)
    eigenComplement (peterssonQSubspace P) b j₀ =
      (Submodule.span ℂ ({f j₀} : Set H))ᗮ.map (peterssonQSubspaceEquiv P).toLinearMap := by
  intro b
  have hbj_eq : ∀ j, b j = (c j : ℂ) • peterssonQSubspaceEquiv P (f j) := fun j => by
    rw [show b j = peterssonQSubspaceEquiv P ((f.toBasis.unitsSMul c) j) from
      Module.Basis.map_apply _ _ j,
      show (f.toBasis.unitsSMul c) j = (c j : ℂ) • f j from by
        rw [Module.Basis.unitsSMul_apply, OrthonormalBasis.coe_toBasis, Units.smul_def],
      map_smul]
  apply le_antisymm
  · rw [eigenComplement, Submodule.span_le]
    rintro _ ⟨j, hj, rfl⟩
    refine ⟨(c j : ℂ) • f j, ?_, ?_⟩
    · rw [SetLike.mem_coe, Submodule.mem_orthogonal]
      intro u hu
      rw [Submodule.mem_span_singleton] at hu
      obtain ⟨a, rfl⟩ := hu
      rw [inner_smul_left, inner_smul_right, (orthonormal_iff_ite.mp f.orthonormal) j₀ j,
        if_neg hj.symm, mul_zero, mul_zero]
    · rw [hbj_eq j]
      exact map_smul (peterssonQSubspaceEquiv P).toLinearMap (c j : ℂ) (f j)
  · rintro _ ⟨v, hv, rfl⟩
    have hv_decomp : v = ∑ j : Fin (Module.finrank ℂ H), inner ℂ (f j) v • f j :=
      (f.sum_repr' v).symm
    have hcoeff0 : inner ℂ (f j₀) v = 0 :=
      (Submodule.mem_orthogonal _ _).mp hv (f j₀) (Submodule.subset_span (Set.mem_singleton _))
    have hv_eq : peterssonQSubspaceEquiv P v =
        ∑ j ∈ Finset.univ.erase j₀,
          (inner ℂ (f j) v * ((c j : ℂ))⁻¹) • b j := by
      conv_lhs => rw [hv_decomp]
      rw [map_sum, ← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ j₀),
        hcoeff0, zero_smul, map_zero, zero_add]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_smul, hbj_eq j, smul_smul, mul_assoc, inv_mul_cancel₀ (c j).ne_zero, mul_one]
    change peterssonQSubspaceEquiv P v ∈ eigenComplement (peterssonQSubspace P) b j₀
    rw [hv_eq]
    refine Submodule.sum_mem _ fun j hj => Submodule.smul_mem _ _ ?_
    exact Submodule.subset_span ⟨j, Finset.ne_of_mem_erase hj, rfl⟩

/-- **MASTER CONGRUENCE-IDEAL CHARACTERIZATION (EXACT RIBET–WILES–HIDA THEOREM, UNCONDITIONAL)**:
For any PID `𝒪 ↪ ℂ`, `𝒪`-valued Nebentypus `χ`, finite-dimensional cuspidal Hecke space `S`, and
eigenbasis `b : Fin d → S` of normalized Hecke eigenforms all lying in `S_𝒪 = integralCuspLattice 𝒪 S`,
fix any `j₀ : Fin d` (`f = b j₀`) and its exact augmentation `π_f : 𝕋_𝒪 →ₐ[𝒪] 𝒪`. Then:
1. **`Stage3PatchingUnification.congruenceIdeal π_f ≠ ⊥`** (proved constructively!),
2. **Divisibility Equivalence (`congruenceIdeal_le_span_iff_congruence_with_complement`)**:
   for EVERY `a : 𝒪`,
   `congruenceIdeal π_f ≤ Ideal.span {a} ↔ ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧ ∀ n, a ∣ (coeff_n(f) - coeff_n(h))`!
3. **Membership Equivalence (`mem_congruenceIdeal_iff_congruence_with_complement`)**:
   for EVERY `a : 𝒪`,
   `a ∈ congruenceIdeal π_f ↔ ∀ c : 𝒪, (∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧ ∀ n, c ∣ (coeff_n(f) - coeff_n(h))) → c ∣ a`! -/
theorem congruenceIdeal_exact_characterization
    [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    {d : ℕ} (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (hb_int : ∀ j : Fin d, b j ∈ integralCuspLattice 𝒪 S)
    (j₀ : Fin d) :
    let S_𝒪 := integralCuspLattice 𝒪 S
    let hS_𝒪_inv := integralCuspLattice_hecke_invariant k χ S hinv hχ
    let f_𝒪 : S_𝒪 := ⟨b j₀, hb_int j₀⟩
    let π_f := eigenformAug k χ S hinv hinj S_𝒪 hS_𝒪_inv f_𝒪 (heig j₀)
      (fun n _ => hb_int j₀ n)
    Stage3PatchingUnification.congruenceIdeal π_f ≠ ⊥ ∧
    (∀ a : 𝒪,
      Stage3PatchingUnification.congruenceIdeal π_f ≤ Ideal.span ({a} : Set 𝒪) ↔
        ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
          ∀ n : ℕ, a ∣ (integralCoeff f_𝒪 n - integralCoeff h n)) ∧
    (∀ a : 𝒪,
      a ∈ Stage3PatchingUnification.congruenceIdeal π_f ↔
        ∀ c : 𝒪,
          (∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
            ∀ n : ℕ, c ∣ (integralCoeff f_𝒪 n - integralCoeff h n)) → c ∣ a) := by
  classical
  intro S_𝒪 hS_𝒪_inv f_𝒪 π_f
  let 𝕋_𝒪 := OHeckeAlg k χ S hinv S_𝒪 hS_𝒪_inv
  obtain ⟨ιT, eDual, hι_inj, hι_spec, hι_gen, heDual_apply⟩ :=
    integralHeckeAlg_embedding_and_duality k χ S hinv hcusp hinj hχ b hb_int
  have hπ_eq_eval : ∀ (T : 𝕋_𝒪),
      algebraMap 𝒪 ℂ (π_f T) = ((ιT T).1 (b j₀)).1 1 := by
    intro T
    rw [eigenformAug_apply_val]
    exact congrFun (congrArg Subtype.val (hι_spec T f_𝒪)) 1
  have hι_alg : ∀ (c : 𝒪),
      ιT (algebraMap 𝒪 𝕋_𝒪 c) = algebraMap ℂ (HeckeAlg k χ S hinv) (algebraMap 𝒪 ℂ c) := by
    intro c
    rw [ιT.commutes, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
    apply Subtype.ext; apply LinearMap.ext; intro v
    exact (algebraMap_smul ℂ c v).symm
  -- Key Lemma A: `t ∈ annAugIdeal π_f ↔ ∀ j ≠ j₀, (ιT t).1 (b j) = 0`
  have hann_iff : ∀ t : 𝕋_𝒪,
      t ∈ Stage3PatchingUnification.annAugIdeal π_f ↔
        ∀ j : Fin d, j ≠ j₀ → (ιT t).1 (b j) = 0 := by
    intro t
    rw [Stage3PatchingUnification.mem_annAugIdeal_iff]
    constructor
    · intro ht j hj
      have hne_fun : (b j).1 ≠ (b j₀).1 := fun h => hj (b.injective (Subtype.ext h))
      have hex_n : ∃ n : ℕ, 1 ≤ n ∧ (b j).1 n ≠ (b j₀).1 n := by
        by_contra hall
        push Not at hall
        apply hne_fun
        funext n
        match n with
        | 0 => rw [hcusp (b j).1 (b j).2, hcusp (b j₀).1 (b j₀).2]
        | n + 1 => exact hall (n + 1) (Nat.succ_pos n)
      obtain ⟨n, hn, hdiff⟩ := hex_n
      let Tn : 𝕋_𝒪 := oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv n hn
      let x : 𝕋_𝒪 := Tn - algebraMap 𝒪 𝕋_𝒪 (integralCoeff f_𝒪 n)
      have hx_ker : x ∈ Stage3PatchingUnification.augIdeal π_f := by
        rw [Stage3PatchingUnification.mem_augIdeal_iff]
        apply hinj
        rw [map_zero]
        change algebraMap 𝒪 ℂ (π_f (Tn - algebraMap 𝒪 𝕋_𝒪 (integralCoeff f_𝒪 n))) = 0
        rw [map_sub, map_sub, show π_f (algebraMap 𝒪 𝕋_𝒪 (integralCoeff f_𝒪 n)) =
            integralCoeff f_𝒪 n from π_f.commutes _,
          hπ_eq_eval Tn, hι_gen n hn, heckeAlgGen_val, heckeEnd_apply_one,
          algebraMap_integralCoeff, sub_self]
      have htx0 : t * x = 0 := ht x hx_ker
      have hact_x : (ιT x).1 (b j) = ((b j).1 n - (b j₀).1 n) • b j := by
        have hTn_j : (heckeAlgGen k χ S hinv n hn).1 (b j) = (b j).1 n • b j :=
          Subtype.ext ((heig j).2 n hn)
        have hιx : ιT x = heckeAlgGen k χ S hinv n hn -
            algebraMap ℂ (HeckeAlg k χ S hinv) ((b j₀).1 n) := by
          change ιT (Tn - algebraMap 𝒪 𝕋_𝒪 (integralCoeff f_𝒪 n)) = _
          rw [map_sub, hι_gen n hn, hι_alg, algebraMap_integralCoeff]
        rw [hιx]
        change (heckeAlgGen k χ S hinv n hn).1 (b j) - (b j₀).1 n • b j = _
        rw [hTn_j, ← sub_smul]
      have h0 : ((b j).1 n - (b j₀).1 n) • (ιT t).1 (b j) = 0 := by
        have h1 := congrArg (fun U : 𝕋_𝒪 => (ιT U).1 (b j)) htx0
        rw [map_mul, map_zero] at h1
        change (ιT t).1 ((ιT x).1 (b j)) = 0 at h1
        rw [hact_x, map_smul] at h1
        exact h1
      exact (smul_eq_zero.mp h0).resolve_left (sub_ne_zero.mpr hdiff)
    · intro ht x hx
      apply hι_inj
      rw [map_mul, map_zero]
      apply Subtype.ext
      apply b.ext
      intro j
      change (ιT t).1 ((ιT x).1 (b j)) = 0
      by_cases hj : j = j₀
      · subst hj
        have hx0 : (ιT x).1 (b j) = 0 := by
          have hact := heckeAlg_apply_of_eigenform k χ S hinv (heig j) (ιT x)
          have hx_val : ((ιT x).1 (b j)).1 1 = 0 := by
            rw [← hπ_eq_eval x, (Stage3PatchingUnification.mem_augIdeal_iff π_f x).mp hx, map_zero]
          rw [hact]
          change ((ιT x).1 (b j)).1 1 • b j = 0
          rw [hx_val, zero_smul]
        rw [hx0, map_zero]
      · have hact := heckeAlg_apply_of_eigenform k χ S hinv (heig j) (ιT x)
        rw [hact, map_smul, ht j hj, smul_zero]
  -- Key Lemma B: Constructive proof that `congruenceIdeal π_f ≠ ⊥`!
  have hη_ne_bot : Stage3PatchingUnification.congruenceIdeal π_f ≠ ⊥ := by
    have hsep : ∀ j : Fin d, j ≠ j₀ → ∃ n : ℕ, 1 ≤ n ∧ (b j).1 n ≠ (b j₀).1 n := by
      intro j hj
      by_contra hall
      push Not at hall
      apply hj
      apply b.injective
      apply Subtype.ext
      funext n
      match n with
      | 0 => rw [hcusp (b j).1 (b j).2, hcusp (b j₀).1 (b j₀).2]
      | n + 1 => exact hall (n + 1) (Nat.succ_pos n)
    let nSep : Fin d → ℕ := fun j => if h : j ≠ j₀ then Classical.choose (hsep j h) else 1
    have hnSep_pos : ∀ j : Fin d, 1 ≤ nSep j := fun j => by
      dsimp only [nSep]
      split_ifs with h
      · exact (Classical.choose_spec (hsep j h)).1
      · exact le_rfl
    have hnSep_ne : ∀ j : Fin d, j ≠ j₀ → (b j).1 (nSep j) ≠ (b j₀).1 (nSep j) := fun j h => by
      simp only [nSep, dif_pos h]
      exact (Classical.choose_spec (hsep j h)).2
    let factor : Fin d → 𝕋_𝒪 := fun j =>
      oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (nSep j) (hnSep_pos j) -
        algebraMap 𝒪 𝕋_𝒪 (integralCoeff ⟨b j, hb_int j⟩ (nSep j))
    let t₀ : 𝕋_𝒪 := ∏ j ∈ Finset.univ.erase j₀, factor j
    have ht₀_ann : t₀ ∈ Stage3PatchingUnification.annAugIdeal π_f := by
      rw [hann_iff]
      intro i hi
      have hfactor_i : (ιT (factor i)).1 (b i) = 0 := by
        have hιf : ιT (factor i) = heckeAlgGen k χ S hinv (nSep i) (hnSep_pos i) -
            algebraMap ℂ (HeckeAlg k χ S hinv) ((b i).1 (nSep i)) := by
          change ιT (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (nSep i) (hnSep_pos i) -
            algebraMap 𝒪 𝕋_𝒪 (integralCoeff ⟨b i, hb_int i⟩ (nSep i))) = _
          rw [map_sub, hι_gen, hι_alg, algebraMap_integralCoeff]
        rw [hιf]
        change (heckeAlgGen k χ S hinv (nSep i) (hnSep_pos i)).1 (b i) -
          (b i).1 (nSep i) • b i = 0
        have hTi : (heckeAlgGen k χ S hinv (nSep i) (hnSep_pos i)).1 (b i) =
            (b i).1 (nSep i) • b i := Subtype.ext ((heig i).2 (nSep i) (hnSep_pos i))
        rw [hTi, sub_self]
      have hsplit : t₀ = (∏ j ∈ (Finset.univ.erase j₀).erase i, factor j) * factor i := by
        rw [mul_comm]
        exact (Finset.mul_prod_erase (Finset.univ.erase j₀) factor
          (Finset.mem_erase.mpr ⟨hi, Finset.mem_univ i⟩)).symm
      rw [hsplit, map_mul]
      change (ιT _).1 ((ιT (factor i)).1 (b i)) = 0
      rw [hfactor_i, map_zero]
    have hπt₀_ne : π_f t₀ ≠ 0 := by
      intro h0
      have hC0 : algebraMap 𝒪 ℂ (π_f t₀) = 0 := by rw [h0, map_zero]
      have hprod_val : algebraMap 𝒪 ℂ (π_f t₀) =
          ∏ j ∈ Finset.univ.erase j₀, ((b j₀).1 (nSep j) - (b j).1 (nSep j)) := by
        simp only [t₀, map_prod]
        refine Finset.prod_congr rfl fun j _ => ?_
        change algebraMap 𝒪 ℂ (π_f (oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (nSep j) (hnSep_pos j) -
          algebraMap 𝒪 𝕋_𝒪 (integralCoeff ⟨b j, hb_int j⟩ (nSep j)))) = _
        rw [map_sub, map_sub, hπ_eq_eval, hι_gen, heckeAlgGen_val, heckeEnd_apply_one,
          show π_f (algebraMap 𝒪 𝕋_𝒪 (integralCoeff ⟨b j, hb_int j⟩ (nSep j))) =
            integralCoeff ⟨b j, hb_int j⟩ (nSep j) from π_f.commutes _,
          algebraMap_integralCoeff]
      rw [hprod_val] at hC0
      rw [Finset.prod_eq_zero_iff] at hC0
      obtain ⟨j, hj, hdiff0⟩ := hC0
      exact hnSep_ne j (Finset.ne_of_mem_erase hj) (sub_eq_zero.mp hdiff0).symm
    intro hbot
    have hmem : π_f t₀ ∈ Stage3PatchingUnification.congruenceIdeal π_f :=
      (Stage3PatchingUnification.mem_congruenceIdeal_iff π_f (π_f t₀)).mpr ⟨t₀, ht₀_ann, rfl⟩
    rw [hbot, Ideal.mem_bot] at hmem
    exact hπt₀_ne hmem
  -- Key Lemma C: `congruenceIdeal π_f ≤ Ideal.span {a} ↔ ∃ h ∈ S_𝒪 ∩ eigenComplement, a ∣ (f - h)`!
  have hle_iff : ∀ a : 𝒪,
      Stage3PatchingUnification.congruenceIdeal π_f ≤ Ideal.span ({a} : Set 𝒪) ↔
        ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
          ∀ n : ℕ, a ∣ (integralCoeff f_𝒪 n - integralCoeff h n) := by
    intro a
    constructor
    · intro hle
      let I_ann : Ideal 𝕋_𝒪 := Stage3PatchingUnification.annAugIdeal π_f
      let Q := 𝕋_𝒪 ⧸ I_ann
      obtain ⟨hS_fin, _⟩ := integralCuspLattice_finite_free hinj S
      have : Module.Finite 𝒪 S_𝒪 := hS_fin
      obtain ⟨hT_fin, _⟩ := oHeckeAlg_finite_free k χ S hinv S_𝒪 hS_𝒪_inv hinj
      have : Module.Finite 𝒪 𝕋_𝒪 := hT_fin
      have : Module.Finite 𝒪 Q :=
        Module.Finite.of_surjective (Ideal.Quotient.mkₐ 𝒪 I_ann).toLinearMap
          Ideal.Quotient.mk_surjective
      have : Module.IsTorsionFree 𝒪 Q := by
        refine Module.isTorsionFree_iff_smul_eq_zero.mpr fun {r q} hrq => ?_
        by_cases hr0 : r = 0
        · exact Or.inl hr0
        · right
          induction q using Quotient.inductionOn' with
          | h t =>
            change Ideal.Quotient.mk I_ann (r • t) = 0 at hrq
            rw [Ideal.Quotient.eq_zero_iff_mem] at hrq
            change Ideal.Quotient.mk I_ann t = 0
            rw [Ideal.Quotient.eq_zero_iff_mem]
            rw [hann_iff] at hrq ⊢
            intro j hj
            have h0 := hrq j hj
            rw [map_smul] at h0
            have h1 : algebraMap 𝒪 ℂ r • (ιT t).1 (b j) = 0 := by
              simpa [Algebra.smul_def] using h0
            have hrC : algebraMap 𝒪 ℂ r ≠ 0 := fun h => hr0 (hinj (h.trans (map_zero _).symm))
            exact (smul_eq_zero.mp h1).resolve_left hrC
      have : Module.Free 𝒪 Q := Module.free_of_finite_type_torsion_free'
      let qMap : 𝕋_𝒪 →ₗ[𝒪] (𝒪 ⧸ Ideal.span ({a} : Set 𝒪)) :=
        (Ideal.Quotient.mkₐ 𝒪 (Ideal.span ({a} : Set 𝒪))).toLinearMap.comp π_f.toLinearMap
      have hI_le_ker : I_ann.restrictScalars 𝒪 ≤ LinearMap.ker qMap := by
        intro t ht
        rw [LinearMap.mem_ker]
        change Ideal.Quotient.mk (Ideal.span ({a} : Set 𝒪)) (π_f t) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact hle ((Stage3PatchingUnification.mem_congruenceIdeal_iff π_f (π_f t)).mpr ⟨t, ht, rfl⟩)
      let barLam : Q →ₗ[𝒪] (𝒪 ⧸ Ideal.span ({a} : Set 𝒪)) :=
        Submodule.liftQ (I_ann.restrictScalars 𝒪) qMap hI_le_ker
      let bQ := Module.Free.chooseBasis 𝒪 Q
      let liftVal : Module.Free.ChooseBasisIndex 𝒪 Q → 𝒪 :=
        fun idx => Quotient.out (barLam (bQ idx))
      let lam : Q →ₗ[𝒪] 𝒪 := bQ.constr 𝒪 liftVal
      have hlam_lift : ∀ q : Q,
          Ideal.Quotient.mk (Ideal.span ({a} : Set 𝒪)) (lam q) = barLam q := by
        intro q
        have hcomp :
            (Ideal.Quotient.mkₐ 𝒪 (Ideal.span ({a} : Set 𝒪))).toLinearMap.comp lam = barLam := by
          apply bQ.ext
          intro idx
          simp only [LinearMap.comp_apply, lam, Module.Basis.constr_basis, liftVal]
          exact Quotient.out_eq (barLam (bQ idx))
        exact LinearMap.congr_fun hcomp q
      let μ : Module.Dual 𝒪 𝕋_𝒪 := lam.comp (Ideal.Quotient.mkₐ 𝒪 I_ann).toLinearMap
      have hμ_vanish : ∀ t ∈ I_ann, μ t = 0 := by
        intro t ht
        change lam (Ideal.Quotient.mk I_ann t) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr ht, map_zero]
      have hμ_mod : ∀ T : 𝕋_𝒪, a ∣ (π_f T - μ T) := by
        intro T
        rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
        exact (hlam_lift (Ideal.Quotient.mk I_ann T)).symm
      let h : S_𝒪 := eDual.symm μ
      have hh_dual : ∀ T : 𝕋_𝒪, integralCoeff (T.1 h) 1 = μ T := fun T => by
        rw [← heDual_apply h T, eDual.apply_symm_apply]
      have hh_comp : h.1 ∈ eigenComplement S b j₀ := by
        obtain ⟨c₀, hc₀_mem, hc₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hη_ne_bot
        obtain ⟨t₀, ht₀_ann, ht₀_val⟩ :=
          (Stage3PatchingUnification.mem_congruenceIdeal_iff π_f c₀).mp hc₀_mem
        have ht₀_h : (ιT t₀).1 h.1 = 0 := by
          apply Subtype.ext
          funext n
          match n with
          | 0 => exact hcusp _ ((ιT t₀).1 h.1).2
          | n + 1 =>
            have hn : 1 ≤ n + 1 := Nat.succ_pos n
            let Tn : 𝕋_𝒪 := oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (n + 1) hn
            have hTn_t₀ : Tn * t₀ ∈ I_ann := Ideal.mul_mem_left I_ann Tn ht₀_ann
            have h0 : integralCoeff ((Tn * t₀).1 h) 1 = 0 := by
              rw [hh_dual (Tn * t₀), hμ_vanish (Tn * t₀) hTn_t₀]
            have hC0 : (((ιT (Tn * t₀)).1 h.1).1 1) = 0 := by
              rw [← congrFun (congrArg Subtype.val (hι_spec (Tn * t₀) h)) 1,
                ← algebraMap_integralCoeff, h0, map_zero]
            rw [map_mul, hι_gen (n + 1) hn] at hC0
            simpa [heckeEnd_apply_one] using hC0
        have hdecomp : h.1 = ∑ j : Fin d, b.repr h.1 j • b j := (b.sum_repr h.1).symm
        have ht₀_apply : (ιT t₀).1 h.1 = (b.repr h.1 j₀ * algebraMap 𝒪 ℂ c₀) • b j₀ := by
          conv_lhs => rw [hdecomp]
          rw [map_sum, Finset.sum_eq_single j₀]
          · rw [map_smul, heckeAlg_apply_of_eigenform k χ S hinv (heig j₀) (ιT t₀), smul_smul]
            congr 1
            change b.repr h.1 j₀ * ((ιT t₀).1 (b j₀)).1 1 = _
            rw [← hπ_eq_eval t₀, ht₀_val]
          · intro j _ hj
            rw [map_smul, (hann_iff t₀).mp ht₀_ann j hj, smul_zero]
          · intro hmem; exact absurd (Finset.mem_univ j₀) hmem
        rw [ht₀_h] at ht₀_apply
        have hcoeff0 : b.repr h.1 j₀ * algebraMap 𝒪 ℂ c₀ = 0 := by
          have hbj_ne : b j₀ ≠ 0 := b.ne_zero j₀
          exact (smul_eq_zero.mp ht₀_apply.symm).resolve_right hbj_ne
        have hc₀C_ne : algebraMap 𝒪 ℂ c₀ ≠ 0 := fun h => hc₀_ne (hinj (h.trans (map_zero _).symm))
        have hr0 : b.repr h.1 j₀ = 0 := (mul_eq_zero.mp hcoeff0).resolve_right hc₀C_ne
        rw [hdecomp, ← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ j₀), hr0, zero_smul,
          zero_add]
        refine Submodule.sum_mem _ fun j hj => Submodule.smul_mem _ _ ?_
        exact Submodule.subset_span ⟨j, Finset.ne_of_mem_erase hj, rfl⟩
      refine ⟨h, hh_comp, fun n => ?_⟩
      match n with
      | 0 =>
        have hf0 : integralCoeff f_𝒪 0 = 0 :=
          hinj (by rw [algebraMap_integralCoeff, map_zero]; exact hcusp (b j₀).1 (b j₀).2)
        have hh0 : integralCoeff h 0 = 0 :=
          hinj (by rw [algebraMap_integralCoeff, map_zero]; exact hcusp h.1.1 h.1.2)
        rw [hf0, hh0, sub_self]
        exact dvd_zero a
      | n + 1 =>
        have hn : 1 ≤ n + 1 := Nat.succ_pos n
        let Tn : 𝕋_𝒪 := oHeckeAlgGen k χ S hinv S_𝒪 hS_𝒪_inv (n + 1) hn
        have hπ_Tn : π_f Tn = integralCoeff f_𝒪 (n + 1) := by
          apply hinj
          rw [hπ_eq_eval Tn, hι_gen (n + 1) hn, heckeAlgGen_val, heckeEnd_apply_one,
            algebraMap_integralCoeff]
        have hμ_Tn : μ Tn = integralCoeff h (n + 1) := by
          rw [← hh_dual Tn]
          apply hinj
          rw [algebraMap_integralCoeff, algebraMap_integralCoeff]
          exact heckeOp_apply_one k χ hn h.1.1
        rw [← hπ_Tn, ← hμ_Tn]
        exact hμ_mod Tn
    · rintro ⟨h, hh_comp, hcong⟩
      intro c hc
      obtain ⟨t, ht_ann, rfl⟩ := (Stage3PatchingUnification.mem_congruenceIdeal_iff π_f c).mp hc
      by_cases ha0 : a = 0
      · subst ha0
        have heq_fh : f_𝒪 = h := by
          apply Subtype.ext; apply Subtype.ext; funext n
          have h0 := hcong n
          rw [zero_dvd_iff, sub_eq_zero] at h0
          rw [← algebraMap_integralCoeff f_𝒪 n, ← algebraMap_integralCoeff h n, h0]
        exfalso
        have hbj_in : b j₀ ∈ eigenComplement S b j₀ := by
          have hval : b j₀ = h.1 := congrArg Subtype.val heq_fh
          rwa [hval]
        have hrepr0 : ∀ v ∈ eigenComplement S b j₀, b.repr v j₀ = 0 := by
          intro v hv
          refine Submodule.span_induction (p := fun v _ => b.repr v j₀ = 0)
            (mem := by
              rintro _ ⟨j, hj, rfl⟩
              rw [b.repr_self, Finsupp.single_eq_of_ne hj.symm])
            (zero := by simp)
            (add := fun x y _ _ hx hy => by simp [hx, hy])
            (smul := fun c x _ hx => by simp [hx])
            hv
        have h1 : b.repr (b j₀) j₀ = 1 := by rw [b.repr_self, Finsupp.single_eq_same]
        exact one_ne_zero (h1.symm.trans (hrepr0 (b j₀) hbj_in))
      · have hdiv : ∀ n : ℕ, ∃ qn : 𝒪, integralCoeff f_𝒪 n - integralCoeff h n = a * qn := hcong
        have haC : algebraMap 𝒪 ℂ a ≠ 0 := fun h => ha0 (hinj (h.trans (map_zero _).symm))
        have hq_mem : (algebraMap 𝒪 ℂ a)⁻¹ • (f_𝒪.1 - h.1) ∈ S_𝒪 := by
          intro n
          obtain ⟨qn, hqn⟩ := hdiv n
          refine ⟨qn, ?_⟩
          have hnum : f_𝒪.1.1 n - h.1.1 n = algebraMap 𝒪 ℂ a * algebraMap 𝒪 ℂ qn := by
            rw [← algebraMap_integralCoeff f_𝒪 n, ← algebraMap_integralCoeff h n,
              ← map_sub, hqn, map_mul]
          simp only [Submodule.coe_smul, Submodule.coe_sub, Pi.smul_apply, Pi.sub_apply,
            smul_eq_mul, hnum, ← mul_assoc, inv_mul_cancel₀ haC, one_mul]
        let q : S_𝒪 := ⟨(algebraMap 𝒪 ℂ a)⁻¹ • (f_𝒪.1 - h.1), hq_mem⟩
        have hfh_eq : f_𝒪 - h = a • q := by
          apply Subtype.ext
          change f_𝒪.1 - h.1 = a • ((algebraMap 𝒪 ℂ a)⁻¹ • (f_𝒪.1 - h.1))
          rw [← algebraMap_smul ℂ a, smul_smul, mul_inv_cancel₀ haC, one_smul]
        have hth0 : t.1 h = 0 := by
          apply Subtype.ext
          rw [hι_spec t h]
          refine Submodule.span_induction (p := fun v _ => (ιT t).1 v = 0)
            (mem := by rintro _ ⟨j, hj, rfl⟩; exact (hann_iff t).mp ht_ann j hj)
            (zero := map_zero _)
            (add := fun x y _ _ hx hy => by rw [map_add, hx, hy, add_zero])
            (smul := fun c x _ hx => by rw [map_smul, hx, smul_zero])
            hh_comp
        have htf_eq : π_f t • f_𝒪 = a • (t.1 q) := by
          calc π_f t • f_𝒪
              = t.1 f_𝒪 := (eigenformAug_smul_eq k χ S hinv hinj S_𝒪 hS_𝒪_inv f_𝒪 (heig j₀)
                  (fun n _ => hb_int j₀ n) t).symm
            _ = t.1 (f_𝒪 - h) := by rw [map_sub, hth0, sub_zero]
            _ = t.1 (a • q) := by rw [hfh_eq]
            _ = a • (t.1 q) := map_smul t.1 a q
        rw [Ideal.mem_span_singleton]
        refine ⟨integralCoeff (t.1 q) 1, ?_⟩
        apply hinj
        have h1 := congrFun (congrArg (fun x : S_𝒪 => x.1.1) htf_eq) 1
        simpa [f_𝒪, Algebra.smul_def, map_mul, (heig j₀).1] using h1
  refine ⟨hη_ne_bot, hle_iff, fun a => ?_⟩
  obtain ⟨gη, hgη⟩ := IsPrincipalIdealRing.principal (Stage3PatchingUnification.congruenceIdeal π_f)
  constructor
  · intro ha c hc
    have hle_c : Stage3PatchingUnification.congruenceIdeal π_f ≤ Ideal.span ({c} : Set 𝒪) :=
      (hle_iff c).mpr hc
    exact Ideal.mem_span_singleton.mp (hle_c ha)
  · intro hall
    have hgη_cong : ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
        ∀ n : ℕ, gη ∣ (integralCoeff f_𝒪 n - integralCoeff h n) :=
      (hle_iff gη).mp (by rw [hgη])
    have hdvd : gη ∣ a := hall gη hgη_cong
    rw [hgη, Ideal.mem_span_singleton]
    exact hdvd

/-- **Named Divisibility Corollary (`congruenceIdeal_le_span_iff_congruence_with_complement`)**. -/
theorem congruenceIdeal_le_span_iff_congruence_with_complement
    [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    {d : ℕ} (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (hb_int : ∀ j : Fin d, b j ∈ integralCuspLattice 𝒪 S)
    (j₀ : Fin d) (a : 𝒪) :
    let S_𝒪 := integralCuspLattice 𝒪 S
    let hS_𝒪_inv := integralCuspLattice_hecke_invariant k χ S hinv hχ
    let f_𝒪 : S_𝒪 := ⟨b j₀, hb_int j₀⟩
    let π_f := eigenformAug k χ S hinv hinj S_𝒪 hS_𝒪_inv f_𝒪 (heig j₀)
      (fun n _ => hb_int j₀ n)
    Stage3PatchingUnification.congruenceIdeal π_f ≤ Ideal.span ({a} : Set 𝒪) ↔
      ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
        ∀ n : ℕ, a ∣ (integralCoeff f_𝒪 n - integralCoeff h n) :=
  (congruenceIdeal_exact_characterization k χ S hinv hcusp hinj hχ b heig hb_int j₀).2.1 a

/-- **Named Membership Corollary (`mem_congruenceIdeal_iff_congruence_with_complement`)**. -/
theorem mem_congruenceIdeal_iff_congruence_with_complement
    [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    {d : ℕ} (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (hb_int : ∀ j : Fin d, b j ∈ integralCuspLattice 𝒪 S)
    (j₀ : Fin d) (a : 𝒪) :
    let S_𝒪 := integralCuspLattice 𝒪 S
    let hS_𝒪_inv := integralCuspLattice_hecke_invariant k χ S hinv hχ
    let f_𝒪 : S_𝒪 := ⟨b j₀, hb_int j₀⟩
    let π_f := eigenformAug k χ S hinv hinj S_𝒪 hS_𝒪_inv f_𝒪 (heig j₀)
      (fun n _ => hb_int j₀ n)
    a ∈ Stage3PatchingUnification.congruenceIdeal π_f ↔
      ∀ c : 𝒪,
        (∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
          ∀ n : ℕ, c ∣ (integralCoeff f_𝒪 n - integralCoeff h n)) → c ∣ a :=
  (congruenceIdeal_exact_characterization k χ S hinv hcusp hinj hχ b heig hb_int j₀).2.2 a

end CongruenceIdealAndWilesLenstra

/-! ### DVR Specialization & Direct Wiring to `Stage3PatchingUnification.wiles_lenstra_length_inequality` -/

section DVRWilesLenstraBridge

variable {𝒪 : Type*} [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪] [Algebra 𝒪 ℂ]

/-- **DVR Uniformizer-Power Congruence Equivalence**:
Over a DVR `𝒪 ↪ ℂ` with uniformizer `ϖ`, for every `m : ℕ`:
1. `congruenceIdeal π_f ≤ (ϖ^m) ↔ ∃ h ∈ S_𝒪 ∩ f^⊥, f ≡ h [MOD ϖ^m]`,
2. `ϖ^m ∈ congruenceIdeal π_f ↔ ¬ (∃ h ∈ S_𝒪 ∩ f^⊥, f ≡ h [MOD ϖ^(m+1)])`! -/
theorem congruenceIdeal_dvr_uniformizer_iff
    [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    {d : ℕ} (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (hb_int : ∀ j : Fin d, b j ∈ integralCuspLattice 𝒪 S)
    (j₀ : Fin d) {ϖ : 𝒪} (hϖ : Irreducible ϖ) (m : ℕ) :
    let S_𝒪 := integralCuspLattice 𝒪 S
    let hS_𝒪_inv := integralCuspLattice_hecke_invariant k χ S hinv hχ
    let f_𝒪 : S_𝒪 := ⟨b j₀, hb_int j₀⟩
    let π_f := eigenformAug k χ S hinv hinj S_𝒪 hS_𝒪_inv f_𝒪 (heig j₀)
      (fun n _ => hb_int j₀ n)
    (Stage3PatchingUnification.congruenceIdeal π_f ≤ Ideal.span ({ϖ ^ m} : Set 𝒪) ↔
      ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
        ∀ n : ℕ, ϖ ^ m ∣ (integralCoeff f_𝒪 n - integralCoeff h n)) ∧
    (ϖ ^ m ∈ Stage3PatchingUnification.congruenceIdeal π_f ↔
      ¬ ∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
          ∀ n : ℕ, ϖ ^ (m + 1) ∣ (integralCoeff f_𝒪 n - integralCoeff h n)) := by
  intro S_𝒪 hS_𝒪_inv f_𝒪 π_f
  obtain ⟨hη_ne, hle_iff, _⟩ :=
    congruenceIdeal_exact_characterization k χ S hinv hcusp hinj hχ b heig hb_int j₀
  refine ⟨hle_iff (ϖ ^ m), ?_⟩
  obtain ⟨gη, hgη⟩ := IsPrincipalIdealRing.principal (Stage3PatchingUnification.congruenceIdeal π_f)
  have hgη_ne : gη ≠ 0 := by
    intro h0
    apply hη_ne
    rw [hgη, h0, Ideal.submodule_span_eq, Ideal.span_singleton_zero]
  obtain ⟨r, hr⟩ := IsDiscreteValuationRing.associated_pow_irreducible hgη_ne hϖ
  have hη_eq : Stage3PatchingUnification.congruenceIdeal π_f = Ideal.span ({ϖ ^ r} : Set 𝒪) := by
    rw [hgη, Ideal.submodule_span_eq]
    exact Stage3PatchingUnification.span_singleton_eq_of_associated hr
  rw [← hle_iff (ϖ ^ (m + 1)), hη_eq, Ideal.mem_span_singleton, Ideal.span_singleton_le_iff_mem,
    Ideal.mem_span_singleton]
  have hdvd_pow : ∀ a c : ℕ, ϖ ^ a ∣ ϖ ^ c ↔ a ≤ c := fun a c => by
    constructor
    · intro h
      by_contra hlt
      have hgt : c < a := Nat.lt_of_not_le hlt
      obtain ⟨q, hq⟩ := h
      have hsplit : ϖ ^ a = ϖ ^ c * ϖ ^ (a - c) := by
        rw [← pow_add, Nat.add_sub_of_le (le_of_lt hgt)]
      rw [hsplit, mul_assoc] at hq
      have h1 : (1 : 𝒪) = ϖ ^ (a - c) * q :=
        mul_left_cancel₀ (pow_ne_zero c hϖ.ne_zero) (by simpa using hq)
      have hunit : IsUnit (ϖ ^ (a - c)) := isUnit_iff_exists_inv.mpr ⟨q, h1.symm⟩
      have hpos : 0 < a - c := by omega
      have hϖ_unit : IsUnit ϖ :=
        (isUnit_pow_iff (Nat.ne_of_gt hpos)).mp hunit
      exact hϖ.not_isUnit hϖ_unit
    · exact pow_dvd_pow ϖ
  rw [hdvd_pow r m, hdvd_pow (m + 1) r]
  omega

/-- **DIRECT WIRING TO `Stage3PatchingUnification.wiles_lenstra_length_inequality` &
`gorenstein_surj_bijective_of_congruenceIdeal_eq` (`R = T`)**:
For any DVR `𝒪 ↪ ℂ` with uniformizer `ϖ`, any finite-dimensional cuspidal Hecke space `S` with an
`𝒪`-integral eigenbasis `b : Fin d → S`, any surjective `𝒪`-algebra homomorphism `φ : R →ₐ[𝒪] 𝕋_𝒪`,
and `π_f : 𝕋_𝒪 →ₐ[𝒪] 𝒪`:
1. `len_𝒪(𝒪 ⧸ η_f) ≤ len_𝒪(Φ_{𝕋_𝒪}) ≤ len_𝒪(Φ_R)` and `len_𝒪(𝒪 ⧸ η_f) < ⊤`.
2. Every mod-`ϖ^m` congruence between `f = b j₀` and a form `h ∈ S_𝒪 ∩ f^⊥` gives the explicit
   Selmer / cotangent lower bound **`(m : ℕ∞) ≤ len_𝒪(𝒪 ⧸ η_f) ≤ len_𝒪(Φ_R)`**!
3. If `R` is local Gorenstein over `𝒪` (`IsGorensteinOver 𝒪 R`) and `η_R = η_f`, then
   **`φ : R ≃ₐ[𝒪] 𝕋_𝒪` IS AN ISOMORPHISM (`R = T`)**! -/
theorem heckeRing_wiles_lenstra_bridge
    [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinj : Function.Injective (algebraMap 𝒪 ℂ))
    (hχ : ∀ d : ℕ, χ (d : ZMod N) ∈ Set.range (algebraMap 𝒪 ℂ))
    {d : ℕ} (b : Module.Basis (Fin d) ℂ S)
    (heig : ∀ j : Fin d, IsNormalizedHeckeEigenform k χ (b j).1 (b j).1)
    (hb_int : ∀ j : Fin d, b j ∈ integralCuspLattice 𝒪 S)
    (j₀ : Fin d) {ϖ : 𝒪} (hϖ : Irreducible ϖ)
    {R : Type*} [CommRing R] [Algebra 𝒪 R]
    (φ : R →ₐ[𝒪] OHeckeAlg k χ S hinv (integralCuspLattice 𝒪 S)
      (integralCuspLattice_hecke_invariant k χ S hinv hχ))
    (hφ : Function.Surjective φ) :
    let S_𝒪 := integralCuspLattice 𝒪 S
    let hS_𝒪_inv := integralCuspLattice_hecke_invariant k χ S hinv hχ
    let f_𝒪 : S_𝒪 := ⟨b j₀, hb_int j₀⟩
    let π_f := eigenformAug k χ S hinv hinj S_𝒪 hS_𝒪_inv f_𝒪 (heig j₀)
      (fun n _ => hb_int j₀ n)
    Module.length 𝒪 (𝒪 ⧸ Stage3PatchingUnification.congruenceIdeal π_f) ≤
        Module.length 𝒪 (Stage3PatchingUnification.Cotangent π_f) ∧
      Module.length 𝒪 (Stage3PatchingUnification.Cotangent π_f) ≤
        Module.length 𝒪 (Stage3PatchingUnification.Cotangent (π_f.comp φ)) ∧
      Module.length 𝒪 (𝒪 ⧸ Stage3PatchingUnification.congruenceIdeal π_f) ≠ ⊤ ∧
      (∀ m : ℕ,
        (∃ h : S_𝒪, h.1 ∈ eigenComplement S b j₀ ∧
          ∀ n : ℕ, ϖ ^ m ∣ (integralCoeff f_𝒪 n - integralCoeff h n)) →
        (m : ℕ∞) ≤ Module.length 𝒪 (𝒪 ⧸ Stage3PatchingUnification.congruenceIdeal π_f) ∧
          (m : ℕ∞) ≤ Module.length 𝒪 (Stage3PatchingUnification.Cotangent (π_f.comp φ))) ∧
      (∀ [IsLocalRing R], IsGorensteinOver 𝒪 R →
        Stage3PatchingUnification.congruenceIdeal (π_f.comp φ) ≠ ⊥ →
        Stage3PatchingUnification.congruenceIdeal (π_f.comp φ) =
          Stage3PatchingUnification.congruenceIdeal π_f →
        Function.Bijective φ) := by
  intro S_𝒪 hS_𝒪_inv f_𝒪 π_f
  obtain ⟨hS_fin, _⟩ := integralCuspLattice_finite_free hinj S
  have : Module.Finite 𝒪 S_𝒪 := hS_fin
  obtain ⟨hT_fin, hT_free⟩ := oHeckeAlg_finite_free k χ S hinv S_𝒪 hS_𝒪_inv hinj
  have : Module.Finite 𝒪 (OHeckeAlg k χ S hinv S_𝒪 hS_𝒪_inv) := hT_fin
  have : Module.Free 𝒪 (OHeckeAlg k χ S hinv S_𝒪 hS_𝒪_inv) := hT_free
  obtain ⟨hη_ne, hle_iff, _⟩ :=
    congruenceIdeal_exact_characterization k χ S hinv hcusp hinj hχ b heig hb_int j₀
  obtain ⟨h1, h2, h3⟩ := Stage3PatchingUnification.wiles_lenstra_length_inequality φ hφ π_f hη_ne
  refine ⟨h1, h2, h3, fun m hm => ?_, fun {_} hG hηR_ne hη_eq =>
    Stage3PatchingUnification.gorenstein_surj_bijective_of_congruenceIdeal_eq hG φ hφ π_f
      hηR_ne hη_eq⟩
  have hle_pow : Stage3PatchingUnification.congruenceIdeal π_f ≤ Ideal.span ({ϖ ^ m} : Set 𝒪) :=
    (hle_iff (ϖ ^ m)).mpr hm
  have hm_le_η : (m : ℕ∞) ≤ Module.length 𝒪 (𝒪 ⧸ Stage3PatchingUnification.congruenceIdeal π_f) := by
    rw [← Stage3PatchingUnification.length_quotient_span_pow_eq_of_dvr hϖ m]
    exact Module.length_le_of_surjective (Submodule.factor hle_pow) (Submodule.factor_surjective hle_pow)
  exact ⟨hm_le_η, hm_le_η.trans (h1.trans h2)⟩

end DVRWilesLenstraBridge

end IntegralDualityAndCongruenceIdeal

/-! ## Section 5: Non-Vacuous Concrete Witness & Master Stage 7 Packaging Theorem -/

section ConcreteWitnessAndMaster

/-- Concrete non-vacuous 1-dimensional Eisenstein witness realizing the entire Stage 7 pipeline
from `Stage6HeckeSpectral.eisensteinPeterssonQExpansionSpace k`:
`HeckeAlg ≃ₐ[ℂ] (Fin 1 → ℂ)`, `IsReduced`, `finrank = 1`, and finite free torsion-free `IntHeckeAlg`! -/
theorem eisenstein_stage7_witness (k : ℕ) :
    let P := eisensteinPeterssonQExpansionSpace k
    let S := peterssonQSubspace P
    let hinv := peterssonQSubspace_hecke_inv P
    let hχ : ∀ d : ℕ, (1 : DirichletCharacter ℂ 1) (d : ZMod 1) ∈ Set.range (algebraMap ℤ ℂ) :=
      fun d => ⟨1, by
        have hu : IsUnit (d : ZMod 1) := (ZMod.isUnit_iff_coprime d 1).mpr (Nat.coprime_one_right d)
        simp [MulChar.one_apply hu]⟩
    let S_ℤ := integralCuspLattice ℤ S
    let hS_ℤ_inv := integralCuspLattice_hecke_invariant k (1 : DirichletCharacter ℂ 1) S hinv hχ
    Module.finrank ℂ (HeckeAlg k (1 : DirichletCharacter ℂ 1) S hinv) = 1 ∧
      IsReduced (HeckeAlg k (1 : DirichletCharacter ℂ 1) S hinv) ∧
      Nonempty (HeckeAlg k (1 : DirichletCharacter ℂ 1) S hinv ≃ₐ[ℂ] (Fin 1 → ℂ)) ∧
      Module.Finite ℤ (IntHeckeAlg k (1 : DirichletCharacter ℂ 1) S hinv S_ℤ hS_ℤ_inv) ∧
      Module.Free ℤ (IntHeckeAlg k (1 : DirichletCharacter ℂ 1) S hinv S_ℤ hS_ℤ_inv) ∧
      Module.IsTorsionFree ℤ (IntHeckeAlg k (1 : DirichletCharacter ℂ 1) S hinv S_ℤ hS_ℤ_inv) := by
  intro P S hinv hχ S_ℤ hS_ℤ_inv
  obtain ⟨_, _, hpi, hred, hdim⟩ := peterssonHeckeAlg_etale_and_reduced P
  have hdim1 : Module.finrank ℂ (EuclideanSpace ℂ (Fin 1)) = 1 := by simp
  obtain ⟨hS_fin, _⟩ := integralCuspLattice_finite_free (𝒪 := ℤ) Int.cast_injective S
  have : Module.Finite ℤ S_ℤ := hS_fin
  obtain ⟨hT_fin, hT_free⟩ := intHeckeAlg_finite_free k (1 : DirichletCharacter ℂ 1) S hinv S_ℤ hS_ℤ_inv
  have hT_tf := intHeckeAlg_isTorsionFree k (1 : DirichletCharacter ℂ 1) S hinv S_ℤ hS_ℤ_inv
  refine ⟨by simpa [hdim1] using hdim, hred, ?_, hT_fin, hT_free, hT_tf⟩
  rcases hpi with ⟨e⟩
  exact ⟨e.trans (AlgEquiv.piCongrLeft' ℂ (fun _ => ℂ) (finCongr hdim1))⟩

/-- **Stage 7 Master Unconditional Packaging Theorem**:
Bundles:
1. Commutative finite-dimensional `HeckeAlg` (`𝕋_ℂ`) and finitely generated, free, torsion-free
   commutative `IntHeckeAlg` (`𝕋_ℤ`),
2. Unconditional Perfect Hecke–Fourier Duality `S ≃ₗ[ℂ] Module.Dual ℂ 𝕋_ℂ` and `dim 𝕋_ℂ = dim S`,
3. Unconditional bijections `{𝕋_ℂ →ₐ[ℂ] ℂ} ≃ {Maximal Ideals of 𝕋_ℂ} ≃ {Normalized Eigenforms in S}`,
4. Étale isomorphism `𝕋_ℂ ≃ₐ[ℂ] (Fin d → ℂ)` and reducedness on every `PeterssonQExpansionSpace`, and
5. Exact congruence-ideal characterization (`congruenceIdeal π_f` ↔ congruences with `f^⊥`) wired
   directly into `Stage3PatchingUnification.wiles_lenstra_length_inequality`. -/
theorem stage7_hecke_ring_master
    {N : ℕ} (k : ℕ) (χ : DirichletCharacter ℂ N)
    (S : Submodule ℂ (ℕ → ℂ)) [FiniteDimensional ℂ S]
    (hcusp : ∀ f ∈ S, f 0 = 0)
    (hinv : ∀ n : ℕ, 1 ≤ n → ∀ f ∈ S, heckeOp k χ n f ∈ S)
    (L : Submodule ℤ S) [Module.Finite ℤ L]
    (hL_inv : ∀ (n : ℕ) (hn : 1 ≤ n), ∀ f ∈ L, heckeEnd k χ S hinv n hn f ∈ L) :
    Module.Finite ℂ (HeckeAlg k χ S hinv) ∧
      Module.finrank ℂ (HeckeAlg k χ S hinv) = Module.finrank ℂ S ∧
      Nonempty (S ≃ₗ[ℂ] Module.Dual ℂ (HeckeAlg k χ S hinv)) ∧
      Nonempty ((HeckeAlg k χ S hinv →ₐ[ℂ] ℂ) ≃
        { f : S // IsNormalizedHeckeEigenform k χ f.1 f.1 }) ∧
      Nonempty ({ 𝔪 : Ideal (HeckeAlg k χ S hinv) // 𝔪.IsMaximal } ≃
        { f : S // IsNormalizedHeckeEigenform k χ f.1 f.1 }) ∧
      Module.Finite ℤ (IntHeckeAlg k χ S hinv L hL_inv) ∧
      Module.Free ℤ (IntHeckeAlg k χ S hinv L hL_inv) ∧
      Module.IsTorsionFree ℤ (IntHeckeAlg k χ S hinv L hL_inv) :=
  ⟨heckeAlg_moduleFinite k χ S hinv,
   finrank_heckeAlg_eq_finrank k χ S hinv hcusp,
   ⟨heckeFourierDualityEquiv k χ S hinv hcusp⟩,
   ⟨algHomEquivNormalizedEigenforms k χ S hinv hcusp⟩,
   ⟨maximalIdealEquivNormalizedEigenforms k χ S hinv hcusp⟩,
   (intHeckeAlg_finite_free k χ S hinv L hL_inv).1,
   (intHeckeAlg_finite_free k χ S hinv L hL_inv).2,
   intHeckeAlg_isTorsionFree k χ S hinv L hL_inv⟩

end ConcreteWitnessAndMaster

end RHDirect.Stage7HeckeRing

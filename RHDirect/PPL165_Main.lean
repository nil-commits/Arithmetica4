/-!
# PPL 165 (Shallit Open Problem #7, £200): Binary Primitive Words `Q_2` and Context-Free Subclasses

## Scope & Honest Labeling
This file formalizes **structural, separation, analytic-transcendence, and pumping-barrier theorems**
for the language of binary primitive words:
`Q_2 = { w : List Bool | w ≠ [] ∧ ∀ u k, 2 ≤ k → w ≠ (List.replicate k u).flatten }`.

- **Honest Scope Statement:** Whether `Q_2` belongs to the full class of context-free languages
  (`Language.IsContextFree Q_2`, Dömösi–Horváth–Ito 1991, Shallit `bc4.pdf` Slide 29, £200)
  **remains OPEN** and is **NOT** claimed solved here.
- **What this file proves (100% pure-Mathlib signatures, 0 custom definitions in public theorem types):**
  1. **Part I (Combinatorics on Words & Möbius Inversion):**
     - `ppl165_exists_primitive_root`: every nonempty binary word is a positive power of a primitive word.
     - `ppl165_primitive_root_unique`: uniqueness of the primitive root and exponent (via Fine–Wilf periodicity).
     - `ppl165_commute_iff_common_power`: Lyndon–Schützenberger commutation theorem.
     - `ppl165_primitive_word_count_mobius`: exact Möbius inversion count `q_n = ∑_{d | n} μ(n/d) · 2^d`.
  2. **Part II (Formal Language Subclass Separations using Mathlib's `Language` & `ContextFreeGrammar`):**
     - `ppl165_not_regular`: `¬ Language.IsRegular Q_2`.
     - `ppl165_not_linear_cfg`: `Q_2` is not generated by any linear `ContextFreeGrammar Bool`.
     - `ppl165_complement_not_context_free`: `¬ Language.IsContextFree Q_2ᶜ` (proved directly via a
       general Bar-Hillel CFL pumping lemma on Mathlib's `ContextFreeGrammar`).
     - `ppl165_not_in_complement_closed_cfl`: `Q_2` lies outside every complement-closed subclass of `CFL`
       (including deterministic context-free languages `DCFL`).
  3. **Part III (Analytic Transcendence — Petersen / Flajolet / Chomsky–Schützenberger Engine):**
     - `ppl165_generating_function_transcendental`: the ordinary generating series `∑_{n ≥ 1} q_n z^n`
       of `Q_2` is transcendental over `ℂ[z]`.
  4. **Part IV (Formal Pumping Barrier):**
     - `ppl165_strong_single_char_pumping` & `ppl165_satisfies_cfl_pumping`: every `w ∈ Q_2` with
       `2 ≤ w.length` admits a single-character pumping decomposition `w = u ++ [c] ++ z` with
       `∀ i, u ++ List.replicate i c ++ z ∈ Q_2`, formally proving that standard Bar-Hillel CFL
       pumping fails on `Q_2` (with optimal pumping constant `P = 2`).
-/

namespace PPL165

/-! ### Internal helpers (all public theorems below unfold to pure Mathlib types) -/

private abbrev wordPow (u : List Bool) (k : ℕ) : List Bool :=
  (List.replicate k u).flatten

private abbrev Q2 : Language Bool :=
  {w : List Bool | w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten}

private lemma wordPow_zero (u : List Bool) : wordPow u 0 = [] := rfl

private lemma wordPow_one (u : List Bool) : wordPow u 1 = u := by
  simp [wordPow]

private lemma wordPow_succ (u : List Bool) (k : ℕ) :
    wordPow u (k + 1) = u ++ wordPow u k := by
  simp [wordPow, List.replicate_succ]

private lemma wordPow_add (u : List Bool) (a b : ℕ) :
    wordPow u (a + b) = wordPow u a ++ wordPow u b := by
  induction a with
  | zero => simp [wordPow]
  | succ a ih => simp [Nat.succ_add, wordPow_succ, ih, List.append_assoc]

private lemma wordPow_mul (u : List Bool) (a b : ℕ) :
    wordPow (wordPow u a) b = wordPow u (a * b) := by
  induction b with
  | zero => simp [wordPow]
  | succ b ih =>
    rw [wordPow_succ, ih, Nat.mul_succ, Nat.add_comm, wordPow_add]

private lemma wordPow_length (u : List Bool) (k : ℕ) :
    (wordPow u k).length = k * u.length := by
  induction k with
  | zero => simp [wordPow]
  | succ k ih =>
    rw [wordPow_succ, List.length_append, ih, Nat.succ_mul]
    omega

private lemma wordPow_count (u : List Bool) (k : ℕ) (b : Bool) :
    (wordPow u k).count b = k * u.count b := by
  induction k with
  | zero => simp [wordPow]
  | succ k ih =>
    rw [wordPow_succ, List.count_append, ih, Nat.succ_mul]
    omega

private lemma wordPow_eq_nil_iff {u : List Bool} {k : ℕ} (hk : 1 ≤ k) :
    wordPow u k = [] ↔ u = [] := by
  constructor
  · intro h
    have hlen := congrArg List.length h
    rw [wordPow_length] at hlen
    have : u.length = 0 := by
      rcases Nat.mul_eq_zero.mp hlen with h1 | h2
      · omega
      · exact h2
    exact List.eq_nil_of_length_eq_zero this
  · rintro rfl
    have : (wordPow [] k).length = 0 := by simp
    exact List.eq_nil_of_length_eq_zero this

private lemma mem_Q2_iff {w : List Bool} :
    w ∈ Q2 ↔ w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ wordPow u k :=
  Iff.rfl

private lemma wordPow_getElem (u : List Bool) (k : ℕ) (i : ℕ) (hi : i < (wordPow u k).length) :
    (wordPow u k)[i] = u[i % u.length]'(by
      have hu : 0 < u.length := by
        rw [wordPow_length] at hi
        exact Nat.pos_of_mul_pos_left (Nat.zero_lt_of_lt hi)
      exact Nat.mod_lt i hu) := by
  induction k generalizing i with
  | zero =>
    simp [wordPow] at hi
  | succ k ih =>
    have hu : 0 < u.length := by
      rw [wordPow_length] at hi
      exact Nat.pos_of_mul_pos_left (Nat.zero_lt_of_lt hi)
    have hsucc : wordPow u (k + 1) = u ++ wordPow u k := wordPow_succ u k
    have hi_app : i < (u ++ wordPow u k).length := hsucc ▸ hi
    have hget_eq : (wordPow u (k + 1))[i]'hi = (u ++ wordPow u k)[i]'hi_app := by
      congr 1
    rw [hget_eq]
    by_cases hlt : i < u.length
    · rw [List.getElem_append_left hlt]
      simp [Nat.mod_eq_of_lt hlt]
    · have hge : u.length ≤ i := Nat.le_of_not_lt hlt
      rw [List.getElem_append_right hge]
      have hi' : i - u.length < (wordPow u k).length := by
        rw [wordPow_length] at hi ⊢
        rw [Nat.succ_mul] at hi
        omega
      rw [ih (i - u.length) hi']
      have hmod : (i - u.length) % u.length = i % u.length := by
        have : i = (i - u.length) + u.length := by omega
        conv_rhs => rw [this]
        rw [Nat.add_mod_right]
      simp [hmod]

private lemma wordPow_take_eq {u : List Bool} {k : ℕ} (hk : 1 ≤ k) :
    (wordPow u k).take u.length = u := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [Nat.add_comm, wordPow_succ, List.take_left]

/-! ### Part I: Primitive-Root Existence, Fine–Wilf Periodicity, Uniqueness, and Möbius Counting -/

private def HasPeriod (w : List Bool) (d : ℕ) : Prop :=
  ∀ (i : ℕ) (h1 : i < w.length) (h2 : i + d < w.length), w[i] = w[i + d]

private lemma hasPeriod_wordPow (u : List Bool) (k : ℕ) :
    HasPeriod (wordPow u k) u.length := by
  intro i h1 h2
  rw [wordPow_getElem u k i h1, wordPow_getElem u k (i + u.length) h2]
  simp [Nat.add_mod_right]

private lemma hasPeriod_sub {w : List Bool} {a b : ℕ}
    (ha : HasPeriod w a) (hb : HasPeriod w b)
    (hlt : a < b) (hlen : a + b ≤ w.length) :
    HasPeriod w (b - a) := by
  intro i h1 h2
  by_cases hbig : i + b < w.length
  · have hstep1 : w[i] = w[i + b] := hb i h1 hbig
    have hstep2 : w[i + (b - a)] = w[i + b] := by
      have hidx : i + (b - a) + a = i + b := by omega
      have := ha (i + (b - a)) h2 (by omega)
      simpa [hidx] using this
    exact hstep1.trans hstep2.symm
  · have hia : a ≤ i := by omega
    have hstep1 : w[i - a] = w[i] := by
      have hidx : (i - a) + a = i := by omega
      have := ha (i - a) (by omega) (by omega)
      simpa [hidx] using this
    have hstep2 : w[i - a] = w[i + (b - a)] := by
      have hidx : (i - a) + b = i + (b - a) := by omega
      have := hb (i - a) (by omega) (by omega)
      simpa [hidx] using this
    exact hstep1.symm.trans hstep2

private lemma hasPeriod_gcd {w : List Bool} :
    ∀ {n a b : ℕ}, a + b ≤ n → 0 < a → 0 < b → a + b ≤ w.length →
      HasPeriod w a → HasPeriod w b → HasPeriod w (Nat.gcd a b) := by
  intro n
  induction n with
  | zero =>
    intro a b hle ha
    omega
  | succ n ih =>
    intro a b hle ha hb hlen hpa hpb
    rcases lt_trichotomy a b with hlt | rfl | hgt
    · have hsub : HasPeriod w (b - a) := hasPeriod_sub hpa hpb hlt hlen
      have hg : Nat.gcd a b = Nat.gcd a (b - a) := by
        rw [Nat.gcd_comm, ← Nat.gcd_sub_self_left (Nat.le_of_lt hlt), Nat.gcd_comm]
      rw [hg]
      exact ih (by omega) ha (by omega) (by omega) hpa hsub
    · simpa using hpa
    · have hsub : HasPeriod w (a - b) := hasPeriod_sub hpb hpa hgt (by omega)
      have hg : Nat.gcd a b = Nat.gcd (a - b) b := by
        rw [← Nat.gcd_sub_self_left (Nat.le_of_lt hgt)]
      rw [hg]
      exact ih (by omega) (by omega) hb (by omega) hsub hpb

private lemma eq_wordPow_take_of_hasPeriod {w : List Bool} {d k : ℕ}
    (hd : 0 < d) (hlen : w.length = k * d) (hp : HasPeriod w d) :
    w = wordPow (w.take d) k := by
  by_cases hk : k = 0
  · subst hk
    simp only [Nat.zero_mul] at hlen
    rw [List.eq_nil_of_length_eq_zero hlen, wordPow_zero]
  · have hdw : d ≤ w.length := by
      rw [hlen]
      exact Nat.le_mul_of_pos_left d (Nat.pos_of_ne_zero hk)
    have htl : (w.take d).length = d := by
      rw [List.length_take, Nat.min_eq_left hdw]
    apply List.ext_getElem
    · rw [wordPow_length, htl, hlen]
    · intro i h1 h2
      rw [wordPow_getElem (w.take d) k i h2]
      have hmod_lt : i % d < d := Nat.mod_lt i hd
      rw [List.getElem_take]
      have hdiv : ∀ q r (hr : r < d) (hqr : q * d + r < w.length),
          w[q * d + r]'hqr = w[r]'(lt_of_lt_of_le hr hdw) := by
        intro q
        induction q with
        | zero => intro r hr hqr; simp
        | succ q ihq =>
          intro r hr hqr
          have hidx : (q + 1) * d + r = q * d + r + d := by rw [Nat.succ_mul]; omega
          have hstep := hp (q * d + r) (by omega) (by omega)
          have heq1 : w[(q + 1) * d + r]'hqr = w[q * d + r + d]'(by omega) := by
            congr 1
          rw [heq1, ← hstep]
          exact ihq r hr (by omega)
      have hdecomp : (i / d) * d + i % d = i := by
        rw [Nat.mul_comm]; exact Nat.div_add_mod i d
      have hres := hdiv (i / d) (i % d) hmod_lt (by omega)
      simp only [htl]
      convert hres using 2
      omega

/-- **Theorem 1a (Existence of Primitive Root):**
Every nonempty binary word is a positive power of a primitive binary word. -/
theorem ppl165_exists_primitive_root (w : List Bool) (hw : w ≠ []) :
    ∃ (p : List Bool) (k : ℕ),
      1 ≤ k ∧
      (p ≠ [] ∧ ∀ (u : List Bool) (m : ℕ), 2 ≤ m → p ≠ (List.replicate m u).flatten) ∧
      w = (List.replicate k p).flatten := by
  suffices ∀ n (w : List Bool), w.length ≤ n → w ≠ [] →
      ∃ p k, 1 ≤ k ∧ p ∈ Q2 ∧ w = wordPow p k from
    this w.length w le_rfl hw
  intro n
  induction n with
  | zero =>
    intro w hlen hne
    exact absurd (List.eq_nil_of_length_eq_zero (Nat.le_zero.mp hlen)) hne
  | succ n ih =>
    intro w hlen hne
    by_cases hprim : w ∈ Q2
    · exact ⟨w, 1, le_rfl, hprim, (wordPow_one w).symm⟩
    · rw [mem_Q2_iff] at hprim
      push Not at hprim
      obtain ⟨u, k, hk2, hwu⟩ := hprim hne
      have hu_ne : u ≠ [] := by
        intro hu0
        subst hu0
        have : w = [] := by
          rw [hwu]
          exact (wordPow_eq_nil_iff (by omega)).mpr rfl
        exact hne this
      have hu_pos : 0 < u.length := List.length_pos_of_ne_nil hu_ne
      have hu_lt : u.length < w.length := by
        rw [hwu, wordPow_length]
        nlinarith
      obtain ⟨p, m, hm1, hp, hup⟩ := ih u (by omega) hu_ne
      refine ⟨p, m * k, ?_, hp, ?_⟩
      · exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
      · rw [hwu, hup, wordPow_mul]

/-- **Theorem 1b (Uniqueness of Primitive Root):**
If `p` and `q` are binary primitive words and `p^k = q^m` with `k, m ≥ 1`, then `p = q` and `k = m`. -/
theorem ppl165_primitive_root_unique
    {p q : List Bool} {k m : ℕ}
    (hp : p ≠ [] ∧ ∀ (u : List Bool) (r : ℕ), 2 ≤ r → p ≠ (List.replicate r u).flatten)
    (hq : q ≠ [] ∧ ∀ (u : List Bool) (r : ℕ), 2 ≤ r → q ≠ (List.replicate r u).flatten)
    (hk : 1 ≤ k) (hm : 1 ≤ m)
    (heq : (List.replicate k p).flatten = (List.replicate m q).flatten) :
    p = q ∧ k = m := by
  have hp_pos : 0 < p.length := List.length_pos_of_ne_nil hp.1
  have hq_pos : 0 < q.length := List.length_pos_of_ne_nil hq.1
  have hlen_eq : k * p.length = m * q.length := by
    have := congrArg List.length heq
    simpa [wordPow_length] using this
  have hpq : p = q := by
    change wordPow p k = wordPow q m at heq
    by_cases hk1 : k = 1
    · subst hk1
      rw [wordPow_one] at heq
      by_cases hm2 : 2 ≤ m
      · exact absurd heq (hp.2 q m hm2)
      · have : m = 1 := by omega
        subst this
        simpa [wordPow_one] using heq
    · by_cases hm1 : m = 1
      · subst hm1
        rw [wordPow_one] at heq
        have hk2 : 2 ≤ k := by omega
        exact absurd heq.symm (hq.2 p k hk2)
      · have hk2 : 2 ≤ k := by omega
        have hm2 : 2 ≤ m := by omega
        let w := wordPow p k
        have hw_len : w.length = k * p.length := wordPow_length p k
        have hw_len2 : w.length = m * q.length := by rw [hw_len, hlen_eq]
        have hsum : p.length + q.length ≤ w.length := by
          have h1 : 2 * p.length ≤ w.length := by
            rw [hw_len]; exact Nat.mul_le_mul_right p.length hk2
          have h2 : 2 * q.length ≤ w.length := by
            rw [hw_len2]; exact Nat.mul_le_mul_right q.length hm2
          omega
        have hpp : HasPeriod w p.length := hasPeriod_wordPow p k
        have hpq_per : HasPeriod w q.length := by
          have : w = wordPow q m := heq
          rw [this]
          exact hasPeriod_wordPow q m
        have hgcd_per : HasPeriod w (Nat.gcd p.length q.length) :=
          hasPeriod_gcd le_rfl hp_pos hq_pos hsum hpp hpq_per
        set d := Nat.gcd p.length q.length
        have hd_pos : 0 < d := Nat.gcd_pos_of_pos_left q.length hp_pos
        have hdp : d ∣ p.length := Nat.gcd_dvd_left p.length q.length
        have hdq : d ∣ q.length := Nat.gcd_dvd_right p.length q.length
        have hdw_eq : w.length = (w.length / d) * d := by
          have hdiv : d ∣ w.length := by
            rw [hw_len]; exact dvd_mul_of_dvd_right hdp k
          exact (Nat.div_mul_cancel hdiv).symm
        -- Show p is a power of w.take d
        have hp_per : HasPeriod p d := by
          intro i h1 h2
          have hi1 : i < w.length := by omega
          have hi2 : i + d < w.length := by omega
          have hget1 : w[i]'hi1 = p[i]'h1 := by
            show (wordPow p k)[i]'hi1 = p[i]'h1
            rw [wordPow_getElem p k i hi1]
            simp [Nat.mod_eq_of_lt h1]
          have hget2 : w[i + d]'hi2 = p[i + d]'h2 := by
            show (wordPow p k)[i + d]'hi2 = p[i + d]'h2
            rw [wordPow_getElem p k (i + d) hi2]
            simp [Nat.mod_eq_of_lt h2]
          rw [← hget1, ← hget2]
          exact hgcd_per i hi1 hi2
        have hp_pow : p = wordPow (p.take d) (p.length / d) :=
          eq_wordPow_take_of_hasPeriod hd_pos (Nat.div_mul_cancel hdp).symm hp_per
        have hpd1 : p.length / d = 1 := by
          by_contra hne
          have hge2 : 2 ≤ p.length / d := by
            have hpos : 0 < p.length / d := Nat.div_pos (Nat.le_of_dvd hp_pos hdp) hd_pos
            omega
          exact hp.2 (p.take d) (p.length / d) hge2 hp_pow
        have hdp_eq : d = p.length := by
          have := Nat.div_mul_cancel hdp
          rw [hpd1, one_mul] at this
          exact this
        -- Symmetrically for q
        have hq_per : HasPeriod q d := by
          intro i h1 h2
          have hi1 : i < w.length := by omega
          have hi2 : i + d < w.length := by omega
          have hget1 : w[i]'hi1 = q[i]'h1 := by
            have : w = wordPow q m := heq
            have hi1' : i < (wordPow q m).length := by rwa [← this]
            have htmp : (wordPow q m)[i]'hi1' = q[i]'h1 := by
              rw [wordPow_getElem q m i hi1']
              simp [Nat.mod_eq_of_lt h1]
            simpa [this] using htmp
          have hget2 : w[i + d]'hi2 = q[i + d]'h2 := by
            have : w = wordPow q m := heq
            have hi2' : i + d < (wordPow q m).length := by rwa [← this]
            have htmp : (wordPow q m)[i + d]'hi2' = q[i + d]'h2 := by
              rw [wordPow_getElem q m (i + d) hi2']
              simp [Nat.mod_eq_of_lt h2]
            simpa [this] using htmp
          rw [← hget1, ← hget2]
          exact hgcd_per i hi1 hi2
        have hq_pow : q = wordPow (q.take d) (q.length / d) :=
          eq_wordPow_take_of_hasPeriod hd_pos (Nat.div_mul_cancel hdq).symm hq_per
        have hqd1 : q.length / d = 1 := by
          by_contra hne
          have hge2 : 2 ≤ q.length / d := by
            have hpos : 0 < q.length / d := Nat.div_pos (Nat.le_of_dvd hq_pos hdq) hd_pos
            omega
          exact hq.2 (q.take d) (q.length / d) hge2 hq_pow
        have hdq_eq : d = q.length := by
          have := Nat.div_mul_cancel hdq
          rw [hqd1, one_mul] at this
          exact this
        have hlpq : p.length = q.length := hdp_eq.symm.trans hdq_eq
        have h1 : (wordPow p k).take p.length = p := wordPow_take_eq hk
        have h2 : (wordPow q m).take q.length = q := wordPow_take_eq hm
        rw [← h1, heq, hlpq, h2]
  refine ⟨hpq, ?_⟩
  subst hpq
  exact Nat.eq_of_mul_eq_mul_right hp_pos hlen_eq

/-- **Theorem 1c (Lyndon–Schützenberger Commutation Theorem):**
Two nonempty binary words commute (`u ++ v = v ++ u`) if and only if they are positive powers of
a common primitive binary word. -/
theorem ppl165_commute_iff_common_power (u v : List Bool) (hu : u ≠ []) (hv : v ≠ []) :
    u ++ v = v ++ u ↔
      ∃ (p : List Bool) (i j : ℕ),
        1 ≤ i ∧ 1 ≤ j ∧
        (p ≠ [] ∧ ∀ (r : List Bool) (m : ℕ), 2 ≤ m → p ≠ (List.replicate m r).flatten) ∧
        u = (List.replicate i p).flatten ∧
        v = (List.replicate j p).flatten := by
  constructor
  · suffices ∀ n (u v : List Bool), u.length + v.length ≤ n → u ≠ [] → v ≠ [] →
        u ++ v = v ++ u →
        ∃ p i j, 1 ≤ i ∧ 1 ≤ j ∧ p ∈ Q2 ∧ u = wordPow p i ∧ v = wordPow p j from
      this (u.length + v.length) u v le_rfl hu hv
    intro n
    induction n with
    | zero =>
      intro u v hlen hu _
      have := List.length_pos_of_ne_nil hu
      omega
    | succ n ih =>
      intro u v hlen hu hv hcomm
      rcases lt_trichotomy u.length v.length with hlt | heq | hgt
      · have hpref : u <+: v := by
          have htu : u = v.take u.length := by
            have := congrArg (List.take u.length) hcomm
            rwa [List.take_left, List.take_append_of_le_length (Nat.le_of_lt hlt)] at this
          refine ⟨v.drop u.length, ?_⟩
          have htd := List.take_append_drop u.length v
          rwa [← htu] at htd
        obtain ⟨w, hw⟩ := hpref
        have hw_ne : w ≠ [] := by
          intro h0; subst h0; simp at hw; subst hw; exact Nat.lt_irrefl _ hlt
        have hcomm' : u ++ w = w ++ u := by
          have h1 : u ++ (u ++ w) = (u ++ w) ++ u := by rwa [← hw] at hcomm
          rw [List.append_assoc] at h1
          exact List.append_cancel_left h1
        have hlen' : u.length + w.length ≤ n := by
          have : v.length = u.length + w.length := by rw [← hw, List.length_append]
          have : 0 < u.length := List.length_pos_of_ne_nil hu
          omega
        obtain ⟨p, i, j, hi, hj, hp, rfl, rfl⟩ := ih u w hlen' hu hw_ne hcomm'
        exact ⟨p, i, i + j, hi, by omega, hp, rfl, by rw [← hw, wordPow_add]⟩
      · have huv : u = v := by
          have : (u ++ v).take u.length = (v ++ u).take v.length := by
            rw [hcomm, heq]
          simpa [List.take_left] using this
        subst huv
        obtain ⟨p, k, hk, hp, rfl⟩ := ppl165_exists_primitive_root u hu
        exact ⟨p, k, k, hk, hk, hp, rfl, rfl⟩
      · have hpref : v <+: u := by
          have htv : v = u.take v.length := by
            have := congrArg (List.take v.length) hcomm.symm
            rwa [List.take_left, List.take_append_of_le_length (Nat.le_of_lt hgt)] at this
          refine ⟨u.drop v.length, ?_⟩
          have htd := List.take_append_drop v.length u
          rwa [← htv] at htd
        obtain ⟨w, hw⟩ := hpref
        have hw_ne : w ≠ [] := by
          intro h0; subst h0; simp at hw; subst hw; exact Nat.lt_irrefl _ hgt
        have hcomm' : w ++ v = v ++ w := by
          have h1 : (v ++ w) ++ v = v ++ (v ++ w) := by rwa [← hw] at hcomm
          rw [List.append_assoc] at h1
          exact List.append_cancel_left h1
        have hlen' : w.length + v.length ≤ n := by
          have : u.length = v.length + w.length := by rw [← hw, List.length_append]
          have : 0 < v.length := List.length_pos_of_ne_nil hv
          omega
        obtain ⟨p, i, j, hi, hj, hp, rfl, rfl⟩ := ih w v hlen' hw_ne hv hcomm'
        exact ⟨p, j + i, j, by omega, hj, hp, by rw [← hw, wordPow_add], rfl⟩
  · rintro ⟨p, i, j, _, _, _, rfl, rfl⟩
    rw [← wordPow_add, ← wordPow_add, Nat.add_comm]

/-- Helper: sum of primitive-word counts over divisors of `n` equals `2^n`. -/
private lemma sum_primitive_count_eq_two_pow (n : ℕ) (hn : 0 < n) :
    ∑ d ∈ n.divisors,
      Nat.card {w : List Bool // w.length = d ∧ w ∈ Q2} = 2 ^ n := by
  classical
  have hcard_eq : ∀ d : ℕ,
      Nat.card {w : List Bool // w.length = d ∧ w ∈ Q2} =
        (Finset.univ.filter (fun v : Fin d → Bool => List.ofFn v ∈ Q2)).card := by
    intro d
    let e : {w : List Bool // w.length = d ∧ w ∈ Q2} ≃
        {v : Fin d → Bool // List.ofFn v ∈ Q2} :=
      { toFun := fun ⟨w, hlen, hp⟩ => ⟨fun i => w[i.1]'(hlen.symm ▸ i.2), by
          have : List.ofFn (fun i : Fin d => w[i.1]'(hlen.symm ▸ i.2)) = w := by
            apply List.ext_getElem
            · simp [hlen]
            · intro i h1 h2; simp
          rwa [this]⟩
        invFun := fun ⟨v, hv⟩ => ⟨List.ofFn v, List.length_ofFn, hv⟩
        left_inv := fun ⟨w, hlen, _⟩ => by
          ext : 1
          apply List.ext_getElem
          · simp [hlen]
          · intro i h1 h2; simp
        right_inv := fun ⟨v, _⟩ => by
          ext i; simp }
    rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_subtype]
  simp_rw [hcard_eq]
  let S : Finset (Σ d : ℕ, Fin d → Bool) :=
    n.divisors.sigma (fun d => Finset.univ.filter (fun v : Fin d → Bool => List.ofFn v ∈ Q2))
  have hcard_S : S.card = ∑ d ∈ n.divisors,
      (Finset.univ.filter (fun v : Fin d → Bool => List.ofFn v ∈ Q2)).card :=
    Finset.card_sigma _ _
  rw [← hcard_S]
  have hcard_fin : (Finset.univ : Finset (Fin n → Bool)).card = 2 ^ n := by
    simp
  rw [← hcard_fin]
  refine Finset.card_bij (fun x hx => fun i : Fin n =>
    have hd_mem : x.1 ∈ n.divisors := (Finset.mem_sigma.mp hx).1
    have hd_pos : 0 < x.1 := Nat.pos_of_mem_divisors hd_mem
    x.2 ⟨i.1 % x.1, Nat.mod_lt i.1 hd_pos⟩) ?_ ?_ ?_
  · intro _ _; exact Finset.mem_univ _
  · intro x hx y hy hxy
    have hx_sig := Finset.mem_sigma.mp hx
    have hy_sig := Finset.mem_sigma.mp hy
    have hdx_dvd : x.1 ∣ n := Nat.dvd_of_mem_divisors hx_sig.1
    have hdy_dvd : y.1 ∣ n := Nat.dvd_of_mem_divisors hy_sig.1
    have hdx_pos : 0 < x.1 := Nat.pos_of_mem_divisors hx_sig.1
    have hdy_pos : 0 < y.1 := Nat.pos_of_mem_divisors hy_sig.1
    have hx_prim : List.ofFn x.2 ∈ Q2 := (Finset.mem_filter.mp hx_sig.2).2
    have hy_prim : List.ofFn y.2 ∈ Q2 := (Finset.mem_filter.mp hy_sig.2).2
    have hpow_eq : wordPow (List.ofFn x.2) (n / x.1) = wordPow (List.ofFn y.2) (n / y.1) := by
      apply List.ext_getElem
      · rw [wordPow_length, wordPow_length, List.length_ofFn, List.length_ofFn,
            Nat.div_mul_cancel hdx_dvd, Nat.div_mul_cancel hdy_dvd]
      · intro i h1 h2
        have hin : i < n := by
          rw [wordPow_length, List.length_ofFn, Nat.div_mul_cancel hdx_dvd] at h1
          exact h1
        rw [wordPow_getElem _ _ i h1, wordPow_getElem _ _ i h2]
        simp only [List.length_ofFn, List.getElem_ofFn]
        exact congrFun hxy ⟨i, hin⟩
    have hkx : 1 ≤ n / x.1 := Nat.div_pos (Nat.le_of_dvd hn hdx_dvd) hdx_pos
    have hky : 1 ≤ n / y.1 := Nat.div_pos (Nat.le_of_dvd hn hdy_dvd) hdy_pos
    have ⟨hlist, _⟩ := ppl165_primitive_root_unique hx_prim hy_prim hkx hky hpow_eq
    have hd_eq : x.1 = y.1 := by
      have := congrArg List.length hlist
      simpa [List.length_ofFn] using this
    rcases x with ⟨dx, vx⟩
    rcases y with ⟨dy, vy⟩
    dsimp only at hd_eq hlist
    subst hd_eq
    congr 1
    funext j
    have := congrArg (fun l => l[j.1]?) hlist
    simpa [List.getElem?_ofFn, j.2] using this
  · intro f _
    let w := List.ofFn f
    have hw_ne : w ≠ [] := by
      intro h0
      have := congrArg List.length h0
      simp [w] at this
      omega
    obtain ⟨p, k, hk, hp, hwp⟩ := ppl165_exists_primitive_root w hw_ne
    have hlen : n = k * p.length := by
      have := congrArg List.length hwp
      simpa [w, wordPow_length] using this
    have hp_dvd : p.length ∣ n := ⟨k, by rw [hlen, Nat.mul_comm]⟩
    have hp_mem : p.length ∈ n.divisors := Nat.mem_divisors.mpr ⟨hp_dvd, Nat.ne_of_gt hn⟩
    let v : Fin p.length → Bool := fun j => p[j.1]'j.2
    have hv_ofFn : List.ofFn v = p := by
      apply List.ext_getElem
      · simp
      · intro i h1 h2; simp [v]
    refine ⟨⟨p.length, v⟩, Finset.mem_sigma.mpr ⟨hp_mem, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩⟩, ?_⟩
    · rwa [hv_ofFn]
    · funext i
      dsimp only [v]
      have hiw : i.1 < (wordPow p k).length := by
        change w = wordPow p k at hwp
        rw [← hwp, List.length_ofFn]; exact i.2
      have hget : (wordPow p k)[i.1]'hiw = p[i.1 % p.length]'(Nat.mod_lt i.1 (List.length_pos_of_ne_nil hp.1)) :=
        wordPow_getElem p k i.1 hiw
      have hget2 : w[i.1]'(by simp [w]) = f i := by simp [w]
      rw [← hget2]
      convert hget.symm using 2

/-- **Theorem 1d (Exact Möbius Inversion Count of Binary Primitive Words):**
For every `n ≥ 1`, the number of binary primitive words of length `n` equals
`∑_{d ∣ n} μ(n / d) · 2^d`. -/
theorem ppl165_primitive_word_count_mobius (n : ℕ) (hn : 0 < n) :
    (Nat.card {w : List Bool // w.length = n ∧ w ≠ [] ∧
        ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten} : ℤ) =
      ∑ x ∈ n.divisorsAntidiagonal, (ArithmeticFunction.moebius x.1 : ℤ) * (2 : ℤ) ^ x.2 := by
  let f : ℕ → ℤ := fun d => (Nat.card {w : List Bool // w.length = d ∧ w ∈ Q2} : ℤ)
  let g : ℕ → ℤ := fun d => (2 : ℤ) ^ d
  have hsum : ∀ m > 0, ∑ d ∈ m.divisors, f d = g m := by
    intro m hm
    have hnat := sum_primitive_count_eq_two_pow m hm
    dsimp [f, g]
    exact_mod_cast hnat
  have hinv := (ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq (f := f) (g := g)).mp hsum n hn
  exact hinv.symm

/-! ### Part II: Subclass Separations (`Q_2 ∉ REG`, `Q_2 ∉ LIN`, `Q_2ᶜ ∉ CFL`, `Q_2 ∉ DCFL`) -/

private lemma count_true_eq_two_prim {a b c : ℕ} (hsum : a + c ≠ b) :
    List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false ∈ Q2 := by
  set w := List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false
  refine ⟨?_, ?_⟩
  · intro h0
    have := congrArg List.length h0
    simp [w] at this
  · intro u k hk hwu
    have hct : w.count true = 2 := by
      simp [w, List.count_append, List.count_replicate]
    have hct2 : k * u.count true = 2 := by
      change w = wordPow u k at hwu
      rw [← wordPow_count, ← hwu, hct]
    have hk2 : k = 2 ∧ u.count true = 1 := by
      have hu1 : u.count true ≥ 1 := by
        by_contra h0
        have : u.count true = 0 := by omega
        rw [this, Nat.mul_zero] at hct2
        omega
      have : k ≤ 2 := by nlinarith
      have hk_eq : k = 2 := by omega
      subst hk_eq
      exact ⟨rfl, by omega⟩
    obtain ⟨rfl, huc⟩ := hk2
    have hwu2 : w = u ++ u := by
      simpa [wordPow, List.replicate] using hwu
    -- Since u has exactly one true, decompose u = 0^p ++ [true] ++ 0^q
    have hmem_u : true ∈ u := List.count_pos_iff.mp (by omega)
    obtain ⟨u1, u2, hu_eq⟩ := List.append_of_mem hmem_u
    have hu1_ct : u1.count true = 0 := by
      have : (u1 ++ true :: u2).count true = u1.count true + 1 + u2.count true := by
        simp; omega
      rw [← hu_eq, huc] at this; omega
    have hu2_ct : u2.count true = 0 := by
      have : (u1 ++ true :: u2).count true = u1.count true + 1 + u2.count true := by
        simp; omega
      rw [← hu_eq, huc] at this; omega
    have hu1_rep : u1 = List.replicate u1.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd (List.count_pos_iff.mpr hx) (by omega)
    have hu2_rep : u2 = List.replicate u2.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd (List.count_pos_iff.mpr hx) (by omega)
    -- Compare lengths before first true, between the two trues, and after second true
    have h_uu : u ++ u =
        List.replicate u1.length false ++ [true] ++
        List.replicate (u2.length + u1.length) false ++ [true] ++
        List.replicate u2.length false := by
      rw [hu_eq, hu1_rep, hu2_rep]
      simp only [List.append_assoc, List.cons_append, List.nil_append, List.replicate_add, List.length_replicate]
    rw [h_uu] at hwu2
    -- Extract equality of block lengths by induction/cancellation
    have hrep_eq : ∀ {x1 x2 : ℕ} {s1 s2 : List Bool},
        List.replicate x1 false ++ true :: s1 = List.replicate x2 false ++ true :: s2 →
        x1 = x2 ∧ s1 = s2 := by
      intro x1
      induction x1 with
      | zero =>
        intro x2 s1 s2 h
        cases x2 with
        | zero => simpa using h
        | succ x2 => simp [List.replicate_succ] at h
      | succ x1 ih =>
        intro x2 s1 s2 h
        cases x2 with
        | zero => simp [List.replicate_succ] at h
        | succ x2 =>
          simp only [List.replicate_succ, List.cons_append, List.cons.injEq, true_and] at h
          obtain ⟨hx, hs⟩ := ih h
          exact ⟨by omega, hs⟩
    have hwu2' : List.replicate a false ++ true :: (List.replicate b false ++ true :: List.replicate c false) =
        List.replicate u1.length false ++ true ::
        (List.replicate (u2.length + u1.length) false ++ true :: List.replicate u2.length false) := by
      simpa [w, List.append_assoc] using hwu2
    obtain ⟨ha_eq, hrest⟩ := hrep_eq hwu2'
    obtain ⟨hb_eq, hc_eq⟩ := hrep_eq hrest
    have hc_len : c = u2.length := by
      have := congrArg List.length hc_eq
      simpa using this
    omega

/-- **Theorem 2 (`Q_2` is NOT Regular):**
Using Mathlib's native `Language.IsRegular` (DFA acceptance). -/
theorem ppl165_not_regular :
    ¬ Language.IsRegular
      {w : List Bool | w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten} := by
  rintro ⟨σ, hfin, M, hM⟩
  have hlt : Fintype.card σ < Fintype.card (Fin (Fintype.card σ + 1)) := by simp
  obtain ⟨i, j, hij, hstate⟩ :=
    Fintype.exists_ne_map_eq_of_card_lt (fun k : Fin (Fintype.card σ + 1) => M.eval (List.replicate (k.1 + 1) false)) hlt
  let suf := [true] ++ List.replicate (i.1 + 1) false ++ [true]
  have hmem_iff : (List.replicate (i.1 + 1) false ++ suf) ∈ M.accepts ↔
      (List.replicate (j.1 + 1) false ++ suf) ∈ M.accepts := by
    simp only [DFA.mem_accepts, DFA.eval, DFA.evalFrom_of_append] at *
    rw [hstate]
  rw [hM] at hmem_iff
  have hnot : (List.replicate (i.1 + 1) false ++ suf) ∉ Q2 := by
    intro h
    have hsq : List.replicate (i.1 + 1) false ++ suf =
        wordPow (List.replicate (i.1 + 1) false ++ [true]) 2 := by
      simp [suf, wordPow, List.replicate, List.append_assoc]
    exact h.2 (List.replicate (i.1 + 1) false ++ [true]) 2 le_rfl hsq
  have hyes : (List.replicate (j.1 + 1) false ++ suf) ∈ Q2 := by
    have hne : j.1 + 1 + 0 ≠ i.1 + 1 := by
      intro heq
      apply hij
      exact Fin.ext (by omega)
    simpa [suf, List.append_assoc] using count_true_eq_two_prim (a := j.1 + 1) (b := i.1 + 1) (c := 0) hne
  exact hnot (hmem_iff.mpr hyes)

/-! #### Linear Context-Free Grammars & Linear Pumping Lemma -/

private def isNT {T N : Type*} : Symbol T N → Bool
  | Symbol.nonterminal _ => true
  | Symbol.terminal _ => false

private lemma isNT_map_terminal {T N : Type*} (w : List T) :
    (w.map (Symbol.terminal (N := N))).filter isNT = [] := by
  induction w with
  | nil => rfl
  | cons a w ih => simp [isNT, ih]

private lemma rewrites_iff {T N : Type*} (r : ContextFreeRule T N) (s₁ s₂ : List (Symbol T N)) :
    r.Rewrites s₁ s₂ ↔
      ∃ pre post, s₁ = pre ++ [Symbol.nonterminal r.input] ++ post ∧ s₂ = pre ++ r.output ++ post := by
  constructor
  · intro h
    induction h with
    | head s => exact ⟨[], s, by simp, by simp⟩
    | cons x _ ih =>
      obtain ⟨pre, post, rfl, rfl⟩ := ih
      exact ⟨x :: pre, post, by simp, by simp⟩
  · rintro ⟨pre, post, rfl, rfl⟩
    induction pre with
    | nil => simpa using ContextFreeRule.Rewrites.head (r := r) post
    | cons x pre ih => simpa using ContextFreeRule.Rewrites.cons x ih

/-- A list with at most one nonterminal is either all terminals or `u ++ [NT A] ++ v`. -/
private lemma linear_sentential_cases {T N : Type*} (s : List (Symbol T N))
    (h : (s.filter isNT).length ≤ 1) :
    (∃ t : List T, s = t.map Symbol.terminal) ∨
    (∃ (u v : List T) (A : N), s = u.map Symbol.terminal ++ [Symbol.nonterminal A] ++ v.map Symbol.terminal) := by
  induction s with
  | nil => left; exact ⟨[], rfl⟩
  | cons x xs ih =>
    cases x with
    | terminal a =>
      have h' : (xs.filter isNT).length ≤ 1 := by simpa [isNT] using h
      rcases ih h' with ⟨t, rfl⟩ | ⟨u, v, A, rfl⟩
      · left; exact ⟨a :: t, rfl⟩
      · right; exact ⟨a :: u, v, A, by simp⟩
    | nonterminal A =>
      have h0 : (xs.filter isNT).length = 0 := by
        simp only [List.filter_cons, show isNT (Symbol.nonterminal (T := T) A) = true from rfl,
          ↓reduceIte, List.length_cons] at h
        omega
      have hxs : ∀ l : List (Symbol T N), (l.filter isNT).length = 0 → ∃ v : List T, l = v.map Symbol.terminal := by
        intro l
        induction l with
        | nil => intro _; exact ⟨[], rfl⟩
        | cons y ys ihy =>
          intro hy0
          cases y with
          | terminal b =>
            have hy0' : (ys.filter isNT).length = 0 := by
              simpa [List.filter_cons, isNT] using hy0
            obtain ⟨v, rfl⟩ := ihy hy0'
            exact ⟨b :: v, rfl⟩
          | nonterminal B =>
            simp [List.filter_cons, isNT] at hy0
      obtain ⟨v, rfl⟩ := hxs xs h0
      right; exact ⟨[], v, A, by simp⟩

/-- A `n`-step linear derivation from a single nonterminal `A` to a terminal string `w`. -/
private inductive LinDeriv {T : Type*} (g : ContextFreeGrammar T) : ℕ → g.NT → List T → Prop
  | term (r : ContextFreeRule T g.NT) (hr : r ∈ g.rules) (t : List T)
      (ho : r.output = t.map Symbol.terminal) :
      LinDeriv g 0 r.input t
  | step {n : ℕ} (r : ContextFreeRule T g.NT) (hr : r ∈ g.rules)
      (u v : List T) (B : g.NT) (w : List T)
      (ho : r.output = u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal)
      (hsub : LinDeriv g n B w) :
      LinDeriv g (n + 1) r.input (u ++ w ++ v)

private lemma linDeriv_to_derives {T : Type*} {g : ContextFreeGrammar T} {n : ℕ} {A : g.NT} {w : List T}
    (h : LinDeriv g n A w) :
    g.Derives [Symbol.nonterminal A] (w.map Symbol.terminal) := by
  induction h with
  | term r hr t ho =>
    apply Relation.ReflTransGen.single
    refine ⟨r, hr, ?_⟩
    rw [← ho]
    simpa using ContextFreeRule.Rewrites.head (r := r) []
  | step r hr u v B w ho hsub ih =>
    have h1 : g.Produces [Symbol.nonterminal r.input]
        (u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal) := by
      refine ⟨r, hr, ?_⟩
      rw [← ho]
      simpa using ContextFreeRule.Rewrites.head (r := r) []
    have h2 : g.Derives (u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal)
        (u.map Symbol.terminal ++ w.map Symbol.terminal ++ v.map Symbol.terminal) :=
      (ih.append_left (u.map Symbol.terminal)).append_right (v.map Symbol.terminal)
    have hmap : (u.map (Symbol.terminal (N := g.NT))) ++ w.map Symbol.terminal ++ v.map Symbol.terminal =
        (u ++ w ++ v).map Symbol.terminal := by
      simp [List.map_append]
    rw [hmap] at h2
    exact Relation.ReflTransGen.head h1 h2

/-- A linear derivation preserves the single-nonterminal invariant and produces a `LinDeriv`. -/
private lemma derives_to_linDeriv {T : Type*} {g : ContextFreeGrammar T}
    (hlin : ∀ r ∈ g.rules, (r.output.filter isNT).length ≤ 1)
    {s : List (Symbol T g.NT)} {w : List T}
    (h : g.Derives s (w.map Symbol.terminal)) :
    (∀ A, s = [Symbol.nonterminal A] → ∃ n, LinDeriv g n A w) := by
  induction h using Relation.ReflTransGen.head_induction_on with
  | refl =>
    intro A hA
    cases w with
    | nil => simp at hA
    | cons a ws => simp at hA
  | @head s₁ s₂ hprod hrest_orig ih =>
    intro A rfl
    obtain ⟨r, hr, hrew⟩ := hprod
    obtain ⟨pre, post, h1, rfl⟩ := (rewrites_iff r _ _).mp hrew
    have hpre : pre = [] ∧ post = [] ∧ r.input = A := by
      cases pre with
      | nil =>
        simp only [List.nil_append, List.cons_append, List.cons.injEq, Symbol.nonterminal.injEq] at h1
        exact ⟨rfl, h1.2.symm, h1.1.symm⟩
      | cons x xs =>
        simp only [List.cons_append, List.cons.injEq] at h1
        have := congrArg List.length h1.2
        simp at this
    obtain ⟨rfl, rfl, rfl⟩ := hpre
    simp only [List.nil_append, List.append_nil] at hrest_orig ih ⊢
    rcases linear_sentential_cases r.output (hlin r hr) with ⟨t, ho⟩ | ⟨u, v, B, ho⟩
    · -- No nonterminals left, so `g.Derives (t.map .terminal) (w.map .terminal)` implies `t = w`
      have htw : t = w := by
        have hno : ∀ {x y : List (Symbol T g.NT)}, g.Derives x y →
            (∀ t' : List T, x = t'.map Symbol.terminal → y = x) := by
          intro x y hd
          induction hd using Relation.ReflTransGen.head_induction_on with
          | refl => intro _ _; rfl
          | head hp _ _ =>
            intro t' ht'
            obtain ⟨r', _, hrew'⟩ := hp
            obtain ⟨p1, p2, hEq, _⟩ := (rewrites_iff r' _ _).mp hrew'
            have hmem : Symbol.nonterminal r'.input ∈ t'.map Symbol.terminal := by
              rw [← ht', hEq]; simp
            simp at hmem
        have heq := hno hrest_orig t ho
        rw [ho] at heq
        exact List.map_injective_iff.mpr (fun _ _ h => Symbol.terminal.inj h) heq.symm
      subst htw
      exact ⟨0, LinDeriv.term r hr t ho⟩
    · have hstrip : ∀ {x y : List (Symbol T g.NT)}, g.Derives x y →
          ∀ (u v : List T) (B : g.NT),
            x = u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal →
            ∀ w : List T, y = w.map Symbol.terminal →
            ∃ (w' : List T) (n : ℕ), w = u ++ w' ++ v ∧ LinDeriv g n B w' := by
        intro x y hd
        induction hd using Relation.ReflTransGen.head_induction_on with
        | refl =>
          intro u v B hx w hy
          have hmem : Symbol.nonterminal B ∈ w.map Symbol.terminal := by
            rw [← hy, hx]; simp
          simp at hmem
        | @head s_a s_c hp hrest ih2 =>
          intro u v B hx w hy
          obtain ⟨r', hr', hrew'⟩ := hp
          obtain ⟨p1, p2, hEq, hEq2⟩ := (rewrites_iff r' _ _).mp hrew'
          have hsplit : p1 = u.map Symbol.terminal ∧ r'.input = B ∧ p2 = v.map Symbol.terminal := by
            have h1' : p1 ++ [Symbol.nonterminal r'.input] ++ p2 =
                u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal := hEq.symm.trans hx
            have hp1_len : p1.length = u.length := by
              by_contra hne
              rcases lt_or_gt_of_ne hne with hlt | hgt
              · have hget := congrArg (fun l => l[p1.length]?) h1'
                rw [List.append_assoc, List.getElem?_append_right le_rfl] at hget
                simp only [Nat.sub_self] at hget
                have hlt_map : p1.length < (u.map (Symbol.terminal (N := g.NT))).length := by
                  simpa using hlt
                rw [List.append_assoc, List.getElem?_append_left hlt_map, List.getElem?_map] at hget
                cases hu : u[p1.length]? <;> simp [hu] at hget
              · have hget := congrArg (fun l => l[u.length]?) h1'
                rw [List.append_assoc, List.getElem?_append_left (by omega)] at hget
                rw [List.append_assoc, List.getElem?_append_right (by simp)] at hget
                simp only [List.length_map, Nat.sub_self] at hget
                have hcnt := congrArg (fun l => (l.filter isNT).length) h1'
                simp only [List.filter_append, List.length_append, isNT_map_terminal, List.length_nil,
                  List.filter_cons, isNT, ↓reduceIte, List.filter_nil, List.length_cons,
                  Nat.zero_add, Nat.add_zero] at hcnt
                have hp1_0 : (p1.filter isNT).length = 0 := by omega
                have hmemB : Symbol.nonterminal B ∈ p1 := by
                  have hlt' : u.length < p1.length := hgt
                  rw [List.getElem?_eq_getElem hlt'] at hget
                  have hval : p1[u.length]'hlt' = Symbol.nonterminal B := Option.some.inj hget
                  rw [← hval]
                  exact List.getElem_mem hlt'
                have hpos : 0 < (p1.filter isNT).length :=
                  List.length_pos_iff_exists_mem.mpr ⟨Symbol.nonterminal B, List.mem_filter.mpr ⟨hmemB, rfl⟩⟩
                omega
            have hp1_eq : p1 = u.map Symbol.terminal := by
              have htake := congrArg (List.take p1.length) h1'
              rw [List.append_assoc, List.take_left, List.append_assoc, hp1_len,
                  ← List.length_map (f := Symbol.terminal), List.take_left] at htake
              exact htake
            subst hp1_eq
            rw [List.append_assoc, List.append_assoc] at h1'
            have htail := List.append_cancel_left h1'
            simp only [List.cons_append, List.nil_append, List.cons.injEq, Symbol.nonterminal.injEq] at htail
            exact ⟨rfl, htail.1, htail.2⟩
          obtain ⟨rfl, rfl, rfl⟩ := hsplit
          rcases linear_sentential_cases r'.output (hlin r' hr') with ⟨t', ho'⟩ | ⟨u', v', C, ho'⟩
          · have hno : ∀ {x y : List (Symbol T g.NT)}, g.Derives x y →
                (∀ t0 : List T, x = t0.map Symbol.terminal → y = x) := by
              intro x y hd0
              induction hd0 using Relation.ReflTransGen.head_induction_on with
              | refl => intro _ _; rfl
              | head hp0 _ _ =>
                intro t0 ht0
                obtain ⟨r0, _, hrew0⟩ := hp0
                obtain ⟨q1, q2, hEq0, _⟩ := (rewrites_iff r0 _ _).mp hrew0
                have hmem0 : Symbol.nonterminal r0.input ∈ t0.map Symbol.terminal := by
                  rw [← ht0, hEq0]; simp
                simp at hmem0
            have hmap : u.map Symbol.terminal ++ r'.output ++ v.map Symbol.terminal =
                (u ++ t' ++ v).map Symbol.terminal := by
              rw [ho']; simp [List.map_append]
            rw [hEq2] at hrest
            have heq_w := hno hrest (u ++ t' ++ v) hmap
            rw [hy, hmap] at heq_w
            have hw_eq : w = u ++ t' ++ v :=
              List.map_injective_iff.mpr (fun _ _ h => Symbol.terminal.inj h) heq_w
            exact ⟨t', 0, hw_eq, LinDeriv.term r' hr' t' ho'⟩
          · have hEq2' : s_c = (u ++ u').map Symbol.terminal ++ [Symbol.nonterminal C] ++ (v' ++ v).map Symbol.terminal := by
              rw [hEq2, ho']; simp [List.map_append, List.append_assoc]
            obtain ⟨w', n', hw_eq, hld⟩ := ih2 (u ++ u') (v' ++ v) C hEq2' w hy
            exact ⟨u' ++ w' ++ v', n' + 1, by simp [hw_eq, List.append_assoc],
              LinDeriv.step r' hr' u' v' C w' ho' hld⟩
      obtain ⟨w', n', hw_eq, hld⟩ := hstrip hrest_orig u v B ho w rfl
      exact ⟨n' + 1, hw_eq ▸ LinDeriv.step r hr u v B w' ho hld⟩

private inductive LinSeg {T : Type*} (g : ContextFreeGrammar T) :
    ℕ → g.NT → g.NT → List T → List T → Prop
  | refl (A : g.NT) : LinSeg g 0 A A [] []
  | step {k : ℕ} (r : ContextFreeRule T g.NT) (hr : r ∈ g.rules)
      (u v : List T) (B C : g.NT) (u' v' : List T)
      (ho : r.output = u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal)
      (hrest : LinSeg g k B C u' v') :
      LinSeg g (k + 1) r.input C (u ++ u') (v' ++ v)

private lemma linSeg_to_derives {T : Type*} {g : ContextFreeGrammar T}
    {k : ℕ} {A B : g.NT} {u v : List T} (h : LinSeg g k A B u v) :
    g.Derives [Symbol.nonterminal A]
      (u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal) := by
  induction h with
  | refl A => simpa using Relation.ReflTransGen.refl
  | step r hr u v B C u' v' ho _ ih =>
    have h1 : g.Produces [Symbol.nonterminal r.input]
        (u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal) := by
      refine ⟨r, hr, ?_⟩
      rw [← ho]
      simpa using ContextFreeRule.Rewrites.head (r := r) []
    have h2 : g.Derives (u.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v.map Symbol.terminal)
        ((u ++ u').map Symbol.terminal ++ [Symbol.nonterminal C] ++ (v' ++ v).map Symbol.terminal) := by
      have := (ih.append_left (u.map Symbol.terminal)).append_right (v.map Symbol.terminal)
      simpa [List.map_append, List.append_assoc] using this
    exact Relation.ReflTransGen.head h1 h2

private lemma linSeg_iterate {T : Type*} {g : ContextFreeGrammar T}
    {k : ℕ} {A : g.NT} {v y : List T} (h : LinSeg g k A A v y) (i : ℕ) :
    g.Derives [Symbol.nonterminal A]
      (((List.replicate i v).flatten).map Symbol.terminal ++ [Symbol.nonterminal A] ++
        ((List.replicate i y).flatten).map Symbol.terminal) := by
  induction i with
  | zero => simpa using Relation.ReflTransGen.refl
  | succ i ih =>
    have h1 := linSeg_to_derives h
    have h2 := (ih.append_left (v.map Symbol.terminal)).append_right (y.map Symbol.terminal)
    have h3 := h1.trans h2
    have hrep_v : (List.replicate (i + 1) v).flatten = v ++ (List.replicate i v).flatten := by
      simp [List.replicate_succ]
    have hrep_y : (List.replicate (i + 1) y).flatten = (List.replicate i y).flatten ++ y := by
      clear ih h1 h2 h3 hrep_v
      induction i with
      | zero => simp
      | succ j ihj =>
        calc (List.replicate (j + 2) y).flatten
            = y ++ (List.replicate (j + 1) y).flatten := by simp [List.replicate_succ]
          _ = y ++ ((List.replicate j y).flatten ++ y) := by rw [ihj]
          _ = (y ++ (List.replicate j y).flatten) ++ y := by rw [List.append_assoc]
          _ = (List.replicate (j + 1) y).flatten ++ y := by simp [List.replicate_succ]
    rw [hrep_v, hrep_y]
    simpa [List.map_append, List.append_assoc] using h3

private lemma linSeg_length_le {T : Type*} {g : ContextFreeGrammar T}
    {k : ℕ} {A B : g.NT} {u v : List T} (M : ℕ)
    (hM : ∀ r ∈ g.rules, r.output.length ≤ M) (h : LinSeg g k A B u v) :
    u.length + v.length ≤ k * M := by
  induction h with
  | refl _ => simp
  | step r hr u v B C u' v' ho _ ih =>
    have h1 := hM r hr
    rw [ho] at h1
    simp only [List.length_append, List.length_map, List.length_singleton] at h1
    simp only [List.length_append, Nat.succ_mul]
    omega

private lemma linSeg_append_linDeriv {T : Type*} {g : ContextFreeGrammar T}
    {k n : ℕ} {A B : g.NT} {u v x : List T}
    (hs : LinSeg g k A B u v) (hd : LinDeriv g n B x) :
    LinDeriv g (k + n) A (u ++ x ++ v) := by
  induction hs with
  | refl _ => simpa using hd
  | step r hr u v B C u' v' ho _ ih =>
    have hsub := ih hd
    have hrew : u ++ (u' ++ x ++ v') ++ v = (u ++ u') ++ x ++ (v' ++ v) := by
      simp [List.append_assoc]
    rw [← hrew, Nat.succ_add]
    exact LinDeriv.step r hr u v B (u' ++ x ++ v') ho hsub

private lemma linDeriv_input_mem {T : Type*} {g : ContextFreeGrammar T}
    {n : ℕ} {A : g.NT} {w : List T} (hd : LinDeriv g n A w) :
    ∃ r ∈ g.rules, r.input = A := by
  cases hd with
  | term r hr _ _ => exact ⟨r, hr, rfl⟩
  | step r hr _ _ _ _ _ _ => exact ⟨r, hr, rfl⟩

private lemma linDeriv_length_le {T : Type*} {g : ContextFreeGrammar T}
    {n : ℕ} {A : g.NT} {w : List T} (M : ℕ)
    (hM : ∀ r ∈ g.rules, r.output.length ≤ M) (hd : LinDeriv g n A w) :
    w.length ≤ (n + 1) * M := by
  induction hd with
  | term r hr t ho =>
    have := hM r hr
    rw [ho, List.length_map] at this
    simpa using this
  | step r hr u v B w' ho _ ih =>
    have h1 := hM r hr
    rw [ho] at h1
    simp only [List.length_append, List.length_map, List.length_singleton] at h1
    simp only [List.length_append]
    rw [Nat.succ_mul]
    omega

/-- Data of a `LinDeriv` peeled into a list of `n + 1` nonterminals along the spine. -/
private lemma linDeriv_split {T : Type*} {g : ContextFreeGrammar T} :
    ∀ {n : ℕ} {A : g.NT} {w : List T} (_hd : LinDeriv g n A w) (k : ℕ), k ≤ n →
      ∃ (B : g.NT) (u x v : List T),
        w = u ++ x ++ v ∧ LinSeg g k A B u v ∧ LinDeriv g (n - k) B x := by
  intro n
  induction n with
  | zero =>
    intro A w hd k hk
    have hk0 : k = 0 := by omega
    subst hk0
    exact ⟨A, [], w, [], by simp, LinSeg.refl A, hd⟩
  | succ n ih =>
    intro A w hd k hk
    cases k with
    | zero => exact ⟨A, [], w, [], by simp, LinSeg.refl A, hd⟩
    | succ k =>
      cases hd with
      | step r hr u v B w' ho hsub =>
        obtain ⟨C, u', x, v', hw', hseg, hrem⟩ := ih hsub k (by omega)
        refine ⟨C, u ++ u', x, v' ++ v, ?_, LinSeg.step r hr u v B C u' v' ho hseg, by simpa using hrem⟩
        rw [hw']; simp [List.append_assoc]

/-- Extract the full spine of `n + 1` nonterminals and prefix/suffix splits from a `LinDeriv`. -/
private lemma linDeriv_spine {T : Type*} {g : ContextFreeGrammar T} :
    ∀ {n : ℕ} {A : g.NT} {w : List T} (_hd : LinDeriv g n A w),
      ∃ (nt : ℕ → g.NT),
        nt 0 = A ∧
        (∀ i ≤ n, ∃ r ∈ g.rules, r.input = nt i) ∧
        (∀ i j, i ≤ j → j ≤ n →
          ∃ (u v x y z : List T),
            w = u ++ v ++ x ++ y ++ z ∧
            LinSeg g i A (nt i) u z ∧
            LinSeg g (j - i) (nt i) (nt j) v y ∧
            LinDeriv g (n - j) (nt j) x) := by
  intro n
  induction n with
  | zero =>
    intro A w hd
    refine ⟨fun _ => A, rfl, fun _ _ => linDeriv_input_mem hd, fun i j hij hjn => ?_⟩
    have hi : i = 0 := by omega
    have hj : j = 0 := by omega
    subst hi; subst hj
    exact ⟨[], [], w, [], [], by simp, LinSeg.refl A, LinSeg.refl A, hd⟩
  | succ n ih =>
    intro A w hd
    cases hd with
    | step r hr u0 v0 B w' ho hsub =>
      obtain ⟨nt', hnt0, hnt_mem, hnt_split⟩ := ih hsub
      let nt : ℕ → g.NT := fun k => match k with | 0 => r.input | k + 1 => nt' k
      refine ⟨nt, rfl, ?_, ?_⟩
      · intro i hi
        cases i with
        | zero => exact ⟨r, hr, rfl⟩
        | succ i => exact hnt_mem i (by omega)
      · intro i j hij hjn
        cases i with
        | zero =>
          cases j with
          | zero =>
            exact ⟨[], [], u0 ++ w' ++ v0, [], [], by simp,
              LinSeg.refl r.input, LinSeg.refl r.input, LinDeriv.step r hr u0 v0 B w' ho hsub⟩
          | succ j =>
            obtain ⟨u1, v1, x1, y1, z1, hw', hseg1, hseg2, hrem⟩ := hnt_split 0 j (Nat.zero_le j) (by omega)
            have hu1z1 : u1 = [] ∧ z1 = [] := by
              cases hseg1; exact ⟨rfl, rfl⟩
            rcases hu1z1 with ⟨rfl, rfl⟩
            simp only [List.nil_append, List.append_nil] at hw'
            rw [hnt0, Nat.sub_zero] at hseg2
            refine ⟨[], u0 ++ v1, x1, y1 ++ v0, [], ?_, LinSeg.refl r.input, ?_, by simpa using hrem⟩
            · rw [hw']; simp [List.append_assoc]
            · exact LinSeg.step r hr u0 v0 B (nt' j) v1 y1 ho hseg2
        | succ i =>
          cases j with
          | zero => omega
          | succ j =>
            obtain ⟨u1, v1, x1, y1, z1, hw', hseg1, hseg2, hrem⟩ := hnt_split i j (by omega) (by omega)
            refine ⟨u0 ++ u1, v1, x1, y1, z1 ++ v0, ?_,
              LinSeg.step r hr u0 v0 B (nt' i) u1 z1 ho hseg1, by simpa using hseg2, by simpa using hrem⟩
            rw [hw']; simp [List.append_assoc]

/-- **Linear Pumping Lemma** for Mathlib's native `ContextFreeGrammar`. -/
private lemma linear_pumping_lemma {T : Type*} (g : ContextFreeGrammar T)
    (hlin : ∀ r ∈ g.rules, (r.output.filter isNT).length ≤ 1) :
    ∃ N : ℕ, 1 ≤ N ∧ ∀ w ∈ g.language, N ≤ w.length →
      ∃ u v x y z : List T,
        w = u ++ v ++ x ++ y ++ z ∧
        (u ++ v).length + (y ++ z).length ≤ N ∧
        1 ≤ (v ++ y).length ∧
        ∀ i : ℕ, u ++ (List.replicate i v).flatten ++ x ++ (List.replicate i y).flatten ++ z ∈ g.language := by
  classical
  let M : ℕ := g.rules.sup (fun r => r.output.length) + 1
  have hM : ∀ r ∈ g.rules, r.output.length ≤ M := fun r hr =>
    Nat.le_trans (Finset.le_sup (f := fun r : ContextFreeRule T g.NT => r.output.length) hr) (Nat.le_succ _)
  let N : ℕ := (g.rules.card + 1) * M + 1
  refine ⟨N, by omega, fun w hw hlen => ?_⟩
  have hex : ∃ n, LinDeriv g n g.initial w := derives_to_linDeriv hlin hw g.initial rfl
  let n := Nat.find hex
  have hdn : LinDeriv g n g.initial w := Nat.find_spec hex
  have hmin : ∀ m < n, ¬ LinDeriv g m g.initial w := fun m hm => Nat.find_min hex hm
  have hn_gt : g.rules.card < n := by
    by_contra hle
    have hwle := linDeriv_length_le M hM hdn
    have : (n + 1) * M ≤ (g.rules.card + 1) * M := Nat.mul_le_mul_right M (by omega)
    omega
  obtain ⟨nt, _, hnt_mem, hnt_split⟩ := linDeriv_spine hdn
  let S : Finset g.NT := g.rules.image ContextFreeRule.input
  have hScard : S.card < (Finset.univ : Finset (Fin (g.rules.card + 1))).card := by
    have h1 : S.card ≤ g.rules.card := Finset.card_image_le
    simp only [Finset.card_univ, Fintype.card_fin]
    omega
  have hmaps : ∀ i ∈ (Finset.univ : Finset (Fin (g.rules.card + 1))), nt i.1 ∈ S := by
    intro i _
    obtain ⟨r, hr, hri⟩ := hnt_mem i.1 (by omega)
    exact Finset.mem_image.mpr ⟨r, hr, hri⟩
  obtain ⟨i₁, _, i₂, _, hne, heq_nt⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hScard hmaps
  have hlt_or : i₁.1 < i₂.1 ∨ i₂.1 < i₁.1 :=
    lt_or_gt_of_ne (fun h => hne (Fin.ext h))
  obtain ⟨I, J, hIJ_lt, hJ_le, hntIJ⟩ : ∃ I J : ℕ, I < J ∧ J ≤ g.rules.card ∧ nt I = nt J := by
    rcases hlt_or with h | h
    · exact ⟨i₁.1, i₂.1, h, Nat.lt_succ_iff.mp i₂.2, heq_nt⟩
    · exact ⟨i₂.1, i₁.1, h, Nat.lt_succ_iff.mp i₁.2, heq_nt.symm⟩
  obtain ⟨u, v, x, y, z, hw_eq, hseg1, hseg2, hrem⟩ := hnt_split I J (Nat.le_of_lt hIJ_lt) (by omega)
  rw [← hntIJ] at hseg2 hrem
  have hvy_pos : 1 ≤ (v ++ y).length := by
    by_contra h0
    simp only [List.length_append] at h0
    have hv0 : v = [] := List.eq_nil_of_length_eq_zero (by omega)
    have hy0 : y = [] := List.eq_nil_of_length_eq_zero (by omega)
    have hshort : LinDeriv g (I + (n - J)) g.initial (u ++ x ++ z) :=
      linSeg_append_linDeriv hseg1 hrem
    have hwx : u ++ x ++ z = w := by rw [hw_eq, hv0, hy0]; simp
    rw [hwx] at hshort
    exact hmin (I + (n - J)) (by omega) hshort
  have huvyz_le : (u ++ v).length + (y ++ z).length ≤ N := by
    have h1 := linSeg_length_le M hM hseg1
    have h2 := linSeg_length_le M hM hseg2
    have hle1 : I + (J - I) = J := by omega
    simp only [List.length_append]
    have hsum : (u.length + z.length) + (v.length + y.length) ≤ J * M := by
      calc (u.length + z.length) + (v.length + y.length)
          ≤ I * M + (J - I) * M := Nat.add_le_add h1 h2
        _ = (I + (J - I)) * M := (Nat.add_mul _ _ _).symm
        _ = J * M := by rw [hle1]
    have hJM : J * M ≤ (g.rules.card + 1) * M := Nat.mul_le_mul_right M (by omega)
    dsimp [N]
    omega
  refine ⟨u, v, x, y, z, hw_eq, huvyz_le, hvy_pos, fun k => ?_⟩
  show g.Generates ((u ++ (List.replicate k v).flatten ++ x ++ (List.replicate k y).flatten ++ z).map Symbol.terminal)
  unfold ContextFreeGrammar.Generates
  have h1 := linSeg_to_derives hseg1
  have h2 := linSeg_iterate hseg2 k
  have h3 := linDeriv_to_derives hrem
  have h23 := h2.trans ((h3.append_left (((List.replicate k v).flatten).map Symbol.terminal)).append_right
    (((List.replicate k y).flatten).map Symbol.terminal))
  have h123 := h1.trans ((h23.append_left (u.map Symbol.terminal)).append_right (z.map Symbol.terminal))
  simpa [List.map_append, List.append_assoc] using h123

/-- **Theorem 3 (`Q_2` is NOT Linear Context-Free):**
No linear `ContextFreeGrammar Bool` (where every rule has at most one nonterminal on its RHS)
generates `Q_2`. -/
theorem ppl165_not_linear_cfg :
    ¬ ∃ g : ContextFreeGrammar Bool,
      (∀ r ∈ g.rules,
        (r.output.filter (fun s => match s with
          | Symbol.nonterminal _ => true
          | Symbol.terminal _ => false)).length ≤ 1) ∧
      g.language =
        {w : List Bool | w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten} := by
  rintro ⟨g, hlin, hlang⟩
  have hlin' : ∀ r ∈ g.rules, (r.output.filter isNT).length ≤ 1 := by
    intro r hr
    have hfun : (isNT : Symbol Bool g.NT → Bool) =
        fun s => match s with | Symbol.nonterminal _ => true | Symbol.terminal _ => false := by
      funext s; cases s <;> rfl
    rw [hfun]
    exact hlin r hr
  obtain ⟨N, hN1, hpump⟩ := linear_pumping_lemma g hlin'
  let F := Nat.factorial N
  have hF_pos : 1 ≤ F := Nat.factorial_pos N
  let w : List Bool :=
    List.replicate N false ++ [true] ++ List.replicate (2 * N + F) false ++ [true] ++ List.replicate N false
  have hw_prim : w ∈ Q2 :=
    count_true_eq_two_prim (by omega)
  have hw_lang : w ∈ g.language := by rwa [hlang]
  have hw_len : N ≤ w.length := by simp [w]
  obtain ⟨u, v, x, y, z, hw_eq, hbound, hvy_pos, hpump_all⟩ := hpump w hw_lang hw_len
  set lu := u.length
  set lv := v.length
  set ly := y.length
  set lz := z.length
  have huv_le : lu + lv ≤ N := by
    have : (u ++ v).length ≤ N := by omega
    simpa [lu, lv] using this
  have hyz_le : ly + lz ≤ N := by
    have : (y ++ z).length ≤ N := by omega
    simpa [ly, lz] using this
  have huv_rep_eq : u ++ v = List.replicate (lu + lv) false := by
    have htake : u ++ v = w.take (lu + lv) := by
      have : w = (u ++ v) ++ (x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
      have hlen : (u ++ v).length = lu + lv := by simp [lu, lv]
      rw [this, ← hlen, List.take_left]
    have hpref : w.take (lu + lv) = List.replicate (lu + lv) false := by
      have : w = List.replicate N false ++ ([true] ++ List.replicate (2 * N + F) false ++ [true] ++ List.replicate N false) := by
        simp [w, List.append_assoc]
      rw [this, List.take_append_of_le_length (by simpa using huv_le), List.take_replicate,
          Nat.min_eq_left huv_le]
    exact htake.trans hpref
  have hyz_rep_eq : y ++ z = List.replicate (ly + lz) false := by
    have hdrop : y ++ z = w.drop (w.length - (ly + lz)) := by
      have : w = (u ++ v ++ x) ++ (y ++ z) := by simp [hw_eq, List.append_assoc]
      have hlen : (y ++ z).length = ly + lz := by simp [ly, lz]
      rw [this, ← hlen, List.length_append, Nat.add_sub_cancel, List.drop_left]
    let pre := List.replicate N false ++ [true] ++ List.replicate (2 * N + F) false ++ [true]
    have hw_split : w = pre ++ List.replicate N false := by simp [w, pre, List.append_assoc]
    have hlen_w : w.length = pre.length + N := by rw [hw_split, List.length_append, List.length_replicate]
    have hsub : w.length - (ly + lz) = pre.length + (N - (ly + lz)) := by omega
    have hsuf : w.drop (w.length - (ly + lz)) = List.replicate (ly + lz) false := by
      rw [hsub, hw_split, List.drop_append, List.drop_eq_nil_of_le (by omega), List.nil_append]
      have h1 : pre.length + (N - (ly + lz)) - pre.length = N - (ly + lz) := by omega
      rw [h1, List.drop_replicate]
      congr 1; omega
    exact hdrop.trans hsuf
  have hu_rep : u = List.replicate lu false := by
    apply List.eq_replicate_iff.mpr
    refine ⟨rfl, fun b hb => ?_⟩
    exact List.eq_of_mem_replicate (huv_rep_eq ▸ List.mem_append_left v hb)
  have hv_rep : v = List.replicate lv false := by
    apply List.eq_replicate_iff.mpr
    refine ⟨rfl, fun b hb => ?_⟩
    exact List.eq_of_mem_replicate (huv_rep_eq ▸ List.mem_append_right u hb)
  have hy_rep : y = List.replicate ly false := by
    apply List.eq_replicate_iff.mpr
    refine ⟨rfl, fun b hb => ?_⟩
    exact List.eq_of_mem_replicate (hyz_rep_eq ▸ List.mem_append_left z hb)
  have hz_rep : z = List.replicate lz false := by
    apply List.eq_replicate_iff.mpr
    refine ⟨rfl, fun b hb => ?_⟩
    exact List.eq_of_mem_replicate (hyz_rep_eq ▸ List.mem_append_right y hb)
  have hx_eq : x = List.replicate (N - (lu + lv)) false ++ [true] ++
      List.replicate (2 * N + F) false ++ [true] ++ List.replicate (N - (ly + lz)) false := by
    have h1 : List.replicate N false = (u ++ v) ++ List.replicate (N - (lu + lv)) false := by
      rw [huv_rep_eq, ← List.replicate_add]
      congr 1; omega
    have h2 : List.replicate N false = List.replicate (N - (ly + lz)) false ++ (y ++ z) := by
      rw [hyz_rep_eq, ← List.replicate_add]
      congr 1; omega
    have hw2 : (u ++ v) ++ x ++ (y ++ z) =
        (u ++ v) ++ (List.replicate (N - (lu + lv)) false ++ [true] ++
          List.replicate (2 * N + F) false ++ [true] ++ List.replicate (N - (ly + lz)) false) ++ (y ++ z) := by
      have hw_rfl : (u ++ v) ++ x ++ (y ++ z) = w := by simp [hw_eq, List.append_assoc]
      rw [hw_rfl]
      change List.replicate N false ++ [true] ++ List.replicate (2 * N + F) false ++ [true] ++ List.replicate N false = _
      have hstep :
          (u ++ v ++ List.replicate (N - (lu + lv)) false) ++ [true] ++
            List.replicate (2 * N + F) false ++ [true] ++
            (List.replicate (N - (ly + lz)) false ++ (y ++ z)) =
          (u ++ v) ++ (List.replicate (N - (lu + lv)) false ++ [true] ++
            List.replicate (2 * N + F) false ++ [true] ++ List.replicate (N - (ly + lz)) false) ++ (y ++ z) := by
        simp only [List.append_assoc]
      rw [← hstep, ← h1, ← h2]
    exact List.append_cancel_left (List.append_cancel_right hw2)
  set d := lv + ly
  have hd_pos : 1 ≤ d := by
    simp only [List.length_append] at hvy_pos; dsimp [d, lv, ly]; omega
  have hd_le : d ≤ N := by
    simp only [List.length_append] at hbound; dsimp [d, lv, ly]; omega
  have hd_dvd : d ∣ F := Nat.dvd_factorial hd_pos hd_le
  let q := F / d
  let i := 1 + q
  have hqd : q * d = F := Nat.div_mul_cancel hd_dvd
  have hwi_lang := hpump_all i
  rw [hlang] at hwi_lang
  have hrep_flat : ∀ (m k : ℕ), (List.replicate m (List.replicate k false)).flatten = List.replicate (m * k) false := by
    intro m k
    induction m with
    | zero => simp
    | succ m ihm =>
      rw [List.replicate_succ, List.flatten_cons, ihm, ← List.replicate_add, Nat.succ_mul, Nat.add_comm]
  have hv_pow : (List.replicate i v).flatten = List.replicate (i * lv) false := by
    rw [hv_rep]; exact hrep_flat i lv
  have hy_pow : (List.replicate i y).flatten = List.replicate (i * ly) false := by
    rw [hy_rep]; exact hrep_flat i ly
  let A := N + q * lv
  let C := N + q * ly
  have hAC : A + C = 2 * N + F := by
    dsimp [A, C]
    have : q * lv + q * ly = q * d := (Nat.mul_add q lv ly).symm
    omega
  have hwi_eq : u ++ (List.replicate i v).flatten ++ x ++ (List.replicate i y).flatten ++ z =
      wordPow (List.replicate A false ++ [true] ++ List.replicate C false) 2 := by
    rw [hu_rep, hv_pow, hx_eq, hy_pow, hz_rep]
    have hL : lu + i * lv + (N - (lu + lv)) = A := by
      have : i * lv = lv + q * lv := by dsimp [i]; rw [Nat.add_mul, Nat.one_mul]
      dsimp [A]; omega
    have hR : (N - (ly + lz)) + i * ly + lz = C := by
      have : i * ly = ly + q * ly := by dsimp [i]; rw [Nat.add_mul, Nat.one_mul]
      dsimp [C]; omega
    have hrepL : List.replicate lu false ++ List.replicate (i * lv) false ++
        List.replicate (N - (lu + lv)) false = List.replicate A false := by
      rw [← List.replicate_add, ← List.replicate_add, hL]
    have hrepR : List.replicate (N - (ly + lz)) false ++ List.replicate (i * ly) false ++
        List.replicate lz false = List.replicate C false := by
      rw [← List.replicate_add, ← List.replicate_add, hR]
    have hmid : List.replicate (2 * N + F) false = List.replicate C false ++ List.replicate A false := by
      rw [← List.replicate_add, show C + A = 2 * N + F by omega]
    have hstep1 :
        List.replicate lu false ++ List.replicate (i * lv) false ++
          (List.replicate (N - (lu + lv)) false ++ [true] ++ List.replicate (2 * N + F) false ++ [true] ++
            List.replicate (N - (ly + lz)) false) ++
          List.replicate (i * ly) false ++ List.replicate lz false =
        (List.replicate lu false ++ List.replicate (i * lv) false ++
          List.replicate (N - (lu + lv)) false) ++ [true] ++
        List.replicate (2 * N + F) false ++ [true] ++
        (List.replicate (N - (ly + lz)) false ++ List.replicate (i * ly) false ++
          List.replicate lz false) := by
      simp only [List.append_assoc]
    rw [hstep1, hrepL, hrepR, hmid]
    simp only [wordPow, List.replicate, List.flatten_cons, List.flatten_nil, List.append_nil, List.append_assoc]
  exact hwi_lang.2 (List.replicate A false ++ [true] ++ List.replicate C false) 2 le_rfl hwi_eq

/-! #### General Context-Free Pumping Lemma (Bar-Hillel) & `Q_2ᶜ ∉ CFL` -/

universe u

mutual
  private inductive PTree {T : Type u} (g : ContextFreeGrammar T) :
      Symbol T g.NT → List T → Type (max 1 u)
    | leaf (a : T) : PTree g (Symbol.terminal a) [a]
    | node (r : ContextFreeRule T g.NT) (hr : r ∈ g.rules)
        {ws : List (List T)} (ch : PForest g r.output ws) :
        PTree g (Symbol.nonterminal r.input) ws.flatten

  private inductive PForest {T : Type u} (g : ContextFreeGrammar T) :
      List (Symbol T g.NT) → List (List T) → Type (max 1 u)
    | nil : PForest g [] []
    | cons {s : Symbol T g.NT} {ss : List (Symbol T g.NT)} {w : List T} {ws : List (List T)}
        (hd : PTree g s w) (tl : PForest g ss ws) :
        PForest g (s :: ss) (w :: ws)
end

mutual
  private def PTree.size {T : Type*} {g : ContextFreeGrammar T} {s : Symbol T g.NT} {w : List T} :
      PTree g s w → ℕ
    | .leaf _ => 1
    | .node _ _ ch => 1 + ch.size

  private def PForest.size {T : Type*} {g : ContextFreeGrammar T} {ss : List (Symbol T g.NT)} {ws : List (List T)} :
      PForest g ss ws → ℕ
    | .nil => 0
    | .cons hd tl => hd.size + tl.size
end

mutual
  private def PTree.height {T : Type*} {g : ContextFreeGrammar T} {s : Symbol T g.NT} {w : List T} :
      PTree g s w → ℕ
    | .leaf _ => 0
    | .node _ _ ch => 1 + ch.height

  private def PForest.height {T : Type*} {g : ContextFreeGrammar T} {ss : List (Symbol T g.NT)} {ws : List (List T)} :
      PForest g ss ws → ℕ
    | .nil => 0
    | .cons hd tl => max hd.height tl.height
end

mutual
  private lemma ptree_length_le {T : Type*} {g : ContextFreeGrammar T} (K : ℕ)
      (hK1 : 1 ≤ K) (hK : ∀ r ∈ g.rules, r.output.length ≤ K)
      {s : Symbol T g.NT} {w : List T} (t : PTree g s w) :
      w.length ≤ K ^ t.height := by
    cases t with
    | leaf a => simp [PTree.height]
    | node r hr ch =>
      have h1 := pforest_length_le K hK1 hK ch
      have h2 := hK r hr
      calc _ ≤ r.output.length * K ^ ch.height := h1
        _ ≤ K * K ^ ch.height := Nat.mul_le_mul_right _ h2
        _ = K ^ (1 + ch.height) := by rw [Nat.add_comm, pow_succ, Nat.mul_comm]

  private lemma pforest_length_le {T : Type*} {g : ContextFreeGrammar T} (K : ℕ)
      (hK1 : 1 ≤ K) (hK : ∀ r ∈ g.rules, r.output.length ≤ K)
      {ss : List (Symbol T g.NT)} {ws : List (List T)} (f : PForest g ss ws) :
      ws.flatten.length ≤ ss.length * K ^ f.height := by
    cases f with
    | nil => simp [PForest.height]
    | cons hd tl =>
      have h1 := ptree_length_le K hK1 hK hd
      have h2 := pforest_length_le K hK1 hK tl
      have hm1 : K ^ hd.height ≤ K ^ max hd.height tl.height :=
        Nat.pow_le_pow_right hK1 (le_max_left _ _)
      have hm2 : K ^ tl.height ≤ K ^ max hd.height tl.height :=
        Nat.pow_le_pow_right hK1 (le_max_right _ _)
      simp only [List.flatten_cons, List.length_append, List.length_cons, PForest.height]
      calc _ ≤ K ^ hd.height + _ * K ^ tl.height := Nat.add_le_add h1 h2
        _ ≤ K ^ max hd.height tl.height + _ * K ^ max hd.height tl.height :=
            Nat.add_le_add hm1 (Nat.mul_le_mul_left _ hm2)
        _ = (_ + 1) * K ^ max hd.height tl.height := by
            rw [Nat.add_mul, Nat.one_mul, Nat.add_comm]
end

mutual
  private lemma ptree_to_derives {T : Type u} {g : ContextFreeGrammar T}
      {s : Symbol T g.NT} {w : List T} (t : PTree g s w) :
      g.Derives [s] (w.map Symbol.terminal) := by
    cases t with
    | leaf a => simpa using Relation.ReflTransGen.refl
    | node r hr ch =>
      have h1 : g.Produces [Symbol.nonterminal r.input] r.output := by
        refine ⟨r, hr, ?_⟩
        simpa using ContextFreeRule.Rewrites.head (r := r) []
      exact Relation.ReflTransGen.head h1 (pforest_to_derives ch)

  private lemma pforest_to_derives {T : Type u} {g : ContextFreeGrammar T}
      {ss : List (Symbol T g.NT)} {ws : List (List T)} (f : PForest g ss ws) :
      g.Derives ss (ws.flatten.map Symbol.terminal) := by
    cases f with
    | nil => simpa using Relation.ReflTransGen.refl
    | @cons s ss w ws hd tl =>
      have h1 := (ptree_to_derives hd).append_right ss
      have h2 := (pforest_to_derives tl).append_left (w.map Symbol.terminal)
      have h3 := h1.trans h2
      simpa [List.flatten_cons, List.map_append] using h3
end

private def ptreeCast {T : Type u} {g : ContextFreeGrammar T}
    {s₁ s₂ : Symbol T g.NT} {w₁ w₂ : List T}
    (hs : s₁ = s₂) (hw : w₁ = w₂) (t : PTree g s₁ w₁) : PTree g s₂ w₂ :=
  hs ▸ hw ▸ t

private lemma ptreeCast_size {T : Type u} {g : ContextFreeGrammar T}
    {s₁ s₂ : Symbol T g.NT} {w₁ w₂ : List T}
    (hs : s₁ = s₂) (hw : w₁ = w₂) (t : PTree g s₁ w₁) :
    (ptreeCast hs hw t).size = t.size := by
  subst hs; subst hw; rfl

private def PForest.append {T : Type*} {g : ContextFreeGrammar T}
    {s1 s2 : List (Symbol T g.NT)} {ws1 ws2 : List (List T)} :
    PForest g s1 ws1 → PForest g s2 ws2 → PForest g (s1 ++ s2) (ws1 ++ ws2)
  | .nil, f2 => f2
  | .cons hd tl, f2 => .cons hd (tl.append f2)

private lemma pforest_split {T : Type*} {g : ContextFreeGrammar T} :
    ∀ (s1 s2 : List (Symbol T g.NT)) {ws : List (List T)},
      PForest g (s1 ++ s2) ws →
      ∃ ws1 ws2, ws = ws1 ++ ws2 ∧ Nonempty (PForest g s1 ws1) ∧ Nonempty (PForest g s2 ws2) := by
  intro s1
  induction s1 with
  | nil =>
    intro s2 ws f
    exact ⟨[], ws, rfl, ⟨.nil⟩, ⟨f⟩⟩
  | cons x xs ih =>
    intro s2 ws f
    cases f with
    | cons hd tl =>
      obtain ⟨ws1, ws2, rfl, ⟨f1⟩, ⟨f2⟩⟩ := ih s2 tl
      exact ⟨_ :: ws1, ws2, rfl, ⟨.cons hd f1⟩, ⟨f2⟩⟩

private lemma pforest_of_terminals {T : Type*} (g : ContextFreeGrammar T) (w : List T) :
    ∃ ws : List (List T), ws.flatten = w ∧ Nonempty (PForest g (w.map Symbol.terminal) ws) := by
  induction w with
  | nil => exact ⟨[], rfl, ⟨.nil⟩⟩
  | cons a w ih =>
    obtain ⟨ws, hw, ⟨f⟩⟩ := ih
    exact ⟨[a] :: ws, by simp [hw], ⟨.cons (.leaf a) f⟩⟩

private lemma derives_to_pforest {T : Type*} {g : ContextFreeGrammar T}
    {s : List (Symbol T g.NT)} {w : List T}
    (hd : g.Derives s (w.map Symbol.terminal)) :
    ∃ ws : List (List T), ws.flatten = w ∧ Nonempty (PForest g s ws) := by
  induction hd using Relation.ReflTransGen.head_induction_on with
  | refl => exact pforest_of_terminals g w
  | head hp _ ih =>
    obtain ⟨ws, hflat, ⟨f⟩⟩ := ih
    obtain ⟨r, hr, hrew⟩ := hp
    obtain ⟨pre, post, rfl, rfl⟩ := (rewrites_iff r _ _).mp hrew
    have f' : PForest g (pre ++ (r.output ++ post)) ws := by
      simpa [List.append_assoc] using f
    obtain ⟨ws1, ws23, hws1, ⟨f1⟩, ⟨f23⟩⟩ := pforest_split pre (r.output ++ post) f'
    obtain ⟨ws2, ws3, hws2, ⟨f2⟩, ⟨f3⟩⟩ := pforest_split r.output post f23
    let node_tree : PTree g (Symbol.nonterminal r.input) ws2.flatten := .node r hr f2
    let f_new : PForest g (pre ++ [Symbol.nonterminal r.input] ++ post) (ws1 ++ [ws2.flatten] ++ ws3) := by
      simpa [List.append_assoc] using f1.append (.cons node_tree f3)
    refine ⟨ws1 ++ [ws2.flatten] ++ ws3, ?_, ⟨f_new⟩⟩
    rw [← hflat, hws1, hws2]
    simp [List.flatten_append]

private lemma generates_to_ptree {T : Type*} {g : ContextFreeGrammar T} {w : List T}
    (hw : w ∈ g.language) :
    Nonempty (PTree g (Symbol.nonterminal g.initial) w) := by
  obtain ⟨ws, hflat, ⟨f⟩⟩ := derives_to_pforest hw
  cases f with
  | cons hd tl =>
    cases tl
    simp only [List.flatten_cons, List.flatten_nil, List.append_nil] at hflat
    exact ⟨hflat ▸ hd⟩

/-- Descend from a `PForest` of height `≥ 1` to the child achieving maximum height. -/
private lemma pforest_max_child {T : Type u} {g : ContextFreeGrammar T}
    {ss : List (Symbol T g.NT)} {ws : List (List T)} (f : PForest g ss ws)
    (h : 1 ≤ f.height) :
    ∃ (s : Symbol T g.NT) (u w v : List T) (t : PTree g s w),
      ws.flatten = u ++ w ++ v ∧
      t.height = f.height ∧
      t.size ≤ f.size ∧
      g.Derives ss (u.map Symbol.terminal ++ [s] ++ v.map Symbol.terminal) ∧
      (∀ (w' : List T) (t' : PTree g s w'), t'.size < t.size →
        ∃ (ws' : List (List T)) (f' : PForest g ss ws'),
          ws'.flatten = u ++ w' ++ v ∧ f'.size < f.size) :=
  match f with
  | .nil => by simp [PForest.height] at h
  | @PForest.cons _ _ s ss w ws hd tl => by
    by_cases hge : tl.height ≤ hd.height
    · refine ⟨s, [], w, ws.flatten, hd, by simp, ?_, ?_, ?_, ?_⟩
      · simp [PForest.height, Nat.max_eq_left hge]
      · simp [PForest.size]
      · have htl := pforest_to_derives tl
        simpa using htl.append_left [s]
      · intro w' t' hlt
        refine ⟨w' :: ws, .cons t' tl, by simp, ?_⟩
        simp only [PForest.size]; omega
    · have htl_pos : 1 ≤ tl.height := by simp [PForest.height] at h; omega
      obtain ⟨s', u', w', v', t', hflat, hht, hsz, hder, hplug⟩ := pforest_max_child tl htl_pos
      refine ⟨s', w ++ u', w', v', t', ?_, ?_, ?_, ?_, ?_⟩
      · simp [List.flatten_cons, hflat, List.append_assoc]
      · simp [PForest.height, Nat.max_eq_right (Nat.le_of_not_le hge), hht]
      · simp only [PForest.size]; omega
      · have hhd := (ptree_to_derives hd).append_right ss
        have htl' := hder.append_left (w.map Symbol.terminal)
        have htr := hhd.trans htl'
        simpa [List.map_append, List.append_assoc] using htr
      · intro w'' t'' hlt
        obtain ⟨ws', f', hflat', hsz'⟩ := hplug w'' t'' hlt
        refine ⟨w :: ws', .cons hd f', ?_, ?_⟩
        · simp [List.flatten_cons, hflat', List.append_assoc]
        · simp only [PForest.size]; omega

/-- Descend from a `PTree` of height `≥ h` (`h ≥ 1`) to a nonterminal subtree of exact height `h`. -/
private lemma ptree_descend_height {T : Type u} {g : ContextFreeGrammar T} :
    ∀ (d : ℕ) {A : g.NT} {w : List T} (t : PTree g (Symbol.nonterminal A) w) (h : ℕ),
      1 ≤ h → t.height = h + d →
      ∃ (C : g.NT) (u w' v : List T) (t' : PTree g (Symbol.nonterminal C) w'),
        w = u ++ w' ++ v ∧
        t'.height = h ∧
        g.Derives [Symbol.nonterminal A] (u.map Symbol.terminal ++ [Symbol.nonterminal C] ++ v.map Symbol.terminal) ∧
        (∀ (w'' : List T) (t'' : PTree g (Symbol.nonterminal C) w''), t''.size < t'.size →
          ∃ t_new : PTree g (Symbol.nonterminal A) (u ++ w'' ++ v), t_new.size < t.size) := by
  intro d
  induction d with
  | zero =>
    intro A w t h _ hht
    refine ⟨A, [], w, [], t, by simp, by simpa using hht, by simpa using Relation.ReflTransGen.refl, ?_⟩
    intro w'' t'' hlt
    have heq : w'' = [] ++ w'' ++ [] := by simp
    refine ⟨ptreeCast rfl heq t'', ?_⟩
    rw [ptreeCast_size]
    exact hlt
  | succ d ih =>
    intro A w t h hh hht
    cases t with
    | node r hr ch =>
      have hch_ht : ch.height = h + d := by simp [PTree.height] at hht; omega
      have hch_pos : 1 ≤ ch.height := by omega
      obtain ⟨s, u1, w1, v1, t1, hflat1, ht1_ht, _, hder1, hplug1⟩ := pforest_max_child ch hch_pos
      cases s with
      | terminal a =>
        cases t1; simp [PTree.height] at ht1_ht; omega
      | nonterminal B =>
        obtain ⟨C, u2, w', v2, t', hw1_eq, ht'_ht, hder2, hplug2⟩ := ih t1 h hh (ht1_ht.trans hch_ht)
        have hstep : g.Produces [Symbol.nonterminal r.input] r.output :=
          ⟨r, hr, by simpa using ContextFreeRule.Rewrites.head (r := r) []⟩
        have hder1' : g.Derives [Symbol.nonterminal r.input]
            (u1.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v1.map Symbol.terminal) :=
          Relation.ReflTransGen.head hstep hder1
        have hder2' := (hder2.append_left (u1.map Symbol.terminal)).append_right (v1.map Symbol.terminal)
        refine ⟨C, u1 ++ u2, w', v2 ++ v1, t', ?_, ht'_ht, ?_, ?_⟩
        · rw [hflat1, hw1_eq]; simp [List.append_assoc]
        · simpa [List.map_append, List.append_assoc] using hder1'.trans hder2'
        · intro w'' t'' hlt
          obtain ⟨t1_new, ht1_sz⟩ := hplug2 w'' t'' hlt
          obtain ⟨ws', f', hflat', hf'_sz⟩ := hplug1 (u2 ++ w'' ++ v2) t1_new ht1_sz
          have heq_w : ws'.flatten = (u1 ++ u2) ++ w'' ++ (v2 ++ v1) := by
            rw [hflat']; simp [List.append_assoc]
          refine ⟨ptreeCast rfl heq_w (PTree.node r hr f'), ?_⟩
          rw [ptreeCast_size]
          simp only [PTree.size]; omega

/-- Extract a spine of `h + 1` nonterminals from a `PTree` of height `h + 1`. -/
private lemma ptree_deep_spine {T : Type u} {g : ContextFreeGrammar T} :
    ∀ (h : ℕ) {A : g.NT} {w : List T} (t : PTree g (Symbol.nonterminal A) w),
      t.height = h + 1 →
      ∃ (nt : ℕ → g.NT),
        nt 0 = A ∧
        (∀ i ≤ h, ∃ r ∈ g.rules, r.input = nt i) ∧
        (∀ i j, i < j → j ≤ h →
          ∃ u v x y z : List T,
            w = u ++ v ++ x ++ y ++ z ∧
            (i = 0 → u = [] ∧ z = []) ∧
            g.Derives [Symbol.nonterminal A] (u.map Symbol.terminal ++ [Symbol.nonterminal (nt i)] ++ z.map Symbol.terminal) ∧
            g.Derives [Symbol.nonterminal (nt i)] (v.map Symbol.terminal ++ [Symbol.nonterminal (nt j)] ++ y.map Symbol.terminal) ∧
            (∃ t_j : PTree g (Symbol.nonterminal (nt j)) x, t_j.size < t.size) ∧
            (nt i = nt j → ∃ t_short : PTree g (Symbol.nonterminal A) (u ++ x ++ z), t_short.size < t.size)) := by
  intro h
  induction h with
  | zero =>
    intro A w t hht
    cases t with
    | node r hr ch =>
      refine ⟨fun _ => r.input, rfl, fun _ _ => ⟨r, hr, rfl⟩, fun i j hij hj0 => by omega⟩
  | succ h ih =>
    intro A w t hht
    cases t with
    | node r hr ch =>
      have hch_ht : ch.height = h + 1 := by simp [PTree.height] at hht; omega
      obtain ⟨s, u0, w0, v0, t0, hflat0, ht0_ht, ht0_sz, hder0, hplug0⟩ :=
        pforest_max_child ch (by omega)
      cases s with
      | terminal a =>
        cases t0; simp [PTree.height] at ht0_ht; omega
      | nonterminal B =>
        obtain ⟨nt', hnt0, hnt_mem, hnt_split⟩ := ih t0 (ht0_ht.trans hch_ht)
        let nt : ℕ → g.NT := fun k => match k with | 0 => r.input | k + 1 => nt' k
        have hstep : g.Produces [Symbol.nonterminal r.input] r.output :=
          ⟨r, hr, by simpa using ContextFreeRule.Rewrites.head (r := r) []⟩
        have hder_top : g.Derives [Symbol.nonterminal r.input]
            (u0.map Symbol.terminal ++ [Symbol.nonterminal B] ++ v0.map Symbol.terminal) :=
          Relation.ReflTransGen.head hstep hder0
        have ht0_lt_t : t0.size < (PTree.node r hr ch).size := by
          simp only [PTree.size]; omega
        refine ⟨nt, rfl, ?_, ?_⟩
        · intro i hi
          cases i with
          | zero => exact ⟨r, hr, rfl⟩
          | succ i => exact hnt_mem i (by omega)
        · intro i j hij hjle
          cases i with
          | zero =>
            cases j with
            | zero => omega
            | succ j =>
              by_cases hj0 : j = 0
              · subst hj0
                have hntj : nt 1 = B := hnt0
                refine ⟨[], u0, w0, v0, [], by simpa using hflat0, fun _ => ⟨rfl, rfl⟩,
                  by simpa using Relation.ReflTransGen.refl,
                  by simpa [hntj] using hder_top,
                  ⟨ptreeCast (congrArg Symbol.nonterminal hntj.symm) rfl t0, by
                    rw [ptreeCast_size]; exact ht0_lt_t⟩,
                  fun heq => ?_⟩
                have hs_eq : Symbol.nonterminal (T := T) B = Symbol.nonterminal r.input :=
                  congrArg Symbol.nonterminal (heq.trans hnt0).symm
                have hw_eq' : w0 = [] ++ w0 ++ [] := by simp
                refine ⟨ptreeCast hs_eq hw_eq' t0, ?_⟩
                rw [ptreeCast_size]
                exact ht0_lt_t
              · have hjpos : 0 < j := Nat.pos_of_ne_zero hj0
                obtain ⟨u1, v1, x1, y1, z1, hw0_eq, hu1z1, _, hdv, ⟨t_j, htj_lt⟩, _⟩ :=
                  hnt_split 0 j hjpos (by omega)
                obtain ⟨rfl, rfl⟩ := hu1z1 rfl
                simp only [List.nil_append, List.append_nil] at hw0_eq
                rw [hnt0] at hdv
                have hdv_top : g.Derives [Symbol.nonterminal r.input]
                    ((u0 ++ v1).map Symbol.terminal ++ [Symbol.nonterminal (nt' j)] ++ (y1 ++ v0).map Symbol.terminal) := by
                  have h2 := (hdv.append_left (u0.map Symbol.terminal)).append_right (v0.map Symbol.terminal)
                  simpa [List.map_append, List.append_assoc] using hder_top.trans h2
                refine ⟨[], u0 ++ v1, x1, y1 ++ v0, [], ?_, fun _ => ⟨rfl, rfl⟩,
                  by simpa using Relation.ReflTransGen.refl, hdv_top,
                  ⟨t_j, lt_trans htj_lt ht0_lt_t⟩, fun heq => ?_⟩
                · rw [hflat0, hw0_eq]; simp [List.append_assoc]
                · have hs_eq : Symbol.nonterminal (T := T) (nt' j) = Symbol.nonterminal r.input :=
                    congrArg Symbol.nonterminal heq.symm
                  have hw_eq' : x1 = [] ++ x1 ++ [] := by simp
                  refine ⟨ptreeCast hs_eq hw_eq' t_j, ?_⟩
                  rw [ptreeCast_size]
                  exact lt_trans htj_lt ht0_lt_t
          | succ i =>
            cases j with
            | zero => omega
            | succ j =>
              obtain ⟨u1, v1, x1, y1, z1, hw0_eq, _, hdu, hdv, ⟨t_j, htj_lt⟩, hshort⟩ :=
                hnt_split i j (by omega) (by omega)
              refine ⟨u0 ++ u1, v1, x1, y1, z1 ++ v0, ?_, fun h => by omega, ?_, hdv,
                ⟨t_j, lt_trans htj_lt ht0_lt_t⟩, fun heq => ?_⟩
              · rw [hflat0, hw0_eq]; simp [List.append_assoc]
              · have h2 := (hdu.append_left (u0.map Symbol.terminal)).append_right (v0.map Symbol.terminal)
                simpa [List.map_append, List.append_assoc] using hder_top.trans h2
              · obtain ⟨t0_short, ht0_lt⟩ := hshort heq
                obtain ⟨ws', f', hflat', hf'_lt⟩ := hplug0 (u1 ++ x1 ++ z1) t0_short ht0_lt
                have heq_w : ws'.flatten = (u0 ++ u1) ++ x1 ++ (z1 ++ v0) := by
                  rw [hflat']; simp [List.append_assoc]
                refine ⟨ptreeCast rfl heq_w (PTree.node r hr f'), ?_⟩
                rw [ptreeCast_size]
                simp only [PTree.size]; omega

private lemma derives_iterate {T : Type*} {g : ContextFreeGrammar T}
    {B : g.NT} {v y : List T}
    (h : g.Derives [Symbol.nonterminal B] (v.map Symbol.terminal ++ [Symbol.nonterminal B] ++ y.map Symbol.terminal))
    (k : ℕ) :
    g.Derives [Symbol.nonterminal B]
      (((List.replicate k v).flatten).map Symbol.terminal ++ [Symbol.nonterminal B] ++
        ((List.replicate k y).flatten).map Symbol.terminal) := by
  induction k with
  | zero => simpa using Relation.ReflTransGen.refl
  | succ k ih =>
    have h2 := (ih.append_left (v.map Symbol.terminal)).append_right (y.map Symbol.terminal)
    have h3 := h.trans h2
    have hrep_v : (List.replicate (k + 1) v).flatten = v ++ (List.replicate k v).flatten := by
      simp [List.replicate_succ]
    have hrep_y : (List.replicate (k + 1) y).flatten = (List.replicate k y).flatten ++ y := by
      clear ih h2 h3 hrep_v
      induction k with
      | zero => simp
      | succ j ihj =>
        calc (List.replicate (j + 2) y).flatten
            = y ++ (List.replicate (j + 1) y).flatten := by simp [List.replicate_succ]
          _ = y ++ ((List.replicate j y).flatten ++ y) := by rw [ihj]
          _ = (y ++ (List.replicate j y).flatten) ++ y := by rw [List.append_assoc]
          _ = (List.replicate (j + 1) y).flatten ++ y := by simp [List.replicate_succ]
    rw [hrep_v, hrep_y]
    simpa [List.map_append, List.append_assoc] using h3

/-- **General Bar-Hillel Context-Free Pumping Lemma** for Mathlib's native `ContextFreeGrammar`. -/
private lemma cfl_pumping_lemma {T : Type*} (g : ContextFreeGrammar T) :
    ∃ P : ℕ, 1 ≤ P ∧ ∀ w ∈ g.language, P ≤ w.length →
      ∃ u v x y z : List T,
        w = u ++ v ++ x ++ y ++ z ∧
        (v ++ x ++ y).length ≤ P ∧
        1 ≤ (v ++ y).length ∧
        ∀ i : ℕ, u ++ (List.replicate i v).flatten ++ x ++ (List.replicate i y).flatten ++ z ∈ g.language := by
  classical
  let K : ℕ := max 2 (g.rules.sup (fun r => r.output.length))
  have hK1 : 1 ≤ K := le_trans (by decide) (le_max_left 2 _)
  have hK : ∀ r ∈ g.rules, r.output.length ≤ K := fun r hr =>
    le_trans (Finset.le_sup (f := fun r : ContextFreeRule T g.NT => r.output.length) hr) (le_max_right 2 _)
  let H : ℕ := g.rules.card + 1
  let P : ℕ := K ^ H + 1
  refine ⟨P, by omega, fun w hw hlen => ?_⟩
  have hex : ∃ sz : ℕ, ∃ t : PTree g (Symbol.nonterminal g.initial) w, t.size = sz := by
    obtain ⟨t⟩ := generates_to_ptree hw
    exact ⟨t.size, t, rfl⟩
  let minSz := Nat.find hex
  obtain ⟨t, ht_sz⟩ := Nat.find_spec hex
  have hmin : ∀ t' : PTree g (Symbol.nonterminal g.initial) w, minSz ≤ t'.size := fun t' =>
    Nat.find_min' hex ⟨t', rfl⟩
  have hht_ge : H ≤ t.height := by
    by_contra hlt
    have hwl := ptree_length_le K hK1 hK t
    have hpow : K ^ t.height ≤ K ^ H := Nat.pow_le_pow_right hK1 (by omega)
    dsimp [P] at hlen
    omega
  obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hht_ge
  obtain ⟨C, u0, w_top, v0, t_top, hw_top_eq, ht_top_ht, hder_top, hplug_top⟩ :=
    ptree_descend_height d t H (by omega) hd
  obtain ⟨nt, _, hnt_mem, hnt_split⟩ := ptree_deep_spine g.rules.card t_top ht_top_ht
  let S : Finset g.NT := g.rules.image ContextFreeRule.input
  have hScard : S.card < (Finset.univ : Finset (Fin (g.rules.card + 1))).card := by
    have h1 : S.card ≤ g.rules.card := Finset.card_image_le
    simp only [Finset.card_univ, Fintype.card_fin]
    omega
  have hmaps : ∀ i ∈ (Finset.univ : Finset (Fin (g.rules.card + 1))), nt i.1 ∈ S := by
    intro i _
    obtain ⟨r, hr, hri⟩ := hnt_mem i.1 (Nat.lt_succ_iff.mp i.2)
    exact Finset.mem_image.mpr ⟨r, hr, hri⟩
  obtain ⟨i₁, _, i₂, _, hne, heq_nt⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hScard hmaps
  have hlt_or : i₁.1 < i₂.1 ∨ i₂.1 < i₁.1 :=
    lt_or_gt_of_ne (fun h => hne (Fin.ext h))
  obtain ⟨I, J, hIJ_lt, hJ_le, hntIJ⟩ : ∃ I J : ℕ, I < J ∧ J ≤ g.rules.card ∧ nt I = nt J := by
    rcases hlt_or with h | h
    · exact ⟨i₁.1, i₂.1, h, Nat.lt_succ_iff.mp i₂.2, heq_nt⟩
    · exact ⟨i₂.1, i₁.1, h, Nat.lt_succ_iff.mp i₁.2, heq_nt.symm⟩
  obtain ⟨u1, v, x, y, z1, hwt_eq, _, hdu1, hdv, ⟨t_j, _⟩, hshort⟩ :=
    hnt_split I J hIJ_lt hJ_le
  have hvxy_le : (v ++ x ++ y).length ≤ P := by
    have h1 : w_top.length ≤ K ^ H := by
      have := ptree_length_le K hK1 hK t_top
      rwa [ht_top_ht] at this
    have h2 : (v ++ x ++ y).length ≤ w_top.length := by
      rw [hwt_eq]; simp; omega
    dsimp [P]; omega
  have hvy_pos : 1 ≤ (v ++ y).length := by
    by_contra h0
    simp only [List.length_append] at h0
    have hv0 : v = [] := List.eq_nil_of_length_eq_zero (by omega)
    have hy0 : y = [] := List.eq_nil_of_length_eq_zero (by omega)
    obtain ⟨t_top_short, ht_short_lt⟩ := hshort hntIJ
    obtain ⟨t_new, ht_new_lt⟩ := hplug_top (u1 ++ x ++ z1) t_top_short ht_short_lt
    have heq_w : u0 ++ (u1 ++ x ++ z1) ++ v0 = w := by
      rw [hw_top_eq, hwt_eq, hv0, hy0]; simp [List.append_assoc]
    have ht_min := hmin (heq_w ▸ t_new)
    have hsz_eq : (heq_w ▸ t_new : PTree g (Symbol.nonterminal g.initial) w).size = t_new.size := by
      cases heq_w; rfl
    omega
  refine ⟨u0 ++ u1, v, x, y, z1 ++ v0, ?_, hvxy_le, hvy_pos, fun k => ?_⟩
  · rw [hw_top_eq, hwt_eq]; simp [List.append_assoc]
  · show g.Generates (((u0 ++ u1) ++ (List.replicate k v).flatten ++ x ++ (List.replicate k y).flatten ++ (z1 ++ v0)).map Symbol.terminal)
    unfold ContextFreeGrammar.Generates
    rw [← hntIJ] at hdv t_j
    have h_u : g.Derives [Symbol.nonterminal g.initial]
        ((u0 ++ u1).map Symbol.terminal ++ [Symbol.nonterminal (nt I)] ++ (z1 ++ v0).map Symbol.terminal) := by
      have h2 := (hdu1.append_left (u0.map Symbol.terminal)).append_right (v0.map Symbol.terminal)
      simpa [List.map_append, List.append_assoc] using hder_top.trans h2
    have h_v := derives_iterate hdv k
    have h_x := ptree_to_derives t_j
    have h_vx := h_v.trans ((h_x.append_left (((List.replicate k v).flatten).map Symbol.terminal)).append_right
      (((List.replicate k y).flatten).map Symbol.terminal))
    have h_all := h_u.trans ((h_vx.append_left ((u0 ++ u1).map Symbol.terminal)).append_right ((z1 ++ v0).map Symbol.terminal))
    simpa [List.map_append, List.append_assoc] using h_all

/-- Helper: a word `0^a 1 0^b 1 0^c 1` with `a, b, c` not all equal is primitive. -/
private lemma count_true_eq_three_prim {a b c : ℕ} (hneq : ¬ (a = b ∧ b = c)) :
    List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false ++ [true] ∈ Q2 := by
  set w := List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false ++ [true]
  refine ⟨?_, ?_⟩
  · intro h0
    have := congrArg List.length h0
    simp [w] at this
  · intro u k hk hwu
    change w = wordPow u k at hwu
    have hct : w.count true = 3 := by
      simp [w, List.count_append, List.count_replicate]
    have hct2 : k * u.count true = 3 := by
      rw [← wordPow_count, ← hwu, hct]
    have hk3 : k = 3 ∧ u.count true = 1 := by
      have hu1 : u.count true ≥ 1 := by
        by_contra h0
        have : u.count true = 0 := by omega
        rw [this, Nat.mul_zero] at hct2; omega
      have hle3 : k ≤ 3 := by nlinarith
      have hne2 : k ≠ 2 := by intro h2; subst h2; omega
      have hk_eq : k = 3 := by omega
      subst hk_eq
      exact ⟨rfl, by omega⟩
    obtain ⟨rfl, huc⟩ := hk3
    have hwu3 : w = u ++ u ++ u := by
      simpa [wordPow, List.replicate, List.append_assoc] using hwu
    have hmem_u : true ∈ u := List.count_pos_iff.mp (by omega)
    obtain ⟨u1, u2, hu_eq⟩ := List.append_of_mem hmem_u
    have hu1_ct : u1.count true = 0 := by
      have : (u1 ++ true :: u2).count true = u1.count true + 1 + u2.count true := by simp; omega
      rw [← hu_eq, huc] at this; omega
    have hu2_ct : u2.count true = 0 := by
      have : (u1 ++ true :: u2).count true = u1.count true + 1 + u2.count true := by simp; omega
      rw [← hu_eq, huc] at this; omega
    have hu1_rep : u1 = List.replicate u1.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd (List.count_pos_iff.mpr hx) (by omega)
    have hu2_rep : u2 = List.replicate u2.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd (List.count_pos_iff.mpr hx) (by omega)
    -- Since w ends with true, u2 must be []!
    have hlast : (u ++ u ++ u).getLast? = some true := by
      rw [← hwu3]
      show (List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false ++ [true]).getLast? = some true
      rw [List.getLast?_append_of_ne_nil _ (by simp)]
      rfl
    have hu2_nil : u2 = [] := by
      by_contra hne
      have hlast_u2 : u2.getLast? = some false := by
        rw [hu2_rep]
        have hpos : 0 < u2.length := List.length_pos_of_ne_nil hne
        obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
        rw [hm, List.getLast?_replicate]
        simp
      have hlast_u : u.getLast? = some false := by
        rw [hu_eq, List.getLast?_append_of_ne_nil _ (by simp),
            List.getLast?_cons_of_ne_nil hne, hlast_u2]
      have hu_ne : u ≠ [] := by rw [hu_eq]; simp
      have hlast_uuu : (u ++ u ++ u).getLast? = some false := by
        rw [List.getLast?_append_of_ne_nil _ hu_ne, hlast_u]
      rw [hlast] at hlast_uuu
      simp at hlast_uuu
    have hu_clean : u = List.replicate u1.length false ++ [true] := by
      rw [hu_eq, hu1_rep, hu2_nil]; simp
    rw [hu_clean] at hwu3
    have hrep_eq : ∀ {x1 x2 : ℕ} {s1 s2 : List Bool},
        List.replicate x1 false ++ true :: s1 = List.replicate x2 false ++ true :: s2 →
        x1 = x2 ∧ s1 = s2 := by
      intro x1
      induction x1 with
      | zero =>
        intro x2 s1 s2 h
        cases x2 with
        | zero => simpa using h
        | succ x2 => simp [List.replicate_succ] at h
      | succ x1 ih =>
        intro x2 s1 s2 h
        cases x2 with
        | zero => simp [List.replicate_succ] at h
        | succ x2 =>
          simp only [List.replicate_succ, List.cons_append, List.cons.injEq, true_and] at h
          obtain ⟨hx, hs⟩ := ih h
          exact ⟨by omega, hs⟩
    have hwu3' : List.replicate a false ++ true :: (List.replicate b false ++ true :: (List.replicate c false ++ [true])) =
        List.replicate u1.length false ++ true ::
        (List.replicate u1.length false ++ true :: (List.replicate u1.length false ++ [true])) := by
      simpa [w, List.append_assoc] using hwu3
    obtain ⟨ha_eq, hr1⟩ := hrep_eq hwu3'
    obtain ⟨hb_eq, hr2⟩ := hrep_eq hr1
    obtain ⟨hc_eq, _⟩ := hrep_eq hr2
    exact hneq ⟨by omega, by omega⟩

/-- Helper: decompose any binary word with 2 trues into `0^a ++ [1] ++ 0^b ++ [1] ++ 0^c`. -/
private lemma decompose_two_trues {w : List Bool} (hct : w.count true = 2) :
    ∃ a b c : ℕ, w = List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false := by
  have hmem1 : true ∈ w := List.count_pos_iff.mp (by omega)
  obtain ⟨w1, w2, rfl⟩ := List.append_of_mem hmem1
  -- Take FIRST true by choosing minimal w1, or just induct on w!
  clear hmem1
  revert hct
  generalize hw : w1 ++ true :: w2 = s
  clear hw w1 w2
  intro hct
  have h1 : ∀ (l : List Bool), l.count true = 1 →
      ∃ a b : ℕ, l = List.replicate a false ++ [true] ++ List.replicate b false := by
    intro l hl
    have hm : true ∈ l := List.count_pos_iff.mp (by omega)
    obtain ⟨l1, l2, rfl⟩ := List.append_of_mem hm
    have h12 : l1.count true + l2.count true = 0 := by
      have : (l1 ++ true :: l2).count true = l1.count true + 1 + l2.count true := by simp; omega
      omega
    have hl1 : l1 = List.replicate l1.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd (List.count_pos_iff.mpr hx) (by omega)
    have hl2 : l2 = List.replicate l2.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd (List.count_pos_iff.mpr hx) (by omega)
    exact ⟨l1.length, l2.length, by rw [hl1, hl2]; simp⟩
  -- Induct on s to peel leading falses until the first true
  induction s with
  | nil => simp at hct
  | cons x xs ih =>
    cases x with
    | false =>
      have hct' : xs.count true = 2 := by simpa using hct
      obtain ⟨a, b, c, rfl⟩ := ih hct'
      exact ⟨a + 1, b, c, by simp [List.replicate_succ, List.append_assoc]⟩
    | true =>
      have hct' : xs.count true = 1 := by simp at hct; omega
      obtain ⟨b, c, rfl⟩ := h1 xs hct'
      exact ⟨0, b, c, by simp⟩

/-- Helper: decompose any binary word with 3 trues ending in `true` into `0^a ++ [1] ++ 0^b ++ [1] ++ 0^c ++ [1]`. -/
private lemma decompose_three_trues_end_true {w : List Bool} (hct : w.count true = 3)
    (hend : w.getLast? = some true) :
    ∃ a b c : ℕ, w = List.replicate a false ++ [true] ++ List.replicate b false ++ [true] ++ List.replicate c false ++ [true] := by
  induction w with
  | nil => simp at hct
  | cons x xs ih =>
    cases x with
    | false =>
      have hxs_ne : xs ≠ [] := by intro h0; subst h0; simp at hct
      have hend' : xs.getLast? = some true := by simpa [List.getLast?_cons_of_ne_nil hxs_ne] using hend
      obtain ⟨a, b, c, rfl⟩ := ih (by simpa using hct) hend'
      exact ⟨a + 1, b, c, by simp [List.replicate_succ, List.append_assoc]⟩
    | true =>
      have hct' : xs.count true = 2 := by simp at hct; omega
      obtain ⟨b, c, d, hxs⟩ := decompose_two_trues hct'
      have hd0 : d = 0 := by
        by_contra hne
        have hxs_ne : xs ≠ [] := by intro h0; subst h0; simp at hct'
        have hend' : xs.getLast? = some true := by simpa [List.getLast?_cons_of_ne_nil hxs_ne] using hend
        rw [hxs] at hend'
        obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hne
        have hrep_ne : List.replicate d false ≠ [] := by rw [hm]; simp
        rw [List.getLast?_append_of_ne_nil _ hrep_ne, hm, List.getLast?_replicate] at hend'
        simp at hend'
      subst hd0
      exact ⟨0, b, c, by rw [hxs]; simp [List.append_assoc]⟩

/-- **Theorem 4a (Complement `Q_2ᶜ` is NOT Context-Free):**
Using Mathlib's native `Language.IsContextFree`, the language of non-primitive binary words
(empty word plus proper powers `u^k`, `k ≥ 2`) is NOT context-free. -/
theorem ppl165_complement_not_context_free :
    ¬ Language.IsContextFree
      ({w : List Bool | w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten} : Language Bool)ᶜ := by
  rintro ⟨g, hlang⟩
  obtain ⟨P, hP1, hpump⟩ := cfl_pumping_lemma g
  let p := P + 1
  let w : List Bool :=
    List.replicate p false ++ [true] ++ List.replicate p false ++ [true] ++ List.replicate p false ++ [true]
  have hw_not_Q2 : w ∈ Q2ᶜ := by
    intro hQ
    have hcube : w = wordPow (List.replicate p false ++ [true]) 3 := by
      simp [w, wordPow, List.replicate, List.append_assoc]
    exact hQ.2 (List.replicate p false ++ [true]) 3 (by decide) hcube
  have hw_lang : w ∈ g.language := by rwa [hlang]
  have hw_len : P ≤ w.length := by simp [w, p]; omega
  obtain ⟨u, v, x, y, z, hw_eq, hvxy_le, hvy_pos, hpump_all⟩ := hpump w hw_lang hw_len
  -- Observe: |v ++ x ++ y| ≤ P < p, so v ++ x ++ y contains at most ONE `true`!
  have hvxy_trues_le_one : (v ++ x ++ y).count true ≤ 1 := by
    by_contra hgt
    have hge2 : 2 ≤ (v ++ x ++ y).count true := by omega
    have hw_true_pos : ∀ (k : ℕ) (hk : k < w.length), w[k]'hk = true →
        k = p ∨ k = 2 * p + 1 ∨ k = 3 * p + 2 := by
      intro k hk htrue
      by_cases h1 : k < p
      · have : w[k]'hk = false := by
          have hw1 : w = List.replicate p false ++ ([true] ++ List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) := by
            simp [w, List.append_assoc]
          have hget : w[k]'hk = (List.replicate p false)[k]'(by simpa using h1) := by
            conv_lhs => simp only [hw1]
            rw [List.getElem_append_left (by simpa using h1)]
          rw [hget, List.getElem_replicate]
        rw [this] at htrue; simp at htrue
      · by_cases h2 : k = p
        · left; exact h2
        · by_cases h3 : k < 2 * p + 1
          · have : w[k]'hk = false := by
              have hw2 : w = (List.replicate p false ++ [true]) ++ List.replicate p false ++ ([true] ++ List.replicate p false ++ [true]) := by
                simp [w, List.append_assoc]
              have hk_lt : k < ((List.replicate p false ++ [true]) ++ List.replicate p false).length := by
                simp; omega
              have hk_ge : (List.replicate p false ++ [true]).length ≤ k := by simp; omega
              have hget : w[k]'hk = (List.replicate p false)[k - (p + 1)]'(by simp; omega) := by
                have h1' : w[k]'hk = ((List.replicate p false ++ [true]) ++ List.replicate p false)[k]'hk_lt := by
                  conv_lhs => simp only [hw2]
                  rw [List.getElem_append_left hk_lt]
                rw [h1', List.getElem_append_right hk_ge]
                simp
              rw [hget, List.getElem_replicate]
            rw [this] at htrue; simp at htrue
          · by_cases h4 : k = 2 * p + 1
            · right; left; exact h4
            · by_cases h5 : k < 3 * p + 2
              · have : w[k]'hk = false := by
                  have hw3 : w = (List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) ++ List.replicate p false ++ [true] := by
                    simp [w, List.append_assoc]
                  have hk_lt : k < ((List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) ++ List.replicate p false).length := by
                    simp; omega
                  have hk_ge : (List.replicate p false ++ [true] ++ List.replicate p false ++ [true]).length ≤ k := by
                    simp; omega
                  have hget : w[k]'hk = (List.replicate p false)[k - (2 * p + 2)]'(by simp; omega) := by
                    have h1' : w[k]'hk = ((List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) ++ List.replicate p false)[k]'hk_lt := by
                      conv_lhs => simp only [hw3]
                      rw [List.getElem_append_left hk_lt]
                    rw [h1', List.getElem_append_right hk_ge]
                    simp
                  rw [hget, List.getElem_replicate]
                rw [this] at htrue; simp at htrue
              · have hlen_w : w.length = 3 * p + 3 := by simp [w]; omega
                right; right; omega
    have hex_two : ∀ (l : List Bool), 2 ≤ l.count true →
        ∃ (i j : ℕ) (hi : i < l.length) (hj : j < l.length), i < j ∧ l[i]'hi = true ∧ l[j]'hj = true := by
      intro l
      induction l with
      | nil => intro h; simp at h
      | cons b bs ih =>
        intro h
        cases b with
        | false =>
          obtain ⟨i, j, hi, hj, hij, hbi, hbj⟩ := ih (by simpa using h)
          exact ⟨i + 1, j + 1, Nat.succ_lt_succ hi, Nat.succ_lt_succ hj, Nat.succ_lt_succ hij, hbi, hbj⟩
        | true =>
          have hbs : 1 ≤ bs.count true := by
            simp only [List.count_cons, beq_self_eq_true, ↓reduceIte] at h; omega
          have hmem : true ∈ bs := List.count_pos_iff.mp (by omega)
          obtain ⟨j, hj, hbj⟩ := List.getElem_of_mem hmem
          exact ⟨0, j + 1, Nat.zero_lt_succ _, Nat.succ_lt_succ hj, Nat.zero_lt_succ j, rfl, hbj⟩
    obtain ⟨i, j, hi, hj, hij, hti, htj⟩ := hex_two (v ++ x ++ y) hge2
    have hwi_lt : u.length + i < w.length := by
      rw [hw_eq]; simp only [List.length_append] at hi ⊢; omega
    have hwj_lt : u.length + j < w.length := by
      rw [hw_eq]; simp only [List.length_append] at hj ⊢; omega
    have hget_sub : ∀ (m : ℕ) (hm : m < (v ++ x ++ y).length) (hmw : u.length + m < w.length),
        w[u.length + m]'hmw = (v ++ x ++ y)[m]'hm := by
      intro m hm hmw
      have h1 : w = u ++ (v ++ x ++ y) ++ z := by simp [hw_eq, List.append_assoc]
      have hlt_uvxy : u.length + m < (u ++ (v ++ x ++ y)).length := by
        simp only [List.length_append] at hm ⊢; omega
      have ha1 : w[u.length + m]'hmw = (u ++ (v ++ x ++ y))[u.length + m]'hlt_uvxy := by
        conv_lhs => simp only [h1]
        rw [List.getElem_append_left hlt_uvxy]
      rw [ha1, List.getElem_append_right (Nat.le_add_right u.length m)]
      simp
    have hpi := hw_true_pos (u.length + i) hwi_lt ((hget_sub i hi hwi_lt).trans hti)
    have hpj := hw_true_pos (u.length + j) hwj_lt ((hget_sub j hj hwj_lt).trans htj)
    have hdist : j - i < P := by omega
    dsimp [p] at hpi hpj
    omega
  -- Now split on whether `v ++ y` contains 0 `true`s or 1 `true`!
  have hvy_trues_le : (v ++ y).count true ≤ 1 := by
    have : (v ++ x ++ y).count true = v.count true + x.count true + y.count true := by
      simp only [List.count_append]
    simp only [List.count_append]
    omega
  by_cases hvy0 : (v ++ y).count true = 0
  · -- Case 1: `v` and `y` consist only of `false`! Pump `i = 2`!
    have hw2_mem : u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z ∈ Q2ᶜ := by
      have := hpump_all 2
      rwa [hlang] at this
    set w2 := u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z
    -- `w2` has 3 trues and ends with `true` (Wait: what if `z = []` and `y` is nonempty all `false`?!)
    -- WAIT A SECOND! If `z = []`, `w` ends with `true`, so `y` CANNOT be nonempty all `false`!
    have hw2_trues : w2.count true = 3 := by
      have hw_ct : w.count true = 3 := by simp [w, List.count_append, List.count_replicate]
      rw [hw_eq] at hw_ct
      simp only [List.count_append] at hw_ct hvy0
      simp only [w2, List.replicate, List.flatten_cons, List.flatten_nil, List.append_nil, List.count_append]
      omega
    have hw2_end : w2.getLast? = some true := by
      have hw_end : w.getLast? = some true := by
        show (List.replicate p false ++ [true] ++ List.replicate p false ++ [true] ++ List.replicate p false ++ [true]).getLast? = some true
        rw [List.getLast?_append_of_ne_nil _ (by simp)]
        rfl
      have hy_false : ∀ b ∈ y, b = false := by
        intro b hb
        cases b
        · rfl
        · have : 0 < y.count true := List.count_pos_iff.mpr hb
          simp only [List.count_append] at hvy0; omega
      by_cases hz : z = []
      · subst hz
        have hy0 : y = [] := by
          by_contra hyne
          have hy_last : y.getLast? = some false := by
            have := List.getLast_mem hyne
            rw [List.getLast?_eq_some_getLast hyne, hy_false _ this]
          have hw_last : w.getLast? = some false := by
            rw [hw_eq, List.append_nil, List.getLast?_append_of_ne_nil _ hyne, hy_last]
          rw [hw_end] at hw_last; simp at hw_last
        subst hy0
        have hw_last' : (u ++ v ++ x).getLast? = some true := by
          simpa [hw_eq] using hw_end
        have hx_ne_or : (u ++ (v ++ v) ++ x).getLast? = some true := by
          by_cases hx : x = []
          · subst hx
            have hv0 : v = [] := by
              by_contra hvne
              have hv_false : ∀ b ∈ v, b = false := by
                intro b hb
                cases b
                · rfl
                · have : 0 < v.count true := List.count_pos_iff.mpr hb
                  simp only [List.count_append] at hvy0; omega
              have hv_last : v.getLast? = some false := by
                rw [List.getLast?_eq_some_getLast hvne, hv_false _ (List.getLast_mem hvne)]
              have : (u ++ v).getLast? = some false := by
                rw [List.getLast?_append_of_ne_nil _ hvne, hv_last]
              rw [List.append_nil] at hw_last'
              rw [this] at hw_last'; simp at hw_last'
            subst hv0; simpa using hw_last'
          · rw [List.getLast?_append_of_ne_nil _ hx] at hw_last' ⊢
            exact hw_last'
        simpa [w2, List.replicate] using hx_ne_or
      · have hz_last : z.getLast? = some true := by
          rw [hw_eq, List.getLast?_append_of_ne_nil _ hz] at hw_end
          exact hw_end
        dsimp [w2]
        rw [List.getLast?_append_of_ne_nil _ hz]
        exact hz_last
    obtain ⟨a, b, c, hw2_form⟩ := decompose_three_trues_end_true hw2_trues hw2_end
    -- Since `w2` has length `3p + 3 + |vy| > 3p + 3`, `a + b + c = 3p + |vy| > 3p`.
    -- Yet AT LEAST ONE of `a, b, c` equals `p` (actually we prove `¬(a = b ∧ b = c)` directly:
    -- if `a = b = c`, then `3a = 3p + |vy|`, so `a > p`, meaning EVERY `0`-block grew,
    -- which requires `v` and `y` to intersect all 3 `0`-blocks, impossible since `|vxy| ≤ P < p`!).
    have hnot_eq : ¬ (a = b ∧ b = c) := by
      rintro ⟨rfl, rfl⟩
      have hlen_w2 : w2.length = 3 * a + 3 := by rw [hw2_form]; simp; omega
      have hlen_w2' : w2.length = 3 * p + 3 + (v ++ y).length := by
        have hw_len_eq : w.length = 3 * p + 3 := by simp [w]; omega
        rw [hw_eq] at hw_len_eq
        simp only [w2, List.replicate, List.flatten_cons, List.flatten_nil, List.append_nil, List.length_append] at hw_len_eq ⊢
        omega
      have ha_gt : p < a := by omega
      -- In `w2`, the first `true` is at index `a > p`, and the third `true` is at index `3a + 2`.
      -- Wait: compare the index of the FIRST `true` (`a`) in `w2` and the SECOND `true` (`2a + 1`) and THIRD `true` (`3a + 2`)!
      -- Look at the prefix `u` of `w` AND `w2`:
      -- `u` is a prefix of BOTH `w` and `w2`!
      -- If `u.count true ≥ 1`, then the FIRST `true` of `w` is ALREADY inside `u`, so its index in `w2` is the SAME as in `w`, namely `p`! Thus `a = p`, contradicting `p < a`!
      -- If `z.count true ≥ 2`, wait: if `u.count true = 0` AND `z.count true ≥ 2`, then the SECOND and THIRD `true`s are BOTH inside `z`!
      -- So the distance between the second and third `true`s in `w2` is the SAME as in `w` (namely `p` falses between them), so `c = p` (`a = p`), contradicting `p < a`!
      -- Wait: what if `u.count true = 0` AND `z.count true ≤ 1`?
      -- Since `v.count true + y.count true = 0`, `x.count true = 3 - u.count true - z.count true ≥ 2`!
      -- Then `(v ++ x ++ y).count true ≥ 2`, contradicting `hvxy_trues_le_one`!!
      have hu_ct_0 : u.count true = 0 := by
        by_contra hu_ne
        have hmem_u : true ∈ u := List.count_pos_iff.mp (Nat.pos_of_ne_zero hu_ne)
        obtain ⟨k, hk, htk⟩ := List.getElem_of_mem hmem_u
        -- Find the MINIMUM index k < u.length with u[k] = true? Even easier: u[k] = true ⇒ w[k] = true ∧ w2[k] = true!
        -- Wait: in w, every true has index ≥ p; in w2, every true has index ≥ a > p!
        -- Wait: if k = p (from w), then w2[p] = true, yet w2 starts with `List.replicate a false` with `p < a`, so `w2[p] = false`! Contradiction!
        -- What if k > p? Still look at `u.take (p + 1)`? No, `w` has `w[p] = true`, and if `u.length > p`, then `w2[p] = u[p] = w[p] = true`, contradicting `w2[p] = false`!
        -- And if `u.length ≤ p`, then `u` is a prefix of `List.replicate p false`, so `u.count true = 0`!
        have hu_len_gt : p < u.length := by
          by_contra hle
          have hu_pref : u = List.replicate u.length false := by
            have h1 : u = w.take u.length := by
              have : w = u ++ (v ++ x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
              rw [this, List.take_left]
            have h2 : w.take u.length = List.replicate u.length false := by
              have : w = List.replicate p false ++ ([true] ++ List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) := by
                simp [w, List.append_assoc]
              rw [this, List.take_append_of_le_length (by simp; omega), List.take_replicate, Nat.min_eq_left (by omega)]
            exact h1.trans h2
          rw [hu_pref, List.count_replicate] at hu_ne
          simp at hu_ne
        have hwp : w[p]'(by simp [w]) = true := by
          have : w = List.replicate p false ++ true :: (List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) := by
            simp [w, List.append_assoc]
          conv_lhs => simp only [this]
          rw [List.getElem_append_right (by simp)]
          simp
        have hup : u[p]'hu_len_gt = true := by
          have : w = u ++ (v ++ x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
          have hget : w[p]'(by simp [w]) = u[p]'hu_len_gt := by
            conv_lhs => simp only [this]
            rw [List.getElem_append_left hu_len_gt]
          rw [← hget, hwp]
        have hw2p : w2[p]'(by rw [hlen_w2]; omega) = true := by
          have : w2 = u ++ ((List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten ++ z) := by
            simp [w2, List.append_assoc]
          conv_lhs => simp only [this]
          rw [List.getElem_append_left hu_len_gt]
          exact hup
        have hw2p_false : w2[p]'(by rw [hlen_w2]; omega) = false := by
          have : w2 = List.replicate a false ++ ([true] ++ List.replicate a false ++ [true] ++ List.replicate a false ++ [true]) := by
            simp [hw2_form, List.append_assoc]
          conv_lhs => simp only [this]
          rw [List.getElem_append_left (by simp; omega), List.getElem_replicate]
        rw [hw2p] at hw2p_false; simp at hw2p_false
      have hz_ct_le : z.count true ≤ 1 := by
        by_contra hgt
        -- If `z.count true ≥ 2`, then `z.length ≥ p + 2`, so the `(p + 2)`-th element from the end of `w` AND `w2` is `true`!
        -- In `w`, index `w.length - (p + 2) = 2p + 1` is `true`!
        -- Wait: in `w2`, index `w2.length - (p + 2) = 3a + 3 - (p + 2) = 3a + 1 - p` satisfies `2a + 1 < 3a + 1 - p < 3a + 2` (since `p < a`),
        -- so `w2[w2.length - (p + 2)] = false`!!
        have hz_len_gt : p + 1 < z.length := by
          by_contra hle
          -- Then z is a suffix of `List.replicate p false ++ [true]`, which has only 1 true!
          have hz_suf : z = w.drop (w.length - z.length) := by
            have : w = (u ++ v ++ x ++ y) ++ z := by simp [hw_eq, List.append_assoc]
            rw [this, List.length_append, Nat.add_sub_cancel, List.drop_left]
          let pre := List.replicate p false ++ [true] ++ List.replicate p false ++ [true]
          have hw_sp : w = pre ++ (List.replicate p false ++ [true]) := by simp [w, pre, List.append_assoc]
          have hpre_len : pre.length = 2 * p + 2 := by simp [pre]; omega
          have hw_l : w.length = 3 * p + 3 := by simp [w]; omega
          have hsub : w.length - z.length = pre.length + (p + 1 - z.length) := by omega
          have hdrop_eq : w.drop (w.length - z.length) = (List.replicate p false ++ [true]).drop (p + 1 - z.length) := by
            rw [hsub, hw_sp, List.drop_append, List.drop_eq_nil_of_le (by omega), List.nil_append]
            congr 1; omega
          have hct_le : z.count true ≤ (List.replicate p false ++ [true]).count true := by
            rw [hz_suf, hdrop_eq]
            have := List.take_append_drop (p + 1 - z.length) (List.replicate p false ++ [true])
            have hc := congrArg (List.count true) this
            rw [List.count_append] at hc; omega
          have : (List.replicate p false ++ [true]).count true = 1 := by simp [List.count_replicate]
          omega
        have hw_l_eq : w.length = 3 * p + 3 := by simp [w]; omega
        have hidx_w : w.length - (p + 2) = 2 * p + 1 := by omega
        have hw_mid : w[w.length - (p + 2)]'(by omega) = true := by
          have h_eq1 : w = (List.replicate p false ++ [true] ++ List.replicate p false) ++ true :: (List.replicate p false ++ [true]) := by
            simp [w, List.append_assoc]
          have h1 : w[w.length - (p + 2)]'(by omega) = w[2 * p + 1]'(by omega) := by
            congr 1
          rw [h1]
          have hge_l : (List.replicate p false ++ [true] ++ List.replicate p false).length ≤ 2 * p + 1 := by simp; omega
          have h2 : ((List.replicate p false ++ [true] ++ List.replicate p false) ++ true :: (List.replicate p false ++ [true]))[2 * p + 1]'(by simp; omega) = true := by
            rw [List.getElem_append_right hge_l]
            have hzero : 2 * p + 1 - (List.replicate p false ++ [true] ++ List.replicate p false).length = 0 := by simp; omega
            simp only [hzero, List.getElem_cons_zero]
          simpa [h_eq1] using h2
        have hz_idx : z[z.length - (p + 2)]'(by omega) = true := by
          have hsp : w = (u ++ v ++ x ++ y) ++ z := by simp [hw_eq, List.append_assoc]
          have hlen_pre : (u ++ v ++ x ++ y).length + z.length = w.length := by
            have := congrArg List.length hsp; simpa only [List.length_append] using this.symm
          have hge : (u ++ v ++ x ++ y).length ≤ w.length - (p + 2) := by omega
          have hsub_eq : w.length - (p + 2) - (u ++ v ++ x ++ y).length = z.length - (p + 2) := by omega
          have hget : ((u ++ v ++ x ++ y) ++ z)[w.length - (p + 2)]'(by rw [← hsp]; omega) =
              z[z.length - (p + 2)]'(by omega) := by
            rw [List.getElem_append_right hge]
            congr 1
          have hget' : w[w.length - (p + 2)]'(by omega) = z[z.length - (p + 2)]'(by omega) := by
            simpa [hsp] using hget
          rw [← hget', hw_mid]
        have hw2_mid : w2[w2.length - (p + 2)]'(by rw [hlen_w2]; omega) = true := by
          have hsp : w2 = (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten) ++ z := by
            simp [w2, List.append_assoc]
          have hlen_pre : (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten).length + z.length = w2.length := by
            have := congrArg List.length hsp; simpa only [List.length_append] using this.symm
          have hge : (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten).length ≤ w2.length - (p + 2) := by omega
          have hsub_eq : w2.length - (p + 2) - (u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten).length = z.length - (p + 2) := by omega
          have hget : ((u ++ (List.replicate 2 v).flatten ++ x ++ (List.replicate 2 y).flatten) ++ z)[w2.length - (p + 2)]'(by rw [← hsp, hlen_w2]; omega) =
              z[z.length - (p + 2)]'(by omega) := by
            rw [List.getElem_append_right hge]
            congr 1
          have hget' : w2[w2.length - (p + 2)]'(by rw [hlen_w2]; omega) = z[z.length - (p + 2)]'(by omega) := by
            simpa [hsp] using hget
          rw [hget', hz_idx]
        have hw2_mid_false : w2[w2.length - (p + 2)]'(by rw [hlen_w2]; omega) = false := by
          have hpos_val : w2.length - (p + 2) = 3 * a + 1 - p := by omega
          have h1 : w2 = (List.replicate a false ++ [true] ++ List.replicate a false ++ [true]) ++ List.replicate a false ++ [true] := by
            simp [hw2_form, List.append_assoc]
          have hlt1 : w2.length - (p + 2) < ((List.replicate a false ++ [true] ++ List.replicate a false ++ [true]) ++ List.replicate a false).length := by
            simp; omega
          have hge1 : (List.replicate a false ++ [true] ++ List.replicate a false ++ [true]).length ≤ w2.length - (p + 2) := by
            simp; omega
          have hget1 : (((List.replicate a false ++ [true] ++ List.replicate a false ++ [true]) ++ List.replicate a false) ++ [true])[w2.length - (p + 2)]'(by rw [← h1, hlen_w2]; omega) = false := by
            rw [List.getElem_append_left hlt1, List.getElem_append_right hge1, List.getElem_replicate]
          simpa [h1] using hget1
        rw [hw2_mid] at hw2_mid_false; simp at hw2_mid_false
      -- Now u.count true = 0, z.count true ≤ 1, (v ++ x ++ y).count true ≤ 1, contradicting w.count true = 3!
      have hw_ct : w.count true = 3 := by simp [w, List.count_append, List.count_replicate]
      rw [hw_eq] at hw_ct
      simp only [List.count_append] at hw_ct hvxy_trues_le_one
      omega
    exact hw2_mem (hw2_form ▸ count_true_eq_three_prim hnot_eq)
  · -- Case 2: `(v ++ y).count true = 1`! Pump `i = 0` (`w0 = u ++ x ++ z`)!
    have hvy1 : (v ++ y).count true = 1 := by omega
    have hw0_mem : u ++ x ++ z ∈ Q2ᶜ := by
      have := hpump_all 0
      simpa [hlang] using this
    set w0 := u ++ x ++ z
    have hw0_trues : w0.count true = 2 := by
      have hw_ct : w.count true = 3 := by simp [w, List.count_append, List.count_replicate]
      rw [hw_eq] at hw_ct
      simp only [List.count_append] at hw_ct hvy1
      simp only [w0, List.count_append]
      omega
    obtain ⟨a, b, c, hw0_form⟩ := decompose_two_trues hw0_trues
    -- Show `a + c ≠ b`!
    -- Notice: `w0.length = a + b + c + 2`, and `w0.length = w.length - (v ++ y).length = 3p + 3 - |vy|`.
    -- Wait: `1 ≤ |vy| ≤ P < p`, so `a + b + c = 3p + 1 - |vy|`!
    -- Even better: if `a + c = b`, then `2b = a + b + c = 3p + 1 - |vy|`!
    -- WAIT A SECOND!! CHECK `b` directly from `w0`:
    -- We have THREE subcases for WHICH of the 3 `true`s in `w` was deleted by `v ++ y`:
    --   - If the 3rd `true` was deleted (so `u` and `x` contain the 1st and 2nd `true`s? Wait: `|vxy| ≤ P < p`, so `x` has `0` trues!):
    --     Because `(v ++ x ++ y).count true ≤ 1` and `(v ++ y).count true = 1`, **`x.count true = 0`!!**
    --     Therefore `u.count true + z.count true = 2`!!
    --     Split on `u.count true ∈ {0, 1, 2}`!!
    --     - `u.count true = 2, z.count true = 0`: `u` has the 1st and 2nd `true`s (`a = p, b = p`), and `c ≥ 1` (since `a + b + c = 3p + 1 - |vy| ≥ 2p + 2`, so `c ≥ 2 > 0`), hence `a + c > p = b`!!
    --     - `u.count true = 1, z.count true = 1`: `u` has the 1st `true` (`a = p`), `z` has the 3rd `true` at its end (`c = 0`), and `a + b + c = 3p + 1 - |vy| ≥ 2p + 2`, so `b ≥ p + 2 > p = a + c`!!
    --     - `u.count true = 0, z.count true = 2`: `z` has the 2nd and 3rd `true`s (`b = p, c = 0`), and `a + b + c = 3p + 1 - |vy| ≥ 2p + 2`, so `a ≥ p + 2 > p = b`, hence `a + c > b`!!
    -- OH!! MY!! GOD!! ALL THREE SUBCASES ARE 5 LINES EACH!!
    have hx_ct : x.count true = 0 := by
      simp only [List.count_append] at hvxy_trues_le_one hvy1
      omega
    have huz_ct : u.count true + z.count true = 2 := by
      simp only [w0, List.count_append] at hw0_trues; omega
    have habc_sum : a + b + c = 3 * p + 1 - (v ++ y).length := by
      have h1 : w0.length = a + b + c + 2 := by rw [hw0_form]; simp; omega
      have h2 : w.length = 3 * p + 3 := by simp [w]; omega
      have h3 : w.length = w0.length + (v ++ y).length := by
        rw [hw_eq]; simp only [w0, List.length_append]; omega
      omega
    have hvy_le_P : (v ++ y).length ≤ P := by
      simp only [List.length_append] at hvxy_le ⊢; omega
    have habc_big : 2 * p + 2 ≤ a + b + c := by dsimp [p] at *; omega
    -- Now check `a + c ≠ b` in the 3 cases of `u.count true ∈ {0, 1, 2}`!
    have hsum_ne : a + c ≠ b := by
      have hlen_w0 : w0.length = a + b + c + 2 := by rw [hw0_form]; simp; omega
      -- Helper: if u.count true ≥ 1, then u has length > p and starts with `0^p ++ [1]`, so `a = p`!
      have ha_eq_p_of_u1 : 1 ≤ u.count true → a = p := by
        intro hu1
        have hu_gt_p : p < u.length := by
          by_contra hle
          have : u = w.take u.length := by
            have hw' : w = u ++ (v ++ x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
            rw [hw', List.take_left]
          have hpref : w.take u.length = List.replicate u.length false := by
            have hw' : w = List.replicate p false ++ ([true] ++ List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) := by
              simp [w, List.append_assoc]
            rw [hw', List.take_append_of_le_length (by simp; omega), List.take_replicate, Nat.min_eq_left (by omega)]
          rw [this, hpref, List.count_replicate] at hu1; simp at hu1
        -- `u.take (p + 1) = 0^p ++ [1]` is a prefix of BOTH `w` and `w0`!
        have hu_pref : u.take (p + 1) = List.replicate p false ++ [true] := by
          have h1 : u.take (p + 1) = w.take (p + 1) := by
            have hw' : w = u ++ (v ++ x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
            rw [hw', List.take_append_of_le_length (by omega)]
          rw [h1]
          have hw' : w = (List.replicate p false ++ [true]) ++ (List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) := by
            simp [w, List.append_assoc]
          have hlen1 : (List.replicate p false ++ [true]).length = p + 1 := by simp
          rw [hw', ← hlen1, List.take_left]
        have hw0_pref : w0.take (p + 1) = List.replicate p false ++ [true] := by
          have hw0' : w0 = u ++ (x ++ z) := by simp [w0, List.append_assoc]
          rw [hw0', List.take_append_of_le_length (by omega), hu_pref]
        -- Compare index of first true in `w0` (`a`) with `p`!
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · -- `a < p`, so `w0[a] = true`, while `(w0.take (p + 1))[a] = false`!
          have h1 : w0[a]'(by omega) = true := by
            have : w0 = List.replicate a false ++ true :: (List.replicate b false ++ [true] ++ List.replicate c false) := by
              simp [hw0_form, List.append_assoc]
            conv_lhs => simp only [this]
            rw [List.getElem_append_right (by simp)]; simp
          have h2 : (w0.take (p + 1))[a]'(by rw [hw0_pref]; simp; omega) = false := by
            have h3 : (List.replicate p false ++ [true])[a]'(by simp; omega) = false := by
              rw [List.getElem_append_left (by simp; omega), List.getElem_replicate]
            simpa [hw0_pref] using h3
          rw [List.getElem_take, h1] at h2; simp at h2
        · -- `p < a`, so `w0[p] = false`, while `(w0.take (p + 1))[p] = true`!
          have h1 : w0[p]'(by omega) = false := by
            have : w0 = List.replicate a false ++ ([true] ++ List.replicate b false ++ [true] ++ List.replicate c false) := by
              simp [hw0_form, List.append_assoc]
            conv_lhs => simp only [this]
            rw [List.getElem_append_left (by simp; omega), List.getElem_replicate]
          have h2 : (w0.take (p + 1))[p]'(by rw [hw0_pref]; simp) = true := by
            simp [hw0_pref]
          rw [List.getElem_take, h1] at h2; simp at h2
      -- Helper: if z.count true ≥ 1, then z is nonempty and ends with `true`, so `c = 0`!
      have hc_eq_0_of_z1 : 1 ≤ z.count true → c = 0 := by
        intro hz1
        have hz_ne : z ≠ [] := by intro h0; subst h0; simp at hz1
        have hw_end : w.getLast? = some true := by
          show (List.replicate p false ++ [true] ++ List.replicate p false ++ [true] ++ List.replicate p false ++ [true]).getLast? = some true
          rw [List.getLast?_append_of_ne_nil _ (by simp)]
          rfl
        have hz_end : z.getLast? = some true := by
          rwa [hw_eq, List.getLast?_append_of_ne_nil _ hz_ne] at hw_end
        have hw0_end : w0.getLast? = some true := by
          dsimp [w0]
          rw [List.getLast?_append_of_ne_nil _ hz_ne]
          exact hz_end
        by_contra hc_ne
        obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hc_ne
        have hrep_ne : List.replicate c false ≠ [] := by rw [hm]; simp
        rw [hw0_form, List.getLast?_append_of_ne_nil _ hrep_ne, hm, List.getLast?_replicate] at hw0_end
        simp at hw0_end
      -- Now split on `u.count true = 0`, `1`, or `2`!
      have hu_cases : u.count true = 0 ∨ u.count true = 1 ∨ u.count true = 2 := by omega
      rcases hu_cases with hu0 | hu1 | hu2
      · -- u.count true = 0, z.count true = 2 -> c = 0 and b = p!
        have hz2 : z.count true = 2 := by omega
        have hc0 : c = 0 := hc_eq_0_of_z1 (by omega)
        -- `z` contains the last two `true`s of `w`, so `z.length ≥ p + 2`, and the suffix of length `p + 2` of BOTH `w` and `w0` is `[true] ++ 0^p ++ [true]`!
        have hz_len_ge : p + 2 ≤ z.length := by
          by_contra hlt
          have hz_suf : z = w.drop (w.length - z.length) := by
            have : w = (u ++ v ++ x ++ y) ++ z := by simp [hw_eq, List.append_assoc]
            rw [this, List.length_append, Nat.add_sub_cancel, List.drop_left]
          let pre := List.replicate p false ++ [true] ++ List.replicate p false ++ [true]
          have hw_sp : w = pre ++ (List.replicate p false ++ [true]) := by simp [w, pre, List.append_assoc]
          have hpre_len : pre.length = 2 * p + 2 := by simp [pre]; omega
          have hw_l : w.length = 3 * p + 3 := by simp [w]; omega
          have hsub : w.length - z.length = pre.length + (p + 1 - z.length) := by omega
          have hdrop_eq : w.drop (w.length - z.length) = (List.replicate p false ++ [true]).drop (p + 1 - z.length) := by
            rw [hsub, hw_sp, List.drop_append, List.drop_eq_nil_of_le (by omega), List.nil_append]
            congr 1; omega
          have hct_le : z.count true ≤ (List.replicate p false ++ [true]).count true := by
            rw [hz_suf, hdrop_eq]
            have := List.take_append_drop (p + 1 - z.length) (List.replicate p false ++ [true])
            have hc := congrArg (List.count true) this
            rw [List.count_append] at hc; omega
          have : (List.replicate p false ++ [true]).count true = 1 := by simp [List.count_replicate]
          omega
        -- Therefore `w0[w0.length - (p + 2)] = z[z.length - (p + 2)] = w[w.length - (p + 2)] = true`,
        -- AND for every `k` with `w0.length - (p + 1) ≤ k < w0.length - 1`, `w0[k] = false`!
        -- Actually simpler: `w0.drop (w0.length - (p + 2)) = [true] ++ List.replicate p false ++ [true]`!
        have hw0_suf : w0.drop (w0.length - (p + 2)) = [true] ++ List.replicate p false ++ [true] := by
          have h1 : w0.drop (w0.length - (p + 2)) = z.drop (z.length - (p + 2)) := by
            have hsp : w0 = (u ++ x) ++ z := by simp [w0]
            have hlen_ux : (u ++ x).length + z.length = w0.length := by
              have := congrArg List.length hsp; simpa only [List.length_append] using this.symm
            have hsub : w0.length - (p + 2) = (u ++ x).length + (z.length - (p + 2)) := by omega
            rw [hsub, hsp, List.drop_append, List.drop_eq_nil_of_le (by omega), List.nil_append]
            congr 1; omega
          have h2 : w.drop (w.length - (p + 2)) = z.drop (z.length - (p + 2)) := by
            have hsp : w = (u ++ v ++ x ++ y) ++ z := by simp [hw_eq, List.append_assoc]
            have hlen_p : (u ++ v ++ x ++ y).length + z.length = w.length := by
              have := congrArg List.length hsp; simpa only [List.length_append] using this.symm
            have hsub : w.length - (p + 2) = (u ++ v ++ x ++ y).length + (z.length - (p + 2)) := by omega
            rw [hsub, hsp, List.drop_append, List.drop_eq_nil_of_le (by omega), List.nil_append]
            congr 1; omega
          rw [h1, ← h2]
          have hw_sp : w = (List.replicate p false ++ [true] ++ List.replicate p false) ++ ([true] ++ List.replicate p false ++ [true]) := by
            simp [w, List.append_assoc]
          have hlen_l : (List.replicate p false ++ [true] ++ List.replicate p false).length = w.length - (p + 2) := by
            simp [w]; omega
          rw [← hlen_l, hw_sp, List.drop_left]
        intro heq_ac
        have hb_gt_p : p < b := by omega
        have hct2 : (w0.drop (w0.length - (p + 2))).count true = 2 := by
          rw [hw0_suf]; simp [List.count_replicate]
        have hct1 : (w0.drop (w0.length - (p + 2))).count true = 1 := by
          have hw0_sp : w0 = (List.replicate a false ++ [true]) ++ (List.replicate b false ++ [true]) := by
            rw [hw0_form, hc0]; simp [List.append_assoc]
          have hsub : w0.length - (p + 2) = (a + 1) + (b - p - 1) := by omega
          rw [hsub, hw0_sp, List.drop_append, List.drop_eq_nil_of_le (by simp), List.nil_append]
          have hsub2 : a + 1 + (b - p - 1) - (List.replicate a false ++ [true]).length = b - p - 1 := by simp
          rw [hsub2, List.drop_append_of_le_length (by simp; omega), List.drop_replicate]
          simp [List.count_replicate]
        omega
      · -- u.count true = 1, z.count true = 1 -> a = p, c = 0, so a + c = p while a + b + c ≥ 2p + 2 -> b ≥ p + 2 > p = a + c!
        have ha_p : a = p := ha_eq_p_of_u1 (by omega)
        have hc0 : c = 0 := hc_eq_0_of_z1 (by omega)
        omega
      · -- u.count true = 2, z.count true = 0 -> u starts with `0^p ++ [1] ++ 0^p ++ [1]`, so `a = p` and `b = p`, hence `c ≥ 2 > 0`, `a + c > b`!
        have ha_p : a = p := ha_eq_p_of_u1 (by omega)
        have hu_gt_2p : 2 * p + 1 < u.length := by
          by_contra hle
          have h1 : u = w.take u.length := by
            have hw' : w = u ++ (v ++ x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
            rw [hw', List.take_left]
          let pre := List.replicate p false ++ [true] ++ List.replicate p false
          have hw' : w = pre ++ ([true] ++ List.replicate p false ++ [true]) := by simp [w, pre, List.append_assoc]
          have hpre_l : pre.length = 2 * p + 1 := by simp [pre]; omega
          have h2 : w.take u.length = pre.take u.length := by
            rw [hw', List.take_append_of_le_length (by omega)]
          have hct_le : u.count true ≤ pre.count true := by
            rw [h1, h2]
            have := List.take_append_drop u.length pre
            have hc := congrArg (List.count true) this
            rw [List.count_append] at hc; omega
          have : pre.count true = 1 := by simp [pre, List.count_replicate]
          omega
        -- Then `w0.take (2p + 2) = u.take (2p + 2) = w.take (2p + 2) = 0^p ++ [1] ++ 0^p ++ [1]`, so `w0.take (2p + 2)` has 2 trues!
        -- If `a + c = b`, since `a = p` and `a + b + c ≥ 2p + 2`, `2b = a + b + c ≥ 2p + 2`, so `b ≥ p + 1`!
        -- Then `w0.take (2p + 2)` is a prefix of `0^p ++ [1] ++ 0^b` (length `p + 1 + b ≥ 2p + 2`), so it has only 1 true! Contradiction!
        intro heq_ac
        have hb_gt_p : p < b := by omega
        have hw0_pref2 : w0.take (2 * p + 2) = List.replicate p false ++ [true] ++ List.replicate p false ++ [true] := by
          have h1 : w0.take (2 * p + 2) = u.take (2 * p + 2) := by
            have : w0 = u ++ (x ++ z) := by simp [w0, List.append_assoc]
            rw [this, List.take_append_of_le_length (by omega)]
          have h2 : w.take (2 * p + 2) = u.take (2 * p + 2) := by
            have : w = u ++ (v ++ x ++ y ++ z) := by simp [hw_eq, List.append_assoc]
            rw [this, List.take_append_of_le_length (by omega)]
          rw [h1, ← h2]
          have hw' : w = (List.replicate p false ++ [true] ++ List.replicate p false ++ [true]) ++ (List.replicate p false ++ [true]) := by
            simp [w, List.append_assoc]
          have hlen1 : (List.replicate p false ++ [true] ++ List.replicate p false ++ [true]).length = 2 * p + 2 := by
            simp; omega
          rw [hw', ← hlen1, List.take_left]
        have hct2 : (w0.take (2 * p + 2)).count true = 2 := by
          rw [hw0_pref2]; simp [List.count_replicate]
        have hct1 : (w0.take (2 * p + 2)).count true = 1 := by
          have hw0_sp : w0 = (List.replicate p false ++ [true] ++ List.replicate b false) ++ ([true] ++ List.replicate c false) := by
            rw [hw0_form, ha_p]; simp [List.append_assoc]
          rw [hw0_sp, List.take_append_of_le_length (by simp; omega)]
          have hsub : 2 * p + 2 = (List.replicate p false ++ [true]).length + (p + 1) := by simp; omega
          rw [hsub, List.take_append, List.take_of_length_le (by simp)]
          have hsub2 : (List.replicate p false ++ [true]).length + (p + 1) - (List.replicate p false ++ [true]).length = p + 1 := by omega
          rw [hsub2, List.take_replicate, Nat.min_eq_left (by omega)]
          simp [List.count_replicate]
        omega
    exact hw0_mem (hw0_form ▸ count_true_eq_two_prim hsum_ne)

/-- **Theorem 4b (Separation from ALL Complement-Closed Subclasses of `CFL`, including `DCFL`):**
If `C` is any family of languages over `Bool` contained in `CFL` and closed under complement
(such as deterministic context-free languages `DCFL` or visibly pushdown languages `VPL`),
then `Q_2 ∉ C`. -/
theorem ppl165_not_in_complement_closed_cfl
    (C : Set (Language Bool))
    (hC_sub : ∀ L ∈ C, Language.IsContextFree L)
    (hC_compl : ∀ L ∈ C, Lᶜ ∈ C) :
    {w : List Bool | w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten} ∉ C :=
  fun hmem => ppl165_complement_not_context_free (hC_sub _ (hC_compl _ hmem))

/-! ### Part III: Analytic Transcendence of the Ordinary Generating Function of `Q_2` -/

private noncomputable def primCount (n : ℕ) : ℕ :=
  Nat.card {w : List Bool // w.length = n ∧ w ∈ Q2}

private noncomputable def primOGF (z : ℂ) : ℂ :=
  ∑' n : ℕ, if n = 0 then (0 : ℂ) else (primCount n : ℂ) * z ^ n

private noncomputable def mobTerm (d : ℕ) (z : ℂ) : ℂ :=
  if d = 0 then 0 else (ArithmeticFunction.moebius d : ℂ) * (2 * z ^ d / (1 - 2 * z ^ d))

private noncomputable def mobMeromorphic (z : ℂ) : ℂ :=
  ∑' d : ℕ, mobTerm d z

private def mobDomain : Set ℂ :=
  {z : ℂ | ‖z‖ < 1 ∧ ∀ d : ℕ, 1 ≤ d → 2 * z ^ d ≠ 1}

private lemma norm_moebius_le_one (d : ℕ) : ‖(ArithmeticFunction.moebius d : ℂ)‖ ≤ 1 := by
  by_cases hsf : Squarefree d
  · rw [ArithmeticFunction.moebius_apply_of_squarefree hsf]
    simp [norm_pow]
  · rw [ArithmeticFunction.moebius_eq_zero_of_not_squarefree hsf]
    simp

private lemma ball_half_sub_mobDomain : Metric.ball (0 : ℂ) (1 / 2) ⊆ mobDomain := by
  intro z hz
  rw [Metric.mem_ball, dist_zero_right] at hz
  refine ⟨by linarith, fun d hd heq => ?_⟩
  have hnorm : ‖(2 : ℂ) * z ^ d‖ = 1 := by rw [heq]; simp
  rw [norm_mul, norm_pow, Complex.norm_ofNat] at hnorm
  have hpow : ‖z‖ ^ d ≤ ‖z‖ := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hd
    rw [Nat.add_comm, pow_succ]
    calc ‖z‖ ^ m * ‖z‖ ≤ 1 * ‖z‖ := by
          apply mul_le_mul_of_nonneg_right _ (norm_nonneg z)
          exact pow_le_one₀ (norm_nonneg z) (by linarith)
      _ = ‖z‖ := one_mul _
  linarith

private lemma primOGF_eq_mobMeromorphic {z : ℂ} (hz : ‖z‖ < 1 / 2) :
    primOGF z = mobMeromorphic z := by
  set r : ℝ := ‖z‖
  have hr0 : 0 ≤ r := norm_nonneg z
  have hr1 : r < 1 := by linarith
  have h2r : 2 * r < 1 := by linarith
  let g : ℕ × ℕ → ℂ := fun p =>
    if p.1 = 0 ∨ p.2 = 0 then 0 else (ArithmeticFunction.moebius p.1 : ℂ) * (2 * z ^ p.1) ^ p.2
  have hg_norm : ∀ p : ℕ × ℕ, ‖g p‖ ≤ r ^ (p.1 - 1) * (2 * r) ^ p.2 := by
    intro ⟨d, m⟩
    by_cases h0 : d = 0 ∨ m = 0
    · simp only [g, h0, ↓reduceIte, norm_zero]
      positivity
    · push Not at h0
      rcases h0 with ⟨hd, hm⟩
      simp only [g, hd, hm, or_self, ↓reduceIte, norm_mul, norm_pow, Complex.norm_ofNat]
      have hmu : ‖(ArithmeticFunction.moebius d : ℂ)‖ ≤ 1 := norm_moebius_le_one d
      have hpow_le : r ^ (d * m) ≤ r ^ (d - 1) * r ^ m := by
        rw [← pow_add]
        apply pow_le_pow_of_le_one hr0 (le_of_lt hr1)
        have hd1 : 1 ≤ d := Nat.pos_of_ne_zero hd
        have hm1 : 1 ≤ m := Nat.pos_of_ne_zero hm
        obtain ⟨d', rfl⟩ := Nat.exists_eq_add_of_le hd1
        obtain ⟨m', rfl⟩ := Nat.exists_eq_add_of_le hm1
        simp only [Nat.add_sub_cancel_left]
        nlinarith
      calc ‖(ArithmeticFunction.moebius d : ℂ)‖ * (2 * r ^ d) ^ m
          ≤ 1 * (2 * r ^ d) ^ m := mul_le_mul_of_nonneg_right hmu (by positivity)
        _ = 2 ^ m * r ^ (d * m) := by rw [one_mul, mul_pow, ← pow_mul]
        _ ≤ 2 ^ m * (r ^ (d - 1) * r ^ m) := mul_le_mul_of_nonneg_left hpow_le (by positivity)
        _ = r ^ (d - 1) * (2 * r) ^ m := by rw [mul_pow]; ring
  have hsum_r : Summable (fun d : ℕ => r ^ (d - 1)) := by
    have hbase : Summable (fun d : ℕ => r ^ d) := summable_geometric_of_lt_one hr0 hr1
    rw [← summable_nat_add_iff 1]
    simpa using hbase
  have hsum_2r : Summable (fun m : ℕ => (2 * r) ^ m) :=
    summable_geometric_of_lt_one (by positivity) h2r
  have hg_summable : Summable g := by
    apply Summable.of_norm_bounded (g := fun p : ℕ × ℕ => r ^ (p.1 - 1) * (2 * r) ^ p.2)
    · exact hsum_r.mul_of_nonneg hsum_2r (fun _ => by positivity) (fun _ => by positivity)
    · exact hg_norm
  -- 1. Sum over m first gives `mobMeromorphic z`
  have hsum_prod : ∑' p : ℕ × ℕ, g p = mobMeromorphic z := by
    rw [hg_summable.tsum_prod' (fun d => hg_summable.comp_injective (fun m1 m2 h => by injection h))]
    unfold mobMeromorphic
    congr 1; funext d
    by_cases hd : d = 0
    · simp [g, mobTerm, hd]
    · have hd1 : 1 ≤ d := Nat.pos_of_ne_zero hd
      have hw_lt : ‖(2 : ℂ) * z ^ d‖ < 1 := by
        rw [norm_mul, norm_pow, Complex.norm_ofNat]
        have : r ^ d ≤ r := by
          obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hd1
          rw [Nat.add_comm, pow_succ]
          calc r ^ k * r ≤ 1 * r := mul_le_mul_of_nonneg_right (pow_le_one₀ hr0 (le_of_lt hr1)) hr0
            _ = r := one_mul r
        linarith
      have hgeom : ∑' m : ℕ, (if m = 0 then (0 : ℂ) else (2 * z ^ d) ^ m) =
          (2 * z ^ d) / (1 - 2 * z ^ d) := by
        have hsum_w : Summable (fun m : ℕ => ((2 : ℂ) * z ^ d) ^ m) :=
          summable_geometric_of_norm_lt_one hw_lt
        have hshift := hsum_w.tsum_eq_zero_add
        have htsum_pos : ∑' m : ℕ, (if m = 0 then (0 : ℂ) else ((2 : ℂ) * z ^ d) ^ m) =
            ∑' m : ℕ, ((2 : ℂ) * z ^ d) ^ (m + 1) := by
          have hsumm_if : Summable (fun m : ℕ => if m = 0 then (0 : ℂ) else ((2 : ℂ) * z ^ d) ^ m) := by
            apply Summable.of_norm_bounded (g := fun m => ‖((2 : ℂ) * z ^ d) ^ m‖) hsum_w.norm
            intro m; split_ifs <;> simp
          rw [hsumm_if.tsum_eq_zero_add]
          simp
        rw [htsum_pos]
        have hmul : (fun m : ℕ => ((2 : ℂ) * z ^ d) ^ (m + 1)) =
            fun m => ((2 : ℂ) * z ^ d) * ((2 : ℂ) * z ^ d) ^ m := by
          funext m; rw [pow_succ']
        rw [hmul, tsum_mul_left, tsum_geometric_of_norm_lt_one hw_lt, div_eq_mul_inv]
      have hpull : (fun m : ℕ => g (d, m)) =
          fun m => (ArithmeticFunction.moebius d : ℂ) * (if m = 0 then 0 else (2 * z ^ d) ^ m) := by
        funext m; by_cases hm : m = 0 <;> simp [g, hd, hm]
      rw [hpull, tsum_mul_left, hgeom]
      simp [mobTerm, hd]
  -- 2. Sum over fibers `p.1 * p.2 = n` gives `primOGF z`
  have hsum_fiber : ∑' p : ℕ × ℕ, g p = primOGF z := by
    let hsig : (Σ n : ℕ, {x : ℕ × ℕ // x ∈ n.divisorsAntidiagonal}) → ℂ := fun s => g s.2.1
    let toProd : (Σ n : ℕ, {x : ℕ × ℕ // x ∈ n.divisorsAntidiagonal}) → ℕ × ℕ := fun s => s.2.1
    have htoProd_inj : Function.Injective toProd := by
      rintro ⟨n1, ⟨⟨a1, b1⟩, h1⟩⟩ ⟨n2, ⟨⟨a2, b2⟩, h2⟩⟩ heq
      dsimp [toProd] at heq
      have ha : a1 = a2 := congrArg Prod.fst heq
      have hb : b1 = b2 := congrArg Prod.snd heq
      subst ha; subst hb
      have hn1 : a1 * b1 = n1 := (Nat.mem_divisorsAntidiagonal.mp h1).1
      have hn2 : a1 * b1 = n2 := (Nat.mem_divisorsAntidiagonal.mp h2).1
      have hn : n1 = n2 := hn1.symm.trans hn2
      subst hn; rfl
    have hsig_summ : Summable hsig := hg_summable.comp_injective htoProd_inj
    have hbij : ∑' p : ℕ × ℕ, g p = ∑' s : (Σ n : ℕ, {x : ℕ × ℕ // x ∈ n.divisorsAntidiagonal}), hsig s := by
      refine tsum_eq_tsum_of_ne_zero_bij (f := g) (g := hsig) (fun s => toProd s.1) ?_ ?_ ?_
      · intro s1 s2 h; exact Subtype.ext (htoProd_inj h)
      · intro ⟨a, b⟩ hne
        have hpos : a ≠ 0 ∧ b ≠ 0 := by
          by_contra hc
          apply hne
          have : a = 0 ∨ b = 0 := by tauto
          simp [g, this]
        have hab_ne : a * b ≠ 0 := Nat.mul_ne_zero hpos.1 hpos.2
        have hmem : (a, b) ∈ (a * b).divisorsAntidiagonal :=
          Nat.mem_divisorsAntidiagonal.mpr ⟨rfl, hab_ne⟩
        refine ⟨⟨⟨a * b, ⟨(a, b), hmem⟩⟩, ?_⟩, rfl⟩
        simpa [hsig] using hne
      · intro s; rfl
    rw [hbij, hsig_summ.tsum_sigma' (fun n => hasSum_fintype _ |>.summable)]
    unfold primOGF
    congr 1; funext n
    by_cases hn : n = 0
    · subst hn
      rw [tsum_fintype]
      simp only [hsig, ↓reduceIte]
      rw [Finset.sum_coe_sort (Nat.divisorsAntidiagonal 0) g, Nat.divisorsAntidiagonal_zero]
      simp
    · have hn_pos : 0 < n := Nat.pos_of_ne_zero hn
      rw [tsum_fintype]
      simp only [hsig, hn, ↓reduceIte]
      rw [Finset.sum_coe_sort n.divisorsAntidiagonal (fun x => g x)]
      have hterm_eq : ∀ x ∈ n.divisorsAntidiagonal,
          g x = ((ArithmeticFunction.moebius x.1 : ℂ) * (2 : ℂ) ^ x.2) * z ^ n := by
        intro ⟨d, m⟩ hmem
        have hdm := Nat.mem_divisorsAntidiagonal.mp hmem
        have hd0 : d ≠ 0 := by intro h0; subst h0; simp at hdm; exact hdm.2 hdm.1.symm
        have hm0 : m ≠ 0 := by intro h0; subst h0; simp at hdm; exact hdm.2 hdm.1.symm
        simp only [g, hd0, hm0, or_self, ↓reduceIte]
        rw [mul_pow, ← pow_mul, hdm.1]
        ring
      rw [Finset.sum_congr rfl hterm_eq, ← Finset.sum_mul]
      congr 1
      have hmob := ppl165_primitive_word_count_mobius n hn_pos
      have hmob_c : (primCount n : ℂ) =
          ∑ x ∈ n.divisorsAntidiagonal, (ArithmeticFunction.moebius x.1 : ℂ) * (2 : ℂ) ^ x.2 := by
        have hmob' : ((primCount n : ℤ) : ℂ) =
            ((∑ x ∈ n.divisorsAntidiagonal, (ArithmeticFunction.moebius x.1 : ℤ) * (2 : ℤ) ^ x.2 : ℤ) : ℂ) :=
          congrArg (Int.cast (R := ℂ)) hmob
        simpa using hmob'
      exact hmob_c.symm
  exact hsum_fiber.symm.trans hsum_prod

private lemma isOpen_mobDomain : IsOpen mobDomain := by
  rw [Metric.isOpen_iff]
  intro z₀ hz₀
  rcases hz₀ with ⟨hz₀_lt, hz₀_ne⟩
  set r₀ : ℝ := (1 + ‖z₀‖) / 2
  have hr₀_pos : 0 < r₀ := by dsimp [r₀]; linarith [norm_nonneg z₀]
  have hr₀_lt : r₀ < 1 := by dsimp [r₀]; linarith
  have hδ0 : 0 < (1 - ‖z₀‖) / 2 := by linarith
  -- Choose N such that 2 * r₀ ^ N < 1
  have htend : Filter.Tendsto (fun n : ℕ => r₀ ^ n) Filter.atTop (nhds 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (le_of_lt hr₀_pos) hr₀_lt
  obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.mp htend) (1 / 4) (by norm_num)
  have hN_bound : ∀ d ≥ N, 2 * r₀ ^ d < 1 := by
    intro d hd
    have h1 := hN d hd
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (pow_nonneg (le_of_lt hr₀_pos) d)] at h1
    linarith
  -- For each 1 ≤ d < N, {z | 2 * z^d ≠ 1} is open and contains z₀
  have hfin_open : IsOpen (⋂ d ∈ (Finset.Ico 1 N : Set ℕ), {z : ℂ | 2 * z ^ d ≠ 1}) := by
    apply Set.Finite.isOpen_biInter (Finset.finite_toSet _)
    intro d _
    exact isOpen_ne_fun (continuous_const.mul (continuous_pow d)) continuous_const
  have hz₀_mem : z₀ ∈ (⋂ d ∈ (Finset.Ico 1 N : Set ℕ), {z : ℂ | 2 * z ^ d ≠ 1}) := by
    simp only [Set.mem_iInter, Finset.mem_coe, Finset.mem_Ico, Set.mem_ofPred_eq]
    intro d hd
    exact hz₀_ne d hd.1
  obtain ⟨ε₁, hε₁_pos, hε₁_sub⟩ := Metric.isOpen_iff.mp hfin_open z₀ hz₀_mem
  refine ⟨min ((1 - ‖z₀‖) / 2) ε₁, lt_min hδ0 hε₁_pos, fun z hz => ?_⟩
  rw [Metric.mem_ball] at hz
  have hz_ball1 : dist z z₀ < (1 - ‖z₀‖) / 2 := lt_of_lt_of_le hz (min_le_left _ _)
  have hz_ball2 : dist z z₀ < ε₁ := lt_of_lt_of_le hz (min_le_right _ _)
  have hz_norm : ‖z‖ < r₀ := by
    have htri : ‖z‖ ≤ ‖z - z₀‖ + ‖z₀‖ := by
      simpa using norm_add_le (z - z₀) z₀
    rw [dist_eq_norm] at hz_ball1
    dsimp [r₀]; linarith
  refine ⟨lt_trans hz_norm hr₀_lt, fun d hd => ?_⟩
  by_cases hdN : d < N
  · have hmem := hε₁_sub (Metric.mem_ball.mpr hz_ball2)
    simp only [Set.mem_iInter, Finset.mem_coe, Finset.mem_Ico, Set.mem_ofPred_eq] at hmem
    exact hmem d ⟨hd, hdN⟩
  · intro heq
    have hnorm : ‖(2 : ℂ) * z ^ d‖ = 1 := by rw [heq]; simp
    rw [norm_mul, norm_pow, Complex.norm_ofNat] at hnorm
    have hpow_le : ‖z‖ ^ d ≤ r₀ ^ d := pow_le_pow_left₀ (norm_nonneg z) (le_of_lt hz_norm) d
    have := hN_bound d (by omega)
    linarith

/-- Helper: `mobDomain` is path-connected (hence preconnected) by dodging finitely many poles in `closedBall 0 r`. -/
private lemma isPreconnected_mobDomain : IsPreconnected mobDomain := by
  have h0_mem : (0 : ℂ) ∈ mobDomain := ball_half_sub_mobDomain (by simp)
  -- Show every `z ∈ mobDomain` is joined to `0` in `mobDomain`
  have hjoin0 : ∀ z ∈ mobDomain, JoinedIn mobDomain 0 z := by
    intro z hz
    by_cases hz0 : z = 0
    · subst hz0; exact JoinedIn.refl h0_mem
    · rcases hz with ⟨hz_lt, hz_ne⟩
      set r : ℝ := (1 + ‖z‖) / 2
      have hr_pos : 0 < r := by dsimp [r]; linarith [norm_nonneg z]
      have hr_lt : r < 1 := by dsimp [r]; linarith
      have hz_r : ‖z‖ < r := by dsimp [r]; linarith
      -- Only finitely many d satisfy `2 * r ^ d ≥ 1`
      have htend : Filter.Tendsto (fun n : ℕ => r ^ n) Filter.atTop (nhds 0) :=
        tendsto_pow_atTop_nhds_zero_of_lt_one (le_of_lt hr_pos) hr_lt
      obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.mp htend) (1 / 4) (by norm_num)
      have hN_small : ∀ d ≥ N, 2 * r ^ d < 1 := by
        intro d hd
        have h1 := hN d hd
        rw [Real.dist_eq, sub_zero, abs_of_nonneg (pow_nonneg (le_of_lt hr_pos) d)] at h1
        linarith
      -- Collect all poles in `closedBall 0 r` into a Finset `Poles`
      let polyOf : ℕ → Polynomial ℂ := fun d => Polynomial.C 2 * Polynomial.X ^ d - 1
      have hpoly_ne : ∀ d ≥ 1, polyOf d ≠ 0 := by
        intro d hd heq
        have h0 := congrArg (Polynomial.eval 0) heq
        simp [polyOf, zero_pow (Nat.ne_of_gt hd)] at h0
      classical
      let Poles : Finset ℂ := (Finset.Ico 1 N).biUnion (fun d => (polyOf d).roots.toFinset)
      have hpoles_cover : ∀ w : ℂ, ‖w‖ ≤ r → w ∉ mobDomain → w ∈ Poles := by
        intro w hwr hnot
        have hne_all : ¬ ∀ d : ℕ, 1 ≤ d → 2 * w ^ d ≠ 1 := fun h => hnot ⟨lt_of_le_of_lt hwr hr_lt, h⟩
        push Not at hne_all
        obtain ⟨d, hd1, hwd⟩ := hne_all
        have hd_lt : d < N := by
          by_contra hge
          have hnorm : ‖(2 : ℂ) * w ^ d‖ = 1 := by rw [hwd]; simp
          rw [norm_mul, norm_pow, Complex.norm_ofNat] at hnorm
          have hpow : ‖w‖ ^ d ≤ r ^ d := pow_le_pow_left₀ (norm_nonneg w) hwr d
          have := hN_small d (by omega)
          linarith
        refine Finset.mem_biUnion.mpr ⟨d, Finset.mem_Ico.mpr ⟨hd1, hd_lt⟩, ?_⟩
        rw [Multiset.mem_toFinset, Polynomial.mem_roots (hpoly_ne d hd1)]
        simp [polyOf, hwd]
      -- Pick a tiny `ε > 0` so that for `t ∈ (0, ε)`, midpoint `m(t) = (1/2 + t * I) * z` has `‖m(t)‖ ≤ r`
      set ε : ℝ := min (1 / 4) ((r - ‖z‖) / (2 * ‖z‖ + 1))
      have hε_pos : 0 < ε := by
        apply lt_min (by norm_num)
        apply div_pos (by linarith) (by linarith [norm_nonneg z])
      let m : ℕ → ℂ := fun k => ((1 / 2 : ℂ) + (((ε / (k + 2 : ℝ)) : ℝ) : ℂ) * Complex.I) * z
      have hm_norm : ∀ k : ℕ, ‖m k‖ ≤ r := by
        intro k
        have ht_pos : 0 < ε / (k + 2 : ℝ) := div_pos hε_pos (by positivity)
        have ht_le : ε / (k + 2 : ℝ) ≤ 1 / 4 := by
          have h1 : ε / (k + 2 : ℝ) ≤ ε := div_le_self (le_of_lt hε_pos) (by linarith)
          exact le_trans h1 (min_le_left _ _)
        have hcoef_norm : ‖((1 / 2 : ℂ) + (((ε / (k + 2 : ℝ)) : ℝ) : ℂ) * Complex.I)‖ ≤ 1 := by
          rw [Complex.norm_def]
          apply Real.sqrt_le_one.mpr
          simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im,
            Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
            show (1 / 2 : ℂ).re = 1 / 2 by norm_num, show (1 / 2 : ℂ).im = 0 by norm_num]
          nlinarith
        calc ‖m k‖ = ‖((1 / 2 : ℂ) + (((ε / (k + 2 : ℝ)) : ℝ) : ℂ) * Complex.I)‖ * ‖z‖ := norm_mul _ _
          _ ≤ 1 * ‖z‖ := mul_le_mul_of_nonneg_right hcoef_norm (norm_nonneg z)
          _ ≤ r := by linarith
      -- Show there exists `k : ℕ` such that both segments `[0, m k]` and `[m k, z]` avoid `Poles`!
      -- Each pole `s ∈ Poles` can lie on `[0, m k]` for at most ONE `k`, and on `[m k, z]` for at most ONE `k`!
      have h_inj1 : ∀ s ∈ Poles, ∀ k₁ k₂ : ℕ,
          (∃ lam₁ : ℝ, 0 ≤ lam₁ ∧ lam₁ ≤ 1 ∧ s = (lam₁ : ℂ) * m k₁) →
          (∃ lam₂ : ℝ, 0 ≤ lam₂ ∧ lam₂ ≤ 1 ∧ s = (lam₂ : ℂ) * m k₂) → k₁ = k₂ := by
        intro s hs k₁ k₂ ⟨lam₁, hlam₁0, _, hs1⟩ ⟨lam₂, hlam₂0, _, hs2⟩
        have hs0 : s ≠ 0 := by
          intro h0; subst h0
          obtain ⟨d, hd, hroot⟩ := Finset.mem_biUnion.mp hs
          rw [Multiset.mem_toFinset, Polynomial.mem_roots (hpoly_ne d (Finset.mem_Ico.mp hd).1)] at hroot
          simp [polyOf, zero_pow (Nat.ne_of_gt (Finset.mem_Ico.mp hd).1)] at hroot
        have hlam₁_pos : 0 < lam₁ := by
          by_contra hle
          have : lam₁ = 0 := by linarith
          subst this; simp at hs1; exact hs0 hs1
        have hlam₂_pos : 0 < lam₂ := by
          by_contra hle
          have : lam₂ = 0 := by linarith
          subst this; simp at hs2; exact hs0 hs2
        have heq_c : (lam₁ : ℂ) * ((1 / 2 : ℂ) + (((ε / (k₁ + 2 : ℝ)) : ℝ) : ℂ) * Complex.I) =
            (lam₂ : ℂ) * ((1 / 2 : ℂ) + (((ε / (k₂ + 2 : ℝ)) : ℝ) : ℂ) * Complex.I) := by
          have h := hs1.symm.trans hs2
          dsimp [m] at h
          rw [← mul_assoc, ← mul_assoc] at h
          exact mul_right_cancel₀ hz0 h
        have hre := congrArg Complex.re heq_c
        have him := congrArg Complex.im heq_c
        simp only [Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
          Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
          show (1 / 2 : ℂ).re = 1 / 2 by norm_num, show (1 / 2 : ℂ).im = 0 by norm_num,
          mul_zero, sub_zero, zero_mul, add_zero, mul_one] at hre him
        have hlam_eq : lam₁ = lam₂ := by linarith
        subst hlam_eq
        rw [zero_add, zero_add] at him
        have hdiv_eq : ε / (k₁ + 2 : ℝ) = ε / (k₂ + 2 : ℝ) := mul_left_cancel₀ (ne_of_gt hlam₁_pos) him
        have hden_eq : (k₁ : ℝ) + 2 = (k₂ : ℝ) + 2 := by
          have h1 : (k₁ : ℝ) + 2 ≠ 0 := by positivity
          have h2 : (k₂ : ℝ) + 2 ≠ 0 := by positivity
          have := (div_eq_div_iff h1 h2).mp hdiv_eq
          exact mul_left_cancel₀ (ne_of_gt hε_pos) this.symm
        exact_mod_cast (by linarith : (k₁ : ℝ) = (k₂ : ℝ))
      have h_inj2 : ∀ s ∈ Poles, ∀ k₁ k₂ : ℕ,
          (∃ lam₁ : ℝ, 0 ≤ lam₁ ∧ lam₁ ≤ 1 ∧ s = (1 - (lam₁ : ℂ)) * z + (lam₁ : ℂ) * m k₁) →
          (∃ lam₂ : ℝ, 0 ≤ lam₂ ∧ lam₂ ≤ 1 ∧ s = (1 - (lam₂ : ℂ)) * z + (lam₂ : ℂ) * m k₂) → k₁ = k₂ := by
        intro s hs k₁ k₂ ⟨lam₁, hlam₁0, _, hs1⟩ ⟨lam₂, hlam₂0, _, hs2⟩
        have hsz : s ≠ z := by
          intro hEq; subst hEq
          obtain ⟨d, hd, hroot⟩ := Finset.mem_biUnion.mp hs
          rw [Multiset.mem_toFinset, Polynomial.mem_roots (hpoly_ne d (Finset.mem_Ico.mp hd).1)] at hroot
          simp only [polyOf, Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_mul,
            Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one,
            sub_eq_zero] at hroot
          exact hz_ne d (Finset.mem_Ico.mp hd).1 hroot
        have hlam₁_pos : 0 < lam₁ := by
          by_contra hle
          have : lam₁ = 0 := by linarith
          subst this; simp at hs1; exact hsz hs1
        have hlam₂_pos : 0 < lam₂ := by
          by_contra hle
          have : lam₂ = 0 := by linarith
          subst this; simp at hs2; exact hsz hs2
        have heq_c : (lam₁ : ℂ) * ((-1 / 2 : ℂ) + (((ε / (k₁ + 2 : ℝ)) : ℝ) : ℂ) * Complex.I) =
            (lam₂ : ℂ) * ((-1 / 2 : ℂ) + (((ε / (k₂ + 2 : ℝ)) : ℝ) : ℂ) * Complex.I) := by
          have h := hs1.symm.trans hs2
          have h1 : (1 - (lam₁ : ℂ)) * z + (lam₁ : ℂ) * m k₁ - z =
              ((lam₁ : ℂ) * ((-1 / 2 : ℂ) + (((ε / (k₁ + 2 : ℝ)) : ℝ) : ℂ) * Complex.I)) * z := by
            dsimp [m]; ring
          have h2 : (1 - (lam₂ : ℂ)) * z + (lam₂ : ℂ) * m k₂ - z =
              ((lam₂ : ℂ) * ((-1 / 2 : ℂ) + (((ε / (k₂ + 2 : ℝ)) : ℝ) : ℂ) * Complex.I)) * z := by
            dsimp [m]; ring
          have hsub : (1 - (lam₁ : ℂ)) * z + (lam₁ : ℂ) * m k₁ - z =
              (1 - (lam₂ : ℂ)) * z + (lam₂ : ℂ) * m k₂ - z := congrArg (· - z) h
          rw [h1, h2] at hsub
          exact mul_right_cancel₀ hz0 hsub
        have hre := congrArg Complex.re heq_c
        have him := congrArg Complex.im heq_c
        simp only [Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
          Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
          show (-1 / 2 : ℂ).re = -1 / 2 by norm_num, show (-1 / 2 : ℂ).im = 0 by norm_num,
          mul_zero, sub_zero, zero_mul, add_zero, mul_one] at hre him
        have hlam_eq : lam₁ = lam₂ := by linarith
        subst hlam_eq
        rw [zero_add, zero_add] at him
        have hdiv_eq : ε / (k₁ + 2 : ℝ) = ε / (k₂ + 2 : ℝ) := mul_left_cancel₀ (ne_of_gt hlam₁_pos) him
        have hden_eq : (k₁ : ℝ) + 2 = (k₂ : ℝ) + 2 := by
          have h1 : (k₁ : ℝ) + 2 ≠ 0 := by positivity
          have h2 : (k₂ : ℝ) + 2 ≠ 0 := by positivity
          have := (div_eq_div_iff h1 h2).mp hdiv_eq
          exact mul_left_cancel₀ (ne_of_gt hε_pos) this.symm
        exact_mod_cast (by linarith : (k₁ : ℝ) = (k₂ : ℝ))
      let Bad1 : Finset (Fin (2 * Poles.card + 1)) :=
        Finset.univ.filter (fun k => ∃ s ∈ Poles, ∃ lam : ℝ, 0 ≤ lam ∧ lam ≤ 1 ∧ s = (lam : ℂ) * m k.1)
      let Bad2 : Finset (Fin (2 * Poles.card + 1)) :=
        Finset.univ.filter (fun k => ∃ s ∈ Poles, ∃ lam : ℝ, 0 ≤ lam ∧ lam ≤ 1 ∧ s = (1 - (lam : ℂ)) * z + (lam : ℂ) * m k.1)
      have hBad1_le : Bad1.card ≤ Poles.card := by
        refine Finset.card_le_card_of_injOn (fun k =>
          if h : ∃ s ∈ Poles, ∃ lam : ℝ, 0 ≤ lam ∧ lam ≤ 1 ∧ s = (lam : ℂ) * m k.1 then Classical.choose h else 0) ?_ ?_
        · intro k hk
          have h := (Finset.mem_filter.mp hk).2
          simp only [h, ↓reduceDIte]
          exact (Classical.choose_spec h).1
        · intro k₁ hk₁ k₂ hk₂ heq
          have h₁ := (Finset.mem_filter.mp hk₁).2
          have h₂ := (Finset.mem_filter.mp hk₂).2
          simp only [h₁, h₂, ↓reduceDIte] at heq
          have hs1 := Classical.choose_spec h₁
          have hs2 := Classical.choose_spec h₂
          rw [heq] at hs1
          exact Fin.ext (h_inj1 _ hs2.1 k₁.1 k₂.1 hs1.2 hs2.2)
      have hBad2_le : Bad2.card ≤ Poles.card := by
        refine Finset.card_le_card_of_injOn (fun k =>
          if h : ∃ s ∈ Poles, ∃ lam : ℝ, 0 ≤ lam ∧ lam ≤ 1 ∧ s = (1 - (lam : ℂ)) * z + (lam : ℂ) * m k.1
          then Classical.choose h else 0) ?_ ?_
        · intro k hk
          have h := (Finset.mem_filter.mp hk).2
          simp only [h, ↓reduceDIte]
          exact (Classical.choose_spec h).1
        · intro k₁ hk₁ k₂ hk₂ heq
          have h₁ := (Finset.mem_filter.mp hk₁).2
          have h₂ := (Finset.mem_filter.mp hk₂).2
          simp only [h₁, h₂, ↓reduceDIte] at heq
          have hs1 := Classical.choose_spec h₁
          have hs2 := Classical.choose_spec h₂
          rw [heq] at hs1
          exact Fin.ext (h_inj2 _ hs2.1 k₁.1 k₂.1 hs1.2 hs2.2)
      have hcard_lt : (Bad1 ∪ Bad2).card < (Finset.univ : Finset (Fin (2 * Poles.card + 1))).card := by
        have h1 := Finset.card_union_le Bad1 Bad2
        simp only [Finset.card_univ, Fintype.card_fin]
        omega
      obtain ⟨k, _, hk_not⟩ := Finset.exists_mem_notMem_of_card_lt_card hcard_lt
      have hk_not1 : k ∉ Bad1 := fun h => hk_not (Finset.mem_union_left Bad2 h)
      have hk_not2 : k ∉ Bad2 := fun h => hk_not (Finset.mem_union_right Bad1 h)
      -- Segment 1: `t ↦ (t : ℂ) * m k.1` from `0` to `m k.1` lies in `mobDomain`
      have hseg1 : JoinedIn mobDomain 0 (m k.1) := by
        refine ⟨⟨⟨fun t => ((t : ℝ) : ℂ) * m k.1,
          (Complex.continuous_ofReal.comp continuous_subtype_val).mul continuous_const⟩,
          by simp, by simp⟩, fun t => ?_⟩
        by_contra hnot
        have hnorm : ‖((t : ℝ) : ℂ) * m k.1‖ ≤ r := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg t.2.1]
          calc (t : ℝ) * ‖m k.1‖ ≤ 1 * r := mul_le_mul t.2.2 (hm_norm k.1) (norm_nonneg _) zero_le_one
            _ = r := one_mul r
        have hmemP := hpoles_cover _ hnorm hnot
        exact hk_not1 (Finset.mem_filter.mpr ⟨Finset.mem_univ _, _, hmemP, t.1, t.2.1, t.2.2, rfl⟩)
      -- Segment 2: `t ↦ (t : ℂ) * z + (1 - t : ℂ) * m k.1` from `m k.1` to `z` lies in `mobDomain`
      have hseg2 : JoinedIn mobDomain (m k.1) z := by
        refine ⟨⟨⟨fun t => ((t : ℝ) : ℂ) * z + ((1 - (t : ℝ) : ℝ) : ℂ) * m k.1,
          ((Complex.continuous_ofReal.comp continuous_subtype_val).mul continuous_const).add
            ((Complex.continuous_ofReal.comp (continuous_const.sub continuous_subtype_val)).mul continuous_const)⟩,
          by simp, by simp⟩, fun t => ?_⟩
        by_contra hnot
        have hnorm : ‖((t : ℝ) : ℂ) * z + ((1 - (t : ℝ) : ℝ) : ℂ) * m k.1‖ ≤ r := by
          calc ‖((t : ℝ) : ℂ) * z + ((1 - (t : ℝ) : ℝ) : ℂ) * m k.1‖
              ≤ ‖((t : ℝ) : ℂ) * z‖ + ‖((1 - (t : ℝ) : ℝ) : ℂ) * m k.1‖ := norm_add_le _ _
            _ = (t : ℝ) * ‖z‖ + (1 - (t : ℝ)) * ‖m k.1‖ := by
                rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
                    Real.norm_of_nonneg t.2.1, Real.norm_of_nonneg (by linarith [t.2.2])]
            _ ≤ (t : ℝ) * r + (1 - (t : ℝ)) * r := by
                have h1 : (t : ℝ) * ‖z‖ ≤ (t : ℝ) * r := mul_le_mul_of_nonneg_left (le_of_lt hz_r) t.2.1
                have h2 : (1 - (t : ℝ)) * ‖m k.1‖ ≤ (1 - (t : ℝ)) * r :=
                  mul_le_mul_of_nonneg_left (hm_norm k.1) (by linarith [t.2.2])
                linarith
            _ = r := by ring
        have hmemP := hpoles_cover _ hnorm hnot
        refine hk_not2 (Finset.mem_filter.mpr ⟨Finset.mem_univ _, _, hmemP, 1 - t.1, by linarith [t.2.2], by linarith [t.2.1], ?_⟩)
        push_cast; ring
      exact hseg1.trans hseg2
  have hpc : IsPathConnected mobDomain := ⟨0, h0_mem, fun y hy => hjoin0 y hy⟩
  exact hpc.isConnected.isPreconnected

private lemma analyticOnNhd_mobMeromorphic : AnalyticOnNhd ℂ mobMeromorphic mobDomain := by
  apply DifferentiableOn.analyticOnNhd _ isOpen_mobDomain
  intro z₀ hz₀
  apply DifferentiableAt.differentiableWithinAt
  rcases hz₀ with ⟨hz₀_lt, hz₀_ne⟩
  set r₀ : ℝ := (1 + ‖z₀‖) / 2
  have hr₀_pos : 0 < r₀ := by dsimp [r₀]; linarith [norm_nonneg z₀]
  have hr₀_lt : r₀ < 1 := by dsimp [r₀]; linarith
  have hδ_pos : 0 < (1 - ‖z₀‖) / 2 := by linarith
  have htend : Filter.Tendsto (fun n : ℕ => r₀ ^ n) Filter.atTop (nhds 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (le_of_lt hr₀_pos) hr₀_lt
  obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.mp htend) (1 / 4) (by norm_num)
  have hN_bound : ∀ d ≥ N, 2 * r₀ ^ d ≤ 1 / 2 := by
    intro d hd
    have h1 := hN d hd
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (pow_nonneg (le_of_lt hr₀_pos) d)] at h1
    linarith
  -- Split `mobMeromorphic z` into `∑ d < N, mobTerm d z + ∑' d, mobTerm (d + N) z` on `V = ball z₀ δ`
  let V : Set ℂ := Metric.ball z₀ ((1 - ‖z₀‖) / 2)
  have hV_norm : ∀ z ∈ V, ‖z‖ < r₀ := by
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    have htri : ‖z‖ ≤ ‖z - z₀‖ + ‖z₀‖ := by simpa using norm_add_le (z - z₀) z₀
    dsimp [r₀]; linarith
  have hterm_tail_bound : ∀ (k : ℕ), ∀ z ∈ V, ‖mobTerm (k + N) z‖ ≤ 4 * r₀ ^ (k + N) := by
    intro k z hz
    by_cases h0 : k + N = 0
    · simp only [mobTerm, h0, ↓reduceIte, norm_zero]; positivity
    · rw [mobTerm, if_neg h0, norm_mul, norm_div]
      have hzr : ‖z‖ < r₀ := hV_norm z hz
      have hnum : ‖(2 : ℂ) * z ^ (k + N)‖ ≤ 2 * r₀ ^ (k + N) := by
        rw [norm_mul, norm_pow, Complex.norm_ofNat]
        exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg z) (le_of_lt hzr) _) (by norm_num)
      have hsmall : ‖(2 : ℂ) * z ^ (k + N)‖ ≤ 1 / 2 := le_trans hnum (hN_bound (k + N) (Nat.le_add_left N k))
      have hden : 1 / 2 ≤ ‖1 - (2 : ℂ) * z ^ (k + N)‖ := by
        have htri := norm_sub_norm_le (1 : ℂ) ((2 : ℂ) * z ^ (k + N))
        simp only [norm_one] at htri
        linarith
      have hmu := norm_moebius_le_one (k + N)
      calc ‖(ArithmeticFunction.moebius (k + N) : ℂ)‖ * (‖(2 : ℂ) * z ^ (k + N)‖ / ‖1 - (2 : ℂ) * z ^ (k + N)‖)
          ≤ 1 * (2 * r₀ ^ (k + N) / (1 / 2)) := by
            apply mul_le_mul hmu _ (by positivity) zero_le_one
            exact div_le_div₀ (by positivity) hnum (by norm_num) hden
        _ = 4 * r₀ ^ (k + N) := by ring
  have hsum_tail_u : Summable (fun k : ℕ => 4 * r₀ ^ (k + N)) := by
    have hbase := (summable_geometric_of_lt_one (le_of_lt hr₀_pos) hr₀_lt).mul_left 4
    exact (summable_nat_add_iff N).mpr hbase
  have htail_unif : TendstoUniformlyOn (fun (s : Finset ℕ) (z : ℂ) => ∑ k ∈ s, mobTerm (k + N) z)
      (fun z => ∑' k : ℕ, mobTerm (k + N) z) Filter.atTop V :=
    tendstoUniformlyOn_tsum hsum_tail_u hterm_tail_bound
  have htail_diffOn : DifferentiableOn ℂ (fun z => ∑' k : ℕ, mobTerm (k + N) z) V := by
    apply htail_unif.tendstoLocallyUniformlyOn.differentiableOn _ Metric.isOpen_ball
    filter_upwards with s
    apply DifferentiableOn.fun_sum
    intro k _ z hz
    apply DifferentiableAt.differentiableWithinAt
    by_cases h0 : k + N = 0
    · have hf : mobTerm (k + N) = fun _ => 0 := funext fun w => by rw [mobTerm, if_pos h0]
      rw [hf]; exact differentiableAt_const 0
    · have hf : mobTerm (k + N) =
          fun w => (ArithmeticFunction.moebius (k + N) : ℂ) * (2 * w ^ (k + N) / (1 - 2 * w ^ (k + N))) :=
        funext fun w => by rw [mobTerm, if_neg h0]
      rw [hf]
      have hden_ne : 1 - (2 : ℂ) * z ^ (k + N) ≠ 0 := by
        intro heq
        have hnorm : ‖(2 : ℂ) * z ^ (k + N)‖ = 1 := by
          have : (2 : ℂ) * z ^ (k + N) = 1 := sub_eq_zero.mp heq |>.symm
          rw [this]; simp
        have hzr : ‖z‖ < r₀ := hV_norm z hz
        have hle : ‖(2 : ℂ) * z ^ (k + N)‖ ≤ 2 * r₀ ^ (k + N) := by
          rw [norm_mul, norm_pow, Complex.norm_ofNat]
          exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg z) (le_of_lt hzr) _) (by norm_num)
        linarith [hN_bound (k + N) (Nat.le_add_left N k)]
      exact (differentiableAt_const _).mul
        (((differentiableAt_const _).mul (differentiableAt_pow _)).div
          ((differentiableAt_const _).sub ((differentiableAt_const _).mul (differentiableAt_pow _))) hden_ne)
  have htail_diffAt : DifferentiableAt ℂ (fun z => ∑' k : ℕ, mobTerm (k + N) z) z₀ :=
    htail_diffOn.differentiableAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ_pos))
  have hhead_diffAt : DifferentiableAt ℂ (fun z => ∑ d ∈ Finset.range N, mobTerm d z) z₀ := by
    apply DifferentiableAt.fun_sum
    intro d _
    by_cases h0 : d = 0
    · have hf : mobTerm d = fun _ => 0 := funext fun w => by rw [mobTerm, if_pos h0]
      rw [hf]; exact differentiableAt_const 0
    · have hf : mobTerm d =
          fun w => (ArithmeticFunction.moebius d : ℂ) * (2 * w ^ d / (1 - 2 * w ^ d)) :=
        funext fun w => by rw [mobTerm, if_neg h0]
      rw [hf]
      have hden_ne : 1 - (2 : ℂ) * z₀ ^ d ≠ 0 := by
        intro heq
        exact hz₀_ne d (Nat.pos_of_ne_zero h0) (sub_eq_zero.mp heq).symm
      exact (differentiableAt_const _).mul
        (((differentiableAt_const _).mul (differentiableAt_pow _)).div
          ((differentiableAt_const _).sub ((differentiableAt_const _).mul (differentiableAt_pow _))) hden_ne)
  -- Show `mobMeromorphic =ᶠ[nhds z₀] (head + tail)`
  have heq_nhds : mobMeromorphic =ᶠ[nhds z₀]
      fun z => (∑ d ∈ Finset.range N, mobTerm d z) + (∑' k : ℕ, mobTerm (k + N) z) := by
    filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ_pos)] with z hz
    unfold mobMeromorphic
    have hsumm : Summable (fun d : ℕ => mobTerm d z) := by
      rw [← summable_nat_add_iff N]
      exact Summable.of_norm_bounded hsum_tail_u (fun k => hterm_tail_bound k z hz)
    exact (hsumm.sum_add_tsum_nat_add N).symm
  exact (hhead_diffAt.add htail_diffAt).congr_of_eventuallyEq heq_nhds

/-- Helper: `Polynomial.eval` is analytic everywhere on `ℂ`. -/
private lemma analyticOnNhd_poly_eval (p : Polynomial ℂ) (U : Set ℂ) (hU : IsOpen U) :
    AnalyticOnNhd ℂ (fun z : ℂ => p.eval z) U := by
  apply DifferentiableOn.analyticOnNhd _ hU
  intro z _
  apply DifferentiableAt.differentiableWithinAt
  have heq : (fun w : ℂ => p.eval w) = fun w => ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i * w ^ i := by
    funext w; exact Polynomial.eval_eq_sum_range w
  rw [heq]
  apply DifferentiableAt.fun_sum
  intro i _
  exact (differentiableAt_const _).mul (differentiableAt_pow i)

/-- **Theorem 5 (Analytic Transcendence of the Generating Function of `Q_2`):**
The ordinary generating series `P(z) = ∑_{n ≥ 1} q_n z^n` of binary primitive words is
**transcendental** over `ℂ[z]` (hence over `ℚ(z)`): no nonzero polynomial relation
`∑_{j=0}^D A_j(z) · P(z)^j = 0` with `A_D ≠ 0` can vanish on `‖z‖ < 1 / 2`.
By the Chomsky–Schützenberger enumeration theorem, this provides the analytic obstruction
separating `Q_2` from all unambiguous context-free languages (`UCFL`). -/
theorem ppl165_generating_function_transcendental
    (D : ℕ) (A : Fin (D + 1) → Polynomial ℂ) (hAD : A ⟨D, Nat.lt_succ_self D⟩ ≠ 0) :
    ∃ z : ℂ, ‖z‖ < 1 / 2 ∧
      ∑ j : Fin (D + 1), (A j).eval z *
        (∑' n : ℕ, if n = 0 then (0 : ℂ) else
          (Nat.card {w : List Bool // w.length = n ∧ w ≠ [] ∧
            ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten} : ℂ) * z ^ n) ^ j.1 ≠ 0 := by
  by_contra h_all
  push Not at h_all
  let G : ℂ → ℂ := fun z => ∑ j : Fin (D + 1), (A j).eval z * (mobMeromorphic z) ^ j.1
  have hG_ana : AnalyticOnNhd ℂ G mobDomain := by
    apply Finset.analyticOnNhd_fun_sum
    intro j _
    exact (analyticOnNhd_poly_eval (A j) mobDomain isOpen_mobDomain).mul
      (analyticOnNhd_mobMeromorphic.pow j.1)
  have hG_ev : G =ᶠ[nhds (0 : ℂ)] 0 := by
    filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (by norm_num : (0 : ℝ) < 1 / 2))] with z hz
    rw [Metric.mem_ball, dist_zero_right] at hz
    have hPF : primOGF z = mobMeromorphic z := primOGF_eq_mobMeromorphic hz
    show G z = 0
    dsimp only [G]
    rw [← hPF]
    exact h_all z hz
  have hG_zero : Set.EqOn G 0 mobDomain :=
    hG_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero isPreconnected_mobDomain
      (ball_half_sub_mobDomain (by simp)) hG_ev
  -- For EVERY prime `p`, prove `(A ⟨D, _⟩).eval ((2 : ℝ) ^ (-(1 : ℝ) / (p : ℝ)) : ℂ) = 0`!
  have hprime_root : ∀ p : ℕ, Nat.Prime p →
      (A ⟨D, Nat.lt_succ_self D⟩).eval (((2 : ℝ) ^ (-(1 : ℝ) / (p : ℝ)) : ℝ) : ℂ) = 0 := by
    intro p hp
    have hp_pos : (0 : ℝ) < (p : ℝ) := Nat.cast_pos.mpr hp.pos
    set rp : ℝ := (2 : ℝ) ^ (-(1 : ℝ) / (p : ℝ))
    have hrp_pos : 0 < rp := Real.rpow_pos_of_pos (by norm_num) _
    have hrp_lt1 : rp < 1 := by
      dsimp [rp]
      rw [Real.rpow_lt_one_iff (by norm_num : (0 : ℝ) ≤ 2)]
      right; left
      exact ⟨by norm_num, by exact div_neg_of_neg_of_pos (by norm_num) hp_pos⟩
    have hrp_pow_p : 2 * rp ^ p = 1 := by
      dsimp [rp]
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      have hexp : -(1 : ℝ) / (p : ℝ) * (p : ℝ) = -1 := by field_simp
      rw [hexp, Real.rpow_neg_one]
      norm_num
    -- For every `d ≥ p + 1`, `2 * rp ^ d ≤ 2 * rp ^ (p + 1) = rp < 1`!
    have hrp_tail_small : ∀ d ≥ p + 1, 2 * rp ^ d ≤ rp := by
      intro d hd
      have hpow : rp ^ d ≤ rp ^ (p + 1) := pow_le_pow_of_le_one (le_of_lt hrp_pos) (le_of_lt hrp_lt1) hd
      calc 2 * rp ^ d ≤ 2 * rp ^ (p + 1) := mul_le_mul_of_nonneg_left hpow (by norm_num)
        _ = (2 * rp ^ p) * rp := by rw [pow_succ]; ring
        _ = rp := by rw [hrp_pow_p, one_mul]
    -- For every `1 ≤ d < p`, `2 * rp ^ d > 1`!
    have hrp_head_gt : ∀ d : ℕ, 1 ≤ d → d < p → 1 < 2 * rp ^ d := by
      intro d _ hdp
      have hpow : rp ^ p < rp ^ d := pow_lt_pow_right_of_lt_one₀ hrp_pos hrp_lt1 hdp
      linarith [hrp_pow_p]
    -- Approach `rp` from the left via `x k = rp - rp / (k + 2)`!
    let x : ℕ → ℝ := fun k => rp - rp / (k + 2 : ℝ)
    let z : ℕ → ℂ := fun k => (x k : ℂ)
    have hx_tend : Filter.Tendsto x Filter.atTop (nhds rp) := by
      have h1 : Filter.Tendsto (fun k : ℕ => rp / ((k : ℝ) + 2)) Filter.atTop (nhds 0) := by
        have hden : Filter.Tendsto (fun k : ℕ => (k : ℝ) + 2) Filter.atTop Filter.atTop :=
          Filter.Tendsto.atTop_add tendsto_natCast_atTop_atTop tendsto_const_nhds
        exact tendsto_const_nhds.div_atTop hden
      simpa using tendsto_const_nhds.sub h1
    have hz_tend : Filter.Tendsto z Filter.atTop (nhds (rp : ℂ)) :=
      Complex.continuous_ofReal.continuousAt.tendsto.comp hx_tend
    have hx_bounds : ∀ k : ℕ, 0 < x k ∧ x k < rp := by
      intro k
      have hk2 : (2 : ℝ) ≤ (k : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) k]
      have hdiv_pos : 0 < rp / ((k : ℝ) + 2) := div_pos hrp_pos (by linarith)
      have hdiv_lt : rp / ((k : ℝ) + 2) < rp := (div_lt_iff₀ (by linarith)).mpr (by nlinarith)
      exact ⟨by dsimp [x]; linarith, by dsimp [x]; linarith⟩
    -- Eventually `z k ∈ mobDomain`
    have hz_ev_dom : ∀ᶠ k in Filter.atTop, z k ∈ mobDomain := by
      have hhead_ev : ∀ d ∈ Finset.Ico 1 p, ∀ᶠ k in Filter.atTop, 1 < 2 * (x k) ^ d := by
        intro d hd
        have hd_gt := hrp_head_gt d (Finset.mem_Ico.mp hd).1 (Finset.mem_Ico.mp hd).2
        have ht : Filter.Tendsto (fun k => 2 * (x k) ^ d) Filter.atTop (nhds (2 * rp ^ d)) :=
          tendsto_const_nhds.mul (hx_tend.pow d)
        exact ht.eventually (Ioi_mem_nhds hd_gt)
      have hall_head : ∀ᶠ k in Filter.atTop, ∀ d ∈ Finset.Ico 1 p, 1 < 2 * (x k) ^ d :=
        Filter.eventually_all_finset (Finset.Ico 1 p) |>.mpr hhead_ev
      filter_upwards [hall_head] with k hk
      have ⟨hx0, hxrp⟩ := hx_bounds k
      refine ⟨?_, fun d hd => ?_⟩
      · rw [Complex.norm_real, Real.norm_of_nonneg (le_of_lt hx0)]
        exact lt_trans hxrp hrp_lt1
      · intro heq
        have hre : 2 * (x k) ^ d = 1 := by
          have hcast : ((2 * (x k) ^ d : ℝ) : ℂ) = ((1 : ℝ) : ℂ) := by
            simpa [z] using heq
          exact Complex.ofReal_injective hcast
        by_cases hdp : d < p
        · have := hk d (Finset.mem_Ico.mpr ⟨hd, hdp⟩)
          linarith
        · have hpow1 : (x k) ^ d < rp ^ d := pow_lt_pow_left₀ hxrp (le_of_lt hx0) (by omega)
          have hpow2 : rp ^ d ≤ rp ^ p := pow_le_pow_of_le_one (le_of_lt hrp_pos) (le_of_lt hrp_lt1) (by omega)
          linarith [hrp_pow_p]
    -- Prove `‖mobMeromorphic (z k)‖ → +∞` as `k → ∞`!
    have hF_blowup : Filter.Tendsto (fun k => ‖mobMeromorphic (z k)‖) Filter.atTop Filter.atTop := by
      have htail_bound : ∀ k : ℕ, ∀ m : ℕ, ‖mobTerm (m + (p + 1)) (z k)‖ ≤ (2 / (1 - rp)) * rp ^ (m + (p + 1)) := by
        intro k m
        have ⟨hx0, hxrp⟩ := hx_bounds k
        have hne0 : m + (p + 1) ≠ 0 := by omega
        rw [mobTerm, if_neg hne0, norm_mul, norm_div]
        have hmu := norm_moebius_le_one (m + (p + 1))
        have hnum : ‖(2 : ℂ) * (z k) ^ (m + (p + 1))‖ ≤ 2 * rp ^ (m + (p + 1)) := by
          rw [norm_mul, norm_pow, Complex.norm_ofNat, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hx0)]
          exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (le_of_lt hx0) (le_of_lt hxrp) _) (by norm_num)
        have hsmall : ‖(2 : ℂ) * (z k) ^ (m + (p + 1))‖ ≤ rp :=
          le_trans hnum (hrp_tail_small (m + (p + 1)) (by omega))
        have hden : 1 - rp ≤ ‖1 - (2 : ℂ) * (z k) ^ (m + (p + 1))‖ := by
          have htri := norm_sub_norm_le (1 : ℂ) ((2 : ℂ) * (z k) ^ (m + (p + 1)))
          simp only [norm_one] at htri
          linarith
        calc ‖(ArithmeticFunction.moebius (m + (p + 1)) : ℂ)‖ *
              (‖(2 : ℂ) * (z k) ^ (m + (p + 1))‖ / ‖1 - (2 : ℂ) * (z k) ^ (m + (p + 1))‖)
            ≤ 1 * (2 * rp ^ (m + (p + 1)) / (1 - rp)) := by
              apply mul_le_mul hmu _ (by positivity) zero_le_one
              exact div_le_div₀ (by positivity) hnum (by linarith) hden
          _ = (2 / (1 - rp)) * rp ^ (m + (p + 1)) := by ring
      have hsum_u : Summable (fun m : ℕ => (2 / (1 - rp)) * rp ^ (m + (p + 1))) := by
        have hbase := (summable_geometric_of_lt_one (le_of_lt hrp_pos) hrp_lt1).mul_left (2 / (1 - rp))
        exact (summable_nat_add_iff (p + 1)).mpr hbase
      set C_tail : ℝ := ∑' m : ℕ, (2 / (1 - rp)) * rp ^ (m + (p + 1))
      have htail_le : ∀ k : ℕ, ‖∑' m : ℕ, mobTerm (m + (p + 1)) (z k)‖ ≤ C_tail := by
        intro k
        have hsumm_k : Summable (fun m : ℕ => mobTerm (m + (p + 1)) (z k)) :=
          Summable.of_norm_bounded hsum_u (htail_bound k)
        calc ‖∑' m : ℕ, mobTerm (m + (p + 1)) (z k)‖
            ≤ ∑' m : ℕ, ‖mobTerm (m + (p + 1)) (z k)‖ := norm_tsum_le_tsum_norm hsumm_k.norm
          _ ≤ C_tail := hsumm_k.norm.tsum_le_tsum (htail_bound k) hsum_u
      have hhead_tend : Filter.Tendsto (fun k => ∑ d ∈ Finset.range p, mobTerm d (z k))
          Filter.atTop (nhds (∑ d ∈ Finset.range p, mobTerm d (rp : ℂ))) := by
        apply tendsto_finsetSum
        intro d hd
        by_cases hd0 : d = 0
        · simp only [mobTerm, hd0, ↓reduceIte]; exact tendsto_const_nhds
        · simp only [mobTerm, hd0, ↓reduceIte]
          have hden_ne : 1 - (2 : ℂ) * (rp : ℂ) ^ d ≠ 0 := by
            intro heq
            have hre : 1 - 2 * rp ^ d = 0 := by
              have hcast : ((1 - 2 * rp ^ d : ℝ) : ℂ) = ((0 : ℝ) : ℂ) := by
                simpa using heq
              exact Complex.ofReal_injective hcast
            linarith [hrp_head_gt d (Nat.pos_of_ne_zero hd0) (Finset.mem_range.mp hd)]
          exact tendsto_const_nhds.mul
            ((tendsto_const_nhds.mul (hz_tend.pow d)).div
              (tendsto_const_nhds.sub (tendsto_const_nhds.mul (hz_tend.pow d))) hden_ne)
      have hhead_ev_bdd : ∀ᶠ k in Filter.atTop,
          ‖∑ d ∈ Finset.range p, mobTerm d (z k)‖ ≤ ‖∑ d ∈ Finset.range p, mobTerm d (rp : ℂ)‖ + 1 := by
        have hn := hhead_tend.norm
        exact hn.eventually (Iio_mem_nhds (lt_add_one _)) |>.mono fun k hk => le_of_lt hk
      have hpole_blowup : Filter.Tendsto (fun k => ‖mobTerm p (z k)‖) Filter.atTop Filter.atTop := by
        have hmu_p : ArithmeticFunction.moebius p = -1 := ArithmeticFunction.moebius_apply_prime hp
        have hp0 : p ≠ 0 := Nat.ne_of_gt hp.pos
        have hterm_eq : (fun k => ‖mobTerm p (z k)‖) = fun k => (2 * (x k) ^ p) / (1 - 2 * (x k) ^ p) := by
          funext k
          have ⟨hx0, hxrp⟩ := hx_bounds k
          have hpow_lt : 2 * (x k) ^ p < 1 := by
            have := pow_lt_pow_left₀ hxrp (le_of_lt hx0) hp0
            linarith [hrp_pow_p]
          rw [mobTerm, if_neg hp0, hmu_p]
          simp only [Int.cast_neg, Int.cast_one, neg_mul, one_mul, norm_neg, norm_div]
          have h1 : (2 : ℂ) * (z k) ^ p = ((2 * (x k) ^ p : ℝ) : ℂ) := by
            simp [z]
          have h2 : (1 : ℂ) - (2 : ℂ) * (z k) ^ p = ((1 - 2 * (x k) ^ p : ℝ) : ℂ) := by
            simp [z]
          rw [h2, h1, Complex.norm_real, Complex.norm_real,
              Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg (by linarith)]
        rw [hterm_eq]
        have hnum_tend : Filter.Tendsto (fun k => (2 : ℝ) * (x k) ^ p) Filter.atTop (nhds 1) := by
          have h := (tendsto_const_nhds (x := (2 : ℝ))).mul (hx_tend.pow p)
          rwa [hrp_pow_p] at h
        have hden_tend : Filter.Tendsto (fun k => (1 : ℝ) - 2 * (x k) ^ p) Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) := by
          rw [tendsto_nhdsWithin_iff]
          refine ⟨?_, ?_⟩
          · have h := (tendsto_const_nhds (x := (1 : ℝ))).sub hnum_tend
            simpa using h
          · filter_upwards with k
            have ⟨hx0, hxrp⟩ := hx_bounds k
            have := pow_lt_pow_left₀ hxrp (le_of_lt hx0) hp0
            show 0 < 1 - 2 * (x k) ^ p
            linarith [hrp_pow_p]
        have hinv_tend : Filter.Tendsto (fun k => (1 - 2 * (x k) ^ p)⁻¹) Filter.atTop Filter.atTop :=
          tendsto_inv_nhdsGT_zero.comp hden_tend
        have hprod := Filter.Tendsto.pos_mul_atTop (by norm_num : (0 : ℝ) < 1) hnum_tend hinv_tend
        simpa [div_eq_mul_inv] using hprod
      -- Combine: `‖mobMeromorphic (z k)‖ ≥ ‖mobTerm p (z k)‖ - (C_head + C_tail)`!
      set C_head : ℝ := ‖∑ d ∈ Finset.range p, mobTerm d (rp : ℂ)‖ + 1
      have hge_ev : ∀ᶠ k in Filter.atTop, ‖mobTerm p (z k)‖ - (C_head + C_tail) ≤ ‖mobMeromorphic (z k)‖ := by
        filter_upwards [hhead_ev_bdd] with k hk
        have hsumm_k : Summable (fun d : ℕ => mobTerm d (z k)) := by
          rw [← summable_nat_add_iff (p + 1)]
          exact Summable.of_norm_bounded hsum_u (htail_bound k)
        have hsplit : mobMeromorphic (z k) =
            mobTerm p (z k) + ((∑ d ∈ Finset.range p, mobTerm d (z k)) + ∑' m : ℕ, mobTerm (m + (p + 1)) (z k)) := by
          unfold mobMeromorphic
          rw [← hsumm_k.sum_add_tsum_nat_add (p + 1), Finset.sum_range_succ]
          ring
        have htri := norm_sub_norm_le (mobTerm p (z k))
          (-((∑ d ∈ Finset.range p, mobTerm d (z k)) + ∑' m : ℕ, mobTerm (m + (p + 1)) (z k)))
        rw [sub_neg_eq_add, ← hsplit, norm_neg] at htri
        have hht_le : ‖(∑ d ∈ Finset.range p, mobTerm d (z k)) + ∑' m : ℕ, mobTerm (m + (p + 1)) (z k)‖ ≤ C_head + C_tail :=
          le_trans (norm_add_le _ _) (add_le_add hk (htail_le k))
        linarith
      exact Filter.tendsto_atTop_mono' Filter.atTop hge_ev
        (Filter.Tendsto.atTop_add hpole_blowup tendsto_const_nhds)
    -- Deduce `(A ⟨D, _⟩).eval (rp : ℂ) = 0` from `G (z k) = 0` and `‖mobMeromorphic (z k)‖ → ∞`!
    have hpoly_tend : ∀ j : Fin (D + 1),
        Filter.Tendsto (fun k => (A j).eval (z k)) Filter.atTop (nhds ((A j).eval (rp : ℂ))) := by
      intro j
      have heq : (fun w : ℂ => (A j).eval w) = fun w => ∑ i ∈ Finset.range ((A j).natDegree + 1), (A j).coeff i * w ^ i := by
        funext w; exact Polynomial.eval_eq_sum_range w
      have hcont : Continuous (fun w : ℂ => (A j).eval w) := by
        rw [heq]
        exact continuous_finsetSum _ (fun i _ => continuous_const.mul (continuous_pow i))
      exact hcont.continuousAt.tendsto.comp hz_tend
    have hF_inv_tend : Filter.Tendsto (fun k => (mobMeromorphic (z k))⁻¹) Filter.atTop (nhds 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      simp_rw [norm_inv]
      exact tendsto_inv_atTop_zero.comp hF_blowup
    have hF_ne0_ev : ∀ᶠ k in Filter.atTop, mobMeromorphic (z k) ≠ 0 := by
      filter_upwards [hF_blowup.eventually (Filter.eventually_gt_atTop 0)] with k hk
      exact norm_pos_iff.mp hk
    have hAD_eq_ev : ∀ᶠ k in Filter.atTop,
        (A ⟨D, Nat.lt_succ_self D⟩).eval (z k) =
          - ∑ j : Fin D, (A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * ((mobMeromorphic (z k))⁻¹) ^ (D - j.1) := by
      filter_upwards [hz_ev_dom, hF_ne0_ev] with k hk_dom hk_ne0
      have hGk : G (z k) = 0 := hG_zero hk_dom
      dsimp [G] at hGk
      rw [Fin.sum_univ_castSucc] at hGk
      have hdiv_eq : (A ⟨D, Nat.lt_succ_self D⟩).eval (z k) * (mobMeromorphic (z k)) ^ D =
          - ∑ j : Fin D, (A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * (mobMeromorphic (z k)) ^ j.1 := by
        have h1 : (A (Fin.last D)).eval (z k) * (mobMeromorphic (z k)) ^ D =
            - ∑ j : Fin D, (A j.castSucc).eval (z k) * (mobMeromorphic (z k)) ^ j.1 :=
          eq_neg_of_add_eq_zero_right hGk
        rw [show (⟨D, Nat.lt_succ_self D⟩ : Fin (D + 1)) = Fin.last D from rfl, h1]
        rfl
      have hpow_ne : (mobMeromorphic (z k)) ^ D ≠ 0 := pow_ne_zero D hk_ne0
      calc (A ⟨D, Nat.lt_succ_self D⟩).eval (z k)
          = ((A ⟨D, Nat.lt_succ_self D⟩).eval (z k) * (mobMeromorphic (z k)) ^ D) * ((mobMeromorphic (z k)) ^ D)⁻¹ := by
              rw [mul_inv_cancel_right₀ hpow_ne]
        _ = (- ∑ j : Fin D, (A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * (mobMeromorphic (z k)) ^ j.1) *
              ((mobMeromorphic (z k)) ^ D)⁻¹ := by rw [hdiv_eq]
        _ = - ∑ j : Fin D, ((A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * (mobMeromorphic (z k)) ^ j.1) *
              ((mobMeromorphic (z k)) ^ D)⁻¹ := by rw [neg_mul, Finset.sum_mul]
        _ = - ∑ j : Fin D, (A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * ((mobMeromorphic (z k))⁻¹) ^ (D - j.1) := by
              congr 1
              apply Finset.sum_congr rfl
              intro j _
              rw [mul_assoc]
              congr 1
              have hsplit_pow : (mobMeromorphic (z k)) ^ D =
                  (mobMeromorphic (z k)) ^ j.1 * (mobMeromorphic (z k)) ^ (D - j.1) := by
                rw [← pow_add, Nat.add_sub_of_le (Nat.le_of_lt j.2)]
              rw [hsplit_pow, mul_inv, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hk_ne0), one_mul, inv_pow]
    have hrhs_tend : Filter.Tendsto (fun k =>
        - ∑ j : Fin D, (A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * ((mobMeromorphic (z k))⁻¹) ^ (D - j.1))
        Filter.atTop (nhds 0) := by
      have hsum_tend : Filter.Tendsto (fun k =>
          ∑ j : Fin D, (A ⟨j.1, Nat.lt_succ_of_lt j.2⟩).eval (z k) * ((mobMeromorphic (z k))⁻¹) ^ (D - j.1))
          Filter.atTop (nhds (∑ _j : Fin D, (0 : ℂ))) := by
        apply tendsto_finsetSum
        intro j _
        have hpos : D - j.1 ≠ 0 := by omega
        have hpow_tend : Filter.Tendsto (fun k => ((mobMeromorphic (z k))⁻¹) ^ (D - j.1)) Filter.atTop (nhds 0) := by
          simpa [zero_pow hpos] using hF_inv_tend.pow (D - j.1)
        simpa using (hpoly_tend ⟨j.1, Nat.lt_succ_of_lt j.2⟩).mul hpow_tend
      simpa using hsum_tend.neg
    have hlhs_tend : Filter.Tendsto (fun k => (A ⟨D, Nat.lt_succ_self D⟩).eval (z k))
        Filter.atTop (nhds ((A ⟨D, Nat.lt_succ_self D⟩).eval (rp : ℂ))) :=
      hpoly_tend ⟨D, Nat.lt_succ_self D⟩
    exact tendsto_nhds_unique (hlhs_tend.congr' hAD_eq_ev) hrhs_tend
  let M := (A ⟨D, Nat.lt_succ_self D⟩).natDegree + 1
  have hex_primes : ∀ m : ℕ, ∃ S : Finset ℕ, S.card = m ∧ ∀ p ∈ S, Nat.Prime p := by
    intro m
    induction m with
    | zero => exact ⟨∅, rfl, fun _ h => by simp at h⟩
    | succ m ih =>
      obtain ⟨S, hScard, hSprime⟩ := ih
      obtain ⟨q, hq_ge, hq_prime⟩ := Nat.exists_infinite_primes (S.sup id + 1)
      have hq_not : q ∉ S := by
        intro hmem
        have : q ≤ S.sup id := Finset.le_sup (f := id) hmem
        omega
      refine ⟨insert q S, by rw [Finset.card_insert_of_notMem hq_not, hScard], fun p hp => ?_⟩
      rcases Finset.mem_insert.mp hp with rfl | hpS
      · exact hq_prime
      · exact hSprime p hpS
  obtain ⟨S, hScard, hSprime⟩ := hex_primes M
  let f : ℕ → ℂ := fun p => (((2 : ℝ) ^ (-(1 : ℝ) / (p : ℝ)) : ℝ) : ℂ)
  have hf_inj : Set.InjOn f S := by
    intro p₁ hp₁ p₂ hp₂ heq
    have hre : (2 : ℝ) ^ (-(1 : ℝ) / (p₁ : ℝ)) = (2 : ℝ) ^ (-(1 : ℝ) / (p₂ : ℝ)) :=
      Complex.ofReal_injective heq
    have hexp : -(1 : ℝ) / (p₁ : ℝ) = -(1 : ℝ) / (p₂ : ℝ) :=
      (Real.rpow_right_inj (by norm_num : (0 : ℝ) < 2) (by norm_num : (2 : ℝ) ≠ 1)).mp hre
    have hp₁_pos : (p₁ : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt (hSprime p₁ hp₁).pos)
    have hp₂_pos : (p₂ : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt (hSprime p₂ hp₂).pos)
    have hinv : (p₁ : ℝ) = (p₂ : ℝ) := by
      have := (div_eq_div_iff hp₁_pos hp₂_pos).mp hexp
      linarith
    exact_mod_cast hinv
  have hsub_roots : S.image f ⊆ (A ⟨D, Nat.lt_succ_self D⟩).roots.toFinset := by
    intro z hz
    obtain ⟨p, hpS, rfl⟩ := Finset.mem_image.mp hz
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hAD]
    exact hprime_root p (hSprime p hpS)
  have hcard1 : M ≤ (A ⟨D, Nat.lt_succ_self D⟩).roots.card := by
    calc M = S.card := hScard.symm
      _ = (S.image f).card := (Finset.card_image_of_injOn hf_inj).symm
      _ ≤ (A ⟨D, Nat.lt_succ_self D⟩).roots.toFinset.card := Finset.card_le_card hsub_roots
      _ ≤ (A ⟨D, Nat.lt_succ_self D⟩).roots.card := Multiset.toFinset_card_le _
  have hcard2 : (A ⟨D, Nat.lt_succ_self D⟩).roots.card ≤ (A ⟨D, Nat.lt_succ_self D⟩).natDegree :=
    Polynomial.card_roots' _
  dsimp [M] at hcard1
  omega

/-! ### Part IV: Strong Single-Character Pumping & Formal Bar-Hillel Barrier on `Q_2` -/

/-- **Two-Periodicity Lemma on `ZMod s`:**
No sequence `b : ZMod s → ℕ` can become periodic after decrementing at two distinct positions
`j₁ ≠ j₂` both having value `M ≥ 1`. -/
private lemma zmod_two_periodic_impossible {s : ℕ} [NeZero s]
    {f g : ZMod s → ℕ} {j₁ j₂ : ZMod s} {p₁ p₂ M : ℕ}
    (hne : j₁ ≠ j₂) (hM : 1 ≤ M)
    (hp₁_pos : 1 ≤ p₁) (hp₁_lt : p₁ < s) (hf_per : ∀ x : ZMod s, f (x + (p₁ : ZMod s)) = f x)
    (hp₂_pos : 1 ≤ p₂) (hp₂_lt : p₂ < s) (hg_per : ∀ x : ZMod s, g (x + (p₂ : ZMod s)) = g x)
    (hagree : ∀ x : ZMod s, x ≠ j₁ → x ≠ j₂ → f x = g x)
    (hf1 : f j₁ = M - 1) (hg1 : g j₁ = M) (hf2 : f j₂ = M) (hg2 : g j₂ = M - 1) :
    False := by
  have hM_ne : M - 1 ≠ M := by omega
  have hf_sub : ∀ x : ZMod s, f (x - (p₁ : ZMod s)) = f x := fun x => by
    have := hf_per (x - (p₁ : ZMod s))
    simpa [sub_add_cancel] using this.symm
  have hg_sub : ∀ x : ZMod s, g (x - (p₂ : ZMod s)) = g x := fun x => by
    have := hg_per (x - (p₂ : ZMod s))
    simpa [sub_add_cancel] using this.symm
  have hp₁_ne0 : (p₁ : ZMod s) ≠ 0 := by
    intro h0
    have hdvd : s ∣ p₁ := (ZMod.natCast_eq_zero_iff p₁ s).mp h0
    exact absurd (Nat.le_of_dvd (by omega) hdvd) (by omega)
  have hp₂_ne0 : (p₂ : ZMod s) ≠ 0 := by
    intro h0
    have hdvd : s ∣ p₂ := (ZMod.natCast_eq_zero_iff p₂ s).mp h0
    exact absurd (Nat.le_of_dvd (by omega) hdvd) (by omega)
  -- `g (j₁ + p₁) = M - 1` and `g (j₁ - p₁) = M - 1`
  have hg_p1 : g (j₁ + (p₁ : ZMod s)) = M - 1 := by
    have h1 : j₁ + (p₁ : ZMod s) ≠ j₁ := fun h => hp₁_ne0 (by simpa using congrArg (· - j₁) h)
    have h2 : j₁ + (p₁ : ZMod s) ≠ j₂ := by
      intro h; have := hf_per j₁; rw [h, hf2, hf1] at this; exact hM_ne this.symm
    rw [← hagree _ h1 h2, hf_per, hf1]
  have hg_m1 : g (j₁ - (p₁ : ZMod s)) = M - 1 := by
    have h1 : j₁ - (p₁ : ZMod s) ≠ j₁ := fun h => hp₁_ne0 (by
      have := congrArg (j₁ - ·) h; simpa using this)
    have h2 : j₁ - (p₁ : ZMod s) ≠ j₂ := by
      intro h; have := hf_sub j₁; rw [h, hf2, hf1] at this; exact hM_ne this.symm
    rw [← hagree _ h1 h2, hf_sub, hf1]
  -- `f (j₁ + p₂) = M` and `f (j₁ - p₂) = M`
  have hf_p2 : f (j₁ + (p₂ : ZMod s)) = M := by
    have h1 : j₁ + (p₂ : ZMod s) ≠ j₁ := fun h => hp₂_ne0 (by simpa using congrArg (· - j₁) h)
    have h2 : j₁ + (p₂ : ZMod s) ≠ j₂ := by
      intro h; have := hg_per j₁; rw [h, hg2, hg1] at this; exact hM_ne this
    rw [hagree _ h1 h2, hg_per, hg1]
  have hf_m2 : f (j₁ - (p₂ : ZMod s)) = M := by
    have h1 : j₁ - (p₂ : ZMod s) ≠ j₁ := fun h => hp₂_ne0 (by
      have := congrArg (j₁ - ·) h; simpa using this)
    have h2 : j₁ - (p₂ : ZMod s) ≠ j₂ := by
      intro h; have := hg_sub j₁; rw [h, hg2, hg1] at this; exact hM_ne this
    rw [hagree _ h1 h2, hg_sub, hg1]
  -- Helper: any `x` with `f x = M` and `g x = M - 1` must equal `j₂`!
  have huniq : ∀ x : ZMod s, f x = M → g x = M - 1 → x = j₂ := by
    intro x hfx hgx
    by_contra hne2
    have hne1 : x ≠ j₁ := fun h => by rw [h, hf1] at hfx; exact hM_ne hfx
    have := hagree x hne1 hne2
    rw [hfx, hgx] at this
    exact hM_ne this.symm
  -- Three points equal to `j₂`!
  have hx1 : j₁ + (p₁ : ZMod s) + (p₂ : ZMod s) = j₂ := by
    apply huniq
    · rw [show j₁ + (p₁ : ZMod s) + (p₂ : ZMod s) = (j₁ + (p₂ : ZMod s)) + (p₁ : ZMod s) by ring,
          hf_per, hf_p2]
    · rw [hg_per, hg_p1]
  have hx2 : j₁ - (p₁ : ZMod s) + (p₂ : ZMod s) = j₂ := by
    apply huniq
    · rw [show j₁ - (p₁ : ZMod s) + (p₂ : ZMod s) = (j₁ + (p₂ : ZMod s)) - (p₁ : ZMod s) by ring,
          hf_sub, hf_p2]
    · rw [hg_per, hg_m1]
  have hx3 : j₁ + (p₁ : ZMod s) - (p₂ : ZMod s) = j₂ := by
    apply huniq
    · rw [show j₁ + (p₁ : ZMod s) - (p₂ : ZMod s) = (j₁ - (p₂ : ZMod s)) + (p₁ : ZMod s) by ring,
          hf_per, hf_m2]
    · rw [hg_sub, hg_p1]
  have h2p1 : ((2 * p₁ : ℕ) : ZMod s) = 0 := by
    have : (p₁ : ZMod s) + (p₁ : ZMod s) = 0 := by linear_combination hx1 - hx2
    simpa [Nat.cast_mul, two_mul] using this
  have h2p2 : ((2 * p₂ : ℕ) : ZMod s) = 0 := by
    have : (p₂ : ZMod s) + (p₂ : ZMod s) = 0 := by linear_combination hx1 - hx3
    simpa [Nat.cast_mul, two_mul] using this
  have hdvd1 : s ∣ 2 * p₁ := (ZMod.natCast_eq_zero_iff (2 * p₁) s).mp h2p1
  have hdvd2 : s ∣ 2 * p₂ := (ZMod.natCast_eq_zero_iff (2 * p₂) s).mp h2p2
  obtain ⟨c1, hc1⟩ := hdvd1
  obtain ⟨c2, hc2⟩ := hdvd2
  have hc1_eq : c1 = 1 := by nlinarith
  have hc2_eq : c2 = 1 := by nlinarith
  subst hc1_eq
  subst hc2_eq
  have hp1_p2 : p₁ + p₂ = s := by omega
  have hsum0 : (p₁ : ZMod s) + (p₂ : ZMod s) = 0 := by
    rw [← Nat.cast_add, hp1_p2, ZMod.natCast_self]
  have : j₁ = j₂ := by linear_combination hx1 - hsum0
  exact hne this

/-- Bit-flip involution on binary words. -/
private def flipWord (w : List Bool) : List Bool := w.map (!·)

private lemma flipWord_invol (w : List Bool) : flipWord (flipWord w) = w := by
  induction w with
  | nil => rfl
  | cons b bs ih => simp [flipWord] at ih ⊢; exact ih

private lemma flipWord_append (u v : List Bool) : flipWord (u ++ v) = flipWord u ++ flipWord v :=
  List.map_append

private lemma flipWord_replicate (k : ℕ) (c : Bool) :
    flipWord (List.replicate k c) = List.replicate k (!c) :=
  List.map_replicate

private lemma flipWord_wordPow (u : List Bool) (k : ℕ) :
    flipWord (List.replicate k u).flatten = (List.replicate k (flipWord u)).flatten := by
  induction k with
  | zero => rfl
  | succ k ih => simp [List.replicate_succ, flipWord_append, ih]

private lemma flipWord_mem_Q2 {w : List Bool} : flipWord w ∈ Q2 ↔ w ∈ Q2 := by
  constructor
  · intro ⟨hne, hnp⟩
    refine ⟨fun h0 => hne (by simp [flipWord, h0]), fun u k hk hwu => ?_⟩
    exact hnp (flipWord u) k hk (by rw [← flipWord_wordPow, ← hwu])
  · intro ⟨hne, hnp⟩
    refine ⟨fun h0 => hne (by rw [← flipWord_invol w, h0]; rfl), fun u k hk hwu => ?_⟩
    have := congrArg flipWord hwu
    rw [flipWord_invol, flipWord_wordPow] at this
    exact hnp (flipWord u) k hk this

/-- Alternating block encoding: `blocksToWord [(a₁,b₁), ...] = 0^{a₁} 1^{b₁} ...`. -/
private def blocksToWord : List (ℕ × ℕ) → List Bool
  | [] => []
  | (a, b) :: rest => List.replicate a false ++ List.replicate b true ++ blocksToWord rest

private def AllPosBlocks (L : List (ℕ × ℕ)) : Prop :=
  ∀ p ∈ L, 1 ≤ p.1 ∧ 1 ≤ p.2

private lemma blocksToWord_append (L₁ L₂ : List (ℕ × ℕ)) :
    blocksToWord (L₁ ++ L₂) = blocksToWord L₁ ++ blocksToWord L₂ := by
  induction L₁ with
  | nil => rfl
  | cons p rest ih => simp [blocksToWord, ih, List.append_assoc]

private lemma replicate_cancel_ne {a b : ℕ} {c : Bool} {s₁ s₂ : List Bool}
    (hs₁ : s₁.head? ≠ some c) (hs₂ : s₂.head? ≠ some c)
    (heq : List.replicate a c ++ s₁ = List.replicate b c ++ s₂) :
    a = b ∧ s₁ = s₂ := by
  induction a generalizing b with
  | zero =>
    cases b with
    | zero => simpa using heq
    | succ b =>
      simp only [List.replicate_zero, List.nil_append, List.replicate_succ, List.cons_append] at heq
      have : s₁.head? = some c := by rw [heq]; rfl
      exact absurd this hs₁
  | succ a ih =>
    cases b with
    | zero =>
      simp only [List.replicate_zero, List.nil_append, List.replicate_succ, List.cons_append] at heq
      have : s₂.head? = some c := by rw [← heq]; rfl
      exact absurd this hs₂
    | succ b =>
      simp only [List.replicate_succ, List.cons_append, List.cons.injEq, true_and] at heq
      obtain ⟨hab, hs⟩ := ih heq
      exact ⟨by omega, hs⟩

private lemma blocksToWord_head_ne_true {L : List (ℕ × ℕ)} (hL : AllPosBlocks L) (t : ℕ) :
    (blocksToWord L ++ List.replicate t false).head? ≠ some true := by
  cases L with
  | nil =>
    cases t with
    | zero => simp [blocksToWord]
    | succ t => simp [blocksToWord, List.replicate_succ]
  | cons p rest =>
    have hp1 : 1 ≤ p.1 := (hL p (by simp)).1
    obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hp1)
    simp [blocksToWord, hm, List.replicate_succ]

private lemma blocksToWord_unique {L₁ L₂ : List (ℕ × ℕ)} {t₁ t₂ : ℕ}
    (hL₁ : AllPosBlocks L₁) (hL₂ : AllPosBlocks L₂)
    (heq : blocksToWord L₁ ++ List.replicate t₁ false = blocksToWord L₂ ++ List.replicate t₂ false) :
    L₁ = L₂ ∧ t₁ = t₂ := by
  induction L₁ generalizing L₂ with
  | nil =>
    cases L₂ with
    | nil =>
      simp only [blocksToWord, List.nil_append] at heq
      exact ⟨rfl, by have := congrArg List.length heq; simpa using this⟩
    | cons p rest =>
      have hp1 : 1 ≤ p.1 := (hL₂ p (by simp)).1
      have hp2 : 1 ≤ p.2 := (hL₂ p (by simp)).2
      have hct : (blocksToWord [] ++ List.replicate t₁ false).count true = 0 := by
        simp [blocksToWord, List.count_replicate]
      rw [heq] at hct
      simp only [blocksToWord, List.count_append, List.count_replicate, beq_self_eq_true, ↓reduceIte] at hct
      omega
  | cons p₁ r₁ ih =>
    cases L₂ with
    | nil =>
      have hp2 : 1 ≤ p₁.2 := (hL₁ p₁ (by simp)).2
      have hct : (blocksToWord [] ++ List.replicate t₂ false).count true = 0 := by
        simp [blocksToWord, List.count_replicate]
      rw [← heq] at hct
      simp only [blocksToWord, List.count_append, List.count_replicate, beq_self_eq_true, ↓reduceIte] at hct
      omega
    | cons p₂ r₂ =>
      have hp₁ := hL₁ p₁ (by simp)
      have hp₂ := hL₂ p₂ (by simp)
      have hr₁ : AllPosBlocks r₁ := fun q hq => hL₁ q (by simp [hq])
      have hr₂ : AllPosBlocks r₂ := fun q hq => hL₂ q (by simp [hq])
      have hheq : List.replicate p₁.1 false ++ (List.replicate p₁.2 true ++ (blocksToWord r₁ ++ List.replicate t₁ false)) =
          List.replicate p₂.1 false ++ (List.replicate p₂.2 true ++ (blocksToWord r₂ ++ List.replicate t₂ false)) := by
        simpa [blocksToWord, List.append_assoc] using heq
      have hne_f1 : (List.replicate p₁.2 true ++ (blocksToWord r₁ ++ List.replicate t₁ false)).head? ≠ some false := by
        obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hp₁.2)
        simp [hm, List.replicate_succ]
      have hne_f2 : (List.replicate p₂.2 true ++ (blocksToWord r₂ ++ List.replicate t₂ false)).head? ≠ some false := by
        obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hp₂.2)
        simp [hm, List.replicate_succ]
      obtain ⟨ha, hrest1⟩ := replicate_cancel_ne hne_f1 hne_f2 hheq
      obtain ⟨hb, hrest2⟩ := replicate_cancel_ne
        (blocksToWord_head_ne_true hr₁ t₁) (blocksToWord_head_ne_true hr₂ t₂) hrest1
      obtain ⟨hr_eq, ht_eq⟩ := ih hr₁ hr₂ hrest2
      have hp_eq : p₁ = p₂ := Prod.ext ha hb
      exact ⟨by rw [hp_eq, hr_eq], ht_eq⟩

private lemma mem_takeWhile_eq {p : Bool → Bool} {w : List Bool} {x : Bool}
    (hx : x ∈ w.takeWhile p) : p x = true := by
  induction w with
  | nil => simp at hx
  | cons a as ih =>
    by_cases hpa : p a = true
    · simp only [List.takeWhile_cons, hpa, ↓reduceIte, List.mem_cons] at hx
      rcases hx with rfl | h'
      · exact hpa
      · exact ih h'
    · have hpa' : p a = false := Bool.eq_false_iff.mpr hpa
      simp [hpa'] at hx

private lemma head_dropWhile_eq_false {p : Bool → Bool} {w : List Bool} {x : Bool} {xs : List Bool}
    (h : w.dropWhile p = x :: xs) : p x = false := by
  induction w with
  | nil => simp at h
  | cons a as ih =>
    by_cases hpa : p a = true
    · simp only [List.dropWhile_cons, hpa, ↓reduceIte] at h
      exact ih h
    · have hpa' : p a = false := Bool.eq_false_iff.mpr hpa
      simp only [List.dropWhile_cons, hpa', Bool.false_eq_true, ↓reduceIte, List.cons.injEq] at h
      rw [← h.1]; exact hpa'

/-- Every word starting with `false` and containing `true` decomposes into `blocksToWord L ++ 0^t`. -/
private lemma decompose_blocks (w : List Bool) (hhead : w.head? = some false) (htrue : true ∈ w) :
    ∃ (L : List (ℕ × ℕ)) (t : ℕ),
      L ≠ [] ∧ AllPosBlocks L ∧ w = blocksToWord L ++ List.replicate t false := by
  suffices ∀ n (w : List Bool), w.length ≤ n → w.head? = some false → true ∈ w →
      ∃ (L : List (ℕ × ℕ)) (t : ℕ), L ≠ [] ∧ AllPosBlocks L ∧ w = blocksToWord L ++ List.replicate t false from
    this w.length w le_rfl hhead htrue
  intro n
  induction n with
  | zero =>
    intro w hlen hhead _
    have := List.eq_nil_of_length_eq_zero (Nat.le_zero.mp hlen)
    subst this; simp at hhead
  | succ n ih =>
    intro w hlen hhead htrue
    -- Peel leading `false`s
    let a := (w.takeWhile (· == false)).length
    let rest1 := w.dropWhile (· == false)
    have hsplit1 : w = List.replicate a false ++ rest1 := by
      have h1 := List.takeWhile_append_dropWhile (p := (· == false)) (l := w)
      have hrep : w.takeWhile (· == false) = List.replicate a false := by
        apply List.eq_replicate_iff.mpr
        refine ⟨rfl, fun x hx => ?_⟩
        have := mem_takeWhile_eq hx
        simpa using this
      rw [← hrep, h1]
    have ha_pos : 1 ≤ a := by
      cases w with
      | nil => simp at hhead
      | cons x xs =>
        simp only [List.head?_cons, Option.some.injEq] at hhead
        subst hhead
        simp [a]
    have hrest1_head : rest1.head? = some true := by
      cases h : rest1 with
      | nil =>
        rw [h, List.append_nil] at hsplit1
        rw [hsplit1] at htrue
        have := List.eq_of_mem_replicate htrue
        simp at this
      | cons x xs =>
        have hnot : (x == false) = false := head_dropWhile_eq_false (p := (· == false)) h
        cases x
        · simp at hnot
        · rfl
    -- Peel leading `true`s from `rest1`
    let b := (rest1.takeWhile (· == true)).length
    let rest2 := rest1.dropWhile (· == true)
    have hsplit2 : rest1 = List.replicate b true ++ rest2 := by
      have h1 := List.takeWhile_append_dropWhile (p := (· == true)) (l := rest1)
      have hrep : rest1.takeWhile (· == true) = List.replicate b true := by
        apply List.eq_replicate_iff.mpr
        refine ⟨rfl, fun x hx => ?_⟩
        have := mem_takeWhile_eq hx
        simpa using this
      rw [← hrep, h1]
    have hb_pos : 1 ≤ b := by
      cases h : rest1 with
      | nil => rw [h] at hrest1_head; simp at hrest1_head
      | cons x xs =>
        rw [h] at hrest1_head
        simp only [List.head?_cons, Option.some.injEq] at hrest1_head
        subst hrest1_head
        simp [b, h]
    by_cases hmem2 : true ∈ rest2
    · have hrest2_head : rest2.head? = some false := by
        cases h : rest2 with
        | nil => rw [h] at hmem2; simp at hmem2
        | cons x xs =>
          have hnot : (x == true) = false := head_dropWhile_eq_false (p := (· == true)) h
          cases x
          · rfl
          · simp at hnot
      have hrest2_len : rest2.length ≤ n := by
        have hw_len : w.length = a + b + rest2.length := by
          rw [hsplit1, hsplit2]; simp; omega
        omega
      obtain ⟨L', t', _, hL'pos, hrest2_eq⟩ := ih rest2 hrest2_len hrest2_head hmem2
      refine ⟨(a, b) :: L', t', by simp, fun q hq => ?_, ?_⟩
      · rcases List.mem_cons.mp hq with rfl | hq'
        · exact ⟨ha_pos, hb_pos⟩
        · exact hL'pos q hq'
      · rw [hsplit1, hsplit2, hrest2_eq]
        simp [blocksToWord, List.append_assoc]
    · have hrest2_rep : rest2 = List.replicate rest2.length false := by
        apply List.eq_replicate_iff.mpr
        refine ⟨rfl, fun x hx => ?_⟩
        cases x
        · rfl
        · exact absurd hx hmem2
      refine ⟨[(a, b)], rest2.length, by simp, fun q hq => ?_, ?_⟩
      · simp only [List.mem_singleton] at hq; subst hq; exact ⟨ha_pos, hb_pos⟩
      · rw [hsplit1, hsplit2, hrest2_rep]
        simp [blocksToWord, List.append_assoc]

/-- Cyclic `0`-run lengths of `blocksToWord L ++ 0^t`: adds `t` to the first block's `0`-count. -/
private def cycZeros (L : List (ℕ × ℕ)) (t : ℕ) : List ℕ :=
  match L with
  | [] => []
  | (a, _) :: rest => (a + t) :: rest.map Prod.fst

private lemma cycZeros_length (L : List (ℕ × ℕ)) (t : ℕ) :
    (cycZeros L t).length = L.length := by
  cases L <;> simp [cycZeros]

/-- Merge trailing `0^t` into the first block of `U`. -/
private def mergeHead (U : List (ℕ × ℕ)) (t : ℕ) : List (ℕ × ℕ) :=
  match U with
  | [] => []
  | (a, b) :: rest => (a + t, b) :: rest

private lemma blocksToWord_mergeHead (U : List (ℕ × ℕ)) (hU : U ≠ []) (t : ℕ) :
    List.replicate t false ++ blocksToWord U = blocksToWord (mergeHead U t) := by
  cases U with
  | nil => exact absurd rfl hU
  | cons p rest =>
    rcases p with ⟨a, b⟩
    simp only [mergeHead, blocksToWord, ← List.append_assoc, ← List.replicate_add]
    rw [Nat.add_comm t a]

private lemma wordPow_blocks (U : List (ℕ × ℕ)) (hU : U ≠ []) (t : ℕ) (k : ℕ) (hk : 1 ≤ k) :
    wordPow (blocksToWord U ++ List.replicate t false) k =
      blocksToWord (U ++ (List.replicate (k - 1) (mergeHead U t)).flatten) ++ List.replicate t false := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  clear hk
  rw [Nat.add_comm]
  induction m with
  | zero => simp [wordPow]
  | succ m ih =>
    rw [show m + 1 + 1 = (m + 1) + 1 from rfl, wordPow_succ, ih]
    simp only [Nat.add_sub_cancel]
    have h1 : (blocksToWord U ++ List.replicate t false) ++
        (blocksToWord (U ++ (List.replicate m (mergeHead U t)).flatten) ++ List.replicate t false) =
        blocksToWord U ++ (List.replicate t false ++ blocksToWord U) ++
        blocksToWord (List.replicate m (mergeHead U t)).flatten ++ List.replicate t false := by
      simp [blocksToWord_append, List.append_assoc]
    rw [h1, blocksToWord_mergeHead U hU t]
    simp [blocksToWord_append, List.replicate_succ, List.append_assoc]

/-- Proper periodicity predicate on a list of natural numbers (as a function on `ZMod L.length`). -/
private def ListHasProperPeriod (l : List ℕ) : Prop :=
  ∃ (p : ℕ) (_ : 1 ≤ p) (_ : p < l.length),
    have : NeZero l.length := ⟨by omega⟩
    ∀ x : ZMod l.length, l[x.val]'(ZMod.val_lt x) = l[(x + (p : ZMod l.length)).val]'(ZMod.val_lt _)

private lemma listHasProperPeriod_congr_len {l : List ℕ} {n : ℕ} (hn : l.length = n)
    (h : ListHasProperPeriod l) :
    ∃ (p : ℕ) (_ : 1 ≤ p) (_ : p < n),
      have : NeZero n := ⟨by omega⟩
      ∀ x : ZMod n, l[x.val]'(by rw [hn]; exact ZMod.val_lt x) =
        l[(x + (p : ZMod n)).val]'(by rw [hn]; exact ZMod.val_lt _) := by
  subst hn; exact h

private lemma list_wordPow_hasProperPeriod {r : List ℕ} {k : ℕ} (hr : r ≠ []) (hk : 2 ≤ k) :
    ListHasProperPeriod ((List.replicate k r).flatten) := by
  have hr_pos : 0 < r.length := List.length_pos_of_ne_nil hr
  have hlen : ((List.replicate k r).flatten).length = k * r.length := by
    clear hk
    induction k with
    | zero => simp
    | succ k ih => rw [List.replicate_succ, List.flatten_cons, List.length_append, ih, Nat.succ_mul]; omega
  refine ⟨r.length, hr_pos, by rw [hlen]; nlinarith, fun x => ?_⟩
  have : NeZero ((List.replicate k r).flatten).length := ⟨by rw [hlen]; nlinarith⟩
  have hget : ∀ (m : ℕ) (i : ℕ) (hi : i < ((List.replicate m r).flatten).length),
      ((List.replicate m r).flatten)[i]'hi = r[i % r.length]'(Nat.mod_lt i hr_pos) := by
    intro m
    induction m with
    | zero => intro i hi; simp at hi
    | succ m ihm =>
      intro i hi
      have hsucc : (List.replicate (m + 1) r).flatten = r ++ (List.replicate m r).flatten := by
        simp [List.replicate_succ]
      have hi' : i < (r ++ (List.replicate m r).flatten).length := hsucc ▸ hi
      have heq : ((List.replicate (m + 1) r).flatten)[i]'hi = (r ++ (List.replicate m r).flatten)[i]'hi' := by
        congr 1
      rw [heq]
      by_cases hlt : i < r.length
      · rw [List.getElem_append_left hlt]; simp [Nat.mod_eq_of_lt hlt]
      · have hge : r.length ≤ i := Nat.le_of_not_lt hlt
        rw [List.getElem_append_right hge]
        have hi2 : i - r.length < ((List.replicate m r).flatten).length := by
          simp only [List.length_append] at hi'; omega
        rw [ihm (i - r.length) hi2]
        have hmod : (i - r.length) % r.length = i % r.length := by
          have : i = (i - r.length) + r.length := by omega
          conv_rhs => rw [this]
          rw [Nat.add_mod_right]
        simp [hmod]
  rw [hget k x.val (ZMod.val_lt x),
    hget k (x + (r.length : ZMod ((List.replicate k r).flatten).length)).val (ZMod.val_lt _)]
  have hmod_eq : (x + (r.length : ZMod ((List.replicate k r).flatten).length)).val % r.length = x.val % r.length := by
    rw [ZMod.val_add, ZMod.val_natCast]
    have hdvd : r.length ∣ ((List.replicate k r).flatten).length := ⟨k, by rw [hlen, Nat.mul_comm]⟩
    rw [Nat.mod_mod_of_dvd _ hdvd, Nat.add_mod, Nat.mod_mod_of_dvd _ hdvd, Nat.mod_self, add_zero, Nat.mod_mod]
  simp [hmod_eq]

/-- **Unified Block-Periodicity Criterion:**
If `w = blocksToWord L ++ 0^t` (`L ≠ []`, `AllPosBlocks L`) is a proper power `u^k` (`k ≥ 2`),
then `2 ≤ L.length` AND BOTH `L.map Prod.snd` AND `cycZeros L t` have a proper period! -/
private lemma blocks_pow_implies_periodic {L : List (ℕ × ℕ)} {t : ℕ}
    (hLne : L ≠ []) (hLpos : AllPosBlocks L)
    (hnot : blocksToWord L ++ List.replicate t false ∉ Q2) :
    2 ≤ L.length ∧ ListHasProperPeriod (L.map Prod.snd) ∧ ListHasProperPeriod (cycZeros L t) := by
  set w := blocksToWord L ++ List.replicate t false
  have hw_head : w.head? = some false := by
    cases L with
    | nil => exact absurd rfl hLne
    | cons p rest =>
      have hp1 := (hLpos p (by simp)).1
      obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hp1)
      simp [w, blocksToWord, hm, List.replicate_succ]
  have hw_ne : w ≠ [] := by intro h0; rw [h0] at hw_head; simp at hw_head
  have hw_true : true ∈ w := by
    cases L with
    | nil => exact absurd rfl hLne
    | cons p rest =>
      have hp2 := (hLpos p (by simp)).2
      obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hp2)
      simp [w, blocksToWord, hm, List.replicate_succ]
  rw [mem_Q2_iff] at hnot
  push Not at hnot
  obtain ⟨u, k, hk2, hwu⟩ := hnot hw_ne
  change w = wordPow u k at hwu
  have hu_ne : u ≠ [] := by
    intro h0; subst h0; rw [(wordPow_eq_nil_iff (by omega)).mpr rfl] at hwu; exact hw_ne hwu
  have hu_head : u.head? = some false := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le (show 1 ≤ k by omega)
    rw [Nat.add_comm, wordPow_succ] at hwu
    cases u with
    | nil => exact absurd rfl hu_ne
    | cons x xs => rw [hwu] at hw_head; simpa using hw_head
  have hu_true : true ∈ u := by
    have hct : 0 < w.count true := List.count_pos_iff.mpr hw_true
    rw [hwu, wordPow_count] at hct
    exact List.count_pos_iff.mp (Nat.pos_of_mul_pos_left hct)
  obtain ⟨U, tu, hUne, hUpos, hu_eq⟩ := decompose_blocks u hu_head hu_true
  have hpow := wordPow_blocks U hUne tu k (by omega)
  rw [← hu_eq, ← hwu] at hpow
  have hMpos : AllPosBlocks (mergeHead U tu) := by
    cases U with
    | nil => exact absurd rfl hUne
    | cons p rest =>
      intro q hq
      rcases List.mem_cons.mp hq with rfl | hq'
      · have := hUpos p (by simp); exact ⟨by omega, this.2⟩
      · exact hUpos q (by simp [hq'])
  have hbig_pos : AllPosBlocks (U ++ (List.replicate (k - 1) (mergeHead U tu)).flatten) := by
    intro q hq
    rcases List.mem_append.mp hq with hq1 | hq2
    · exact hUpos q hq1
    · rw [List.mem_flatten] at hq2
      obtain ⟨l, hl, hql⟩ := hq2
      rw [List.eq_of_mem_replicate hl] at hql
      exact hMpos q hql
  obtain ⟨hL_eq, ht_eq⟩ := blocksToWord_unique hLpos hbig_pos hpow
  have hU_len_pos : 1 ≤ U.length := List.length_pos_of_ne_nil hUne
  have hM_len : (mergeHead U tu).length = U.length := by cases U <;> simp [mergeHead]
  have hL_len : L.length = k * U.length := by
    rw [hL_eq, List.length_append]
    have hflat_len : ∀ m, ((List.replicate m (mergeHead U tu)).flatten).length = m * U.length := by
      intro m; induction m with
      | zero => simp
      | succ m ihm => rw [List.replicate_succ, List.flatten_cons, List.length_append, hM_len, ihm, Nat.succ_mul]; omega
    rw [hflat_len (k - 1)]
    have : 1 + (k - 1) = k := by omega
    calc U.length + (k - 1) * U.length = (1 + (k - 1)) * U.length := by rw [Nat.add_mul, Nat.one_mul]
      _ = k * U.length := by rw [this]
  refine ⟨by nlinarith, ?_, ?_⟩
  · -- `L.map Prod.snd = (List.replicate k (U.map Prod.snd)).flatten`
    have hsnd_M : (mergeHead U tu).map Prod.snd = U.map Prod.snd := by cases U <;> simp [mergeHead]
    have hsnd_eq : L.map Prod.snd = (List.replicate k (U.map Prod.snd)).flatten := by
      rw [hL_eq, List.map_append, List.map_flatten, List.map_replicate, hsnd_M]
      obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le (show 1 ≤ k by omega)
      simp [Nat.add_comm, List.replicate_succ]
    rw [hsnd_eq]
    exact list_wordPow_hasProperPeriod (by simpa using hUne) hk2
  · -- `cycZeros L t = (List.replicate k (cycZeros U tu)).flatten`
    have hfst_M : (mergeHead U tu).map Prod.fst = cycZeros U tu := by cases U <;> simp [mergeHead, cycZeros]
    have hcyc_eq : cycZeros L t = (List.replicate k (cycZeros U tu)).flatten := by
      rw [hL_eq, ht_eq]
      cases U with
      | nil => exact absurd rfl hUne
      | cons p rest =>
        rcases p with ⟨a0, b0⟩
        simp only [List.cons_append, cycZeros, List.map_append, List.map_flatten, List.map_replicate,
          mergeHead, List.map_cons]
        obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le (show 1 ≤ k by omega)
        simp [Nat.add_comm, List.replicate_succ]
    rw [hcyc_eq]
    exact list_wordPow_hasProperPeriod (by cases U with | nil => exact absurd rfl hUne | cons _ _ => simp [cycZeros]) hk2

/-- Any list of `ℕ` with a **unique maximum** has NO proper period! -/
private lemma not_hasProperPeriod_of_unique_max {l : List ℕ} {j : ℕ} (hj : j < l.length)
    (huniq : ∀ i (hi : i < l.length), i ≠ j → l[i]'hi < l[j]'hj) :
    ¬ ListHasProperPeriod l := by
  rintro ⟨p, hp1, hplt, hper⟩
  have : NeZero l.length := ⟨by omega⟩
  let x : ZMod l.length := (j : ZMod l.length)
  have hx_val : x.val = j := ZMod.val_natCast_of_lt hj
  have hxp_ne : x + (p : ZMod l.length) ≠ x := by
    intro h
    have hp0 : (p : ZMod l.length) = 0 := by linear_combination h
    have hdvd : l.length ∣ p := (ZMod.natCast_eq_zero_iff p l.length).mp hp0
    exact absurd (Nat.le_of_dvd (by omega) hdvd) (by omega)
  have hval_ne : (x + (p : ZMod l.length)).val ≠ j := by
    intro h
    apply hxp_ne
    apply ZMod.val_injective
    rw [h, hx_val]
  have heq := hper x
  have hlt := huniq (x + (p : ZMod l.length)).val (ZMod.val_lt _) hval_ne
  simp only [hx_val] at heq
  omega

/-- Helper: decrementing position `j` of a list `l` (where `l[j] = M ≥ 1`) cannot yield a periodic list
at two distinct maximum positions `j₁ ≠ j₂`! -/
private lemma exists_good_max_or_unique {l : List ℕ} (hne : l ≠ [])
    (hM_ge : ∃ M : ℕ, 1 ≤ M ∧ (∀ i (hi : i < l.length), l[i]'hi ≤ M) ∧ ∃ j, ∃ hj : j < l.length, l[j]'hj = M) :
    ∃ (M : ℕ), 1 ≤ M ∧ (∀ i (hi : i < l.length), l[i]'hi ≤ M) ∧
      ((∃ (j : ℕ) (hj : j < l.length), l[j]'hj = M ∧ ¬ ListHasProperPeriod (l.set j (M - 1))) ∨
       (∃ (j : ℕ) (hj : j < l.length), l[j]'hj = M ∧ ∀ i (hi : i < l.length), i ≠ j → l[i]'hi < M)) := by
  obtain ⟨M, hM1, hle, j₀, hj₀, hlj₀⟩ := hM_ge
  refine ⟨M, hM1, hle, ?_⟩
  by_cases hgood : ∃ (j : ℕ) (hj : j < l.length), l[j]'hj = M ∧ ¬ ListHasProperPeriod (l.set j (M - 1))
  · left; exact hgood
  · right
    push Not at hgood
    refine ⟨j₀, hj₀, hlj₀, fun i hi hij => ?_⟩
    by_contra hge
    have hli : l[i]'hi = M := le_antisymm (hle i hi) (by omega)
    have hper1 := listHasProperPeriod_congr_len List.length_set (hgood j₀ hj₀ hlj₀)
    have hper2 := listHasProperPeriod_congr_len List.length_set (hgood i hi hli)
    rcases hper1 with ⟨p₁, hp₁1, hp₁lt, hfper⟩
    rcases hper2 with ⟨p₂, hp₂1, hp₂lt, hgper⟩
    have : NeZero l.length := ⟨List.length_pos_of_ne_nil hne |>.ne'⟩
    let f : ZMod l.length → ℕ := fun x => (l.set j₀ (M - 1))[x.val]'(by rw [List.length_set]; exact ZMod.val_lt x)
    let g : ZMod l.length → ℕ := fun x => (l.set i (M - 1))[x.val]'(by rw [List.length_set]; exact ZMod.val_lt x)
    have hj_ne : (j₀ : ZMod l.length) ≠ (i : ZMod l.length) := by
      intro h
      have := congrArg ZMod.val h
      rw [ZMod.val_natCast_of_lt hj₀, ZMod.val_natCast_of_lt hi] at this
      exact hij this.symm
    have hfg_agree : ∀ x : ZMod l.length, x ≠ (j₀ : ZMod l.length) → x ≠ (i : ZMod l.length) → f x = g x := by
      intro x hx1 hx2
      have hxv1 : x.val ≠ j₀ := fun h => hx1 (ZMod.val_injective _ (by rw [h, ZMod.val_natCast_of_lt hj₀]))
      have hxv2 : x.val ≠ i := fun h => hx2 (ZMod.val_injective _ (by rw [h, ZMod.val_natCast_of_lt hi]))
      dsimp [f, g]
      rw [List.getElem_set_ne (Ne.symm hxv1), List.getElem_set_ne (Ne.symm hxv2)]
    have hf1 : f (j₀ : ZMod l.length) = M - 1 := by
      dsimp [f]; simp [ZMod.val_natCast_of_lt hj₀]
    have hg1 : g (j₀ : ZMod l.length) = M := by
      dsimp [g]
      have : (j₀ : ZMod l.length).val = j₀ := ZMod.val_natCast_of_lt hj₀
      simp only [this, List.getElem_set_ne hij, hlj₀]
    have hf2 : f (i : ZMod l.length) = M := by
      dsimp [f]
      have : (i : ZMod l.length).val = i := ZMod.val_natCast_of_lt hi
      simp only [this, List.getElem_set_ne (Ne.symm hij), hli]
    have hg2 : g (i : ZMod l.length) = M - 1 := by
      dsimp [g]; simp [ZMod.val_natCast_of_lt hi]
    have hf_per' : ∀ x : ZMod l.length, f (x + (p₁ : ZMod l.length)) = f x := fun x => (hfper x).symm
    have hg_per' : ∀ x : ZMod l.length, g (x + (p₂ : ZMod l.length)) = g x := fun x => (hgper x).symm
    exact zmod_two_periodic_impossible hj_ne hM1 hp₁1 hp₁lt hf_per' hp₂1 hp₂lt hg_per' hfg_agree hf1 hg1 hf2 hg2

/-- Helper: every nonempty list of `ℕ` attains its maximum. -/
private lemma list_exists_max (l : List ℕ) (hne : l ≠ []) :
    ∃ M : ℕ, (∀ i (hi : i < l.length), l[i]'hi ≤ M) ∧ ∃ (j : ℕ) (hj : j < l.length), l[j]'hj = M := by
  induction l with
  | nil => exact absurd rfl hne
  | cons a xs ih =>
    cases xs with
    | nil =>
      refine ⟨a, fun i hi => ?_, 0, by simp, rfl⟩
      have : i = 0 := by simp at hi; omega
      subst this; exact le_rfl
    | cons b ys =>
      obtain ⟨M', hle', j', hj', hlj'⟩ := ih (by simp)
      by_cases hab : a ≤ M'
      · refine ⟨M', fun i hi => ?_, j' + 1, Nat.succ_lt_succ hj', hlj'⟩
        cases i with
        | zero => simpa using hab
        | succ i => exact hle' i (Nat.lt_of_succ_lt_succ hi)
      · refine ⟨a, fun i hi => ?_, 0, Nat.zero_lt_succ _, rfl⟩
        cases i with
        | zero => exact le_rfl
        | succ i => exact le_trans (hle' i (Nat.lt_of_succ_lt_succ hi)) (by omega)

/-- Helper: split `blocksToWord L` at block `j` to isolate a single `true` inside block `j`. -/
private lemma blocks_pump_true (L : List (ℕ × ℕ)) (t : ℕ) (j : ℕ) (hj : j < L.length)
    (hb : 1 ≤ (L[j]'hj).2) :
    ∃ u z : List Bool,
      blocksToWord L ++ List.replicate t false = u ++ [true] ++ z ∧
      (∀ k : ℕ, 1 ≤ (L[j]'hj).2 - 1 + k →
        u ++ List.replicate k true ++ z =
          blocksToWord (L.set j ((L[j]'hj).1, (L[j]'hj).2 - 1 + k)) ++ List.replicate t false) ∧
      (∀ k : ℕ, u ++ List.replicate k true ++ z =
        blocksToWord (L.take j) ++ List.replicate (L[j]'hj).1 false ++
        List.replicate ((L[j]'hj).2 - 1 + k) true ++
        blocksToWord (L.drop (j + 1)) ++ List.replicate t false) := by
  let a := (L[j]'hj).1
  let b := (L[j]'hj).2
  let u := blocksToWord (L.take j) ++ List.replicate a false ++ List.replicate (b - 1) true
  let z := blocksToWord (L.drop (j + 1)) ++ List.replicate t false
  have hLsplit : L = L.take j ++ [(a, b)] ++ L.drop (j + 1) := by
    have h1 := List.take_append_drop j L
    have h2 : L.drop j = (a, b) :: L.drop (j + 1) := by
      rw [List.drop_eq_getElem_cons hj]
    rw [h2] at h1
    simpa [List.append_assoc] using h1.symm
  have hrep_b : List.replicate b true = List.replicate (b - 1) true ++ [true] := by
    rw [show [true] = List.replicate 1 true from rfl, ← List.replicate_add]
    congr 1; omega
  have hw_eq : blocksToWord L ++ List.replicate t false = u ++ [true] ++ z := by
    conv_lhs => rw [hLsplit]
    simp only [blocksToWord_append, blocksToWord, List.append_nil, hrep_b, u, z, List.append_assoc]
  have hform : ∀ k : ℕ, u ++ List.replicate k true ++ z =
      blocksToWord (L.take j) ++ List.replicate a false ++
      List.replicate (b - 1 + k) true ++
      blocksToWord (L.drop (j + 1)) ++ List.replicate t false := by
    intro k
    simp only [u, z, List.append_assoc]
    rw [← List.append_assoc (List.replicate (b - 1) true), ← List.replicate_add]
  refine ⟨u, z, hw_eq, fun k _ => ?_, hform⟩
  rw [hform k]
  have hset_eq : L.set j (a, b - 1 + k) = L.take j ++ [(a, b - 1 + k)] ++ L.drop (j + 1) := by
    rw [List.set_eq_take_cons_drop (a, b - 1 + k) hj]
    simp [List.append_assoc]
  rw [hset_eq]
  simp only [blocksToWord_append, blocksToWord, List.append_nil, List.append_assoc]

/-- Helper: split `blocksToWord L` at block `j` to isolate a single `false` inside block `j`. -/
private lemma blocks_pump_false (L : List (ℕ × ℕ)) (t : ℕ) (j : ℕ) (hj : j < L.length)
    (ha : 1 ≤ (L[j]'hj).1) :
    ∃ u z : List Bool,
      blocksToWord L ++ List.replicate t false = u ++ [false] ++ z ∧
      (∀ k : ℕ, u ++ List.replicate k false ++ z =
        blocksToWord (L.set j ((L[j]'hj).1 - 1 + k, (L[j]'hj).2)) ++ List.replicate t false) ∧
      (∀ k : ℕ, u ++ List.replicate k false ++ z =
        blocksToWord (L.take j) ++ List.replicate ((L[j]'hj).1 - 1 + k) false ++
        List.replicate (L[j]'hj).2 true ++
        blocksToWord (L.drop (j + 1)) ++ List.replicate t false) := by
  let a := (L[j]'hj).1
  let b := (L[j]'hj).2
  let u := blocksToWord (L.take j) ++ List.replicate (a - 1) false
  let z := List.replicate b true ++ blocksToWord (L.drop (j + 1)) ++ List.replicate t false
  have hLsplit : L = L.take j ++ [(a, b)] ++ L.drop (j + 1) := by
    have h1 := List.take_append_drop j L
    have h2 : L.drop j = (a, b) :: L.drop (j + 1) := by rw [List.drop_eq_getElem_cons hj]
    rw [h2] at h1
    simpa [List.append_assoc] using h1.symm
  have hrep_a : List.replicate a false = List.replicate (a - 1) false ++ [false] := by
    rw [show [false] = List.replicate 1 false from rfl, ← List.replicate_add]
    congr 1; omega
  have hw_eq : blocksToWord L ++ List.replicate t false = u ++ [false] ++ z := by
    conv_lhs => rw [hLsplit]
    simp only [blocksToWord_append, blocksToWord, List.append_nil, hrep_a, u, z, List.append_assoc]
  have hform : ∀ k : ℕ, u ++ List.replicate k false ++ z =
      blocksToWord (L.take j) ++ List.replicate (a - 1 + k) false ++
      List.replicate b true ++ blocksToWord (L.drop (j + 1)) ++ List.replicate t false := by
    intro k
    simp only [u, z, List.append_assoc]
    rw [← List.append_assoc (List.replicate (a - 1) false), ← List.replicate_add]
  refine ⟨u, z, hw_eq, fun k => ?_, hform⟩
  rw [hform k]
  have hset_eq : L.set j (a - 1 + k, b) = L.take j ++ [(a - 1 + k, b)] ++ L.drop (j + 1) := by
    rw [List.set_eq_take_cons_drop (a - 1 + k, b) hj]
    simp [List.append_assoc]
  rw [hset_eq]
  simp only [blocksToWord_append, blocksToWord, List.append_nil, List.append_assoc]

/-- Core case: `w ∈ Q2` starting with `false` and `2 ≤ w.length` has a single-character pump. -/
private lemma strong_single_char_pump_false (w : List Bool) (hw : w ∈ Q2)
    (hlen : 2 ≤ w.length) (hhead : w.head? = some false) :
    ∃ (u z : List Bool) (c : Bool),
      w = u ++ [c] ++ z ∧ ∀ i : ℕ, u ++ List.replicate i c ++ z ∈ Q2 := by
  have htrue : true ∈ w := by
    by_contra hnt
    have hrep : w = List.replicate w.length false := by
      apply List.eq_replicate_iff.mpr
      refine ⟨rfl, fun x hx => ?_⟩
      cases x
      · rfl
      · exact absurd hx hnt
    have hpow : w = wordPow [false] w.length := by
      conv_lhs => rw [hrep]
      have haux : ∀ m : ℕ, List.replicate m false = wordPow [false] m := by
        intro m
        induction m with
        | zero => rfl
        | succ m ih => rw [List.replicate_succ, wordPow_succ, ← ih]; rfl
      exact haux w.length
    exact hw.2 [false] w.length hlen hpow
  obtain ⟨L, t, hLne, hLpos, hw_eq⟩ := decompose_blocks w hhead htrue
  -- Case 0: `L.length = 1`
  by_cases hL1 : L.length = 1
  · cases L with
    | nil => exact absurd rfl hLne
    | cons p rest =>
      have hrest : rest = [] := by simpa using hL1
      subst hrest
      rcases p with ⟨a, b⟩
      have hab := hLpos (a, b) (by simp)
      by_cases hb2 : 2 ≤ b
      · -- Pump one `true`: for all `i`, `b - 1 + i ≥ 1` so `L.length = 1` still!
        refine ⟨List.replicate a false ++ List.replicate (b - 1) true, List.replicate t false, true, ?_, fun i => ?_⟩
        · rw [hw_eq]; simp only [blocksToWord, List.append_nil, List.append_assoc]
          have : List.replicate b true = List.replicate (b - 1) true ++ [true] := by
            rw [show [true] = List.replicate 1 true from rfl, ← List.replicate_add]; congr 1; omega
          rw [this]; simp [List.append_assoc]
        · by_contra hnot
          have heq_i : (List.replicate a false ++ List.replicate (b - 1) true) ++ List.replicate i true ++ List.replicate t false =
              blocksToWord [(a, b - 1 + i)] ++ List.replicate t false := by
            simp only [blocksToWord, List.append_nil, List.append_assoc]
            rw [← List.append_assoc (List.replicate (b - 1) true), ← List.replicate_add]
          rw [heq_i] at hnot
          have hper := blocks_pow_implies_periodic (L := [(a, b - 1 + i)]) (t := t)
            (by simp) (fun q hq => by simp at hq; subst hq; exact ⟨hab.1, by omega⟩) hnot
          simp at hper
      · -- `b = 1`: word is `0^a ++ [true] ++ 0^t`! Pump the first `false`!
        have hb1 : b = 1 := by omega
        subst hb1
        refine ⟨[], List.replicate (a - 1) false ++ [true] ++ List.replicate t false, false, ?_, fun i => ?_⟩
        · rw [hw_eq]; simp only [blocksToWord, List.append_nil, List.nil_append, List.append_assoc]
          have : List.replicate a false = [false] ++ List.replicate (a - 1) false := by
            rw [show [false] = List.replicate 1 false from rfl, ← List.replicate_add]; congr 1; omega
          rw [this]; simp
        · -- `0^i ++ 0^(a-1) ++ [true] ++ 0^t` has EXACTLY ONE `true`, hence is primitive!
          refine ⟨by intro h0; have := congrArg (List.count true) h0; simp [List.count_replicate] at this,
            fun u k hk hwu => ?_⟩
          change _ = wordPow u k at hwu
          have hct : ([] ++ List.replicate i false ++ (List.replicate (a - 1) false ++ [true] ++ List.replicate t false)).count true = 1 := by
            simp [List.count_append, List.count_replicate]
          have hct2 : k * u.count true = 1 := by
            rw [← wordPow_count, ← hwu, hct]
          have : 1 ≤ u.count true := by
            by_contra h0; have : u.count true = 0 := by omega
            rw [this, Nat.mul_zero] at hct2; omega
          nlinarith
  · -- Now `2 ≤ L.length`!
    have hL2 : 2 ≤ L.length := by
      have : 1 ≤ L.length := List.length_pos_of_ne_nil hLne
      omega
    -- Inspect max of `b`-runs (`L.map Prod.snd`)
    let B := L.map Prod.snd
    have hBne : B ≠ [] := by simpa [B] using hLne
    obtain ⟨Mb, hB_le, jb₀, hjb₀, hB_jb₀⟩ := list_exists_max B hBne
    have hMb_pos : 1 ≤ Mb := by
      have hlt : jb₀ < L.length := by simpa [B] using hjb₀
      have := (hLpos (L[jb₀]'hlt) (List.getElem_mem hlt)).2
      rw [← hB_jb₀]; simpa [B] using this
    by_cases hMb2 : 2 ≤ Mb
    · -- Case 1: `Mb ≥ 2`! Apply `exists_good_max_or_unique` to `B`!
      obtain ⟨M, hM1, hM_le, hcase⟩ := exists_good_max_or_unique hBne ⟨Mb, hMb_pos, hB_le, jb₀, hjb₀, hB_jb₀⟩
      have hM_eq : M = Mb := le_antisymm (by
        rcases hcase with ⟨j, hj, hlj, _⟩ | ⟨j, hj, hlj, _⟩ <;> [exact hlj ▸ hB_le j hj; exact hlj ▸ hB_le j hj])
        (hB_jb₀ ▸ hM_le jb₀ hjb₀)
      subst M
      rcases hcase with ⟨j, hj, hlj, hnotper⟩ | ⟨j, hj, hlj, huniq_b⟩
      · -- Subcase 1a: decrementing `b_j` keeps `B.set j (Mb - 1)` non-periodic! Pump `true` at block `j`!
        have hjL : j < L.length := by simpa [B] using hj
        have hbj_eq : (L[j]'hjL).2 = Mb := by simpa [B] using hlj
        obtain ⟨u, z, hw_split, hset_form, _⟩ := blocks_pump_true L t j hjL (by omega)
        refine ⟨u, z, true, hw_eq.trans hw_split, fun i => ?_⟩
        by_cases hi1 : i = 1
        · subst hi1; simpa [← hw_eq, ← hw_split] using hw
        · by_contra hnot
          have hpos_i : 1 ≤ (L[j]'hjL).2 - 1 + i := by omega
          rw [hset_form i hpos_i] at hnot

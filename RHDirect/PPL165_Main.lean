              | cons p rest =>
                obtain ⟨j', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj0
                simp only [List.set_cons_succ, C, cycZeros, List.map_set, haj_eq]
            rw [hcyc_set] at hper
            by_cases hi0 : i = 0
            · subst hi0; simpa using hnotper hper
            · have hi2 : 2 ≤ i := by omega
              have huniq_i : ∀ idx (hidx : idx < (C.set j (Mc - 1 + i)).length), idx ≠ j →
                  (C.set j (Mc - 1 + i))[idx]'hidx < (C.set j (Mc - 1 + i))[j]'(by simp [hj]) := by
                intro idx hidx hne
                rw [List.getElem_set_ne (Ne.symm hne), List.getElem_set_self]
                have := hC_le idx (by simpa using hidx)
                omega
              exact not_hasProperPeriod_of_unique_max (by simp [hj]) huniq_i hper
      · -- Subcase 2b: `j` is the UNIQUE maximum of `C` (`∀ i ≠ j, C[i] < Mc`)!
        -- Pump the single `true` at block `j` (`b_j = 1`)!
        have hjL : j < L.length := by omega
        have hbj1 : (L[j]'hjL).2 = 1 := hb_all1 j hjL
        obtain ⟨u, z, hw_split, hset_form, hraw_form⟩ := blocks_pump_true L t j hjL (by omega)
        refine ⟨u, z, true, hw_eq.trans hw_split, fun i => ?_⟩
        by_cases hi1 : i = 1
        · subst hi1; simpa [← hw_eq, ← hw_split] using hw
        · by_cases hi0 : i = 0
          · -- `i = 0`: deleting the `true` at block `j` merges `C[j] = Mc` with `C[(j + 1) % L.length] ≥ 1`!
            subst hi0
            by_contra hnot
            rw [hraw_form 0] at hnot
            by_cases hj_last : j + 1 < L.length
            · -- Internal `true` deleted: merges `a_j` and `a_{j+1}`!
              have hdrop_j1 : L.drop (j + 1) = L[j + 1]'hj_last :: L.drop (j + 2) :=
                List.drop_eq_getElem_cons hj_last
              let Lnew := L.take j ++ [((L[j]'hjL).1 + (L[j + 1]'hj_last).1, (L[j + 1]'hj_last).2)] ++ L.drop (j + 2)
              have hword_eq :
                  blocksToWord (L.take j) ++ List.replicate (L[j]'hjL).1 false ++
                  List.replicate ((L[j]'hjL).2 - 1 + 0) true ++ blocksToWord (L.drop (j + 1)) ++ List.replicate t false =
                  blocksToWord Lnew ++ List.replicate t false := by
                rw [hbj1, hdrop_j1]
                simp only [Lnew, blocksToWord_append, blocksToWord, Nat.sub_self, Nat.add_zero,
                  List.replicate_zero, List.append_nil, List.append_assoc]
                rw [← List.append_assoc (List.replicate (L[j]'hjL).1 false), ← List.replicate_add]
              rw [hword_eq] at hnot
              have hLnew_ne : Lnew ≠ [] := by simp [Lnew]
              have hLnew_pos : AllPosBlocks Lnew := by
                intro q hq
                simp only [Lnew, List.mem_append, List.mem_singleton] at hq
                rcases hq with (hq1 | rfl) | hq2
                · exact hLpos q (List.mem_of_mem_take hq1)
                · have h1 := hLpos _ (List.getElem_mem hjL)
                  have h2 := hLpos _ (List.getElem_mem hj_last)
                  exact ⟨by omega, h2.2⟩
                · exact hLpos q (List.mem_of_mem_drop hq2)
              have hper := (blocks_pow_implies_periodic hLnew_ne hLnew_pos hnot).2.2
              -- Compute `cycZeros Lnew t`: position `j` has value `C[j] + C[j + 1] > Mc`, all other positions ≤ Mc!
              have hlen_c : (cycZeros Lnew t).length = L.length - 1 := by
                rw [cycZeros_length]
                simp only [Lnew, List.length_append, List.length_take, List.length_singleton, List.length_drop]
                omega
              have hj_c : j < (cycZeros Lnew t).length := by omega
              have hCnew_at : ∀ idx (hidx : idx < (cycZeros Lnew t).length),
                  (cycZeros Lnew t)[idx]'hidx =
                    if idx = j then Mc + (L[j + 1]'hj_last).1
                    else if idx < j then C[idx]'(by omega)
                    else C[idx + 1]'(by omega) := by
                intro idx hidx
                have hLn_len : Lnew.length = L.length - 1 := by rw [← cycZeros_length Lnew t, hlen_c]
                have htake_len : (L.take j).length = j := by rw [List.length_take]; omega
                -- Helper relating `(cycZeros M t)[k]` to `(M[k]).1 + (if k = 0 then t else 0)`
                have hcyc_get : ∀ (M : List (ℕ × ℕ)) (k : ℕ) (hk : k < (cycZeros M t).length),
                    (cycZeros M t)[k]'hk = (M[k]'(by rwa [cycZeros_length] at hk)).1 + (if k = 0 then t else 0) := by
                  intro M k hk
                  cases M with
                  | nil => simp [cycZeros] at hk
                  | cons p rest =>
                    cases k with
                    | zero => simp [cycZeros]
                    | succ k => simp [cycZeros]
                rw [hcyc_get Lnew idx hidx]
                have hidx_Lnew : idx < Lnew.length := by rw [← cycZeros_length Lnew t]; exact hidx
                by_cases hij : idx = j
                · subst hij
                  simp only [↓reduceIte]
                  have hget_j : (Lnew[idx]'hidx_Lnew).1 = (L[idx]'hjL).1 + (L[idx + 1]'hj_last).1 := by
                    simp only [Lnew, List.append_assoc]
                    rw [List.getElem_append_right (by omega)]
                    simp [htake_len]
                  rw [hget_j]
                  have hCj : C[idx]'hj = (L[idx]'hjL).1 + (if idx = 0 then t else 0) :=
                    hcyc_get L idx hj
                  rw [hlj] at hCj; omega
                · simp only [hij, ↓reduceIte]
                  by_cases hlt : idx < j
                  · simp only [hlt, ↓reduceIte]
                    have hget_lt : (Lnew[idx]'hidx_Lnew).1 = (L[idx]'(by omega)).1 := by
                      simp only [Lnew, List.append_assoc]
                      rw [List.getElem_append_left (by omega), List.getElem_take]
                    rw [hget_lt, hcyc_get L idx (by rw [cycZeros_length]; omega)]
                  · simp only [hlt, ↓reduceIte]
                    have hgt : j < idx := by omega
                    have hget_gt : (Lnew[idx]'hidx_Lnew).1 = (L[idx + 1]'(by omega)).1 := by
                      simp only [Lnew, List.append_assoc]
                      rw [List.getElem_append_right (by omega)]
                      have hpos : 1 ≤ idx - j := by omega
                      rw [List.getElem_append_right (by simp [htake_len]; omega)]
                      simp only [List.length_singleton, htake_len, List.getElem_drop]
                      congr 2; omega
                    rw [hget_gt, hcyc_get L (idx + 1) (by rw [cycZeros_length]; omega)]
                    simp [show idx ≠ 0 by omega]
              have huniq_new : ∀ idx (hidx : idx < (cycZeros Lnew t).length), idx ≠ j →
                  (cycZeros Lnew t)[idx]'hidx < (cycZeros Lnew t)[j]'hj_c := by
                intro idx hidx hne
                rw [hCnew_at idx hidx, hCnew_at j hj_c]
                simp only [↓reduceIte, hne]
                have hpos_next := (hLpos _ (List.getElem_mem hj_last)).1
                split_ifs with hlt
                · have := hC_le idx (by omega); omega
                · have := hC_le (idx + 1) (by omega); omega
              exact not_hasProperPeriod_of_unique_max hj_c huniq_new hper
            · -- Last `true` deleted (`j = L.length - 1`): merges `a_j` into trailing `t` (so `t_new = a_j + t`, and `C_new[0] = a_0 + a_j + t = C[0] + C[j] > Mc`!)
              have hj_eq : j = L.length - 1 := by omega
              have hdrop_nil : L.drop (j + 1) = [] := List.drop_eq_nil_of_le (by omega)
              let Lnew := L.take j
              let tnew := (L[j]'hjL).1 + t
              have hword_eq :
                  blocksToWord (L.take j) ++ List.replicate (L[j]'hjL).1 false ++
                  List.replicate ((L[j]'hjL).2 - 1 + 0) true ++ blocksToWord (L.drop (j + 1)) ++ List.replicate t false =
                  blocksToWord Lnew ++ List.replicate tnew false := by
                rw [hbj1, hdrop_nil]
                simp only [Lnew, tnew, blocksToWord, Nat.sub_self, Nat.add_zero,
                  List.replicate_zero, List.append_nil, List.append_assoc, ← List.replicate_add]
              rw [hword_eq] at hnot
              have hLnew_len : Lnew.length = L.length - 1 := by simp [Lnew, List.length_take]; omega
              have hLnew_ne : Lnew ≠ [] := by intro h0; rw [h0] at hLnew_len; simp at hLnew_len; omega
              have hLnew_pos : AllPosBlocks Lnew := fun q hq => hLpos q (List.mem_of_mem_take hq)
              have hper := (blocks_pow_implies_periodic hLnew_ne hLnew_pos hnot).2.2
              have hlen_c : (cycZeros Lnew tnew).length = L.length - 1 := by rw [cycZeros_length, hLnew_len]
              have h0_c : 0 < (cycZeros Lnew tnew).length := by omega
              have hj_pos : 1 ≤ j := by omega
              have haj_eq : (L[j]'hjL).1 = Mc := by
                cases L with
                | nil => exact absurd rfl hLne
                | cons p rest =>
                  obtain ⟨j', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
                  simpa [C, cycZeros] using hlj
              have hcyc_get : ∀ (M : List (ℕ × ℕ)) (tau : ℕ) (k : ℕ) (hk : k < (cycZeros M tau).length),
                  (cycZeros M tau)[k]'hk = (M[k]'(by rwa [cycZeros_length] at hk)).1 + (if k = 0 then tau else 0) := by
                intro M tau k hk
                cases M with
                | nil => simp [cycZeros] at hk
                | cons p rest =>
                  cases k with
                  | zero => simp [cycZeros]
                  | succ k => simp [cycZeros]
              have huniq_new : ∀ idx (hidx : idx < (cycZeros Lnew tnew).length), idx ≠ 0 →
                  (cycZeros Lnew tnew)[idx]'hidx < (cycZeros Lnew tnew)[0]'h0_c := by
                intro idx hidx hne
                rw [hcyc_get Lnew tnew idx hidx, hcyc_get Lnew tnew 0 h0_c]
                simp only [hne, ↓reduceIte, add_zero]
                have hget0 : (Lnew[0]'(by omega)).1 = (L[0]'(by omega)).1 := by
                  simp [Lnew, List.getElem_take]
                have hget_idx : (Lnew[idx]'(by omega)).1 = (L[idx]'(by omega)).1 := by
                  simp [Lnew, List.getElem_take]
                rw [hget0, hget_idx]
                have hpos0 := (hLpos _ (List.getElem_mem (show 0 < L.length by omega))).1
                have hC_idx : C[idx]'(by omega) = (L[idx]'(by omega)).1 := by
                  rw [hcyc_get L t idx (by rw [cycZeros_length]; omega)]; simp [hne]
                have hle_idx := hC_le idx (by omega)
                dsimp [tnew]; omega
              exact not_hasProperPeriod_of_unique_max h0_c huniq_new hper
          · -- `i ≥ 2`: `b_j` becomes `i ≥ 2` while all other `b_r = 1`, UNIQUE maximum of `B`!
            have hi2 : 2 ≤ i := by omega
            by_contra hnot
            rw [hset_form i (by omega)] at hnot
            have hset_pos : AllPosBlocks (L.set j ((L[j]'hjL).1, (L[j]'hjL).2 - 1 + i)) := by
              intro q hq
              obtain ⟨idx, hidx, rfl⟩ := List.getElem_of_mem hq
              by_cases hji : idx = j
              · subst hji; rw [List.getElem_set_self]; exact ⟨(hLpos _ (List.getElem_mem hjL)).1, by omega⟩
              · rw [List.getElem_set_ne (Ne.symm hji)]
                exact hLpos _ (List.getElem_mem (by simpa using hidx))
            have hper := (blocks_pow_implies_periodic (by simp [hLne]) hset_pos hnot).2.1
            have hmap_set : (L.set j ((L[j]'hjL).1, (L[j]'hjL).2 - 1 + i)).map Prod.snd =
                B.set j i := by
              simp only [B, List.map_set, hbj1]; congr 1; omega
            rw [hmap_set] at hper
            have hjb : j < B.length := by simpa [B] using hjL
            have huniq_i : ∀ idx (hidx : idx < (B.set j i).length), idx ≠ j →
                (B.set j i)[idx]'hidx < (B.set j i)[j]'(by simp [hjb]) := by
              intro idx hidx hne
              rw [List.getElem_set_ne (Ne.symm hne), List.getElem_set_self]
              have hidxL : idx < L.length := by simp [B] at hidx; exact hidx
              have hBidx : B[idx]'(by simpa using hidx) = 1 := by
                simpa [B] using hb_all1 idx hidxL
              omega
            exact not_hasProperPeriod_of_unique_max (by simp [hjb]) huniq_i hper

/-- **Theorem 6a (Strong Single-Character Pumping Theorem for `Q_2`):**
Every binary primitive word `w ∈ Q_2` of length `≥ 2` admits a single-character pumping
decomposition `w = u ++ [c] ++ z` such that `u ++ List.replicate i c ++ z ∈ Q_2` for **all** `i ≥ 0`. -/
theorem ppl165_strong_single_char_pumping (w : List Bool)
    (hw : w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten)
    (hlen : 2 ≤ w.length) :
    ∃ (u z : List Bool) (c : Bool),
      w = u ++ [c] ++ z ∧
      ∀ i : ℕ,
        let wi := u ++ List.replicate i c ++ z
        wi ≠ [] ∧ ∀ (r : List Bool) (k : ℕ), 2 ≤ k → wi ≠ (List.replicate k r).flatten := by
  cases h : w with
  | nil => exact absurd h hw.1
  | cons b bs =>
    cases b with
    | false =>
      have hw' : w ∈ Q2 := hw
      rw [← h]
      exact strong_single_char_pump_false w hw' hlen (by simp [h])
    | true =>
      have hflip_mem : flipWord w ∈ Q2 := flipWord_mem_Q2.mpr hw
      have hflip_len : 2 ≤ (flipWord w).length := by simpa [flipWord] using hlen
      have hflip_head : (flipWord w).head? = some false := by simp [flipWord, h]
      obtain ⟨u, z, c, hsplit, hpump⟩ := strong_single_char_pump_false (flipWord w) hflip_mem hflip_len hflip_head
      refine ⟨flipWord u, flipWord z, !c, ?_, fun i => ?_⟩
      · have hfl := congrArg flipWord hsplit
        rw [flipWord_invol, flipWord_append, flipWord_append] at hfl
        rw [← h]
        simpa [flipWord] using hfl
      · have hi := hpump i
        have hfl : flipWord (u ++ List.replicate i c ++ z) =
            flipWord u ++ List.replicate i (!c) ++ flipWord z := by
          simp [flipWord_append, flipWord_replicate]
        rw [← hfl]
        exact flipWord_mem_Q2.mpr hi

/-- **Theorem 6b (Formal Bar-Hillel CFL Pumping Barrier on `Q_2`):**
`Q_2` satisfies the Bar-Hillel Context-Free Pumping property with optimal pumping length `P = 2`,
formally demonstrating why the standard CFL pumping lemma cannot prove `¬ Language.IsContextFree Q_2`. -/
theorem ppl165_satisfies_cfl_pumping :
    ∃ P : ℕ, 1 ≤ P ∧
      ∀ w : List Bool,
        (w ≠ [] ∧ ∀ (u : List Bool) (k : ℕ), 2 ≤ k → w ≠ (List.replicate k u).flatten) →
        P ≤ w.length →
        ∃ u v x y z : List Bool,
          w = u ++ v ++ x ++ y ++ z ∧
          (v ++ x ++ y).length ≤ P ∧
          1 ≤ (v ++ y).length ∧
          ∀ i : ℕ,
            let wi := u ++ (List.replicate i v).flatten ++ x ++ (List.replicate i y).flatten ++ z
            wi ≠ [] ∧ ∀ (r : List Bool) (k : ℕ), 2 ≤ k → wi ≠ (List.replicate k r).flatten := by
  refine ⟨2, by decide, fun w hw hlen => ?_⟩
  obtain ⟨u, z, c, hsplit, hpump⟩ := ppl165_strong_single_char_pumping w hw hlen
  refine ⟨u, [c], [], [], z, by simpa using hsplit, by simp, by simp, fun i => ?_⟩
  have hrep : (List.replicate i [c]).flatten = List.replicate i c := by
    induction i with
    | zero => rfl
    | succ i ih => simp [List.replicate_succ, ih]
  have hnil : (List.replicate i ([] : List Bool)).flatten = [] := by
    induction i with
    | zero => rfl
    | succ i ih => simp [List.replicate_succ, ih]
  simpa [hrep, hnil] using hpump i

end PPL165

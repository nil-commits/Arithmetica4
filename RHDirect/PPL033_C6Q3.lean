private def checkAut3Aux (q : Q3Bits) (ci ri : ℕ) : Bool :=
  if h1 : ci < 48 then if h2 : ri < 116 then decide (applyAut3 ⟨ci, h1⟩ q = q3RepBits ⟨ri, h2⟩) else false else false

private lemma checkAut3Aux_ok (q : Q3Bits) (ci ri : ℕ) (h : checkAut3Aux q ci ri = true) :
    ∃ (ai : Fin 48) (ri' : Fin 116), applyAut3 ai q = q3RepBits ri' := by
  unfold checkAut3Aux at h
  split at h <;> try contradiction
  split at h <;> try contradiction
  simp only [decide_eq_true_eq] at h
  exact ⟨⟨ci, ‹_›⟩, ⟨ri, ‹_›⟩, h⟩

private def checkAut3Slice (e01 e02 e04 e13 : Bool) : Bool :=
  [false, true].all fun e15 => [false, true].all fun e23 => [false, true].all fun e26 => [false, true].all fun e37 => [false, true].all fun e45 => [false, true].all fun e46 => [false, true].all fun e57 => [false, true].all fun e67 =>
    !q3IsC6FreeBool e01 e02 e04 e13 e15 e23 e26 e37 e45 e46 e57 e67 ||
    checkAut3Aux ⟨e01, e02, e04, e13, e15, e23, e26, e37, e45, e46, e57, e67⟩ (canonIdx48Nat e01 e02 e04 e13 e15 e23 e26 e37 e45 e46 e57 e67) (canonRep116Nat e01 e02 e04 e13 e15 e23 e26 e37 e45 e46 e57 e67)

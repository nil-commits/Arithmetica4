lemma q3_exists_aut3_rep (q : Q3Bits)
    (hc : q3IsC6FreeBool q.e01 q.e02 q.e04 q.e13 q.e15 q.e23 q.e26 q.e37 q.e45 q.e46 q.e57 q.e67 = true) :
    ∃ (ai : Fin 48) (ri : Fin 116), applyAut3 ai q = q3RepBits ri := by
  have hslice : checkAut3Slice q.e01 q.e02 q.e04 q.e13 = true := by
    cases q.e01 <;> cases q.e02 <;> cases q.e04 <;> cases q.e13
    · exact checkAut3_00
    · exact checkAut3_01
    · exact checkAut3_02
    · exact checkAut3_03

  have h := (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool (list_all_bool hslice q.e15) q.e23) q.e26) q.e37) q.e45) q.e46) q.e57) q.e67)
